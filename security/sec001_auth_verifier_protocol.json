{
  "id": "SEC-001-VERIFIER-PROTOCOL",
  "version": 2,
  "status": "managed_idp_target_not_deployed",
  "principle": "identity proof is separated from Campus authorization and session issuance",
  "preferred_poc_provider": "Auth0 Essentials",
  "steady_state": {
    "browser_to_idp": {
      "transport": "HTTPS",
      "login_surface": "Universal Login",
      "identifier": "Campus usuario",
      "password_destination": "IdP only",
      "mfa_destination": "IdP only",
      "apps_script_receives_password": false
    },
    "browser_to_campus": {
      "request": "OIDC/OAuth identity proof from successful IdP authentication",
      "must_not_include": [
        "password",
        "password_hash",
        "TOTP secret",
        "TOTP verification code after IdP completion"
      ]
    },
    "identity_validation": {
      "required": true,
      "preferred_for_poc": "remote OIDC/UserInfo validation over HTTPS",
      "reason": "avoid implementing JWT verification cryptography from scratch inside the Apps Script monolith",
      "required_identity_fields": [
        "issuer",
        "subject",
        "audience_or_client_binding",
        "authenticated_username_or_stable_mapping"
      ],
      "reject_expired_or_wrong_issuer": true
    },
    "apps_script_after_identity": {
      "lookup_local_account": true,
      "derive_role_from_local_source": true,
      "derive_groups_from_local_source": true,
      "derive_active_state_from_local_source": true,
      "issue_existing_campus_session_token": true,
      "idp_role_claims_are_authoritative": false
    }
  },
  "campus_session": {
    "unchanged_initial_target": true,
    "password_credentials_are_not_session_credentials": true,
    "existing_validarSesion_contract_preserved": true
  },
  "failure_behavior": {
    "uniform_external_invalid_identity_response": true,
    "must_not_reveal": [
      "account existence",
      "local active/inactive state before authentication is complete",
      "password correctness reason",
      "whether a username is present only in a legacy store"
    ]
  },
  "password_policy": {
    "minimum_length": 15,
    "maximum_ui_length": 128,
    "arbitrary_composition_rules": false,
    "common_password_dictionary": true,
    "block_personal_data_after_qa": true
  },
  "mfa": {
    "provider_managed": true,
    "preferred_factor": "TOTP",
    "required_for_staff_target": true,
    "campus_does_not_store_totp_secret": true,
    "campus_does_not_verify_totp": true
  },
  "temporary_migration_bridge": {
    "steady_state_component": false,
    "purpose": "move one legacy account to the managed IdP without bulk plaintext export",
    "legacy_password_may_reach_apps_script_during_bridge": true,
    "legacy_password_may_be_logged": false,
    "legacy_password_may_be_returned": false,
    "new_password_required": true,
    "new_password_min_length": 15,
    "new_password_must_not_be_read_from_sheet_for_copy": true,
    "rate_limit_required_before_legacy_verification": true,
    "anti_automation_required": true,
    "successful_sequence": [
      "verify legacy credential once",
      "create managed IdP identity with username and new password",
      "persist AUTH_SUB/provider/migration state only",
      "neutralize readable password from every applicable legacy store",
      "issue Campus session",
      "route future logins only to IdP"
    ],
    "failed_idp_creation": [
      "do not mark migrated",
      "do not clear legacy credential",
      "record non-secret technical event"
    ],
    "migrated_account_plaintext_fallback_allowed": false,
    "retirement_required": true
  },
  "legacy_stores_in_scope": [
    "USUARIOS.clave",
    "DATOS.clave",
    "PROSPECTOS.CLAVE and equivalent pending-account credential paths"
  ],
  "new_account_target": {
    "password_persisted_in_sheets": false,
    "identity_created_only_after_authorized_account_establishment": true,
    "campus_persists": [
      "AUTH_PROVIDER",
      "AUTH_SUB",
      "AUTH_STATE",
      "AUTH_MIGRATED_AT",
      "AUTH_MIGRATION_VERSION"
    ],
    "campus_must_not_persist": [
      "password",
      "IdP access token",
      "IdP refresh token",
      "TOTP secret"
    ]
  },
  "production_authorized": false
}
