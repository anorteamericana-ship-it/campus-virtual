  var actualStart = _ccF84_fechaHora_(actual.fechaIso, _ccF84_minHora_(actual.iniMin));
  for (var i = 0; i < malla.length; i++) {
    var iso = _ccF84_iso_(malla[i].fecha);
    var st = _ccF84_fechaHora_(iso, _ccF84_minHora_(malla[i].horaIniMin));
    if (st && actualStart && st.getTime() > actualStart.getTime()) {
      return { ok:true, fecha:malla[i].fecha, fechaIso:iso, dia:malla[i].diaSemana, turno:malla[i].turno,
        horaInicio:_ccF84_minHora_(malla[i].horaIniMin), horaFin:_ccF84_minHora_(malla[i].horaFinMin),
        iniMin:malla[i].horaIniMin, finMin:malla[i].horaFinMin };
    }
