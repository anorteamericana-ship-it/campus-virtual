var CONAPE_DRIVE_FOLDER_ID = '1LIX_vbyyZAtPElUpfm5S5WjIHs79n0Vt';

// ncuenta por nivel: matrícula y certificado (de OTROS PAGOS)
var CONAPE_NCUENTA_MAT  = { B1: 60, B2: 61, I1: 62, I2: 63 };
var CONAPE_NCUENTA_CERT = { B1: 43, B2: 44, I1: 45, I2: 46 };
var CONAPE_NIVELES      = ['B1', 'B2', 'I1', 'I2'];
var CONAPE_COD_MATERIA  = { B1:'ING-IN-B1-01', B2:'ING-IN-B2-02', I1:'ING-IN-I1-03', I2:'ING-IN-I2-04' };
var CONAPE_BLOQUE       = { B1: 1, B2: 2, I1: 3, I2: 4 };
var CONAPE_TIPO_P_MAP   = { C: 'C', B: 'B' }; // cuatrimestral / bimestral

// sincronizarCONAPE(params)                          — v4.13
// GET ?fn=sincronizarCONAPE                          → sincroniza API CONAPE (flujo existente)
// GET ?fn=sincronizarCONAPE&codigo=17055             → actualiza Drive para 1 estudiante
// GET ?fn=sincronizarCONAPE&cod_grupo=B1-LM69-C1-0126 → actualiza Drive para todo el grupo
// ============================================================
// ============================================================
// _limpiarCedula(s)                                  — v4.27.3
// Normaliza una cédula a string sin guiones ni espacios.
// USAR EN TODOS LOS PUNTOS donde se lee, escribe o compara
// una cédula contra las hojas CONAPE 4-7.
//
// El bug histórico de duplicados venía de comparar '7-0153-0669'
// con '701530669' como si fueran personas distintas. Con esta
// función todos los comparadores ven la versión limpia.
// ============================================================
function _limpiarCedula(s) {
  return String(s == null ? '' : s).replace(/[-\s]/g, '').trim();
}

function sincronizarCONAPE(params) {
  params = params || {};
  var codigo    = String(params.codigo    || '').trim();
  var cod_grupo = String(params.cod_grupo || '').trim();

  // Modo 1: actualizar 1 estudiante en Drive
  if (codigo) {
    return sincronizarCONAPE_estudiante(codigo);
  }

  // Modo 2: actualizar grupo completo en Drive
  if (cod_grupo) {
    return sincronizarCONAPE_grupo(cod_grupo);
  }

  // Modo 3: sin parámetros → flujo original de sincronización con API CONAPE
  try {
    var response = UrlFetchApp.fetch(getConapeUrl(), {
      method: 'get',
      muteHttpExceptions: true,
    });

    if (response.getResponseCode() !== 200) {
      return { ok: false, error: 'CONAPE API error: ' + response.getResponseCode() };
    }

    var xmlText = response.getContentText();
    var prestatarios = parsearXmlConape(xmlText);

    var ss = SpreadsheetApp.openById(SHEET_ID);
    prestatarios = cruzarConApollo(ss, prestatarios);

    var ws = getOrCreateConapeSyncSheet(ss);
    var rows = ws.getDataRange().getValues();
    var h = rows[0];

    var iCed  = h.indexOf('CEDULA');
    var iNum  = h.indexOf('NUM_DESEMBOLSO');
    var iMes  = h.indexOf('PERIODO_MES');
    var iAnio = h.indexOf('PERIODO_ANIO');

    var mapaSync = {};
    for (var i = 1; i < rows.length; i++) {
      var ced = _limpiarCedula(rows[i][iCed]); // v4.27.3
      if (ced) mapaSync[ced] = { fila: i + 1, data: rows[i] };
    }

    var ahora = Utilities.formatDate(new Date(), 'America/Costa_Rica', 'yyyy-MM-dd HH:mm:ss');
    var novedades = [], nuevos = 0, actualizados = 0;

    prestatarios.forEach(function(p) {
      var novedad = '';
      var estadoCampus = p.codigoEst ? 'VINCULADO' : 'SIN_VINCULAR';

      if (mapaSync[p.cedula]) {
        var filaActual = mapaSync[p.cedula].data;
        var numAnterior  = String(filaActual[iNum]  || '').trim();
        var mesAnterior  = String(filaActual[iMes]  || '').trim();
        var anioAnterior = String(filaActual[iAnio] || '').trim();

        if (p.fechaRaw && (p.numDesembolso !== numAnterior ||
            p.periodoMes !== mesAnterior || p.periodoAnio !== anioAnterior)) {
          novedad = 'NUEVO_DESEMBOLSO_' + p.numDesembolso + '_' + p.periodoMes + '_' + p.periodoAnio;
          novedades.push({ cedula: p.cedula, nombre: p.nombre, grupo: p.grupo,
                           codigo: p.codigoEst, novedad: novedad,
                           desembolso: p.numDesembolso, periodo: p.periodoMes + '/' + p.periodoAnio });
          actualizados++;
        } else if (!p.fechaRaw && numAnterior) {
          novedad = 'DESEMBOLSO_REMOVIDO';
        }
        var filaNum = mapaSync[p.cedula].fila;
        ws.getRange(filaNum, 1, 1, CONAPE_SYNC_HEADERS.length).setValues([[
          p.cedula, p.nombre, p.numDesembolso, p.periodoMes, p.periodoAnio,
          p.fechaRaw, p.codigoEst, p.grupo, estadoCampus, ahora, novedad
        ]]);
      } else {
        novedad = p.fechaRaw ? 'PRIMER_DESEMBOLSO' : 'APROBADO_SIN_DESEMBOLSO';
        if (p.fechaRaw) novedades.push({ cedula: p.cedula, nombre: p.nombre, grupo: p.grupo,
                                         codigo: p.codigoEst, novedad: novedad,
                                         desembolso: p.numDesembolso, periodo: p.periodoMes + '/' + p.periodoAnio });
        ws.appendRow([p.cedula, p.nombre, p.numDesembolso, p.periodoMes, p.periodoAnio,
                      p.fechaRaw, p.codigoEst, p.grupo, estadoCampus, ahora, novedad]);
        nuevos++;
      }
      // v4.24.0 — guardar la novedad por cédula para cruce con PROSPECTOS abajo
      p._novedad = novedad;
    });

    // v4.24.0 — cruzar con PROSPECTOS y avanzar etapas automáticamente
    var avancesProspecto = 0;
    try {
      avancesProspecto = _avanzarEtapasProspectosDesdeCONAPE(ss, prestatarios, ahora);
    } catch (eProsp) {
      // No fallar el sync completo si esto revienta — solo loguear
      Logger.log('[sincronizarCONAPE] Error avanzando etapas PROSPECTOS: ' + eProsp);
    }

    return { ok: true, timestamp: ahora, total: prestatarios.length,
             nuevos: nuevos, actualizados: actualizados, novedades: novedades,
             avancesProspecto: avancesProspecto,
             mensaje: 'CONAPE sincronizado: ' + prestatarios.length + ' prestatarios, '
                      + novedades.length + ' novedades detectadas, '
                      + avancesProspecto + ' etapas avanzadas en PROSPECTOS.' };
  } catch(e) {
    return { ok: false, error: e.toString() };
  }
}

// ============================================================
// _avanzarEtapasProspectosDesdeCONAPE                  — v4.24.0
// Helper interno. Recibe los prestatarios del WS CONAPE (cada uno
// con _novedad: PRIMER_DESEMBOLSO | NUEVO_DESEMBOLSO_... |
// APROBADO_SIN_DESEMBOLSO | '' | DESEMBOLSO_REMOVIDO) y avanza la
// columna ETAPA + F_* correspondiente en PROSPECTOS.
//
// Reglas:
//   - Solo afecta prospectos con FINANCIAMIENTO = 'CONAPE' (o vacío
//     pero con conape_* en true; nos quedamos con FINANCIAMIENTO).
//   - PRIMER_DESEMBOLSO o NUEVO_DESEMBOLSO_* → etapa CONAPE_DESEMBOLSO,
//     llenar F_DESEMBOLSO solo si está vacío (preserva primera fecha).
//   - APROBADO_SIN_DESEMBOLSO → etapa CONAPE_APROBADO si estaba en
//     LEAD/SOLICITUD/DOCUMENTOS; llenar F_APROBADO si vacío.
//   - NUNCA retrocede: si ya está en PAGO_ACADEMIA o ACTIVO no toca.
//   - Retorna cantidad de filas avanzadas.
// ============================================================
function _avanzarEtapasProspectosDesdeCONAPE(ss, prestatarios, ahora) {
  var wsP = ss.getSheetByName('PROSPECTOS');
  if (!wsP) return 0;
  var rows = wsP.getDataRange().getValues();
  if (rows.length <= 1) return 0;

  var h = rows[0];
  var iCed   = h.indexOf('CEDULA');
  var iFin   = h.indexOf('FINANCIAMIENTO');
  var iEtapa = h.indexOf('ETAPA');
  var iFAp   = h.indexOf('F_APROBADO');
  var iFDes  = h.indexOf('F_DESEMBOLSO');
  var iNotas = h.indexOf('NOTAS');

  // Si la migración no agregó ETAPA aún, no podemos avanzar
  if (iEtapa < 0 || iFAp < 0 || iFDes < 0) return 0;

  // Map cédula → { etapa, _novedad } desde prestatarios
  var mapCed = {};
  prestatarios.forEach(function(p) {
    var ced = String(p.cedula || '').replace(/[-\s]/g,'').trim();
    if (!ced) return;
    mapCed[ced] = p._novedad || '';
  });

  // Etapas que se consideran "antes de aprobado"
  var etapasPrevias = { 'LEAD':1, 'CONAPE_SOLICITUD':1, 'CONAPE_DOCUMENTOS':1 };
  // Etapas que NO permiten retroceder a CONAPE_DESEMBOLSO o anteriores
  var etapasFinales = { 'PAGO_ACADEMIA':1, 'ACTIVO':1, 'CANCELADO':1 };

  var avances = 0;

  for (var i = 1; i < rows.length; i++) {
    var ced = String(rows[i][iCed] || '').replace(/[-\s]/g,'').trim();
    if (!ced || !mapCed.hasOwnProperty(ced)) continue;

    var fin = String(rows[i][iFin] || '').toUpperCase().trim();
    if (fin !== 'CONAPE') continue;  // solo prospectos CONAPE

    var etapaActual = String(rows[i][iEtapa] || '').trim();
    if (etapasFinales[etapaActual]) continue;  // no retrocede

    var nov = mapCed[ced];
    var nuevaEtapa = null;
    var llenarFAprobado  = false;
    var llenarFDesembolso = false;
    var motivoNota = '';

    if (nov === 'PRIMER_DESEMBOLSO' || (nov && nov.indexOf('NUEVO_DESEMBOLSO_') === 0)) {
      nuevaEtapa = 'CONAPE_DESEMBOLSO';
      llenarFDesembolso = !rows[i][iFDes];  // solo si vacío
      // Si nunca pasó por APROBADO, también marca F_APROBADO
      if (!rows[i][iFAp]) llenarFAprobado = true;
      motivoNota = 'Auto: ' + nov + ' detectado en CONAPE_SYNC';
    } else if (nov === 'APROBADO_SIN_DESEMBOLSO' && etapasPrevias[etapaActual]) {
      nuevaEtapa = 'CONAPE_APROBADO';
      llenarFAprobado = !rows[i][iFAp];
      motivoNota = 'Auto: aprobado por CONAPE detectado';
    }

    if (!nuevaEtapa) continue;
    if (nuevaEtapa === etapaActual && !llenarFAprobado && !llenarFDesembolso) continue;

    // Aplicar updates
    var filaNum = i + 1;
    if (nuevaEtapa !== etapaActual) {
      wsP.getRange(filaNum, iEtapa + 1).setValue(nuevaEtapa);
    }
    if (llenarFAprobado) wsP.getRange(filaNum, iFAp + 1).setValue(ahora);
    if (llenarFDesembolso) wsP.getRange(filaNum, iFDes + 1).setValue(ahora);

    // Append a NOTAS
    if (iNotas >= 0) {
      var notaPrev = String(rows[i][iNotas] || '').trim();
      var nuevaLinea = '[' + ahora + '] ' + motivoNota + ' (etapa: ' + (etapaActual || '∅') + ' → ' + nuevaEtapa + ')';
      var notaNueva = notaPrev ? (notaPrev + '\n' + nuevaLinea) : nuevaLinea;
      wsP.getRange(filaNum, iNotas + 1).setValue(notaNueva);
    }

    avances++;
  }

  return avances;
}

// ============================================================
// sincronizarCONAPE_estudiante(codigo)
// Actualiza las 4 filas del estudiante en los archivos Drive
// sin crear páginas nuevas — solo modifica valores existentes
// ============================================================
// ============================================================
// reescribirHoja(ws, headers, filas)
// Limpia todo el contenido bajo la fila 1 y reescribe con filas nuevas.
// ============================================================
function reescribirHoja(ws, headers, filas) {
  var lastRow = ws.getLastRow();
  if (lastRow > 1) {
    ws.getRange(2, 1, lastRow - 1, Math.max(ws.getLastColumn(), 10)).clearContent();
  }
  if (!filas || filas.length === 0) return;
  ws.getRange(2, 1, filas.length, filas[0].length).setValues(filas);
}

// ============================================================
// buildFilas_4: 1 fila por estudiante
// Schema: id | cedula | nombre_completo
// ============================================================
function buildFilas_4(todosDatos) {
  var filas = [];
  todosDatos.forEach(function(d) {
    filas.push([d.codigo, _limpiarCedula(d.cedula), d.nombre]); // v4.27.3
  });
  return filas;
}

// ============================================================
// buildFilas_5: 4 filas por estudiante
// Schema: estudiante_id | codigo_sede | codigo_carrera | nombre_grado |
//         numero_bloque | tipo_periodo | codigo_materia | estatus | nota
// ============================================================
function buildFilas_5(todosDatos) {
  var filas = [];
  todosDatos.forEach(function(d) {
    CONAPE_NIVELES.forEach(function(nivel) {
      var ed = d.estatusPorNivel[nivel];
      if (!ed) return;
      var tipoP  = (ed.tipo === 'B') ? 'B' : 'C';
      var estatus= mapearEstatusCONAPE(ed.estatus);
      var nota   = (ed.estatus === 'APR' || ed.estatus === 'REP') ? Math.round(ed.nota) : '';
      filas.push([_limpiarCedula(d.cedula), 'SJ01', 'ING-CONV-IN', 'CURSO IDIOMA',
                  CONAPE_BLOQUE[nivel], tipoP, CONAPE_COD_MATERIA[nivel], estatus, nota]); // v4.27.3
    });
  });
  return filas;
}

// ============================================================
// buildFilas_6: 4 filas por estudiante — espejo en tiempo real
// Schema: codigo_sede | codigo_carrera | estudiante_id | nombre_grado |
//         codigo_materia | ano | periodo | tipo_periodo | estatus | nota
// ============================================================
function buildFilas_6(todosDatos) {
  var filas = [];
  todosDatos.forEach(function(d) {
    CONAPE_NIVELES.forEach(function(nivel) {
      var ed = d.estatusPorNivel[nivel];
      if (!ed) return;
      var tipoP      = (ed.tipo === 'B') ? 'B' : 'C';
      var anio       = ed.anio || new Date().getFullYear();
      var periodoNum = calcularNumeroPeriodo(ed.periodo, tipoP);
      var estatus    = mapearEstatusCONAPE(ed.estatus);
      var nota       = (ed.estatus === 'APR' || ed.estatus === 'REP') ? Math.round(ed.nota) : '';
      filas.push(['SJ01', 'ING-CONV-IN', _limpiarCedula(d.cedula), 'CURSO IDIOMA',
                  CONAPE_COD_MATERIA[nivel], anio, periodoNum, tipoP, estatus, nota]); // v4.27.3
    });
  });
  return filas;
}

// ============================================================
// buildFilas_7: una fila por nivel con historial
// Schema: codigo_sede | estudiante_id | ano | periodo | estado
// ============================================================
function buildFilas_7(todosDatos) {
  var filas = [];
  todosDatos.forEach(function(d) {
    CONAPE_NIVELES.forEach(function(nivel) {
      var ed = d.estatusPorNivel[nivel];
      if (!ed) return;
      if (ed.estatus === 'PE' && d.morosidad[nivel] === 'PE') return;
      var tipoP      = (ed.tipo === 'B') ? 'B' : 'C';
      var anio       = ed.anio || new Date().getFullYear();
      var periodoNum = calcularNumeroPeriodo(ed.periodo, tipoP);
      filas.push(['SJ01', _limpiarCedula(d.cedula), anio, periodoNum, d.morosidad[nivel]]); // v4.27.3
    });
  });
  return filas;
}

function sincronizarCONAPE_estudiante(codigo) {
  // Estrategia: leer las 4 hojas completas, reemplazar filas del estudiante,
  // reescribir la hoja completa. Sin riesgo de duplicados ni filas huérfanas.
  if (!codigo) return { ok: false, error: 'codigo requerido' };
  try {
    var ss    = SpreadsheetApp.openById(SHEET_ID);
    var datos = leerDatosEstudiante_CONAPE(ss, String(codigo).trim());
    if (!datos) return { ok: false, error: 'Estudiante no encontrado: ' + codigo };

    var cedula = datos.cedula;

    // 4-estudiantes: 1 fila por estudiante (col 0 = id, col 1 = cedula)
    actualizarArchivoCONAPE_Drive('4-estudiantes', function(ws) {
      var rows = ws.getDataRange().getValues();
      // Filtrar filas que NO son este estudiante (mantener el resto)
      var nuevasFilas = [];
      for (var i = 1; i < rows.length; i++) {
        var c = _limpiarCedula(rows[i][1]); // v4.27.3 — sin guiones
        if (c !== cedula) nuevasFilas.push(rows[i]);
      }
      nuevasFilas.push([datos.codigo, cedula, datos.nombre]);
      reescribirHoja(ws, rows[0], nuevasFilas);
    });

    // 5-plan_estudios: 4 filas por estudiante (col 0 = estudiante_id = cedula)
    actualizarArchivoCONAPE_Drive('5-plan_estudios', function(ws) {
      var rows = ws.getDataRange().getValues();
      var nuevasFilas = [];
      for (var i = 1; i < rows.length; i++) {
        var c = _limpiarCedula(rows[i][0]); // v4.27.3
        if (c !== cedula) nuevasFilas.push(rows[i]);
      }
      buildFilas_5([datos]).forEach(function(f) { nuevasFilas.push(f); });
      reescribirHoja(ws, rows[0], nuevasFilas);
    });

    // 6-historial: 4 filas por estudiante (col 2 = estudiante_id = cedula)
    actualizarArchivoCONAPE_Drive('6-historial', function(ws) {
      var rows = ws.getDataRange().getValues();
      var nuevasFilas = [];
      for (var i = 1; i < rows.length; i++) {
        var c = _limpiarCedula(rows[i][2]); // v4.27.3
        if (c !== cedula) nuevasFilas.push(rows[i]);
      }
      buildFilas_6([datos]).forEach(function(f) { nuevasFilas.push(f); });
      reescribirHoja(ws, rows[0], nuevasFilas);
    });

    // 7-morosidad: múltiples filas por estudiante (col 1 = estudiante_id = cedula)
    actualizarArchivoCONAPE_Drive('7-morosidad', function(ws) {
      var rows = ws.getDataRange().getValues();
      var nuevasFilas = [];
      for (var i = 1; i < rows.length; i++) {
        var c = _limpiarCedula(rows[i][1]); // v4.27.3
        if (c !== cedula) nuevasFilas.push(rows[i]);
      }
      buildFilas_7([datos]).forEach(function(f) { nuevasFilas.push(f); });
      reescribirHoja(ws, rows[0], nuevasFilas);
    });

    return { ok: true, codigo: codigo, cedula: cedula, nombre: datos.nombre,
             mensaje: 'CONAPE actualizado para ' + datos.nombre };
  } catch(e) {
    return { ok: false, error: e.toString() };
  }
}

// ============================================================
// sincronizarCONAPE_grupo(cod_grupo) — v4.19.0
// Sincroniza SOLO los estudiantes con huella en el grupo:
//   - Vivos: DATOS.GRUPO === cod_grupo
//   - Históricos: cualquier código con fila en ESTATUS.GRUPO === cod_grupo
// Los demás estudiantes en CONAPE quedan intactos.
// Esto evita reescribir las 4 hojas completas con los 100+ estudiantes
// y respeta el límite de 6 minutos de Apps Script.
// ============================================================
function sincronizarCONAPE_grupo(cod_grupo) {
  if (!cod_grupo) return { ok: false, error: 'cod_grupo requerido' };
  var codGrupoStr = String(cod_grupo).trim();

  try {
    var ss = SpreadsheetApp.openById(SHEET_ID);

    // ── 1. Identificar códigos con huella en el grupo ────────────────
    var codigosSet = {};

    // 1a. Vivos: DATOS.GRUPO = cod_grupo
    var wsDatos  = ss.getSheetByName(SH.DATOS);
    var datRows  = wsDatos.getDataRange().getValues();
    var datH     = datRows[0];
    var iDCod    = datH.indexOf('CODIGO');
    var iDGrp    = datH.indexOf('GRUPO');
    for (var i = 1; i < datRows.length; i++) {
      if (String(datRows[i][iDGrp] || '').trim() === codGrupoStr) {
        var c = String(datRows[i][iDCod] || '').trim();
        if (c) codigosSet[c] = true;
      }
    }

    // 1b. Históricos: ESTATUS.GRUPO = cod_grupo (cubre quienes ya pasaron de nivel)
    var wsEst   = ss.getSheetByName(SH.ESTATUS);
    var estRows = wsEst.getDataRange().getValues();
    var estH    = estRows[0];
    var iECod   = estH.indexOf('CODIGO');
    var iEGrp   = estH.indexOf('GRUPO');
    for (var j = 1; j < estRows.length; j++) {
      if (String(estRows[j][iEGrp] || '').trim() === codGrupoStr) {
        var c2 = String(estRows[j][iECod] || '').trim();
        if (c2) codigosSet[c2] = true;
      }
    }

    var codigosDelGrupo = Object.keys(codigosSet);
    if (codigosDelGrupo.length === 0) {
      return { ok: false, error: 'No se encontraron estudiantes con huella en ' + codGrupoStr };
    }

    // ── 2. Leer datos completos solo de esos estudiantes ─────────────
    var datosGrupo = [];
    var cedulasGrupo = {}; // set para filtrar al reescribir

    codigosDelGrupo.forEach(function(cod) {
      var d = leerDatosEstudiante_CONAPE(ss, cod);
      if (d) {
        datosGrupo.push(d);
        if (d.cedula) cedulasGrupo[_limpiarCedula(d.cedula)] = true; // v4.27.3
      }
    });

    if (datosGrupo.length === 0) {
      return { ok: false, error: 'leerDatosEstudiante_CONAPE retornó null para todos los códigos del grupo' };
    }

    // ── 3. Reescritura selectiva de cada hoja CONAPE ─────────────────
    // Patrón: leer hoja completa, conservar filas que NO son del grupo,
    // agregar las filas recalculadas del grupo, reescribir.

    // 4-estudiantes: cedula en col 1
    actualizarArchivoCONAPE_Drive('4-estudiantes', function(ws) {
      var rows = ws.getDataRange().getValues();
      var conservadas = [];
      for (var k = 1; k < rows.length; k++) {
        var ced = _limpiarCedula(rows[k][1]); // v4.27.3
        if (!cedulasGrupo[ced]) conservadas.push(rows[k]);
      }
      var nuevasGrupo = buildFilas_4(datosGrupo);
      var todasFilas = conservadas.concat(nuevasGrupo);
      reescribirHoja(ws, rows[0], todasFilas);
    });

    // 5-plan_estudios: cedula en col 0
    actualizarArchivoCONAPE_Drive('5-plan_estudios', function(ws) {
      var rows = ws.getDataRange().getValues();
      var conservadas = [];
      for (var k = 1; k < rows.length; k++) {
        var ced = _limpiarCedula(rows[k][0]); // v4.27.3
        if (!cedulasGrupo[ced]) conservadas.push(rows[k]);
      }
      var nuevasGrupo = buildFilas_5(datosGrupo);
      var todasFilas = conservadas.concat(nuevasGrupo);
      reescribirHoja(ws, rows[0], todasFilas);
    });

    // 6-historial: cedula en col 2
    actualizarArchivoCONAPE_Drive('6-historial', function(ws) {
      var rows = ws.getDataRange().getValues();
      var conservadas = [];
      for (var k = 1; k < rows.length; k++) {
        var ced = _limpiarCedula(rows[k][2]); // v4.27.3
        if (!cedulasGrupo[ced]) conservadas.push(rows[k]);
      }
      var nuevasGrupo = buildFilas_6(datosGrupo);
      var todasFilas = conservadas.concat(nuevasGrupo);
      reescribirHoja(ws, rows[0], todasFilas);
    });

    // 7-morosidad: cedula en col 1 (múltiples filas por estudiante posibles)
    actualizarArchivoCONAPE_Drive('7-morosidad', function(ws) {
      var rows = ws.getDataRange().getValues();
      var conservadas = [];
      for (var k = 1; k < rows.length; k++) {
        var ced = _limpiarCedula(rows[k][1]); // v4.27.3
        if (!cedulasGrupo[ced]) conservadas.push(rows[k]);
      }
      var nuevasGrupo = buildFilas_7(datosGrupo);
      var todasFilas = conservadas.concat(nuevasGrupo);
      reescribirHoja(ws, rows[0], todasFilas);
    });

    return {
      ok: true,
      cod_grupo: codGrupoStr,
      total: datosGrupo.length,
      mensaje: 'CONAPE sincronizado: ' + datosGrupo.length + ' estudiantes del grupo ' + codGrupoStr
    };
  } catch(e) {
    return { ok: false, error: e.toString() };
  }
}

