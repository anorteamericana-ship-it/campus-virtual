function _certF25NivelNombre_(nivel) {
  nivel = String(nivel || '').trim().toUpperCase();
  return {
    B1: 'BASICO 1',
    B2: 'BASICO 2',
    I1: 'INTERMEDIO 1',
    I2: 'INTERMEDIO 2'
  }[nivel] || nivel;
}

function _certF25NombreOficial_(nivel, codigo, cedula) {
  return 'CERTIFICADO ' + _certF25NivelNombre_(nivel) + ' - ' + String(codigo || '').trim() + ' - ' + String(cedula || '').trim() + '.pdf';
}

function _certF25DriveSearchUrl_(q) {
  return 'https://drive.google.com/drive/search?q=' + encodeURIComponent(q || '');
}

function _certF25ArchivoInfo_(file) {
  return {
    id: file.getId(),
    url: file.getUrl(),
    nombre: file.getName(),
    fecha_creacion: file.getDateCreated ? file.getDateCreated() : '',
    fecha_modificacion: file.getLastUpdated ? file.getLastUpdated() : ''
  };
}

function _certF25ElegirMasReciente_(files) {
  if (!files || !files.length) return null;
  files.sort(function(a, b) {
    var da = a.getLastUpdated ? a.getLastUpdated() : a.getDateCreated();
    var db = b.getLastUpdated ? b.getLastUpdated() : b.getDateCreated();
    return db.getTime() - da.getTime();
  });
  return files[0];
}

