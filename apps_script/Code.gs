// ════════════════════════════════════════════════════════════════════
// EDICIÓN DE LECCIÓN CERRADA — SOLO SUPERADMIN              — v4.22.5
// Edita retro, progress check, asistencia y nota de una lección ya
// cerrada. Reemplaza el dato existente (no duplica). Marca discreta
// editado_por + fecha en la misma fila (trazabilidad mínima ante INA).
// Seguridad SEC-004A: requiere token de sesión válido con rol superadmin.
// Ya no acepta confirmacion_superadmin='LEONARDO_SI' ni cédula enviada por navegador.
// ════════════════════════════════════════════════════════════════════

function _esSuperadmin(body) {
  if (!body) return false;
  var token = String(body.token || body.session_token || '').trim();
  if (!token) return false;
  try {
    var sesion = validarSesion(token);
    return !!(sesion && sesion.ok === true && String(sesion.rol || '').trim() === 'superadmin');
  } catch (e) {
    return false;
  }
}

function _asegurarColsEdicion(ws) {
  var lastCol = ws.getLastColumn();
  var H = ws.getRange(1, 1, 1, lastCol).getValues()[0];
  var iEP = H.indexOf('editado_por');
  var iEF = H.indexOf('editado_fecha');
  if (iEP === -1) { ws.getRange(1, lastCol + 1).setValue('editado_por').setFontWeight('bold'); iEP = lastCol; lastCol++; }
  if (iEF === -1) { ws.getRange(1, lastCol + 1).setValue('editado_fecha').setFontWeight('bold'); iEF = lastCol; lastCol++; }
  return { iEP: iEP, iEF: iEF };
}

// body: { tipo:'retro'|'pc', cod_grupo, leccion_num, lista:[{cod_estudiante,comentario}],
//         editado_por, confirmacion_superadmin }
function editarRetroPCCerrada(body) {
  if (!_esSuperadmin(body)) return { ok: false, error: 'Operación restringida a superadmin.' };
  if (!body.cod_grupo || !body.leccion_num || !body.lista || !body.tipo) {
    return { ok: false, error: 'Faltan: tipo, cod_grupo, leccion_num, lista' };
  }
  var tipo = String(body.tipo).toLowerCase();
  var ss = SpreadsheetApp.openById(OPERATIVO_ID);
  var ws = ss.getSheetByName(tipo === 'pc' ? OP.PROGRESS_CHECK : OP.RETROALIMENTACION);
  if (!ws) return { ok: false, error: 'Hoja no existe' };

  var data = ws.getDataRange().getValues();
  var H = data[0];
  var iG = H.indexOf('cod_grupo');
  var iL = H.indexOf('leccion_num');
  var iCE = H.indexOf('cod_estudiante');
  var iCom = H.indexOf('comentario');
  if (iG === -1 || iL === -1 || iCE === -1 || iCom === -1) {
    return { ok: false, error: 'Hoja sin columnas esperadas' };
  }
  var cols = _asegurarColsEdicion(ws);
  var editor = String(body.editado_por || 'SUPERADMIN');
  var ahora = new Date();
  var cg = String(body.cod_grupo).trim();
  var ln = String(body.leccion_num).trim();

  var actualizados = 0, agregados = 0;
  body.lista.forEach(function(item){
    var ce = String(item.cod_estudiante || '').trim();
    if (!ce) return;
    var fila = -1;
    for (var r = 1; r < data.length; r++) {
      if (String(data[r][iG] || '').trim() !== cg) continue;
      if (String(data[r][iL] || '').trim() !== ln) continue;
      if (String(data[r][iCE] || '').trim() !== ce) continue;
      fila = r + 1; break;
    }
    if (fila > -1) {
      ws.getRange(fila, iCom + 1).setValue(item.comentario || '');
      ws.getRange(fila, cols.iEP + 1).setValue(editor);
      ws.getRange(fila, cols.iEF + 1).setValue(ahora);
      actualizados++;
    } else {
      var nueva = [];
      for (var c = 0; c < ws.getLastColumn(); c++) nueva.push('');
      nueva[0] = ahora;
      nueva[iG] = cg; nueva[iL] = ln; nueva[iCE] = ce; nueva[iCom] = item.comentario || '';
      nueva[cols.iEP] = editor; nueva[cols.iEF] = ahora;
      ws.appendRow(nueva);
      agregados++;
    }
  });
  return { ok: true, tipo: tipo, actualizados: actualizados, agregados: agregados,
           mensaje: 'Editado por ' + editor + ': ' + actualizados + ' actualizados, ' + agregados + ' nuevos.' };
}

// body: { cod_grupo, nivel, leccion, asistencias:[{cod_estudiante,presente}],
//         notas:[...](opc), editado_por, confirmacion_superadmin }
function editarAsistenciaNotaCerrada(body) {
  if (!_esSuperadmin(body)) return { ok: false, error: 'Operación restringida a superadmin.' };
  if (!body.cod_grupo || !body.nivel || body.leccion == null) {
    return { ok: false, error: 'Faltan: cod_grupo, nivel, leccion' };
  }
  var ss = SpreadsheetApp.openById(OPERATIVO_ID);
  var resultado = { ok: true, asistencia_editada: 0, notas_editadas: 0 };

  if (body.asistencias && body.asistencias.length) {
    var ws = _hojaAsistencia(ss);
    var idx = _idxAsistencia(ws);
    var data = ws.getDataRange().getValues();
    var cols = _asegurarColsEdicion(ws);
    var editor = String(body.editado_por || 'SUPERADMIN');
    var ahora = new Date();
    var cg = String(body.cod_grupo).trim();
    var nv = String(body.nivel).trim().toUpperCase();
    var ln = String(body.leccion).trim();

    body.asistencias.forEach(function(a){
      var ce = String(a.cod_estudiante || '').trim();
      if (!ce) return;
      for (var r = 1; r < data.length; r++) {
        if (idx.cod_grupo>-1 && String(data[r][idx.cod_grupo]||'').trim() !== cg) continue;
        if (idx.leccion_num>-1 && String(data[r][idx.leccion_num]||'').trim() !== ln) continue;
        if (idx.cod_estudiante>-1 && String(data[r][idx.cod_estudiante]||'').trim() !== ce) continue;
        if (idx.nivel>-1 && nv && String(data[r][idx.nivel]||'').trim().toUpperCase() !== nv) continue;
        ws.getRange(r+1, idx.presente+1).setValue(a.presente === true || a.presente === 'true');
        ws.getRange(r+1, cols.iEP+1).setValue(editor);
        ws.getRange(r+1, cols.iEF+1).setValue(ahora);
        resultado.asistencia_editada++;
        break;
      }
    });
  }

  if (body.notas && body.notas.length) {
    body.notas.forEach(function(n){
      var r = registrarEvaluacion(n);
      if (r && r.ok) resultado.notas_editadas++;
    });
  }

  resultado.mensaje = 'Editado: ' + resultado.asistencia_editada + ' asistencias, ' +
                      resultado.notas_editadas + ' notas. (lección permanece CERRADA)';
  return resultado;
}


