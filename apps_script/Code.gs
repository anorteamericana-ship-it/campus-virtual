function _examSensitivePublicKeys_() {
  return {
    correct:true, accepted:true, answerskey:true, answerkey:true, audioscript:true,
    script:true, key:true, teacherkey:true, privatekey:true, rubricprivate:true, answers:true,
    answer_key_fuente:true, audio_script_fuente:true, fuente_original:true, atribucion:true
  };
}

function _examSanitizeForStudent_(payload) {
  var banned = _examSensitivePublicKeys_();
  function clean(v) {
    if (Array.isArray(v)) {
      var arr = [];
      for (var i = 0; i < v.length; i++) arr.push(clean(v[i]));
      return arr;
    }
    if (v && typeof v === 'object') {
      var out = {};
      for (var k in v) {
        if (!v.hasOwnProperty(k)) continue;
        var lk = String(k || '').toLowerCase();
        if (banned[lk]) continue;
        out[k] = clean(v[k]);
      }
      return out;
    }
    return v;
  }
  return clean(payload || {});
}

function _examPublicExamById_(examId, plan) {
  var id = _examUpper_(examId);
  if (!id) return null;
  var raw = EXAM_PUBLIC_BANK_V10G[id];
  if (!raw) return null;
  var out = _examSanitizeForStudent_(raw);
  var p = _examUpper_(plan || 'CON_INA');
  out.exam_id = id;
  out.public_payload_version = 'V10H';
  out.payload_scope = 'student_public_no_keys';
  out.plan = p;
  out.weight_percent = p === 'SIN_INA' ? 15 : 5;
  out.security_note = 'Payload público: sin correct, accepted, audioScript, scripts ni answer keys.';
  return out;
}

function _examPublicPayloadByActivation_(activation) {
