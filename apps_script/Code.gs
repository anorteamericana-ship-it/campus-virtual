}

function _ccF85_validarChoqueSlot_(ctx, slot, excludeRows) {
  excludeRows = excludeRows || {};
  var idx = ctx.idx, d = ctx.data;
  var targetTeacher = _normalizarNombre(ctx.meta.docente || '');
  for (var r = 1; r < d.length; r++) {
    if (excludeRows[r]) continue;
    var estado = String(d[r][idx.ESTADO] || '').trim().toUpperCase();
    if (!estado || estado === 'LIBRE') continue;
    if (_ccF84_iso_(d[r][idx.FECHA]) !== slot.fechaIso) continue;
    var codQ = String(d[r][idx.COD_GRUPO] || '').trim();
    var nivQ = String(d[r][idx.NIVEL] || '').trim().toUpperCase();
    var metaQ = ctx.cat[codQ + '|' + nivQ];
    var intQ = _ccF84_intervaloFila_(d[r], idx, metaQ);
    if (!intQ) continue;
    var sameGroup = codQ === ctx.cod;
    var teacherQ = _normalizarNombre((metaQ && metaQ.docente) || (idx.DOCENTE != null ? d[r][idx.DOCENTE] : '') || '');
    var sameTeacher = targetTeacher && teacherQ && targetTeacher === teacherQ;
    if (!sameGroup && !sameTeacher) continue;
