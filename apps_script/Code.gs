// ============================================================
// 5. getGrupoInfo(cod_grupo)                          ← v4.1
// Devuelve el nivel ACTIVO HOY del grupo, su fecha de inicio,
// docente y todos los niveles proyectados.
//
// Lógica de nivel activo:
//   - Recorre TODAS las filas del grupo en GRUPOS
//   - Encuentra la fila con FECHA_INICIO <= hoy con mayor fecha
//   - Esa es el nivel activo (el más reciente que ya empezó)
//
// Respuesta:
//   {
//     ok: true,
//     startDate: "YYYY-MM-DD",   // inicio del nivel activo
//     levelId: "b2",             // nivel activo hoy
//     teacherName: "...",
//     programa: "SIN_INA",
//     todosLosNiveles: [         // todos los niveles del grupo
//       { nivel:"B1", fecha:"2025-09-22", comentario:"Completado" },
//       { nivel:"B2", fecha:"2026-01-20", comentario:"En curso" },
//       { nivel:"I1", fecha:"2026-05-19", comentario:"Proyectado" },
//       { nivel:"I2", fecha:"2026-09-08", comentario:"Proyectado" },
//     ]
//   }
// ============================================================
function getGrupoInfo(cod_grupo) {
  if (!cod_grupo) return { ok: false, error: 'missing_param' };

  var ss = SpreadsheetApp.openById(SHEET_ID);
  var ws = ss.getSheetByName(SH.GRUPOS);
  if (!ws) return { ok: false, error: 'sheet_not_found' };

  var rows   = ws.getDataRange().getValues();
  var header = rows[0];

  var iCodigo      = header.indexOf('CODIGO_GRUPO');
  var iFecha       = header.indexOf('FECHA_INICIO');
  var iNivel       = header.indexOf('NIVEL_INICIO');
  var iDocente     = header.indexOf('DOCENTE');
  var iPrograma    = header.indexOf('PROGRAMA');
  var iComentario  = header.indexOf('COMENTARIO');

  if (iCodigo === -1 || iFecha === -1) {
    return { ok: false, error: 'schema_error' };
  }

  var hoy = new Date();
  hoy.setHours(0,0,0,0);

  var levelMap = { 'B1':'b1', 'B2':'b2', 'I1':'i1', 'I2':'i2' };
  var filasGrupo = [];

  // Recoger todas las filas del grupo
  for (var i = 1; i < rows.length; i++) {
    var codigo = String(rows[i][iCodigo] || '').trim();
    if (codigo !== String(cod_grupo).trim()) continue;

    var rawFecha = rows[i][iFecha];
    var fechaDate = new Date(rawFecha);
    fechaDate.setHours(0,0,0,0);
    var fechaStr = Utilities.formatDate(fechaDate, 'America/Costa_Rica', 'yyyy-MM-dd');
    var nivelRaw = String(rows[i][iNivel] || '').trim().toUpperCase();
    var comentario = String(rows[i][iComentario] || '').trim();

    filasGrupo.push({
      nivel:       nivelRaw,
      levelId:     levelMap[nivelRaw] || 'b1',
      fecha:       fechaStr,
      fechaDate:   fechaDate,
      docente:     String(rows[i][iDocente]  || '').trim(),
      programa:    String(rows[i][iPrograma] || '').trim(),
      comentario:  comentario,
    });
  }

  if (filasGrupo.length === 0) return { ok: false, error: 'not_found' };

  // Ordenar por fecha
  filasGrupo.sort(function(a,b) { return a.fechaDate - b.fechaDate; });

  // Nivel activo = el más reciente con FECHA_INICIO <= hoy
  var activo = null;
  for (var j = 0; j < filasGrupo.length; j++) {
    if (filasGrupo[j].fechaDate <= hoy) {
      activo = filasGrupo[j];
    }
  }
  // Si ninguno ha empezado (grupo futuro), usar el primero
  if (!activo) activo = filasGrupo[0];

  return {
    ok:          true,
    startDate:   activo.fecha,
    levelId:     activo.levelId,
    teacherName: activo.docente,
    programa:    activo.programa,
    todosLosNiveles: filasGrupo.map(function(f) {
      return { nivel: f.nivel, fecha: f.fecha, comentario: f.comentario };
    }),
  };
}




// ════════════════════════════════════════════════════════════════════
// MORA_CACHE — caché de conteo de morosos por grupo
// El cálculo de mora (reusar getRadiografiaGrupo ×10) es lento, así que
// se PRE-CALCULA y guarda en la hoja MORA_CACHE de CAMPUS_OPERATIVO.
// El calendario LEE el caché (instantáneo). Se refresca con botón manual.
//
//   actualizarMoraCache()  → recalcula los grupos activos y guarda. POST.
//   getMoraGrupos()         → lee el caché para el calendario. GET.
//
// Hoja MORA_CACHE: COD_GRUPO | CA | MORA | ACTUALIZADO
// Robusto a timeout: guarda grupo por grupo; si se corta, lo hecho queda.
// ════════════════════════════════════════════════════════════════════

var SH_MORA_CACHE = 'MORA_CACHE';

// Recalcula la mora de todos los grupos activos y la guarda en MORA_CACHE.
// Reusa getRadiografiaGrupo (misma regla _estaEnMora → cuadra con Estudiantes).
function actualizarMoraCache() {
  try {
    // 1. Lista de grupos activos (la misma fuente que el calendario)
    var resp = getGruposActivos();
    if (!resp || !resp.ok) return { ok:false, error:'no se pudo listar grupos' };
    var grupos = resp.grupos || [];

    // 2. Preparar la hoja MORA_CACHE
    var ssOp = SpreadsheetApp.openById(OPERATIVO_ID);
    var ws = ssOp.getSheetByName(SH_MORA_CACHE);
    if (!ws) {
      ws = ssOp.insertSheet(SH_MORA_CACHE);
      ws.appendRow(['COD_GRUPO','CA','MORA','ACTUALIZADO']);
    }
    // Mapa de filas existentes por grupo (para actualizar en sitio)
    var data = ws.getDataRange().getValues();
    var filaDe = {};
    for (var r = 1; r < data.length; r++) {
      filaDe[String(data[r][0]).trim()] = r + 1; // fila real (1-based)
    }

    var ahora = Utilities.formatDate(new Date(),'America/Costa_Rica','yyyy-MM-dd HH:mm');
    var procesados = 0;

    // 3. Recalcular grupo por grupo y GUARDAR cada uno apenas termina
    //    (si se corta por timeout, lo guardado queda firme).
    for (var i = 0; i < grupos.length; i++) {
      var cod = grupos[i].code;
      var nivelActivo = grupos[i].nivelId;   // nivel del MÓDULO activo a la fecha
      var rad = getRadiografiaGrupo(cod);
      var ca = 0, mora = 0;
      if (rad && rad.ok && rad.niveles) {
        // CONTAR SOLO EL NIVEL ACTIVO, no todos los niveles del programa.
        // Un grupo en I2 arrastra registros de B1/B2/I1 (módulos pasados) que
        // NO cuentan: solo importan los que cursan el período activo (mayo).
        var arrNivel = rad.niveles[nivelActivo] || [];
        arrNivel.forEach(function(est) {
          // Solo cuentan los que están CURSANDO el nivel activo (CA).
          // Así mora nunca supera CA, y refleja la operación del período actual.
          if (String(est.estatus||'').toUpperCase() === 'CA') {
            ca++;
            if (est.mora === true) mora++;
          }
        });
      }
      var fila = [cod, ca, mora, ahora];
      if (filaDe[cod]) {
        ws.getRange(filaDe[cod], 1, 1, 4).setValues([fila]);
      } else {
        ws.appendRow(fila);
        filaDe[cod] = ws.getLastRow();
      }
      SpreadsheetApp.flush(); // fuerza el guardado antes del siguiente
      procesados++;
    }

    return { ok:true, procesados:procesados, actualizado:ahora };
  } catch (err) {
    return { ok:false, error:String(err) };
  }
}

// Lee el caché MORA_CACHE para el calendario (rápido, sin recalcular).
function getMoraGrupos() {
  try {
    var ssOp = SpreadsheetApp.openById(OPERATIVO_ID);
    var ws = ssOp.getSheetByName(SH_MORA_CACHE);
    if (!ws) return { ok:true, grupos:{}, actualizado:null, vacio:true };
    var data = ws.getDataRange().getValues();
    var grupos = {};
    var ultima = null;
    for (var r = 1; r < data.length; r++) {
      var cod = String(data[r][0]).trim();
      if (!cod) continue;
      grupos[cod] = { ca: Number(data[r][1])||0, mora: Number(data[r][2])||0 };
      var act = data[r][3];
      if (act && (!ultima || String(act) > String(ultima))) ultima = String(act);
    }
    return { ok:true, grupos:grupos, actualizado:ultima };
  } catch (err) {
    return { ok:false, error:String(err) };
  }
}

// ============================================================
// getGruposActivos()                                  — v4.23.6
// Devuelve TODOS los grupos activos + aperturas con sus lecciones,
// para la vista "todos los grupos" del cronograma (semana/mes).
//
// "Activo" = grupo con al menos 1 estudiante CA en ESTATUS.
// "Apertura" = grupo en GRUPOS con fecha futura SIN estudiantes CA
//   (lo querés ver para programar; va marcado esApertura=true).
//
// Lee cada hoja UNA sola vez (patrón batch). Devuelve para cada grupo:
//   code, nivelId, nivel, docente, dias, hora, turnoOrden, estudiantes,
//   esApertura, leccionActual, lecciones:[{leccion,fecha,tipo,estado}]
//
// El frontend ordena/filtra; el backend solo provee el dato crudo.
// GET ?fn=getGruposActivos
// ============================================================
function getGruposActivos() {
  try {
    var ss   = SpreadsheetApp.openById(SHEET_ID);
    var ssOp = SpreadsheetApp.openById(OPERATIVO_ID);

    // ── 1. ESTATUS: contar estudiantes CA por grupo (1 lectura) ──
    var wsEst = ss.getSheetByName(SH.ESTATUS);
    if (!wsEst) return { ok:false, error:'ESTATUS no existe' };
    var estRows = wsEst.getDataRange().getValues();
    var eH = estRows[0];
    var iECod = eH.indexOf('CODIGO'), iENiv = eH.indexOf('NIVEL'),
        iEGrp = eH.indexOf('GRUPO'),  iEEst = eH.indexOf('ESTATUS');
    var caPorGrupo = {};   // cod_grupo -> count CA
    for (var i = 1; i < estRows.length; i++) {
      if (String(estRows[i][iEEst] || '').trim().toUpperCase() !== 'CA') continue;
      var g = String(estRows[i][iEGrp] || '').trim();
      if (g) caPorGrupo[g] = (caPorGrupo[g] || 0) + 1;
    }

    // ── 2. GRUPOS: meta de cada grupo (1 lectura) ──
    var wsGru = ss.getSheetByName(SH.GRUPOS);
    var gruRows = wsGru.getDataRange().getValues();
    var gH = gruRows[0];
    var iGCod = gH.indexOf('CODIGO_GRUPO'), iGNiv = gH.indexOf('NIVEL_INICIO'),
        iGFec = gH.indexOf('FECHA_INICIO'), iGDoc = gH.indexOf('DOCENTE'),
        iGDias = gH.indexOf('DIAS'), iGProg = gH.indexOf('PROGRAMA');

    var hoy = new Date(); hoy.setHours(0,0,0,0);
    var levelMap = { B1:'Básico I', B2:'Básico II', I1:'Intermedio I', I2:'Intermedio II' };
    var diasLabel = { LM:'Lun/Mié', KJ:'Mar/Jue', LJ:'Lun-Jue', SA:'Sáb' };

    // Agrupar filas de GRUPOS por código (un grupo puede tener varias filas, una por nivel)
    var grupoMap = {};
    for (var r = 1; r < gruRows.length; r++) {
      var cod = String(gruRows[r][iGCod] || '').trim();
      if (!cod) continue;
      var fechaD = new Date(gruRows[r][iGFec]); fechaD.setHours(0,0,0,0);
      if (!grupoMap[cod]) {
        grupoMap[cod] = { cod:cod, filas:[],
          docente: String(gruRows[r][iGDoc]||'').trim(),
          dias:    String(gruRows[r][iGDias]||'').trim(),
          programa:String(gruRows[r][iGProg]||'').trim() };
      }
      grupoMap[cod].filas.push({ fecha:fechaD, nivel:String(gruRows[r][iGNiv]||'').trim().toUpperCase() });
    }

    // ── 3. CALENDARIO_LECCIONES: todas las lecciones (1 lectura) ──
    var wsCal = ssOp.getSheetByName(SH_CALENDARIO);
    var calRows = wsCal ? wsCal.getDataRange().getValues() : [[]];
    var cH = calRows[0];
    var iCG=cH.indexOf('COD_GRUPO'), iCN=cH.indexOf('NIVEL'), iCL=cH.indexOf('LECCION'),
        iCF=cH.indexOf('FECHA'), iCT=cH.indexOf('TIPO_LECCION'), iCE=cH.indexOf('ESTADO');
    var leccionesPorGrupoNivel = {};  // "cod||nivel" -> [lecciones]
    for (var c = 1; c < calRows.length; c++) {
      var ccod = String(calRows[c][iCG]||'').trim();
      var cniv = String(calRows[c][iCN]||'').trim().toUpperCase();
      if (!ccod) continue;
      var key = ccod + '||' + cniv;
      if (!leccionesPorGrupoNivel[key]) leccionesPorGrupoNivel[key] = [];
      var f = calRows[c][iCF];
      leccionesPorGrupoNivel[key].push({
        leccion: parseInt(calRows[c][iCL]) || 0,
        fecha:   f instanceof Date ? Utilities.formatDate(f,'America/Costa_Rica','yyyy-MM-dd') : String(f),
        tipo:    String(calRows[c][iCT]||''),
        estado:  String(calRows[c][iCE]||'')
      });
    }

    // ── 4. Construir la respuesta ──
    var grupos = [];
    Object.keys(grupoMap).forEach(function(cod) {
      var g = grupoMap[cod];
      g.filas.sort(function(a,b){ return a.fecha - b.fecha; });

      // Nivel activo = última fila con fecha <= hoy; si ninguna, la primera (futuro)
      var activo = null;
      g.filas.forEach(function(f){ if (f.fecha <= hoy) activo = f; });
      var esFuturo = !activo;
      if (!activo) activo = g.filas[0];
      var nivelId = (activo ? activo.nivel : 'B1');

      var caCount = caPorGrupo[cod] || 0;

      // Hora desde el código (segmento 2: 69=6pm, 94=9am)
      var partes = cod.split('-');
      var seg = partes.length > 1 ? partes[1] : '';
      var hora, turnoOrden;
      if (seg.indexOf('94') !== -1)      { hora = '9am–12pm'; turnoOrden = 1; }
      else if (seg.indexOf('69') !== -1) { hora = '6pm–9pm';  turnoOrden = 2; }
      else                               { hora = '';          turnoOrden = 2; }

      var diasCode = g.dias.replace(/[0-9]/g,'') || (partes.length>1 ? partes[1].replace(/[0-9]/g,'') : '');

      // Lecciones del nivel activo
      var lecciones = leccionesPorGrupoNivel[cod + '||' + nivelId] || [];
      lecciones.sort(function(a,b){ return a.leccion - b.leccion; });

      // APERTURA = grupo SIN calendario generado (no tiene lecciones todavía).
      // Estos grupos existen en GRUPOS pero aún no se les generó el cronograma:
      // sirven para programar. Van marcados esApertura=true y al final del orden.
      var esApertura = (lecciones.length === 0);

      // Si el grupo NO es apertura pero tampoco tiene estudiantes CA y ya empezó
      // hace rato, es basura histórica → fuera. (Aperturas SÍ entran aunque no tengan CA.)
      if (!esApertura && caCount === 0 && !esFuturo) return;

      // Lección actual para ORDENAR = próxima lección a darse según HOY
      // (primera lección con fecha >= hoy). Si todas pasaron, la última.
      // Si es apertura (sin lecciones), queda 0.
      var leccionActual = 0;
      var hoyStr = Utilities.formatDate(new Date(),'America/Costa_Rica','yyyy-MM-dd');
      for (var li = 0; li < lecciones.length; li++) {
        if (lecciones[li].fecha >= hoyStr) { leccionActual = lecciones[li].leccion; break; }
      }
      if (leccionActual === 0 && lecciones.length) {
        leccionActual = lecciones[lecciones.length - 1].leccion; // todas pasaron → la última
      }

      grupos.push({
        code:          cod,
        nivelId:       nivelId,
        nivel:         levelMap[nivelId] || nivelId,
        docente:       g.docente || 'POR DEFINIR',
        dias:          diasLabel[diasCode] || g.dias,
        diasCode:      diasCode,
        hora:          hora,
        turnoOrden:    turnoOrden,
        programa:      g.programa,
        estudiantes:   caCount,
        esApertura:    esApertura,
        leccionActual: leccionActual,
        lecciones:     lecciones
      });
    });

    return { ok:true, grupos:grupos, total:grupos.length, generado: Utilities.formatDate(new Date(),'America/Costa_Rica','yyyy-MM-dd HH:mm') };
  } catch (err) {
    return { ok:false, error:String(err) };
  }
}

// ============================================================
// getInfoGeneral()
// Devuelve los documentos de "1. Información General del Programa"
// (reglamento estudiantil, netiqueta, video bienvenida, guías).
// Lee la hoja INFO_GENERAL de CAMPUS_OPERATIVO (poblada por el
// script de mapeo). Cada doc trae su Drive ID y una URL de visor.
// GET ?fn=getInfoGeneral
// ============================================================
function getInfoGeneral() {
  try {
    var ss = SpreadsheetApp.openById(OPERATIVO_ID);
    var ws = ss.getSheetByName(OP.INFO_GENERAL);
    if (!ws) return { ok: false, error: 'sheet_not_found', docs: [] };

    var rows = ws.getDataRange().getValues();
    if (rows.length < 2) return { ok: true, docs: [] };

    var header = rows[0].map(function(h){ return String(h || '').trim().toUpperCase(); });
    var iCod    = header.indexOf('CODIGO');
    var iSec    = header.indexOf('SECCION');
    var iNom    = header.indexOf('NOMBRE_ARCHIVO');
    var iTipo   = header.indexOf('TIPO');
    var iId     = header.indexOf('DRIVE_ID');
    var iUrl    = header.indexOf('DRIVE_URL');
    var iOrden  = header.indexOf('ORDEN');

    if (iId === -1) return { ok: false, error: 'schema_error', docs: [] };

    var docs = [];
    for (var r = 1; r < rows.length; r++) {
      var id = String(rows[r][iId] || '').trim();
      if (!id) continue;
      var tipo = (iTipo !== -1) ? String(rows[r][iTipo] || '').trim().toLowerCase() : 'pdf';
      // URL de visor embebible: /preview para iframe, /view para pestaña nueva
      var urlBase = 'https://drive.google.com/file/d/' + id;
      docs.push({
        codigo:  (iCod  !== -1) ? String(rows[r][iCod]  || '').trim() : '',
        seccion: (iSec  !== -1) ? String(rows[r][iSec]  || '').trim() : '',
        nombre:  (iNom  !== -1) ? String(rows[r][iNom]  || '').trim() : '',
        tipo:    tipo,
        drive_id: id,
        url_view:    urlBase + '/view',
        url_preview: urlBase + '/preview',
        orden:   (iOrden !== -1) ? (Number(rows[r][iOrden]) || (r)) : r
      });
    }
    // Ordenar por ORDEN
    docs.sort(function(a,b){ return a.orden - b.orden; });

    return { ok: true, docs: docs };
  } catch (err) {
    return { ok: false, error: String(err), docs: [] };
  }
}

// ============================================================
// 6. importarExtracto(filas)
// ============================================================
function importarExtracto(filas) {
  if (!Array.isArray(filas) || filas.length === 0) return { error: 'Array de filas requerido' };
  var ss     = SpreadsheetApp.openById(SHEET_ID);
  var ws     = ss.getSheetByName(SH.BDBANCARIO);
  var rows   = ws.getDataRange().getValues();
  var header = rows[0];

  var iDoc = -1;
  for (var c = 0; c < header.length; c++) {
    if (String(header[c]).indexOf('Documento') > -1) { iDoc = c; break; }
  }

  var docsExistentes = {};
  for (var i = 1; i < rows.length; i++) {
    var d = String(rows[i][iDoc] || '').trim();
    if (d) docsExistentes[d] = true;
  }

  var agregados = 0, duplicados = 0;
  for (var f = 0; f < filas.length; f++) {
    var fila = filas[f];
    var doc  = String(fila.doc || '').trim();
    if (!doc || docsExistentes[doc]) { duplicados++; continue; }
    ws.appendRow(['', fila.fechaContable || '', fila.fechaRegistro || '', fila.hora || '',
                  doc, fila.descripcion || '', fila.oficina || '',
                  parseFloat(fila.debito) || 0, parseFloat(fila.credito) || 0, 0]);
    docsExistentes[doc] = true;
    agregados++;
  }
  return { ok: true, agregados: agregados, duplicados: duplicados };
}

// ============================================================
// 7. aplicarPago(data)
// ============================================================
function aplicarPago(data) {
  try {
  var doc = data.doc, monto_total = data.monto_total;
  var cod_estudiante = data.cod_estudiante, rubros = data.rubros;
  if (!doc || !cod_estudiante || !rubros || rubros.length === 0) {
    return { error: 'Faltan: doc, cod_estudiante, rubros' };
  }

  var ss      = SpreadsheetApp.openById(SHEET_ID);
  var wsBanco = ss.getSheetByName(SH.BDBANCARIO);
  var bRows   = wsBanco.getDataRange().getValues();
  var bHeader = bRows[0];

  // Schema real BDBANCARIO (verificado 16-may-2026 contra imagen):
  //   col A: (vacía/ID)  B: Fecha Contable  C: Fecha Registro  D: Hora
  //   col E: N° Documento  F: Descripción  G: Oficina
  //   col H: Débitos  col I: Créditos  col J: MONTO_APLICADO
  //   col K: estudiante (código del primer estudiante aplicado)
  //
  // PAGOS schema (imagen 2):
  //   LLAVE | CODIGO | FECHA | RECIBO | PAGO | GRUPO | RESP | FECHAH | HORA | enhisto | Estacion | Concepto | TipoRecibo
  //
  // OTROS_PAGOS schema (imagen 1):
  //   LLAVE | nombre | descripcion | monto | fecha | USUARIO | RECIBO | grupo | ncuenta | Codigo | TipoRecibo
  //
  // DIFERENCIA CLAVE: PAGOS.PAGO = cuotas mensuales. OTROS_PAGOS = matrícula y certificado.
  // El frontend separa rubros por tipo: CUOTA → PAGOS, MATRICULA/CERTIFICADO → OTROS_PAGOS.

  var iDoc = -1, iCredito = -1, iAplicado = -1, iEstud = -1;
  for (var c = 0; c < bHeader.length; c++) {
    var h = String(bHeader[c]).trim();
    if (h.indexOf('Documento') > -1)                         iDoc      = c;
    if (h.indexOf('dito') > -1 && h.substring(0,1) !== 'D') iCredito  = c;
    if (h === 'MONTO_APLICADO')                              iAplicado = c;
    if (h === 'estudiante')                                  iEstud    = c;
  }
  // Guardia: si MONTO_APLICADO no se encuentra en el header, buscar por posición fija (col J = índice 9)
  // Esto previene el error "columna inicial del rango demasiado pequeña" cuando iAplicado=-1
  if (iAplicado === -1) {
    // Buscar cualquier variante
    for (var c = 0; c < bHeader.length; c++) {
      var h = String(bHeader[c]).trim().toUpperCase();
      if (h.indexOf('APLICADO') > -1 || h.indexOf('APLICAR') > -1) { iAplicado = c; break; }
    }
    // Último recurso: columna J (índice 9) es la posición histórica en BDBANCARIO
    if (iAplicado === -1) iAplicado = 9;
    Logger.log('AVISO: columna MONTO_APLICADO no encontrada por nombre, usando índice ' + iAplicado);
  }
  if (iEstud === -1) {
    // columna K (índice 10) es la posición histórica de "estudiante"
    for (var c = 0; c < bHeader.length; c++) {
      var h = String(bHeader[c]).trim().toLowerCase();
      if (h === 'estudiante' || h === 'codigo_est') { iEstud = c; break; }
    }
    if (iEstud === -1) iEstud = 10;
  }

  var bancoRowIdx = -1, creditoActual = 0, aplicadoActual = 0;
  for (var i = 1; i < bRows.length; i++) {
    if (String(bRows[i][iDoc]).trim() === String(doc).trim()) {
      bancoRowIdx    = i + 1;
      creditoActual  = parseFloat(bRows[i][iCredito])  || 0;
      aplicadoActual = parseFloat(bRows[i][iAplicado]) || 0;
      break;
    }
  }
  if (bancoRowIdx === -1) return { error: 'Comprobante no encontrado: ' + doc };

  var saldo = creditoActual - aplicadoActual;
  if (monto_total > saldo) return { error: 'Saldo insuficiente. Disponible: ' + saldo };

  var recibo  = getNextRecibo(ss);
  var wsPagos = ss.getSheetByName(SH.PAGOS);
  var wsOtros = ss.getSheetByName(SH.OTROS_PAGOS);
  var hoy     = new Date();
  var recibosGenerados = [];

  // Leer nombre del estudiante para OTROS_PAGOS (col nombre)
  var nombreEstudiante = String(cod_estudiante); // fallback
  var wsDatosNom = ss.getSheetByName(SH.DATOS);
  var datRowsNom = wsDatosNom.getDataRange().getValues();
  var datHNom    = datRowsNom[0];
  var iDCodNom   = datHNom.indexOf('CODIGO');
  var iDNomNom   = datHNom.indexOf('NOMBRE');
  for (var dn = 1; dn < datRowsNom.length; dn++) {
    if (String(datRowsNom[dn][iDCodNom]||'').trim() === String(cod_estudiante).trim()) {
      nombreEstudiante = String(datRowsNom[dn][iDNomNom]||'').trim() || nombreEstudiante;
      break;
    }
  }

  var ssOp          = SpreadsheetApp.openById(OPERATIVO_ID);
  var wsPagosCampus = ssOp.getSheetByName(OP.PAGOS_CAMPUS);

  for (var r = 0; r < rubros.length; r++) {
    var rubro    = rubros[r];
    // Concepto: "CUOTA_B1-BCR-12345-14/05/2026"
    // MID(concepto,7,2) en SUMIF de PAGOS extrae el nivel (posición 6-7, 0-based) → 'B1','B2','I1','I2'
    // Formato: TIPO_NIVEL-BANCO-DOC-FECHA (el nivel va siempre en chars 6-7)
    // Blindar grupo — si llega como objeto por error del frontend, extraer CODIGO_GRUPO
    var grupoStr = '';
    if (rubro.grupo && typeof rubro.grupo === 'object') {
      grupoStr = String(rubro.grupo['CODIGO_GRUPO'] || rubro.grupo.CODIGO_GRUPO || '').trim();
    } else {
      grupoStr = String(rubro.grupo || '').trim();
    }
    // Reemplazar en rubro para que los appendRow usen el string limpio
    rubro.grupo = grupoStr;

    var concepto = rubro.tipo + '_' + String(rubro.nivel||'').toUpperCase() + '-BCR-' + doc + '-' + formatFecha(hoy);

    if (rubro.tipo === 'CUOTA') {
      // ── PAGOS schema (verificado 16-may-2026, imagen 2) ──────────────
      // LLAVE | CODIGO | FECHA | RECIBO | PAGO | GRUPO | RESP | FECHAH | HORA | enhisto | Estacion | Concepto | TipoRecibo
      var llavePagos = String(cod_estudiante) + String(rubro.nivel||'B1').toUpperCase() + '-BCR-' + doc;
      wsPagos.appendRow([
        llavePagos,          // A: LLAVE
        cod_estudiante,      // B: CODIGO
        hoy,                 // C: FECHA
        recibo,              // D: RECIBO
        rubro.monto,         // E: PAGO
        rubro.grupo,         // F: GRUPO
        'CAMPUS',            // G: RESP
        hoy,                 // H: FECHAH
        '',                  // I: HORA
        'FALSE',             // J: enhisto
        'CAMPUS_VIRTUAL',    // K: Estacion
        concepto,            // L: Concepto
        'S',                 // M: TipoRecibo
      ]);
    } else {
      // ── OTROS_PAGOS schema (verificado 16-may-2026, imagen 1) ────────
      // LLAVE | nombre | descripcion | monto | fecha | USUARIO | RECIBO | grupo | ncuenta | Codigo | TipoRecibo
      // ncuenta: matrícula=60/61/62/63 por nivel B1/B2/I1/I2
      //          certificado=43/44/45/46 por nivel B1/B2/I1/I2
      var ncuentaMap = {
        MATRICULA:   { B1: 60, B2: 61, I1: 62, I2: 63 },
        CERTIFICADO: { B1: 43, B2: 44, I1: 45, I2: 46 },
      };
      var ncuenta = '';
      var nivelRubro = String(rubro.nivel || '').toUpperCase();
      if (ncuentaMap[rubro.tipo] && ncuentaMap[rubro.tipo][nivelRubro]) {
        ncuenta = ncuentaMap[rubro.tipo][nivelRubro];
      }
      var llavePago = String(cod_estudiante) + rubro.grupo + String(rubro.nivel||'B1').toUpperCase();
      wsOtros.appendRow([
        llavePago,           // A: LLAVE
        nombreEstudiante,    // B: nombre
        concepto,            // C: descripcion
        rubro.monto,         // D: monto
        hoy,                 // E: fecha
        'CAMPUS',            // F: USUARIO
        recibo,              // G: RECIBO
        rubro.grupo,         // H: grupo
        ncuenta,             // I: ncuenta
        cod_estudiante,      // J: Codigo
        'S',                 // K: TipoRecibo
      ]);
    }

    wsPagosCampus.appendRow([
      new Date(), cod_estudiante, rubro.tipo, rubro.nivel,
      rubro.monto, rubro.grupo, recibo, doc, 'CAMPUS', concepto,
    ]);

    recibosGenerados.push(recibo);
    recibo++;
  }

  wsBanco.getRange(bancoRowIdx, iAplicado + 1).setValue(aplicadoActual + monto_total);
  if (!String(wsBanco.getRange(bancoRowIdx, iEstud + 1).getValue()).trim()) {
    wsBanco.getRange(bancoRowIdx, iEstud + 1).setValue(cod_estudiante);
  }

  // v4.15: sincronizar CONAPE silenciosamente — no bloquea si falla
  var syncResult = { ok: false };
  try { syncResult = sincronizarCONAPE_estudiante(cod_estudiante); } catch(e) {}
  return { ok: true, recibos: recibosGenerados, saldo_restante: saldo - monto_total, conape_sync: syncResult.ok };
  } catch (err) { return {ok:false, error:String(err)}; }
}

// ============================================================
// 8. actualizarEstatus(data)
// ============================================================
function actualizarEstatus(data) {
  var cod_estudiante = data.cod_estudiante || data.codigo || data.rec_m;
  var nivel   = data.nivel;
  var estatus = data.estatus;
  var nota    = data.nota;
  var grupo   = data.grupo || '';  // grupo actual del estudiante

  if (!cod_estudiante || !nivel || !estatus) return { error: 'Faltan: cod_estudiante, nivel, estatus' };

  var validos = ['APR','REP','CNV','CA','PE','RI','RJ'];
  if (validos.indexOf(estatus.toUpperCase()) === -1) return { error: 'Estatus invalido: ' + estatus };

  // ── Validaciones lógicas ─────────────────────────────────────────────
  if (estatus.toUpperCase() === 'APR') {
    // 1. No se puede aprobar un nivel PE (nunca cursado)
    // Verificar estatus actual del registro
    var ss0  = SpreadsheetApp.openById(SHEET_ID);
    var ws0  = ss0.getSheetByName(SH.ESTATUS);
    var r0   = ws0.getDataRange().getValues();
    var h0   = r0[0];
    var iC0  = h0.indexOf('CODIGO');
    var iN0  = h0.indexOf('NIVEL');
    var iE0  = h0.indexOf('ESTATUS');
    var iL0  = h0.indexOf('LLAVE');
    var iG0  = h0.indexOf('GRUPO');

    var estatusActual = '';
    var llaveBuscar   = String(cod_estudiante) + (grupo||'') + nivel.toUpperCase();

    for (var x = 1; x < r0.length; x++) {
      var lx = String(r0[x][iL0]||'').trim();
      var cx = String(r0[x][iC0]||'').trim();
      var nx = String(r0[x][iN0]||'').trim().toUpperCase();
      if (lx === llaveBuscar || (cx === String(cod_estudiante).trim() && nx === nivel.toUpperCase())) {
        estatusActual = String(r0[x][iE0]||'').trim().toUpperCase();
        break;
      }
    }

    if (estatusActual === 'PE') {
      return { ok: false, error: 'No se puede aprobar ' + nivel + ': el estudiante nunca cursó este nivel (PE). Debe estar CA primero.' };
    }

    // 2. Nivel anterior debe estar APR o CNV (excepto B1)
    var nivelAntReq = { B2:'B1', I1:'B2', I2:'I1' };
    var nivAntReq   = nivelAntReq[nivel.toUpperCase()];
    if (nivAntReq) {
      var estatusAntReq = '';
      for (var y = 1; y < r0.length; y++) {
        var cy = String(r0[y][iC0]||'').trim();
        var ny = String(r0[y][iN0]||'').trim().toUpperCase();
        if (cy === String(cod_estudiante).trim() && ny === nivAntReq) {
          var eAnt = String(r0[y][iE0]||'').trim().toUpperCase();
          if (eAnt === 'APR' || eAnt === 'CNV') { estatusAntReq = eAnt; }
        }
      }
      if (!estatusAntReq) {
        return { ok: false, error: 'No se puede aprobar ' + nivel + ': el nivel anterior (' + nivAntReq + ') debe estar APR o CNV primero.' };
      }
    }
  }

  var ss  = SpreadsheetApp.openById(SHEET_ID);
  var ws  = ss.getSheetByName(SH.ESTATUS);
  var rows   = ws.getDataRange().getValues();
  var header = rows[0];

  var iLlave   = header.indexOf('LLAVE');
  var iGrupo   = header.indexOf('GRUPO');
  var iCodigo  = header.indexOf('CODIGO');
  var iNivel   = header.indexOf('NIVEL');
  var iEstatus = header.indexOf('ESTATUS');
  var iNota    = header.indexOf('NOTA');
  var iFecha   = header.indexOf('FECHA DE MODIFICION');

  // Si no se pasa grupo, buscarlo en DATOS
  if (!grupo) {
    var wsDatos  = ss.getSheetByName(SH.DATOS);
    var datRows  = wsDatos.getDataRange().getValues();
    var datH     = datRows[0];
    var iDCod    = datH.indexOf('CODIGO');
    var iDGrupo  = datH.indexOf('GRUPO');
    for (var d = 1; d < datRows.length; d++) {
      if (String(datRows[d][iDCod] || '').trim() === String(cod_estudiante).trim()) {
        grupo = String(datRows[d][iDGrupo] || '').trim();
        break;
      }
    }
  }

  // Buscar por LLAVE (GRUPO+CODIGO+NIVEL) — la más reciente si hay varias
  // Si no hay LLAVE buscar por CODIGO+NIVEL como fallback
  var llaveBuscada = String(cod_estudiante) + grupo + nivel.toUpperCase();
  var rowIdx = -1;

  for (var i = 1; i < rows.length; i++) {
    var llave   = String(rows[i][iLlave]  || '').trim();
    var codFila = String(rows[i][iCodigo] || '').trim();
    var nivFila = String(rows[i][iNivel]  || '').trim().toUpperCase();

    if (iLlave > -1 && llave === llaveBuscada) {
      rowIdx = i + 1; break;
    } else if (codFila === String(cod_estudiante).trim() && nivFila === nivel.toUpperCase() && !grupo) {
      rowIdx = i + 1; // fallback sin grupo
    }
  }

  if (rowIdx === -1) {
    // Crear nueva fila con LLAVE generada
    var nuevaFila = new Array(header.length).fill('');
    var llavaNueva = String(cod_estudiante) + grupo + nivel.toUpperCase();
    if (iLlave > -1)   nuevaFila[iLlave]   = llavaNueva;
    if (iGrupo > -1)   nuevaFila[iGrupo]   = grupo;
    nuevaFila[iCodigo]  = String(cod_estudiante);
    nuevaFila[iNivel]   = nivel.toUpperCase();
    nuevaFila[iEstatus] = estatus.toUpperCase();
    nuevaFila[iFecha]   = new Date();
    if (nota !== undefined && iNota > -1) nuevaFila[iNota] = nota;
    ws.appendRow(nuevaFila);
  } else {
    ws.getRange(rowIdx, iEstatus + 1).setValue(estatus.toUpperCase());
    ws.getRange(rowIdx, iFecha   + 1).setValue(new Date());
    if (nota !== undefined && iNota > -1) ws.getRange(rowIdx, iNota + 1).setValue(nota);
  }

  // Validaciones para APR: certificado debe estar pagado
  if (estatus.toUpperCase() === 'APR') {
    var wsOtrosVal = ss.getSheetByName(SH.OTROS_PAGOS);
    var oRowsVal   = wsOtrosVal.getDataRange().getValues();
    var oHVal      = oRowsVal[0];
    var ioCodVal  = oHVal.indexOf('Codigo');
    if (ioCodVal === -1) ioCodVal = oHVal.indexOf('CODIGO');
    var ioMonVal  = oHVal.indexOf('monto');
    if (ioMonVal === -1) ioMonVal = oHVal.indexOf('MONTO');
    var ioDescVal = oHVal.indexOf('descripcion');
    if (ioDescVal === -1) ioDescVal = oHVal.indexOf('DESCRIPCION');
    var ioncVal   = oHVal.indexOf('ncuenta');

    var certPagado = false;
    var matPagada  = false;
    var nivelUp    = nivel.toUpperCase();
    var ncCertMap  = { B1:'43', B2:'44', I1:'45', I2:'46' };
    var ncMatMap   = { B1:'60', B2:'61', I1:'62', I2:'63' };
    var ncCert = ncCertMap[nivelUp];
    var ncMat  = ncMatMap[nivelUp];

    for (var v = 1; v < oRowsVal.length; v++) {
      var codV = String(oRowsVal[v][ioCodVal] || '').trim();
      var monV = parseFloat(oRowsVal[v][ioMonVal]) || 0;
      if (codV !== String(cod_estudiante).trim() || monV <= 0) continue;

      // Prioridad: ncuenta
      if (ioncVal > -1) {
        var ncV = String(oRowsVal[v][ioncVal] || '').trim();
        if (ncV === ncCert) { certPagado = true; continue; }
        if (ncV === ncMat)  { matPagada  = true; continue; }
      }
      // Fallback: descripción
      var descV = String(oRowsVal[v][ioDescVal] || '').toUpperCase();
      var nivelDescMap2 = { B1:'BASICO I', B2:'BASICO II', I1:'INTERMEDIO I', I2:'INTERMEDIO II' };
      var nd = nivelDescMap2[nivelUp] || nivelUp;
      if (descV.indexOf('CERTIF') > -1 && (descV.indexOf(nd) > -1 || descV.indexOf('_'+nivelUp) > -1)) certPagado = true;
      if (descV.indexOf('MATRI')  > -1 && (descV.indexOf(nd) > -1 || descV.indexOf('_'+nivelUp) > -1)) matPagada  = true;
    }

    if (!matPagada) return { ok: false, error: 'No se puede aprobar: la matrícula de ' + nivelUp + ' no está pagada.' };

    // Validar cuotas completas — leer PAGOS para contar cuotas pagadas
    var wsPagosVal  = ss.getSheetByName(SH.PAGOS);
    var pRowsVal    = wsPagosVal.getDataRange().getValues();
    var pHVal       = pRowsVal[0];
    var ipCodVal    = pHVal.indexOf('CODIGO');
    var ipConVal    = pHVal.indexOf('Concepto');
    if (ipConVal === -1) ipConVal = pHVal.indexOf('CONCEPTO');
    var ipPagVal    = pHVal.indexOf('PAGO');

    // Obtener tipo_periodo del grupo para saber cuántas cuotas se esperan
    var wsGruposVal  = ss.getSheetByName(SH.GRUPOS);
    var gRowsVal     = wsGruposVal.getDataRange().getValues();
    var gHVal        = gRowsVal[0];
    var igCodVal     = gHVal.indexOf('CODIGO_GRUPO');
    var igTipoVal    = gHVal.indexOf('TIPO_PERIODO');
    var tipoPeriodoVal = 'C'; // default cuatrimestral
    for (var gv = 1; gv < gRowsVal.length; gv++) {
      if (String(gRowsVal[gv][igCodVal]||'').trim() === grupo) {
        tipoPeriodoVal = String(gRowsVal[gv][igTipoVal]||'C').toUpperCase();
        break;
      }
    }
    var cuotasEsperadas = tipoPeriodoVal === 'C' ? 4 : 2;

    var montoCuotasAcum = 0;
    for (var pv = 1; pv < pRowsVal.length; pv++) {
      var codPv = String(pRowsVal[pv][ipCodVal]||'').trim();
      if (codPv !== String(cod_estudiante).trim()) continue;
      var conPv = String(pRowsVal[pv][ipConVal]||'').toUpperCase();
      if (conPv.indexOf('CUOTA') === -1) continue;
      var monPv = parseFloat(pRowsVal[pv][ipPagVal]) || 0;
      if (monPv <= 0) continue;
      var mNiv = conPv.match(/CUOTA[_\s]*([BI][0-9])/);
      if (mNiv && mNiv[1] === nivelUp) montoCuotasAcum += monPv;
    }

    // Obtener cuota individual del estudiante
    var wsDatosVal = ss.getSheetByName(SH.DATOS);
    var dRowsVal   = wsDatosVal.getDataRange().getValues();
    var dHVal      = dRowsVal[0];
    var idCodVal   = dHVal.indexOf('CODIGO');
    var idCuoVal   = dHVal.indexOf('CUOTAS');
    var cuotaInd   = 0;
    for (var dv = 1; dv < dRowsVal.length; dv++) {
      if (String(dRowsVal[dv][idCodVal]||'').trim() === String(cod_estudiante).trim()) {
        cuotaInd = parseFloat(dRowsVal[dv][idCuoVal]) || 0;
        break;
      }
    }

    var cuotasPagadas = cuotaInd > 0 ? Math.floor(montoCuotasAcum / cuotaInd) : 0;
    if (cuotasPagadas < cuotasEsperadas) {
      return { ok: false, error: 'No se puede aprobar: faltan cuotas de ' + nivelUp + '. Pagadas: ' + cuotasPagadas + ' de ' + cuotasEsperadas + '.' };
    }
    // Certificado no es requisito para APR

    crearSiguienteNivel(ss, cod_estudiante, nivel, grupo);
  }

  // v4.13: crear siguiente nivel también para CNV (no solo APR)
  if (estatus.toUpperCase() === 'CNV') {
    crearSiguienteNivel(ss, cod_estudiante, nivel, grupo);
  }

  // v4.15: sync CONAPE silencioso
  var syncEst = { ok: false };
  try { syncEst = sincronizarCONAPE_estudiante(cod_estudiante); } catch(e) {}
  return { ok: true, cod_estudiante: cod_estudiante, nivel: nivel, estatus: estatus, grupo: grupo, conape_sync: syncEst.ok };
}

// ============================================================
// 9. registrarAsistencia(data)
// ============================================================
function registrarAsistencia(data) {
  try {
  if (!data.cod_grupo || !data.leccion_num || !data.lista) {
    return { error: 'Faltan: cod_grupo, leccion_num, lista' };
  }
  var ss  = SpreadsheetApp.openById(OPERATIVO_ID);
  var ws  = ss.getSheetByName(OP.ASISTENCIA);
  var ts  = new Date();
  var registrados = 0;

  for (var i = 0; i < data.lista.length; i++) {
    var item = data.lista[i];
    ws.appendRow([
      ts,
      data.cod_grupo,
      data.leccion_num,
      data.fecha_leccion || formatFecha(ts),
      item.cod_estudiante,
      item.presente === true || item.presente === 'TRUE',
      data.registrado_por || 'CAMPUS',
      data.programa || 'SIN_INA',
    ]);
    registrados++;
  }
  return { ok: true, registrados: registrados };
  } catch (err) { return {ok:false, error:String(err)}; }
}

