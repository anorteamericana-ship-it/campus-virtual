  var ssOp = SpreadsheetApp.openById(OPERATIVO_ID);
  var ws = ssOp.getSheetByName(SH_CALENDARIO);
  if (!ws) return { ok:false, error:'CALENDARIO_LECCIONES no existe' };
  var h = _ccF84_ensureHeaders_(ws, ['EVENTO_ID','FECHA_ORIGINAL','HORA_INICIO','HORA_FIN','REPROGRAMADA','REPROGRAMADA_AT','REPROGRAMADA_POR','ULTIMO_MOVIMIENTO_ID','ULTIMO_CAMBIO_AT','ULTIMO_CAMBIO_POR','CAMBIO_SOLICITUD_ID']);
