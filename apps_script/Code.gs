    if (!ws || ws.getLastRow() < 2) return [];
    var rows = ws.getDataRange().getValues();
    var h = rows[0];
    var m = _an4407_headerMap_(h);
    var iUsuario  = _an4407_getIdx_(m, ['usuario','USUARIO']);
    var iRol      = _an4407_getIdx_(m, ['rol','ROL']);
    var iNombre   = _an4407_getIdx_(m, ['nombre','NOMBRE']);
    var iGrupo    = _an4407_getIdx_(m, ['grupo','GRUPO']);
    var iCodigo   = _an4407_getIdx_(m, ['codigo','CODIGO']);
    var iActivo   = _an4407_getIdx_(m, ['activo','ACTIVO']);
    var iCedula   = _an4407_getIdx_(m, ['CEDULA','cedula']);
    var iCorreo   = _an4407_getIdx_(m, ['CORREO','correo','EMAIL','email']);
    var iTel      = _an4407_getIdx_(m, ['TELEFONO','telefono','TEL','tel','WHATSAPP','whatsapp']);

    var out = [];
    for (var r = 1; r < rows.length; r++) {
      var activo = iActivo >= 0 ? _an4407_bool_(rows[r][iActivo]) : true;
      if (!activo) continue;
      var usuario = iUsuario >= 0 ? _an4407_txt_(rows[r][iUsuario]) : '';
      var nombre  = iNombre  >= 0 ? _an4407_txt_(rows[r][iNombre])  : usuario;
      var rol     = iRol     >= 0 ? _an4407_txt_(rows[r][iRol])     : '';
      var tel     = iTel     >= 0 ? _an4407_txt_(rows[r][iTel])     : '';
      if (!usuario && !nombre) continue;
      out.push({
        usuario: usuario,
        nombre: nombre,
        rol: rol,
        rol_norm: _an4407_norm_(rol),
        nombre_norm: _an4407_norm_(nombre),
        usuario_norm: _an4407_norm_(usuario),
        telefono: tel,
        grupo: iGrupo >= 0 ? _an4407_txt_(rows[r][iGrupo]) : '',
        codigo: iCodigo >= 0 ? _an4407_txt_(rows[r][iCodigo]) : '',
        cedula: iCedula >= 0 ? _an4407_txt_(rows[r][iCedula]) : '',
        correo: iCorreo >= 0 ? _an4407_txt_(rows[r][iCorreo]) : ''
      });
    }
    return out;
  } catch (e) {
    return [];
  }
}

function _an4407_esRol_(u, tipo) {
  if (!u) return false;
  var r = u.rol_norm || '';
  var n = (u.nombre_norm || '') + ' ' + (u.usuario_norm || '');
  if (tipo === 'admin') return r === 'admin' || r === 'superadmin' || r.indexOf('administr') >= 0;
  if (tipo === 'academico') return r.indexOf('academic') >= 0 || r.indexOf('profesor') >= 0 || n.indexOf('director de profes') >= 0 || n.indexOf('director academ') >= 0;
  if (tipo === 'cobros') return r.indexOf('cobro') >= 0 || n.indexOf('cobro') >= 0;
  if (tipo === 'supervisor_ventas') return (r.indexOf('supervisor') >= 0 && r.indexOf('venta') >= 0) || r === 'supervisor de ventas';
  if (tipo === 'ventas') return r === 'ventas' || r.indexOf('asesor') >= 0 || r.indexOf('venta') >= 0;
  return false;
}

function _an4407_findByTipo_(usuarios, tipo) {
  for (var i = 0; i < usuarios.length; i++) {
    if (_an4407_esRol_(usuarios[i], tipo)) {
      var c = _an4407_contactObj_(usuarios[i], 'USUARIOS:' + tipo);
      if (c) return c;
    }
  }
  return null;
}

function _an4407_valorEst_(est, names) {
  est = est || {};
  for (var i = 0; i < names.length; i++) {
    var k = names[i];
    if (est[k] != null && _an4407_txt_(est[k])) return _an4407_txt_(est[k]);
    var up = String(k).toUpperCase();
    if (est[up] != null && _an4407_txt_(est[up])) return _an4407_txt_(est[up]);
    var low = String(k).toLowerCase();
    if (est[low] != null && _an4407_txt_(est[low])) return _an4407_txt_(est[low]);
  }
  return '';
}

function _an4407_contactoVentasAsignado_(usuarios, estudiante) {
  var vendedor = _an4407_valorEst_(estudiante, [
    'VENDEDOR','Vendedor','vendedor','ASESOR','Asesor','asesor',
    'ASESOR_REF','asesor_ref','ASESOR_ASIGNADO','asesor_asignado','USUARIO_VENTAS'
  ]);
  var vn = _an4407_norm_(vendedor);
  if (vn) {
    for (var i = 0; i < usuarios.length; i++) {
      var u = usuarios[i];
      var match = (u.nombre_norm && (u.nombre_norm === vn || u.nombre_norm.indexOf(vn) >= 0 || vn.indexOf(u.nombre_norm) >= 0)) ||
                  (u.usuario_norm && (u.usuario_norm === vn || u.usuario_norm.indexOf(vn) >= 0 || vn.indexOf(u.usuario_norm) >= 0));
      if (match) {
        var c = _an4407_contactObj_(u, 'USUARIOS:ventas_asignado');
        if (c) return c;
      }
    }
  }
  return _an4407_findByTipo_(usuarios, 'supervisor_ventas') || _an4407_findByTipo_(usuarios, 'ventas');
}

function _an4407_getContactosCampusParaEstudiante_(estudiante) {
  var usuarios = _an4407_leerUsuariosContacto_();
  var admin = _an4407_findByTipo_(usuarios, 'admin');
  var academico = _an4407_findByTipo_(usuarios, 'academico') || admin;
  var cobros = _an4407_findByTipo_(usuarios, 'cobros') || admin;
  var supervisorVentas = _an4407_findByTipo_(usuarios, 'supervisor_ventas');
