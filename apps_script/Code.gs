    ws.setColumnWidth(4, 200);  // CORREO
    return ws;
  }
  // Migración: agregar columnas faltantes si la hoja ya existía
  var headerRow = ws.getRange(1, 1, 1, Math.max(ws.getLastColumn(), 1)).getValues()[0];
  var faltantes = [];
  PROSPECTOS_HEADERS.forEach(function(col) {
    if (headerRow.indexOf(col) === -1) faltantes.push(col);
  });
  if (faltantes.length > 0) {
    var startCol = ws.getLastColumn() + 1;
    ws.getRange(1, startCol, 1, faltantes.length).setValues([faltantes]);
    var addedRange = ws.getRange(1, startCol, 1, faltantes.length);
    addedRange.setFontWeight('bold');
    addedRange.setBackground('#1a237e');
    addedRange.setFontColor('#ffffff');
  }
