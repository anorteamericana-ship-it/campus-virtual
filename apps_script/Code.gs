    var od = wsOral.getDataRange().getValues();
    var oi = _ccF84_idxMap_(od[0] || []);
    for (var orow = 1; orow < od.length; orow++) {
      if (!_ccF85_rowMatches_(od[orow], oi, cod, niv, lec)) continue;
      var oe = oi.ESTADO != null ? String(od[orow][oi.ESTADO] || '').trim().toUpperCase() : 'REGISTRADO';
