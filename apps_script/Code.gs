// ── HELPER: indexar pagos de matrícula B1 de OTROS_PAGOS ────
// Devuelve { codigoEstudiante: fechaPagoMasReciente } solo para pagos donde
// ncuenta=60 (matrícula B1). Fallback a descripción 'MATRICULA_B1' para
// compatibilidad con pagos viejos.
function _indexarPagosB1(ss) {
  var pagosB1 = {};
  var wsO = ss.getSheetByName(SH.OTROS_PAGOS);
  if (!wsO || wsO.getLastRow() <= 1) return pagosB1;

  var oRows = wsO.getDataRange().getValues();
  var oH    = oRows[0];

  var iOFecha = -1, iONcu = -1, iOCod = -1, iODesc = -1;
  for (var k = 0; k < oH.length; k++) {
    var hn = String(oH[k]).trim().toLowerCase();
    if (hn === 'fecha')       iOFecha = k;
    if (hn === 'ncuenta')     iONcu   = k;
    if (hn === 'codigo')      iOCod   = k;
    if (hn === 'descripcion') iODesc  = k;
  }

  for (var i = 1; i < oRows.length; i++) {
    var nc = String(oRows[i][iONcu] || '').trim();
    var esB1 = (nc === '60');
    if (!esB1 && iODesc >= 0) {
      var desc = String(oRows[i][iODesc] || '').toUpperCase();
      esB1 = desc.indexOf('MATRICULA_B1') >= 0 || desc.indexOf('MATRICULA-B1') >= 0;
    }
    if (!esB1) continue;

    var codEst = String(oRows[i][iOCod] || '').trim();
    if (!codEst) continue;

    var raw = oRows[i][iOFecha];
    var fp = null;
    if (raw instanceof Date) fp = raw;
    else if (raw && String(raw).trim()) {
      fp = new Date(raw);
      if (isNaN(fp.getTime())) fp = null;
    }
    if (!fp) continue;

    if (!pagosB1[codEst] || fp > pagosB1[codEst]) pagosB1[codEst] = fp;
  }

  return pagosB1;
}

// ── HELPER: calcular etapa del embudo para un prospecto ────
// Devuelve {etapa, fecha_etapa} o null si no debe aparecer en el embudo
// activo (cancelado o matrícula con decay).
//
// Decay: CONAPE_MATRICULA y PAGO_ACADEMIA solo aparecen si el pago B1 fue
// durante la SEMANA CALENDARIO en curso (lunes a domingo). Al cambiar de
// semana (lunes 00:00 CR), las matrículas de la semana anterior salen del
// embudo del vendedor — "lunes empieza de cero" según la regla del director.
function _calcularEtapaProspecto(prospecto, fechaPagoB1, inicioSemana) {
  if (String(prospecto.ETAPA || '').toUpperCase() === 'CANCELADO') return null;

  var financiamiento = String(prospecto.FINANCIAMIENTO || '').toUpperCase();

  // Con pago de matrícula B1 → CONAPE_MATRICULA o PAGO_ACADEMIA con decay semanal
  if (fechaPagoB1) {
    if (fechaPagoB1 < inicioSemana) return null;  // semana pasada o anterior → sale del embudo
    return {
      etapa:       financiamiento === 'CONAPE' ? 'CONAPE_MATRICULA' : 'PAGO_ACADEMIA',
      fecha_etapa: fechaPagoB1
    };
  }

  // Sin pago, CONAPE → recorre las etapas según el estado del WS
  if (financiamiento === 'CONAPE') {
    var ultimoDes = String(prospecto.CONAPE_WS_ULTIMO_DESEMBOLSO || '').trim();
    var novedad   = String(prospecto.CONAPE_WS_NOVEDAD            || '').trim();

    if (ultimoDes) return { etapa: 'CONAPE_DESEMBOLSO', fecha_etapa: null };
    if (novedad === 'aprobado_sin_desembolso') {
      return { etapa: 'CONAPE_APROBADO_FIRMA', fecha_etapa: null };
    }
    // 'no_encontrado', nunca consultado, o vacío → sigue siendo Solicitud
    return { etapa: 'CONAPE_SOLICITUD', fecha_etapa: null };
  }

  // Sin pago, no CONAPE → Lead
  return { etapa: 'LEAD', fecha_etapa: null };
}

// ── HELPER: inicio de la semana de comisiones (lunes 00:00 CR) ──
// Regla del director: comisiones se pagan el domingo, lunes empieza nueva
// semana en cero. Día 0=domingo, 1=lunes, ..., 6=sábado.
function _inicioSemanaComisiones() {
  // Apps Script timezone puede no ser CR; forzamos cálculo en CR explícito
  // tomando primero la fecha en CR y luego construyendo el inicio.
  var tz = 'America/Costa_Rica';
  var hoyStr = Utilities.formatDate(new Date(), tz, 'yyyy-MM-dd HH:mm:ss');
  // Parsear hoyStr como Date local (sin TZ conversion)
  var parts = hoyStr.split(/[- :]/);
  var hoy = new Date(+parts[0], +parts[1]-1, +parts[2], +parts[3], +parts[4], +parts[5]);
  var dia = hoy.getDay();  // 0=domingo, 1=lunes
  var diasAtras = dia === 0 ? 6 : dia - 1;
  var lunes = new Date(hoy);
  lunes.setDate(hoy.getDate() - diasAtras);
  lunes.setHours(0, 0, 0, 0);
  return lunes;
}

// ── ENDPOINT: getDashboardVentas(params) ──────────────────────
// Devuelve TODO lo que el panel del vendedor necesita en una sola llamada:
// embudo agregado, prospectos del asesor con etapa calculada, métrica
// "matrículas esta semana" + promedio últimas 4 semanas, y grupos disponibles
// (sin info de matriculados de otros vendedores — respeta privacidad operativa).
//
// params: { asesor: 'Fiorella Salazar' } o { cedula: '402110915' }
function getDashboardVentas(params) {
  var asesorRaw = params && params.asesor ? String(params.asesor).trim() : '';
  var cedulaRaw = params && params.cedula
    ? String(params.cedula).trim().replace(/[-\s]/g,'')
    : '';

  if (!asesorRaw && !cedulaRaw) return { ok: false, error: 'Falta asesor o cedula' };

  var ss = SpreadsheetApp.openById(SHEET_ID);

  // ── 1. Resolver nombre del asesor ─────────────────────────
  var nombreFiltro = '';
  if (cedulaRaw) {
    var wsU = ss.getSheetByName(SH.USUARIOS);
    if (wsU) {
      var uRows = wsU.getDataRange().getValues();
      var uH    = uRows[0];
      var iUUser = -1, iUNombre = -1, iUCed = -1;
      for (var k = 0; k < uH.length; k++) {
        var hn = String(uH[k]).trim().toLowerCase();
        if (hn === 'usuario')  iUUser   = k;
        if (hn === 'nombre')   iUNombre = k;
        if (hn === 'cedula')   iUCed    = k;
      }
      for (var u = 1; u < uRows.length; u++) {
        var cedU = String(uRows[u][iUCed >= 0 ? iUCed : iUUser] || '').replace(/[-\s]/g,'').trim();
        if (cedU === cedulaRaw && iUNombre >= 0) {
          nombreFiltro = String(uRows[u][iUNombre] || '').trim().toUpperCase();
          break;
        }
      }
    }
  } else if (asesorRaw) {
    nombreFiltro = asesorRaw.toUpperCase();
  }

  if (!nombreFiltro) return { ok: false, error: 'No se pudo resolver el asesor' };

  // ── 2. Indexar pagos B1 + filtrar prospectos del asesor ────
  var pagosB1 = _indexarPagosB1(ss);

  // v4.34.1 — Semana de comisiones lunes-domingo (no rolling 7d).
  // "Lunes empieza de cero": al pasar a lunes 00:00 CR, las matrículas de la
  // semana anterior salen del embudo del vendedor.
  var inicioSemana   = _inicioSemanaComisiones();
  var inicioSem_4    = new Date(inicioSemana); inicioSem_4.setDate(inicioSemana.getDate() - 28);

  // CALGRUPO_F52_20260617_FIX_VENTAS_PROSPECTOS_EMPTY
  // En ambientes nuevos/test, PROSPECTOS puede no existir o tener solo encabezado.
  // Eso no debe tumbar ventas.html: se crea/migra la hoja y el panel carga en cero.
  var wsP = getOrCreateProspectos(ss);
  var pRows = (wsP && wsP.getLastRow() > 0) ? wsP.getDataRange().getValues() : [PROSPECTOS_HEADERS];
  if (!pRows || !pRows.length) pRows = [PROSPECTOS_HEADERS];
  var pH    = pRows[0] || PROSPECTOS_HEADERS;
  var iPAse = pH.indexOf('ASESOR_REF');
  var iPCod = pH.indexOf('CODIGO_ESTUDIANTE');

  // Etapas del embudo (orden definido por el director)
  var ETAPAS_EMBUDO = [
    'LEAD',
    'CONAPE_SOLICITUD',
    'CONAPE_DOCUMENTOS',       // placeholder, queda en 0 hasta que CONAPE dé la lista
    'CONAPE_APROBADO_FIRMA',
    'CONAPE_DESEMBOLSO',
    'CONAPE_MATRICULA',
    'PAGO_ACADEMIA'
  ];
  var embudo = {};
  ETAPAS_EMBUDO.forEach(function(e) { embudo[e] = 0; });

  var prospectosActivos = [];   // los que el vendedor ve en el embudo
  var pagosB1DelAsesor = [];    // para promedio 4 semanas

  for (var i = 1; i < pRows.length; i++) {
    var aseRaw = String(pRows[i][iPAse] || '').trim();
    if (!aseRaw) continue;
    var aseKey = aseRaw.toUpperCase();

    // Match flexible (igual que getProspectosAsesor)
    var matches = (aseKey === nombreFiltro)
               || (nombreFiltro.length >= 4 && aseKey.indexOf(nombreFiltro) >= 0)
               || (aseKey.length >= 4 && nombreFiltro.indexOf(aseKey) >= 0);
    if (!matches) continue;

    // Construir objeto del prospecto
    var prospecto = {};
    for (var j = 0; j < pH.length; j++) prospecto[pH[j]] = pRows[i][j];

    // Pago B1 (si tiene código)
    var codigo = String(prospecto.CODIGO_ESTUDIANTE || '').trim();
    var fechaPagoB1 = (codigo && pagosB1[codigo]) ? pagosB1[codigo] : null;
    if (fechaPagoB1) pagosB1DelAsesor.push(fechaPagoB1);

    // Calcular etapa (semana calendario)
    var resEtapa = _calcularEtapaProspecto(prospecto, fechaPagoB1, inicioSemana);
    if (!resEtapa) continue;  // cancelado o decay

    embudo[resEtapa.etapa] = (embudo[resEtapa.etapa] || 0) + 1;

    // Solo entregar los campos que el vendedor necesita (sin sensibles)
    prospectosActivos.push({
      cedula:            String(prospecto.CEDULA || ''),
      nombre:            String(prospecto.NOMBRE || ''),
      whatsapp:          String(prospecto.WHATSAPP || ''),
      correo:            String(prospecto.CORREO || ''),
      programa:          String(prospecto.PROGRAMA || ''),
      modalidad:         String(prospecto.MODALIDAD || ''),
      financiamiento:    String(prospecto.FINANCIAMIENTO || ''),
      grupo_tentativo:   String(prospecto.GRUPO_TENTATIVO || ''),
      codigo_estudiante: codigo,
      etapa:             resEtapa.etapa,
      fecha_etapa:       resEtapa.fecha_etapa
                           ? Utilities.formatDate(resEtapa.fecha_etapa, 'America/Costa_Rica', 'yyyy-MM-dd')
                           : '',
      f_lead:            prospecto.F_LEAD instanceof Date
                           ? Utilities.formatDate(prospecto.F_LEAD, 'America/Costa_Rica', 'yyyy-MM-dd')
                           : String(prospecto.F_LEAD || ''),
      conape_ultima_consulta: String(prospecto.CONAPE_WS_ULTIMA_CONSULTA || ''),
      conape_ultimo_desembolso: String(prospecto.CONAPE_WS_ULTIMO_DESEMBOLSO || ''),
      notas:             String(prospecto.NOTAS || ''),
    });
  }

  // ── 3. "Mi semana" (lunes-domingo actual) + promedio 4 semanas previas ──
  // matriculas = pagos B1 del asesor desde el lunes 00:00 hasta ahora.
  // promedio_4s = pagos B1 en las 4 semanas calendario ANTERIORES / 4.
  // (No se incluye la semana actual en el promedio — si la actual está
  // recién empezando, sería injusto bajar el promedio artificialmente).
  var matSemanaActual = 0;
  var matSemanasPrevias4 = 0;
  for (var p = 0; p < pagosB1DelAsesor.length; p++) {
    var fp = pagosB1DelAsesor[p];
    if (fp >= inicioSemana)                              matSemanaActual++;
    else if (fp >= inicioSem_4 && fp < inicioSemana)     matSemanasPrevias4++;
  }
  var promedio4Sem = Math.round((matSemanasPrevias4 / 4) * 10) / 10;

  // ── 4. Grupos disponibles (DISPONIBLE_INSCRIPCION=TRUE) ────
  // Sin info de matriculados de otros vendedores (privacidad operativa).
  var gruposDispo = [];
  var wsG = ss.getSheetByName(SH.GRUPOS);
  if (wsG && wsG.getLastRow() > 1) {
    var gRows = wsG.getDataRange().getValues();
    var gH    = gRows[0];
    var iGCod  = gH.indexOf('CODIGO_GRUPO');
    var iGNiv  = gH.indexOf('NIVEL_INICIO');
    var iGFec  = gH.indexOf('FECHA_INICIO');
    var iGCap  = gH.indexOf('CAPACIDAD');
    var iGMod  = gH.indexOf('MODALIDAD');
    var iGProg = gH.indexOf('PROGRAMA');
    var iGDis  = gH.indexOf('DISPONIBLE_INSCRIPCION');

    for (var i = 1; i < gRows.length; i++) {
      var nivel = String(gRows[i][iGNiv] || '').trim().toUpperCase();
      if (nivel !== 'B1') continue;
      var dispRaw = iGDis >= 0 ? gRows[i][iGDis] : true;
      var disp = dispRaw === true || String(dispRaw).trim().toUpperCase() === 'TRUE';
      if (!disp) continue;

      var cod = String(gRows[i][iGCod] || '').trim();
      var fec = gRows[i][iGFec];
      var fecStr = _anF52_courseDateIso_(fec);

      gruposDispo.push({
        codigo:        cod,
        fecha_inicio:  fecStr,
        modalidad:     String(gRows[i][iGMod] || '').trim().toUpperCase(),
        programa:      String(gRows[i][iGProg] || '').trim().toUpperCase(),
        capacidad:     parseInt(gRows[i][iGCap]) || 20,
      });
    }
    gruposDispo.sort(function(a, b) { return a.fecha_inicio.localeCompare(b.fecha_inicio); });
  }

  // ── 5. Armar respuesta ────────────────────────────────────
  return {
    ok:     true,
    asesor: nombreFiltro,
    semana_actual: {
      matriculas:   matSemanaActual,
      promedio_4s:  promedio4Sem
    },
    embudo: ETAPAS_EMBUDO.map(function(e) {
      return { etapa: e, count: embudo[e] };
    }),
    prospectos:         prospectosActivos,
    grupos_disponibles: gruposDispo,
    total_prospectos:   prospectosActivos.length
  };
}

// ════════════════════════════════════════════════════════════════════════════
// v4.35.0 — Fase 3.5: Reporte de pagos por el vendedor
// El vendedor sube un comprobante (foto + número de doc + monto). Eso queda
// en la hoja SOLICITUDES_PAGO con estado PENDIENTE. El admin recibe la
// solicitud en su vista nueva y gestiona el pago siguiendo el flujo manual
// existente (Generar Matrícula / Aplicar Pago). Cuando termina, marca la
// solicitud como APLICADA. La imagen es EVIDENCIA / AVISO, no automatiza
// nada: el admin sigue siendo la fuente de verdad cruzando BDBANCARIO.
// ════════════════════════════════════════════════════════════════════════════

var SOL_PAGO_HEADERS = [
  'ID','TIMESTAMP','ORIGEN','USUARIO_REPORTA','NOMBRE_REPORTA',
  'ESTUDIANTE_CEDULA','ESTUDIANTE_CODIGO','ESTUDIANTE_NOMBRE',
  'TIPO_PAGO','NIVEL','NUMERO_COMPROBANTE','MONTO_REPORTADO',
  'URL_COMPROBANTE','NOTAS_REPORTA','ESTADO',
  'ADMIN_APLICO','FECHA_APLICACION','NOTAS_ADMIN'
];

function _getOrCreateSolicitudesPagoSheet(ss) {
  var ws = ss.getSheetByName('SOLICITUDES_PAGO');
  if (!ws) {
    ws = ss.insertSheet('SOLICITUDES_PAGO');
    ws.getRange(1, 1, 1, SOL_PAGO_HEADERS.length).setValues([SOL_PAGO_HEADERS]);
    ws.setFrozenRows(1);
    ws.getRange(1, 1, 1, SOL_PAGO_HEADERS.length).setFontWeight('bold');
  }
  return ws;
}

// ── HELPER: subir imagen del comprobante a Drive ────────────
// Devuelve URL pública. Estructura: DOCUMENTOS_FOLDER/SOLICITUDES_PAGO/{ID}.{ext}
function _subirComprobanteADrive(base64Data, mimeType, solicitudId) {
  if (!base64Data) return '';
  try {
    var raizFolder = DriveApp.getFolderById(DOCUMENTOS_FOLDER_ID);
    var subFolders = raizFolder.getFoldersByName('SOLICITUDES_PAGO');
    var subFolder = subFolders.hasNext() ? subFolders.next()
                  : raizFolder.createFolder('SOLICITUDES_PAGO');

    var ext = 'jpg';
    if (mimeType && mimeType.indexOf('png') >= 0) ext = 'png';
    else if (mimeType && mimeType.indexOf('pdf') >= 0) ext = 'pdf';

    var fileName = solicitudId + '.' + ext;
    var blob = Utilities.newBlob(Utilities.base64Decode(base64Data), mimeType || 'image/jpeg', fileName);
    var file = subFolder.createFile(blob);
    file.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
    return 'https://lh3.googleusercontent.com/d/' + file.getId();
  } catch (e) {
    Logger.log('Error subiendo comprobante: ' + e.message);
    return '';
  }
}

// ── ENDPOINT: reportarPago(body) ────────────────────────────
// El vendedor o estudiante reporta un comprobante. Aplica detección de
// duplicados: si ya existe una solicitud APLICADA con el mismo
// NUMERO_COMPROBANTE, la nueva queda con estado DUPLICADO.
//
// body:
//   usuario_reporta:    cédula de quien sube (vendedor o estudiante)
//   nombre_reporta:     nombre legible (para display)
//   origen:             'VENDEDOR' | 'ESTUDIANTE' | 'TUTOR'  (default VENDEDOR)
//   estudiante_cedula:  cédula del estudiante
//   estudiante_codigo:  (opcional) si ya está activado
//   estudiante_nombre:  para display
//   tipo_pago:          'MATRICULA' | 'CUOTA' | 'CERTIFICADO' | 'TITULO' | 'OTRO'
//   nivel:              'B1' | 'B2' | 'I1' | 'I2' | ''
//   numero_comprobante: ⭐ clave para cruzar con BDBANCARIO
//   monto_reportado:    número
//   foto_base64:        contenido del comprobante (base64 sin prefijo data:...)
//   foto_mime:          'image/jpeg' | 'image/png' | 'application/pdf'
//   notas_reporta:      texto libre opcional
function reportarPago(body) {
  if (!body) return { ok: false, error: 'Body vacío' };
  if (!body.usuario_reporta) return { ok: false, error: 'Falta usuario_reporta' };
  if (!body.estudiante_cedula) return { ok: false, error: 'Falta estudiante_cedula' };
  if (!body.numero_comprobante) return { ok: false, error: 'Falta numero_comprobante (clave para cruzar con BDBANCARIO)' };
  if (!body.tipo_pago) return { ok: false, error: 'Falta tipo_pago' };

  var lock = LockService.getDocumentLock();
  if (!lock.tryLock(20000)) return { ok: false, error: 'Sistema ocupado, intentá de nuevo' };

  try {
    var ss = SpreadsheetApp.openById(SHEET_ID);
    var ws = _getOrCreateSolicitudesPagoSheet(ss);

    var ahora = Utilities.formatDate(new Date(), 'America/Costa_Rica', 'yyyy-MM-dd HH:mm:ss');
    var id    = Utilities.getUuid().substring(0, 8);

    var numComp = String(body.numero_comprobante).trim();

    // Detectar duplicado: misma cédula + mismo comprobante + estado=APLICADO
    var estadoInicial = 'PENDIENTE';
    if (ws.getLastRow() > 1) {
      var rows = ws.getDataRange().getValues();
      var h    = rows[0];
      var iNum = h.indexOf('NUMERO_COMPROBANTE');
      var iEst = h.indexOf('ESTADO');
      var iCed = h.indexOf('ESTUDIANTE_CEDULA');
      var cedLimpia = String(body.estudiante_cedula).replace(/[-\s]/g,'').trim();
      for (var i = 1; i < rows.length; i++) {
        var n2 = String(rows[i][iNum] || '').trim();
        var e2 = String(rows[i][iEst] || '').trim().toUpperCase();
        var c2 = String(rows[i][iCed] || '').replace(/[-\s]/g,'').trim();
        if (n2 === numComp && c2 === cedLimpia && e2 === 'APLICADO') {
          estadoInicial = 'DUPLICADO';
          break;
        }
      }
    }

    // Subir comprobante a Drive
    var urlComp = '';
    if (body.foto_base64) {
      urlComp = _subirComprobanteADrive(body.foto_base64, body.foto_mime, id);
    }

    var fila = [
      id,                                                                    // ID
      ahora,                                                                 // TIMESTAMP
      String(body.origen || 'VENDEDOR').toUpperCase(),                       // ORIGEN
      String(body.usuario_reporta).replace(/[-\s]/g,'').trim(),              // USUARIO_REPORTA
      String(body.nombre_reporta || '').trim(),                              // NOMBRE_REPORTA
      String(body.estudiante_cedula).replace(/[-\s]/g,'').trim(),            // ESTUDIANTE_CEDULA
      String(body.estudiante_codigo || '').trim(),                           // ESTUDIANTE_CODIGO
      String(body.estudiante_nombre || '').trim(),                           // ESTUDIANTE_NOMBRE
      String(body.tipo_pago).toUpperCase().trim(),                           // TIPO_PAGO
      String(body.nivel || '').toUpperCase().trim(),                         // NIVEL
      numComp,                                                               // NUMERO_COMPROBANTE
      parseFloat(body.monto_reportado) || 0,                                 // MONTO_REPORTADO
      urlComp,                                                               // URL_COMPROBANTE
      String(body.notas_reporta || '').trim(),                               // NOTAS_REPORTA
      estadoInicial,                                                         // ESTADO
      '',                                                                    // ADMIN_APLICO
      '',                                                                    // FECHA_APLICACION
      ''                                                                     // NOTAS_ADMIN
    ];

    ws.appendRow(fila);

    return {
      ok:                true,
      id:                id,
      estado:            estadoInicial,
      url_comprobante:   urlComp,
      mensaje:           estadoInicial === 'DUPLICADO'
                           ? 'Este comprobante ya fue aplicado antes para este estudiante. Quedó como DUPLICADO.'
                           : 'Solicitud enviada al admin. Te avisará cuando aplique el pago.'
    };

  } catch (err) {
    return { ok: false, error: 'Error en reportarPago: ' + err.message };
  } finally {
    lock.releaseLock();
  }
}

// ── ENDPOINT: getSolicitudesPago(filtros) ────────────────────
// Devuelve solicitudes según filtros opcionales. Sin filtros → todas.
//   estado:       'PENDIENTE' | 'APLICADO' | 'RECHAZADO' | 'DUPLICADO' | ''
//   asesor:       nombre del asesor que reportó (case-insensitive)
//   fecha_desde:  YYYY-MM-DD (solicitudes con TIMESTAMP >= esa fecha)
//   fecha_hasta:  YYYY-MM-DD (solicitudes con TIMESTAMP <= esa fecha)
function getSolicitudesPago(params) {
  params = params || {};
  var filtroEstado = String(params.estado || '').toUpperCase().trim();
  var filtroAsesor = String(params.asesor || '').toUpperCase().trim();
  var fechaDesde   = params.fecha_desde ? new Date(params.fecha_desde) : null;
  var fechaHasta   = params.fecha_hasta ? new Date(params.fecha_hasta) : null;

  try {
    var ss = SpreadsheetApp.openById(SHEET_ID);
    var ws = _getOrCreateSolicitudesPagoSheet(ss);

    if (ws.getLastRow() <= 1) {
      return { ok: true, solicitudes: [], total: 0, pendientes: 0 };
    }

    var rows = ws.getDataRange().getValues();
    var h    = rows[0];
    var idx  = {};
    SOL_PAGO_HEADERS.forEach(function(name) {
      idx[name] = h.indexOf(name);
    });

    var out = [];
    var pendientes = 0;

    for (var i = 1; i < rows.length; i++) {
      var r = rows[i];

      var solicitud = {};
      SOL_PAGO_HEADERS.forEach(function(name) {
        var ix = idx[name];
        var val = ix >= 0 ? r[ix] : '';
        // Normalizar fechas
        if (val instanceof Date) {
          val = Utilities.formatDate(val, 'America/Costa_Rica', 'yyyy-MM-dd HH:mm:ss');
        }
        solicitud[name.toLowerCase()] = val;
      });

      var estado = String(solicitud.estado || '').toUpperCase();
      if (estado === 'PENDIENTE') pendientes++;

      // Aplicar filtros
      if (filtroEstado && estado !== filtroEstado) continue;
      if (filtroAsesor) {
        var nr = String(solicitud.nombre_reporta || '').toUpperCase();
        if (nr.indexOf(filtroAsesor) < 0) continue;
      }
      if (fechaDesde || fechaHasta) {
        var ts = solicitud.timestamp ? new Date(solicitud.timestamp) : null;
        if (!ts || isNaN(ts.getTime())) continue;
        if (fechaDesde && ts < fechaDesde) continue;
        if (fechaHasta && ts > fechaHasta) continue;
      }

      out.push(solicitud);
    }

    // Más recientes primero
    out.sort(function(a, b) {
      return String(b.timestamp || '').localeCompare(String(a.timestamp || ''));
    });

    return {
      ok:          true,
      solicitudes: out,
      total:       out.length,
      pendientes:  pendientes   // contador global, para badge en navegación admin
    };

  } catch (err) {
    return { ok: false, error: 'Error en getSolicitudesPago: ' + err.message };
  }
}

// ── ENDPOINT: marcarSolicitudAplicada({id, admin_nombre}) ────
// Admin marca una solicitud como APLICADA después de haber aplicado el pago
// real desde Aplicar Pago. No automatizamos: el admin sigue gestionando
// manualmente porque es la fuente de verdad (cruza con BDBANCARIO).
function marcarSolicitudAplicada(body) {
  if (!body || !body.id) return { ok: false, error: 'Falta id' };
  return _actualizarEstadoSolicitud(body.id, 'APLICADO', body.admin_nombre || '', body.notas_admin || '');
}

// ── ENDPOINT: rechazarSolicitudPago({id, admin_nombre, motivo}) ──
function rechazarSolicitudPago(body) {
  if (!body || !body.id) return { ok: false, error: 'Falta id' };
  if (!body.motivo) return { ok: false, error: 'Falta motivo del rechazo' };
  return _actualizarEstadoSolicitud(body.id, 'RECHAZADO', body.admin_nombre || '', body.motivo);
}

function _actualizarEstadoSolicitud(id, nuevoEstado, adminNombre, notasAdmin) {
  var lock = LockService.getDocumentLock();
  if (!lock.tryLock(15000)) return { ok: false, error: 'Sistema ocupado' };

  try {
    var ss = SpreadsheetApp.openById(SHEET_ID);
    var ws = _getOrCreateSolicitudesPagoSheet(ss);

    if (ws.getLastRow() <= 1) return { ok: false, error: 'No hay solicitudes' };

    var rows = ws.getDataRange().getValues();
    var h    = rows[0];
    var iId    = h.indexOf('ID');
    var iEst   = h.indexOf('ESTADO');
    var iAdm   = h.indexOf('ADMIN_APLICO');
    var iFec   = h.indexOf('FECHA_APLICACION');
    var iNot   = h.indexOf('NOTAS_ADMIN');

    var ahora = Utilities.formatDate(new Date(), 'America/Costa_Rica', 'yyyy-MM-dd HH:mm:ss');

    for (var i = 1; i < rows.length; i++) {
      if (String(rows[i][iId] || '').trim() === String(id).trim()) {
        ws.getRange(i + 1, iEst + 1).setValue(nuevoEstado);
        if (iAdm >= 0) ws.getRange(i + 1, iAdm + 1).setValue(adminNombre);
        if (iFec >= 0) ws.getRange(i + 1, iFec + 1).setValue(ahora);
        if (iNot >= 0 && notasAdmin) ws.getRange(i + 1, iNot + 1).setValue(notasAdmin);
        return { ok: true, id: id, estado_nuevo: nuevoEstado };
      }
    }
    return { ok: false, error: 'Solicitud no encontrada: ' + id };

  } catch (err) {
    return { ok: false, error: 'Error: ' + err.message };
  } finally {
    lock.releaseLock();
  }
}

// ════════════════════════════════════════════════════════════════════════════
// v4.35.1 — cancelarProspecto: soft-delete con auditoría
// El vendedor "limpia su panel" cancelando un prospecto, pero la fila NO se
// borra. ETAPA pasa a 'CANCELADO' y se registra quién canceló, cuándo, y por
// qué. El admin sigue viendo el prospecto con ese detalle. Si el mismo
// prospecto se inscribe de nuevo, queda evidencia del intento anterior.
// ════════════════════════════════════════════════════════════════════════════
function cancelarProspecto(body) {
  if (!body) return { ok: false, error: 'Body vacío' };
  if (!body.cedula) return { ok: false, error: 'Falta cedula' };
  if (!body.cancelado_por) return { ok: false, error: 'Falta cancelado_por (nombre del vendedor/admin)' };
  if (!body.motivo) return { ok: false, error: 'Falta motivo de cancelación' };

  var lock = LockService.getDocumentLock();
  if (!lock.tryLock(15000)) return { ok: false, error: 'Sistema ocupado' };

  try {
    var ss = SpreadsheetApp.openById(SHEET_ID);
    getOrCreateProspectos(ss);  // asegura columnas nuevas si no existen

    var wsP = ss.getSheetByName('PROSPECTOS');
    if (!wsP) return { ok: false, error: 'Hoja PROSPECTOS no encontrada' };
    var pRows = wsP.getDataRange().getValues();
    var pH    = pRows[0];

    var iCed   = pH.indexOf('CEDULA');
    var iEtapa = pH.indexOf('ETAPA');
    var iPor   = pH.indexOf('CANCELADO_POR');
    var iFec   = pH.indexOf('CANCELADO_FECHA');
    var iMot   = pH.indexOf('CANCELADO_MOTIVO');
    var iNotas = pH.indexOf('NOTAS');

    if (iCed < 0 || iEtapa < 0) return { ok: false, error: 'Columnas faltantes en PROSPECTOS' };

    var cedLimpia = String(body.cedula).replace(/[-\s]/g,'').trim();
    var ahora = Utilities.formatDate(new Date(), 'America/Costa_Rica', 'yyyy-MM-dd HH:mm:ss');

    for (var i = 1; i < pRows.length; i++) {
      var ced = String(pRows[i][iCed] || '').replace(/[-\s]/g,'').trim();
      if (ced !== cedLimpia) continue;

      var etapaActual = String(pRows[i][iEtapa] || '').trim();
      if (etapaActual === 'CANCELADO') {
        return { ok: false, error: 'El prospecto ya estaba cancelado' };
      }

      var fila = i + 1;
      wsP.getRange(fila, iEtapa + 1).setValue('CANCELADO');
      if (iPor >= 0) wsP.getRange(fila, iPor + 1).setValue(String(body.cancelado_por).trim());
      if (iFec >= 0) wsP.getRange(fila, iFec + 1).setValue(ahora);
      if (iMot >= 0) wsP.getRange(fila, iMot + 1).setValue(String(body.motivo).trim());

      // Append a NOTAS con la cancelación (para mantener historial)
      if (iNotas >= 0) {
        var notaPrev = String(pRows[i][iNotas] || '').trim();
        var linea = '[' + ahora + ' · ' + body.cancelado_por + '] CANCELADO. Motivo: ' + body.motivo;
        var notaNueva = notaPrev ? (notaPrev + '\n' + linea) : linea;
        wsP.getRange(fila, iNotas + 1).setValue(notaNueva);
      }

      return {
        ok:         true,
        cedula:     cedLimpia,
        etapa_anterior: etapaActual,
        cancelado_por:  body.cancelado_por,
        fecha:      ahora,
        mensaje:    'Prospecto cancelado. Salió del panel del vendedor, pero el admin lo sigue viendo.'
      };
    }

    return { ok: false, error: 'Prospecto no encontrado: ' + cedLimpia };

  } catch (err) {
    return { ok: false, error: 'Error: ' + err.message };
  } finally {
    lock.releaseLock();
  }
}

// ════════════════════════════════════════════════════════════════════════════
// v4.36.0 — Fase 3.7: Calendario semanal de matrículas
// Cruza pagos B1 (OTROS_PAGOS.ncuenta=60) con asesor (PROSPECTOS.ASESOR_REF
// por CODIGO_ESTUDIANTE). Agrupa por (asesor, día de la semana).
// ════════════════════════════════════════════════════════════════════════════

// ── HELPER: inicio de semana arbitrario ────────────────────
// Dado un date cualquiera, devuelve el lunes 00:00 de esa semana (zona CR).
function _inicioSemanaDeFecha(fecha) {
  var tz   = 'America/Costa_Rica';
  var s    = Utilities.formatDate(fecha, tz, 'yyyy-MM-dd HH:mm:ss');
  var p    = s.split(/[- :]/);
  var d    = new Date(+p[0], +p[1]-1, +p[2], +p[3], +p[4], +p[5]);
  var dia  = d.getDay();  // 0=domingo
  var atras = dia === 0 ? 6 : dia - 1;
  var lun  = new Date(d);
  lun.setDate(d.getDate() - atras);
  lun.setHours(0, 0, 0, 0);
  return lun;
}

// ── HELPER: índice de PROSPECTOS por CODIGO_ESTUDIANTE → ASESOR ──
function _indexarAsesoresPorCodigo(ss) {
  var idx = {};
  var wsP = ss.getSheetByName('PROSPECTOS');
  if (!wsP || wsP.getLastRow() <= 1) return idx;
  var rows = wsP.getDataRange().getValues();
  var h    = rows[0];
  var iCod = h.indexOf('CODIGO_ESTUDIANTE');
  var iAse = h.indexOf('ASESOR_REF');
  if (iCod < 0 || iAse < 0) return idx;
  for (var i = 1; i < rows.length; i++) {
    var cod = String(rows[i][iCod] || '').trim();
    var ase = String(rows[i][iAse] || '').trim();
    if (cod && ase) idx[cod] = ase;
  }
  return idx;
}

// ── HELPER: día código (L/M/X/J/V/S/D) desde Date ────────────
function _diaCodigo(fecha) {
  var d = fecha.getDay();  // 0=domingo, 1=lunes, ...
  return ['D','L','M','X','J','V','S'][d];
}

// ── ENDPOINT: getCalendarioMatriculas ────────────────────────
// Devuelve la tabla de pagos B1 agrupados por (asesor, día de la semana)
// para la semana solicitada (o la actual por default).
//
// params (todos opcionales):
//   semana_inicio:   'YYYY-MM-DD' (lunes). Si no se pasa, usa la actual.
//   asesor_filtro:   nombre del asesor (vendedor solo ve el suyo).
//                    Match flexible (case-insensitive, substring).
//   con_tendencia:   true | false. Si true, devuelve también las 8 semanas previas.
function getCalendarioMatriculas(params) {
  params = params || {};
  try {
    var ss = SpreadsheetApp.openById(SHEET_ID);
    var asesorFiltro = String(params.asesor_filtro || '').toUpperCase().trim();
    var conTendencia = params.con_tendencia === true ||
                       String(params.con_tendencia).toLowerCase() === 'true';

    // Determinar inicio/fin de la semana solicitada
    var lunes;
    if (params.semana_inicio) {
      var sp = String(params.semana_inicio).split('-');
      lunes = new Date(+sp[0], +sp[1]-1, +sp[2], 0, 0, 0, 0);
    } else {
      lunes = _inicioSemanaComisiones();
    }
    var domingo = new Date(lunes);
    domingo.setDate(lunes.getDate() + 7);  // exclusivo (lunes siguiente 00:00)

    var hoyLun = _inicioSemanaComisiones();
    var esSemanaActual = (lunes.getTime() === hoyLun.getTime());

    // Indexar pagos B1 (todos)
    var pagosB1Idx = _indexarPagosB1(ss);
    var pagosArr   = [];
    for (var cod in pagosB1Idx) {
      pagosArr.push({ codigo: cod, fecha: pagosB1Idx[cod] });
    }

    // Indexar asesores por código
    var asesorPorCodigo = _indexarAsesoresPorCodigo(ss);

    // Identificar todos los asesores que aparecen en los pagos (para devolver
    // la lista completa, incluso si en esta semana no pagó nadie de algunos)
    var asesoresSet = {};
    pagosArr.forEach(function(p) {
      var ase = asesorPorCodigo[p.codigo];
      if (!ase) return;
      var aseKey = ase.toUpperCase();
      if (asesorFiltro) {
        var m = aseKey === asesorFiltro
             || (asesorFiltro.length >= 4 && aseKey.indexOf(asesorFiltro) >= 0)
             || (aseKey.length >= 4 && asesorFiltro.indexOf(aseKey) >= 0);
        if (!m) return;
      }
      asesoresSet[ase] = true;
    });

    var DIAS = ['L','M','X','J','V','S','D'];
    var datosPorAsesor = [];
    var totalDia       = { L:0, M:0, X:0, J:0, V:0, S:0, D:0 };

    Object.keys(asesoresSet).sort().forEach(function(ase) {
      var porDia = { L:0, M:0, X:0, J:0, V:0, S:0, D:0 };
      var total  = 0;
      pagosArr.forEach(function(p) {
        if (asesorPorCodigo[p.codigo] !== ase) return;
        if (p.fecha < lunes || p.fecha >= domingo) return;
        var dc = _diaCodigo(p.fecha);
        porDia[dc] = (porDia[dc] || 0) + 1;
        totalDia[dc] = (totalDia[dc] || 0) + 1;
        total++;
      });
      datosPorAsesor.push({ asesor: ase, por_dia: porDia, total: total });
    });

    var totalSemana = 0;
    DIAS.forEach(function(d) { totalSemana += totalDia[d]; });

    var out = {
      ok:               true,
      semana_inicio:    Utilities.formatDate(lunes,   'America/Costa_Rica', 'yyyy-MM-dd'),
      semana_fin:       Utilities.formatDate(new Date(domingo.getTime() - 1), 'America/Costa_Rica', 'yyyy-MM-dd'),
      es_semana_actual: esSemanaActual,
      dias_orden:       DIAS,
      datos_por_asesor: datosPorAsesor,
      total_dia:        totalDia,
      total_semana:     totalSemana
    };

    // ── Tendencia 8 semanas (solo admin con con_tendencia=true) ──
    if (conTendencia) {
      var tendencia = [];
      var lunBase = _inicioSemanaComisiones();  // lunes actual
      for (var w = 7; w >= 0; w--) {  // -7..0, donde 0 = semana actual
        var lunW = new Date(lunBase);
        lunW.setDate(lunBase.getDate() - 7 * w);
        var domW = new Date(lunW);
        domW.setDate(lunW.getDate() + 7);

        var totPorAsesor = {};
        Object.keys(asesoresSet).forEach(function(a) { totPorAsesor[a] = 0; });
        pagosArr.forEach(function(p) {
          if (p.fecha < lunW || p.fecha >= domW) return;
          var ase = asesorPorCodigo[p.codigo];
          if (!ase) return;
          if (asesorFiltro) {
            var aseKey = ase.toUpperCase();
            var m = aseKey === asesorFiltro
                 || (asesorFiltro.length >= 4 && aseKey.indexOf(asesorFiltro) >= 0)
                 || (aseKey.length >= 4 && asesorFiltro.indexOf(aseKey) >= 0);
            if (!m) return;
          }
          if (totPorAsesor[ase] === undefined) totPorAsesor[ase] = 0;
          totPorAsesor[ase]++;
        });

        var totalSem = 0;
        Object.keys(totPorAsesor).forEach(function(a) { totalSem += totPorAsesor[a]; });

        tendencia.push({
          semana_inicio:    Utilities.formatDate(lunW, 'America/Costa_Rica', 'yyyy-MM-dd'),
          total_por_asesor: totPorAsesor,
          total_semana:     totalSem
        });
      }
      out.tendencia_8s = tendencia;
    }

    return out;

  } catch (err) {
