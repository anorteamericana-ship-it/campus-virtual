// v4.37.0 — Fase 3.8: Sistema dinámico de becas
// CRUD admin sobre la hoja CONFIG_BECAS. Las becas viejas (IMPACTA, MUJER)
// quedaron auto-migradas al schema nuevo. generarMatricula ahora lee
// dinámicamente — los porcentajes ya no están hardcoded.
// ════════════════════════════════════════════════════════════════════════════

// ── ENDPOINT: getBecas(params) — versión completa para admin ──
// params:
//   solo_activas:    true → solo ACTIVA='SI'
//   solo_visibles:   true → solo ACTIVA='SI' Y VISIBLE_INSCRIPCION='SI' Y vigente
//   programa:        'INA' | 'SIN_INA' → filtra por compatibilidad
function getBecas(params) {
  params = params || {};
  try {
    var ss = SpreadsheetApp.openById(SHEET_ID);
    var ws = _getOrCreateBecas(ss);
    if (ws.getLastRow() <= 1) return { ok: true, becas: [] };

    var rows = ws.getDataRange().getValues();
    var H = rows[0];
    var idx = {};
    BECAS_HEADERS.forEach(function(name) { idx[name] = H.indexOf(name); });

    var hoy = new Date(); hoy.setHours(0,0,0,0);
    var becas = [];

    for (var i = 1; i < rows.length; i++) {
      var r = rows[i];
      var beca = {};
      BECAS_HEADERS.forEach(function(name) {
        var ix = idx[name];
        var v  = ix >= 0 ? r[ix] : '';
        // Normalizar fechas
        if (v instanceof Date) v = Utilities.formatDate(v, 'America/Costa_Rica', 'yyyy-MM-dd');
        // Normalizar booleanos SI/NO → boolean para frontend
        if (name === 'ACTIVA' || name === 'VISIBLE_INSCRIPCION' ||
            name === 'COMPATIBLE_INA' || name === 'COMPATIBLE_SIN_INA') {
          v = String(v).toUpperCase() === 'SI' || v === true;
        }
        // Normalizar números
        if (name.indexOf('PCT_') === 0 || name === 'CUPO_TOTAL' || name === 'CUPO_USADO') {
          v = parseFloat(v) || 0;
        }
        beca[name.toLowerCase()] = v;
      });

      // Calcular cupos disponibles
      beca.cupo_disponible = Math.max(0, (beca.cupo_total || 0) - (beca.cupo_usado || 0));

      // Vigencia
      beca.vigente = true;
      if (beca.fecha_inicio) {
        var fi = new Date(beca.fecha_inicio);
        if (!isNaN(fi.getTime()) && hoy < fi) beca.vigente = false;
      }
      if (beca.fecha_fin && beca.vigente) {
        var ff = new Date(beca.fecha_fin);
        if (!isNaN(ff.getTime()) && hoy > ff) beca.vigente = false;
      }

      // Filtros
      if (params.solo_activas && !beca.activa) continue;
      if (params.solo_visibles && (!beca.activa || !beca.visible_inscripcion || !beca.vigente)) continue;
      if (params.programa === 'INA' && !beca.compatible_ina) continue;
      if (params.programa === 'SIN_INA' && !beca.compatible_sin_ina) continue;

      becas.push(beca);
    }

    return { ok: true, becas: becas, total: becas.length };

  } catch (err) {
    return { ok: false, error: 'Error en getBecas: ' + err.message };
  }
}

// ── ENDPOINT: crearBeca(body) ────────────────────────────────
// body requeridos:
//   nombre: string (será uppercase, único)
//   pct_matricula, pct_cuota, pct_certificado, pct_titulo: 0-100
//   compatible_ina, compatible_sin_ina: boolean
// body opcionales:
//   descripcion, cupo_total (0=ilimitado), fecha_inicio, fecha_fin,
//   visible_inscripcion (default true), creado_por, notas
function crearBeca(body) {
  if (!body) return { ok: false, error: 'Body vacío' };
  if (!body.nombre) return { ok: false, error: 'Falta nombre' };

  var pcts = ['pct_matricula','pct_cuota','pct_certificado','pct_titulo'];
  for (var i = 0; i < pcts.length; i++) {
    var v = parseFloat(body[pcts[i]]);
    if (isNaN(v) || v < 0 || v > 100) {
      return { ok: false, error: pcts[i] + ' debe estar entre 0 y 100' };
    }
  }

  var lock = LockService.getDocumentLock();
  if (!lock.tryLock(15000)) return { ok: false, error: 'Sistema ocupado' };

  try {
    var ss = SpreadsheetApp.openById(SHEET_ID);
    var ws = _getOrCreateBecas(ss);
    var rows = ws.getDataRange().getValues();
    var H = rows[0];
    var iNom = H.indexOf('NOMBRE');
    var iId  = H.indexOf('ID');

    var nombreUpper = String(body.nombre).trim().toUpperCase();
    var idBeca      = nombreUpper.replace(/[^A-Z0-9]+/g, '_').replace(/^_|_$/g,'');

    // Validar unicidad
    for (var r = 1; r < rows.length; r++) {
      if (String(rows[r][iId]).toUpperCase() === idBeca ||
          String(rows[r][iNom]).toUpperCase() === nombreUpper) {
        return { ok: false, error: 'Ya existe una beca con ese nombre' };
      }
    }

    var ahora = Utilities.formatDate(new Date(), 'America/Costa_Rica', 'yyyy-MM-dd HH:mm:ss');
    var pctMat  = parseFloat(body.pct_matricula);
    var pctCuo  = parseFloat(body.pct_cuota);
    var pctCert = parseFloat(body.pct_certificado);
    var pctTit  = parseFloat(body.pct_titulo);
    var pctRepresentativo = pctMat / 100;  // para compat con código viejo PORCENTAJE 0..1

    var fila = [
      idBeca,
      String(body.nombre).trim(),
      String(body.descripcion || '').trim(),
      pctRepresentativo,
      parseInt(body.cupo_total) || 0,
      0,
      'SI',
      ahora,
      pctMat, pctCuo, pctCert, pctTit,
      body.visible_inscripcion === false ? 'NO' : 'SI',
      body.fecha_inicio || '',
      body.fecha_fin || '',
      body.compatible_ina === false ? 'NO' : 'SI',
      body.compatible_sin_ina === false ? 'NO' : 'SI',
      String(body.creado_por || '').trim(),
      String(body.notas || '').trim()
    ];

    ws.appendRow(fila);
    return { ok: true, id: idBeca, mensaje: 'Beca creada: ' + body.nombre };

  } catch (err) {
    return { ok: false, error: 'Error en crearBeca: ' + err.message };
  } finally {
    lock.releaseLock();
  }
}

// ── ENDPOINT: editarBeca(body) ───────────────────────────────
// body: { id, ...campos_a_modificar }
// No se permite cambiar ID. Si se cambia NOMBRE, debe seguir siendo único.
function editarBeca(body) {
  if (!body || !body.id) return { ok: false, error: 'Falta id' };

  var lock = LockService.getDocumentLock();
  if (!lock.tryLock(15000)) return { ok: false, error: 'Sistema ocupado' };

  try {
    var ss = SpreadsheetApp.openById(SHEET_ID);
    var ws = _getOrCreateBecas(ss);
    var rows = ws.getDataRange().getValues();
    var H = rows[0];
    var idx = {};
    H.forEach(function(h, i) { if (h) idx[String(h).trim()] = i; });

    var targetRow = -1;
    var idBuscado = String(body.id).toUpperCase();
    for (var r = 1; r < rows.length; r++) {
      if (String(rows[r][idx['ID']]).toUpperCase() === idBuscado) { targetRow = r; break; }
    }
    if (targetRow < 0) return { ok: false, error: 'Beca no encontrada: ' + body.id };

    // Si cambia NOMBRE, validar unicidad
    if (body.nombre) {
      var nuevoUpper = String(body.nombre).trim().toUpperCase();
      for (var rr = 1; rr < rows.length; rr++) {
        if (rr === targetRow) continue;
        if (String(rows[rr][idx['NOMBRE']]).toUpperCase() === nuevoUpper) {
          return { ok: false, error: 'Ya existe otra beca con ese nombre' };
        }
      }
    }

    // Mapeo campos del body → headers
    var mapping = {
      nombre:              'NOMBRE',
      descripcion:         'DESCRIPCION',
      cupo_total:          'CUPO_TOTAL',
      activa:              'ACTIVA',
      pct_matricula:       'PCT_MATRICULA',
      pct_cuota:           'PCT_CUOTA',
      pct_certificado:     'PCT_CERTIFICADO',
      pct_titulo:          'PCT_TITULO',
      visible_inscripcion: 'VISIBLE_INSCRIPCION',
      fecha_inicio:        'FECHA_INICIO',
      fecha_fin:           'FECHA_FIN',
      compatible_ina:      'COMPATIBLE_INA',
      compatible_sin_ina:  'COMPATIBLE_SIN_INA',
      notas:               'NOTAS'
    };

    for (var k in mapping) {
      if (!body.hasOwnProperty(k)) continue;
      var col = mapping[k];
      var ix  = idx[col];
      if (ix === undefined) continue;
      var val = body[k];
      // Booleanos → SI/NO
      if (col === 'ACTIVA' || col === 'VISIBLE_INSCRIPCION' ||
          col === 'COMPATIBLE_INA' || col === 'COMPATIBLE_SIN_INA') {
        val = (val === true || String(val).toUpperCase() === 'SI') ? 'SI' : 'NO';
      }
      // PCT_*: validar rango
      if (col.indexOf('PCT_') === 0) {
        var n = parseFloat(val);
        if (isNaN(n) || n < 0 || n > 100) {
          return { ok: false, error: col + ' inválido (0-100)' };
        }
        val = n;
      }
      ws.getRange(targetRow + 1, ix + 1).setValue(val);
    }

    return { ok: true, id: idBuscado, mensaje: 'Beca actualizada' };

  } catch (err) {
    return { ok: false, error: 'Error en editarBeca: ' + err.message };
  } finally {
    lock.releaseLock();
  }
}

// ── ENDPOINT: cambiarBecaActivo({id, activo}) ─────────────────
function cambiarBecaActivo(body) {
  if (!body || !body.id) return { ok: false, error: 'Falta id' };
  return editarBeca({ id: body.id, activa: !!body.activo });
}

// ── ENDPOINT: cambiarBecaVisibilidad({id, visible}) ──────────
function cambiarBecaVisibilidad(body) {
  if (!body || !body.id) return { ok: false, error: 'Falta id' };
  return editarBeca({ id: body.id, visible_inscripcion: !!body.visible });
}

// ── HELPERS v4.40.2: normalización/canonización de becas ───────────────
// Soporta variantes comunes:
//   IMPACTA | BECA_IMPACTA | BECA IMPACTA | Beca Impacta  → misma beca.
function _normalizarClaveBeca_(valor) {
  var s = String(valor || '').trim().toUpperCase();
  try { s = s.normalize('NFD').replace(/[\u0300-\u036f]/g, ''); } catch (e) {}
  s = s.replace(/[_\-]+/g, ' ').replace(/\s+/g, ' ').trim();
  s = s.replace(/^BECA\s+/, '');
  return s.replace(/[^A-Z0-9]/g, '');
}

function _formatearNombreBecaParaDatos_(becaConfig, original) {
  var raw = '';
  if (becaConfig) raw = String(becaConfig.NOMBRE || becaConfig.ID || '').trim();
  if (!raw) raw = String(original || '').trim();
  var up = raw.toUpperCase().replace(/[_\-]+/g, ' ').replace(/\s+/g, ' ').trim();
  if (!up) return '';
  if (up.indexOf('BECA ') !== 0) up = 'BECA ' + up;
  return up;
}

// ── HELPER: buscar beca por nombre/ID de forma flexible ───────────────
// Usado por generarMatricula para obtener los % dinámicos.
function _getBecaPorNombre(ss, nombre) {
  if (!nombre) return null;
  var ws = _getOrCreateBecas(ss);
  if (ws.getLastRow() <= 1) return null;
  var rows = ws.getDataRange().getValues();
  var H = rows[0];
  var idx = {};
  H.forEach(function(h, i) { if (h) idx[String(h).trim()] = i; });

  var buscado = String(nombre).trim().toUpperCase();
  var keyBuscado = _normalizarClaveBeca_(buscado);
  for (var r = 1; r < rows.length; r++) {
    var nomUpper = String(rows[r][idx['NOMBRE']] || '').toUpperCase();
    var idUpper  = String(rows[r][idx['ID']] || '').toUpperCase();
    var keyNom   = _normalizarClaveBeca_(nomUpper);
    var keyId    = _normalizarClaveBeca_(idUpper);

    if (nomUpper === buscado || idUpper === buscado || keyNom === keyBuscado || keyId === keyBuscado) {
      var b = {};
      H.forEach(function(h, i) { if (h) b[String(h).trim()] = rows[r][i]; });
      // Normalizar booleanos
      b.ACTIVA = String(b.ACTIVA).toUpperCase() === 'SI';
      return b;
    }
  }
  return null;
}

