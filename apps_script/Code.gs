    for (var tr = 1; tr < td.length; tr++) {
      var matchDirect = true;
      if (ti.COD_GRUPO != null) matchDirect = String(td[tr][ti.COD_GRUPO] || '').trim() === cod;
      if (matchDirect && ti.NIVEL != null) matchDirect = String(td[tr][ti.NIVEL] || '').trim().toUpperCase() === niv;
      if (matchDirect && ti.LECCION != null) matchDirect = Number(td[tr][ti.LECCION]) === lec;
      var aid2 = ti.ACTIVATION_ID != null ? String(td[tr][ti.ACTIVATION_ID] || '').trim() : '';
