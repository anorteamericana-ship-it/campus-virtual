function _examEnsureSheet_(ss, name, headers) {
  var ws = ss.getSheetByName(name);
  if (!ws) ws = ss.insertSheet(name);
  var lastCol = ws.getLastColumn();
  if (lastCol < 1) {
    ws.getRange(1, 1, 1, headers.length).setValues([headers]);
  } else {
    var current = ws.getRange(1, 1, 1, Math.max(lastCol, 1)).getValues()[0];
    var normalized = {};
    for (var i = 0; i < current.length; i++) {
      var h = _examClean_(current[i]);
      if (h) normalized[h] = true;
    }
    var missing = [];
    for (var j = 0; j < headers.length; j++) {
      if (!normalized[headers[j]]) missing.push(headers[j]);
    }
    if (!current[0]) {
      ws.getRange(1, 1, 1, headers.length).setValues([headers]);
    } else if (missing.length) {
      ws.getRange(1, lastCol + 1, 1, missing.length).setValues([missing]);
    }
  }
  try { ws.setFrozenRows(1); } catch (_) {}
  return ws;
}

function _examHeaderMap_(ws) {
  var lastCol = ws.getLastColumn();
  var row = lastCol ? ws.getRange(1, 1, 1, lastCol).getValues()[0] : [];
  var map = {};
  for (var i = 0; i < row.length; i++) {
    var h = _examClean_(row[i]);
    if (h) map[h] = i;
  }
  return map;
}

function _examRowObj_(headers, row) {
  var o = {};
  for (var i = 0; i < headers.length; i++) o[headers[i]] = row[i];
  return o;
}

function _examAppendObj_(ws, obj) {
  var headers = ws.getRange(1, 1, 1, ws.getLastColumn()).getValues()[0].map(function(h){ return _examClean_(h); });
  var row = [];
  for (var i = 0; i < headers.length; i++) row.push(obj.hasOwnProperty(headers[i]) ? obj[headers[i]] : '');
  ws.appendRow(row);
}

function _examSetupSheetsInternal_(actor) {
  var ss = _examSs_();
  var specs = _examSheetSpecs_();
  var created = [];
  Object.keys(specs).forEach(function(name) {
    var existed = !!ss.getSheetByName(name);
    _examEnsureSheet_(ss, name, specs[name]);
    created.push({ sheet: name, existed: existed });
  });

  var wsCfg = ss.getSheetByName(EXAM_SH.CONFIG);
  var cfgValues = wsCfg.getDataRange().getValues();
  var existing = {};
  for (var i = 1; i < cfgValues.length; i++) existing[_examClean_(cfgValues[i][0])] = true;
  var seed = _examConfigSeed_();
  for (var s = 0; s < seed.length; s++) {
    if (!existing[seed[s][0]]) {
      wsCfg.appendRow([seed[s][0], seed[s][1], seed[s][2], seed[s][3], _examNow_(), actor && actor.id || 'system']);
    }
  }

