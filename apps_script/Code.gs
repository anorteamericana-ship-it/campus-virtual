        var horaIniSolicitada = _ccF84_hora_(sol[i.HORA_ORIGINAL_INICIO]);
        var horaFinSolicitada = _ccF84_hora_(sol[i.HORA_ORIGINAL_FIN]);
        var vigenteIni = vigente.originalInterval ? _ccF84_minHora_(vigente.originalInterval.ini) : '';
        var vigenteFin = vigente.originalInterval ? _ccF84_minHora_(vigente.originalInterval.fin) : '';
        if ((fechaSolicitada && vigente.fechaOriginal !== fechaSolicitada) || (horaIniSolicitada && vigenteIni !== horaIniSolicitada) || (horaFinSolicitada && vigenteFin !== horaFinSolicitada)) {
          return { ok:false, error:'La fecha u horario de la lección cambió desde que se creó la solicitud. Revisá y solicitá de nuevo.', solicitud_sigue:'PENDIENTE' };
        }
        if (tipo === 'REPROGRAMACION') {
          common.fecha_destino = _ccF84_iso_(sol[i.FECHA_DESTINO]);
          common.hora_destino_inicio = _ccF84_hora_(sol[i.HORA_DESTINO_INICIO]);
          common.hora_destino_fin = _ccF84_hora_(sol[i.HORA_DESTINO_FIN]);
