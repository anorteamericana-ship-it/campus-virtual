// ============================================================
// leerDatosEstudiante_CONAPE(ss, codigo)
// Lee DATOS + ESTATUS + PAGOS + OTROS_PAGOS y calcula morosidad
// Retorna objeto con todo lo necesario para las 4 hojas Drive
// ============================================================
function leerDatosEstudiante_CONAPE(ss, codigo) {
  // ── DATOS ──────────────────────────────────────────────
  var wsDatos  = ss.getSheetByName(SH.DATOS);
  var datosR   = wsDatos.getDataRange().getValues();
  var datosH   = datosR[0];
  var iDCod    = datosH.indexOf('CODIGO');
  var iDCed    = datosH.indexOf('NUM_CEDULA');
  var iDNom    = datosH.indexOf('NOMBRE');
  var iDGrp    = datosH.indexOf('GRUPO');
  var iDCuot   = datosH.indexOf('CUOTAS');
  var iDMat2   = datosH.indexOf('MATRICULA');   // costo matrícula (col real en APOLLO)
  var iDCert   = datosH.indexOf('CERTIFICADO'); // costo certificado

  var filaDatos = null;
  for (var i = 1; i < datosR.length; i++) {
    if (String(datosR[i][iDCod] || '').trim() === codigo) {
      filaDatos = datosR[i]; break;
    }
  }
  if (!filaDatos) return null;

  var cedula   = _limpiarCedula(filaDatos[iDCed]); // v4.27.3 — sin guiones
  var nombre   = String(filaDatos[iDNom] || '').trim();
  var grupo    = String(filaDatos[iDGrp] || '').trim();
  var costoMat = parseFloat(filaDatos[iDMat2]) || 0;
  var costoCert= parseFloat(filaDatos[iDCert]) || 0;
  var costoQtA = parseFloat(filaDatos[iDCuot]) || 0; // cuota mensual (colegiatura por cuota)

  // ── ESTATUS ────────────────────────────────────────────
  var wsEst  = ss.getSheetByName(SH.ESTATUS);
  var estR   = wsEst.getDataRange().getValues();
  var estH   = estR[0];
  var iECod  = estH.indexOf('CODIGO');  // col C index
  var iEGrp  = estH.indexOf('GRUPO');
  var iEEst  = estH.indexOf('ESTATUS');
  var iENiv  = estH.indexOf('NIVEL');
  var iENota = estH.indexOf('NOTA');
  var iEPer  = estH.indexOf('PERIODO');   // si existe
  var iETipo = estH.indexOf('TIPO_PERIODO'); // si existe

  // Buscar por REC_M (código)
  if (iECod === -1) iECod = estH.indexOf('REC_M');

  var estatusPorNivel = {}; // { B1: { estatus, nota, grupo, periodo, tipo } }
  for (var j = 1; j < estR.length; j++) {
    var eCod = String(estR[j][iECod] || '').trim();
    if (eCod !== codigo) continue;
    var nivel = String(estR[j][iENiv] || '').trim().toUpperCase();
    estatusPorNivel[nivel] = {
      estatus: String(estR[j][iEEst] || '').trim().toUpperCase(),
      nota:    parseFloat(estR[j][iENota]) || 0,
      grupo:   String(estR[j][iEGrp] || grupo).trim(),
      periodo: iEPer  > -1 ? String(estR[j][iEPer]  || '').trim() : '',
      tipo:    iETipo > -1 ? String(estR[j][iETipo] || 'C').trim().toUpperCase() : 'C',
    };
  }

  // ── GRUPOS: leer periodo y tipo real por nivel ─────────
  var wsGrp = ss.getSheetByName(SH.GRUPOS);
  var grpR  = wsGrp.getDataRange().getValues();
  var grpH  = grpR[0];
  var iGCod = grpH.indexOf('CODIGO_GRUPO');
  var iGNiv = grpH.indexOf('NIVEL_INICIO');
  var iGPer = grpH.indexOf('PERIODO_INICIO');
  var iGAnio= grpH.indexOf('AÑO_INICIO');
  var iGTipo= grpH.indexOf('TIPO_PERIODO');

  // Índice de FECHA_INICIO — fuente de verdad para calcular periodo y año real
  var iGFech = grpH.indexOf('FECHA_INICIO');

  CONAPE_NIVELES.forEach(function(nivel) {
    var ed = estatusPorNivel[nivel];
    var grpEst = (ed ? ed.grupo : null) || grupo;
    for (var k = 1; k < grpR.length; k++) {
      if (String(grpR[k][iGCod] || '').trim() !== grpEst) continue;
      if (String(grpR[k][iGNiv] || '').trim().toUpperCase() !== nivel) continue;
      if (!ed) ed = { estatus: 'PE', nota: 0, grupo: grpEst, periodo: '', tipo: 'C' };

      var tipoP  = String(grpR[k][iGTipo] || 'C').trim().toUpperCase();
      ed.tipo    = tipoP;

      // Calcular periodo y año desde FECHA_INICIO real (no PERIODO_INICIO que puede estar mal)
      var rawF   = iGFech > -1 ? grpR[k][iGFech] : null;
      var dIni   = rawF instanceof Date ? rawF : (rawF ? new Date(String(rawF)) : null);
      if (dIni && !isNaN(dIni.getTime())) {
        ed.anio   = dIni.getFullYear();
        // Número de período dentro del año: cuatrimestre = mes/4+1, bimestre = mes/2+1
        var mes   = dIni.getMonth(); // 0-based
        if (tipoP === 'C') {
          ed.periodo = 'C' + (Math.floor(mes / 4) + 1); // C1=ene-abr, C2=may-ago, C3=sep-dic
        } else {
          ed.periodo = 'B' + (Math.floor(mes / 2) + 1); // B1=ene-feb, B2=mar-abr, ...
        }
      } else {
        // Fallback si no hay FECHA_INICIO
        ed.anio    = parseInt(grpR[k][iGAnio]) || new Date().getFullYear();
        ed.periodo = String(grpR[k][iGPer] || '').trim();
      }
      break;
    }
    if (ed) estatusPorNivel[nivel] = ed;
  });

  // ── PAGOS: SUMIF(PAGOS!C, codigo+grupo+nivel, PAGOS!G) ─
  var wsPagos = ss.getSheetByName(SH.PAGOS);
  var pagosR  = wsPagos.getDataRange().getValues();
  var pagosH  = pagosR[0];
  var iPCod   = pagosH.indexOf('CODIGO');
  var iPGrp   = pagosH.indexOf('GRUPO');
  var iPPago  = pagosH.indexOf('PAGO');
  var iPConc  = pagosH.indexOf('Concepto');

  var pagosPorNivel = { B1: 0, B2: 0, I1: 0, I2: 0 };
  var _RE_CUOTA_NIV = /^CUOTA_(B1|B2|I1|I2)\b/i;
  for (var p = 1; p < pagosR.length; p++) {
    var pCod  = String(pagosR[p][iPCod] || '').trim();
    if (pCod !== codigo) continue;
    var conc  = String(pagosR[p][iPConc] || '').trim();
    // FIX v4.23.5: regex robusta en vez de substring(6,8) posicional.
    // Solo cuenta CUOTA_B1/B2/I1/I2; ignora formatos viejos sin nivel (CUOTA_BAC, etc.)
    var _m = conc.match(_RE_CUOTA_NIV);
    if (_m) {
      var nivConc = _m[1].toUpperCase();
      if (CONAPE_NIVELES.indexOf(nivConc) > -1) {
        pagosPorNivel[nivConc] += parseFloat(pagosR[p][iPPago]) || 0;
      }
    }
  }

  // ── OTROS PAGOS: matrícula y certificado ────────────────
  var wsOtros = ss.getSheetByName(SH.OTROS_PAGOS);
  var otrosR  = wsOtros.getDataRange().getValues();
  var otrosH  = otrosR[0];
  // v4.15: buscar con fallbacks — schema puede variar según si tiene LLAVE en col A
  var iOCod   = otrosH.indexOf('Codigo');
  if (iOCod  === -1) iOCod  = otrosH.indexOf('CODIGO');
  var iONcta  = otrosH.indexOf('ncuenta');
  var iOMonto = otrosH.indexOf('monto');
  if (iOMonto === -1) iOMonto = otrosH.indexOf('MONTO');

  var pagadoMat  = { B1: 0, B2: 0, I1: 0, I2: 0 };
  var pagadoCert = { B1: 0, B2: 0, I1: 0, I2: 0 };

  for (var o = 1; o < otrosR.length; o++) {
    var oCod   = iOCod > -1 ? String(otrosR[o][iOCod] || '').trim() : '';
    if (oCod !== codigo) continue;
    var ncta   = iONcta  > -1 ? (parseInt(otrosR[o][iONcta])   || 0) : 0;
    var monto  = iOMonto > -1 ? (parseFloat(otrosR[o][iOMonto]) || 0) : 0;

    CONAPE_NIVELES.forEach(function(nivel) {
      if (ncta === CONAPE_NCUENTA_MAT[nivel])  pagadoMat[nivel]  += monto;
      if (ncta === CONAPE_NCUENTA_CERT[nivel]) pagadoCert[nivel] += monto;
    });
  }

  // ── Calcular morosidad por nivel ────────────────────────
  // Replica fórmulas S70:S73 exactas de CALENDARIO
  // Z  = matrícula pendiente: costoMat - pagadoMat > 0 → 1, si no → 0
  // AB = cuotas pendientes: cuotasEsperadas - pagadasCuotas > 0 → diferencia, si no → 0
  // AD = cert pendiente: costoCert - pagadoCert > 0 → 1, si no → 0
  // S70 B1: IF(estatus=CNV → NO, IF(Z+AB+AD=0 → NO, SI))
  // S71 B2: IF(estatusB1=CNV → NO, IF(estatus=PE → PE, IF(Z+AB+AD=0 → NO, SI)))
  // S72,73: igual, encadenado al nivel anterior

  function calcMorosidad(nivel, nivelAnterior) {
    var ed        = estatusPorNivel[nivel] || { estatus: 'PE', nota: 0 };
    var estActual = ed.estatus;

    // PE → sin obligación
    if (estActual === 'PE') return 'PE';
    // CNV → exonerado
    if (estActual === 'CNV') return 'NO';
    // Todo lo demás: SI a menos que mat+cuotas+cert estén todos pagados
    var tipoNivel       = (ed.tipo === 'B') ? 'B' : 'C';
    var numCuotas       = tipoNivel === 'C' ? 4 : 2;
    var totalCuotasDebe = costoQtA * numCuotas;
    var totalCuotasPago = pagosPorNivel[nivel];
    var matPagada   = costoMat  <= 0 || pagadoMat[nivel]  >= costoMat;
    var certPagado  = costoCert <= 0 || pagadoCert[nivel] >= costoCert;
    var cuotasAlDia = costoQtA  <= 0 || totalCuotasPago   >= totalCuotasDebe;
    return (matPagada && cuotasAlDia && certPagado) ? 'NO' : 'SI';
  }

  var morosidad = {
    B1: calcMorosidad('B1', null),
    B2: calcMorosidad('B2', 'B1'),
    I1: calcMorosidad('I1', 'B2'),
    I2: calcMorosidad('I2', 'I1'),
  };

  return {
    codigo:          codigo,
    cedula:          cedula,
    nombre:          nombre,
    grupo:           grupo,
    estatusPorNivel: estatusPorNivel,
    pagosPorNivel:   pagosPorNivel,
    pagadoMat:       pagadoMat,
    pagadoCert:      pagadoCert,
    costoMat:        costoMat,
    costoCert:       costoCert,
    costoQtA:        costoQtA,
    morosidad:       morosidad,
  };
}

// ============================================================
// upsertFila_4: hoja 4-estudiantes
// Cols: id | cedula | nombre_completo
// Busca por id (código). Si existe → actualiza. Si no → agrega.
// ============================================================
function upsertFila_4(ws, datos) {
  var rows = ws.getDataRange().getValues();
  for (var i = 1; i < rows.length; i++) {
    if (String(rows[i][0] || '').trim() === datos.codigo) {
      ws.getRange(i + 1, 1, 1, 3).setValues([[datos.codigo, datos.cedula, datos.nombre]]);
      return;
    }
  }
  // No existe → agregar al final
  ws.appendRow([datos.codigo, datos.cedula, datos.nombre]);
}

// ============================================================
// upsertFilas_5: hoja 5-plan_estudios
// Cols: estudiante_id | codigo_sede | codigo_carrera | nombre_grado | numero_bloque | tipo_periodo | codigo_materia | estatus | nota
// Busca por cedula+bloque. Si existe → actualiza solo estatus y nota.
// ============================================================
function upsertFilas_5(ws, datos) {
  var rows = ws.getDataRange().getValues();

  CONAPE_NIVELES.forEach(function(nivel) {
    var ed    = datos.estatusPorNivel[nivel];
    if (!ed) return; // nivel no iniciado aún
    var bloque = CONAPE_BLOQUE[nivel];
    var tipoP  = (ed.tipo === 'B') ? 'B' : 'C';
    var codMat = CONAPE_COD_MATERIA[nivel];
    var estatus = mapearEstatusCONAPE(ed.estatus);
    var nota    = (ed.estatus === 'APR' || ed.estatus === 'REP') ? Math.round(ed.nota) : '';

    // Buscar fila: cedula en col 0 + bloque en col 4
    for (var i = 1; i < rows.length; i++) {
      var rowCed    = String(rows[i][0] || '').trim();
      var rowBloque = parseInt(rows[i][4]) || 0;
      if (rowCed === datos.cedula && rowBloque === bloque) {
        // Actualizar solo estatus (col 7) y nota (col 8) — NO tocar otras cols
        ws.getRange(i + 1, 8, 1, 2).setValues([[estatus, nota]]);
        return;
      }
    }
    // No existe → agregar fila completa
    ws.appendRow([datos.cedula, 'SJ01', 'ING-CONV-IN', 'CURSO IDIOMA',
                  bloque, tipoP, codMat, estatus, nota]);
    // Refrescar referencia local para evitar duplicados en la misma ejecución
    rows.push([datos.cedula, 'SJ01', 'ING-CONV-IN', 'CURSO IDIOMA', bloque, tipoP, codMat, estatus, nota]);
  });
}

// ============================================================
// upsertFilas_6: hoja 6-historial
// Cols: codigo_sede | codigo_carrera | estudiante_id | nombre_grado | codigo_materia | ano | periodo | tipo_periodo | estatus | nota
// Solo se registran niveles COMPLETADOS (APR, REP, RI, RJ)
// Si está CA o PE no se registra en historial todavía
// ============================================================
function upsertFilas_6(ws, datos) {
  // 6-historial = espejo en tiempo real, igual que 5-plan_estudios.
  // 4 filas por estudiante, 1 por nivel. Siempre refleja el estado actual.
  // Busca por cedula (col 2) + codigo_materia (col 4). Actualiza o agrega.
  var rows = ws.getDataRange().getValues();

  CONAPE_NIVELES.forEach(function(nivel) {
    var ed = datos.estatusPorNivel[nivel];
    if (!ed) return; // nivel sin datos aún

    var codMat     = CONAPE_COD_MATERIA[nivel];
    var tipoP      = (ed.tipo === 'B') ? 'B' : 'C';
    var anio       = ed.anio || new Date().getFullYear();
    var periodoNum = calcularNumeroPeriodo(ed.periodo, tipoP);
    var estatus    = mapearEstatusCONAPE(ed.estatus);
    var nota       = (ed.estatus === 'APR' || ed.estatus === 'REP') ? Math.round(ed.nota) : '';

    // Buscar por cedula (col 2) + codigo_materia (col 4)
    for (var i = 1; i < rows.length; i++) {
      var rowCed = String(rows[i][2] || '').trim();
      var rowMat = String(rows[i][4] || '').trim();
      if (rowCed === datos.cedula && rowMat === codMat) {
        // Actualizar cols 6-10: ano, periodo, tipo, estatus, nota
        ws.getRange(i + 1, 6, 1, 5).setValues([[anio, periodoNum, tipoP, estatus, nota]]);
        return;
      }
    }
    // No existe → agregar fila completa
    ws.appendRow(['SJ01', 'ING-CONV-IN', datos.cedula, 'CURSO IDIOMA',
                  codMat, anio, periodoNum, tipoP, estatus, nota]);
    rows.push(['SJ01', 'ING-CONV-IN', datos.cedula, 'CURSO IDIOMA',
               codMat, anio, periodoNum, tipoP, estatus, nota]);
  });
}

// ============================================================
// upsertFilas_7: hoja 7-morosidad
// Cols: codigo_sede | estudiante_id | ano | periodo | estado
// Una fila por nivel activo. Actualiza estado SI/NO/PE
// ============================================================
function upsertFilas_7(ws, datos) {
  var rows = ws.getDataRange().getValues();

  CONAPE_NIVELES.forEach(function(nivel) {
    var ed = datos.estatusPorNivel[nivel];
    if (!ed) return;
    // Solo registrar niveles que ya empezaron (no PE sin historial)
    if (ed.estatus === 'PE' && datos.morosidad[nivel] === 'PE') return;

    var anio       = ed.anio || new Date().getFullYear();
    var tipoP      = (ed.tipo === 'B') ? 'B' : 'C';
    var periodoNum = calcularNumeroPeriodo(ed.periodo, tipoP);
    var estado     = datos.morosidad[nivel]; // 'SI', 'NO', o 'PE'

    // Buscar por cedula (col 1) + año (col 2) + periodo (col 3)
    for (var i = 1; i < rows.length; i++) {
      var rowCed = String(rows[i][1] || '').trim();
      var rowAnio= parseInt(rows[i][2]) || 0;
      var rowPer = parseInt(rows[i][3]) || 0;
      if (rowCed === datos.cedula && rowAnio === anio && rowPer === periodoNum) {
        // Actualizar solo estado (col 4)
        ws.getRange(i + 1, 5, 1, 1).setValue(estado);
        return;
      }
    }
    // No existe → agregar
    ws.appendRow(['SJ01', datos.cedula, anio, periodoNum, estado]);
    rows.push(['SJ01', datos.cedula, anio, periodoNum, estado]);
  });
}

// ============================================================
// Helpers CONAPE
// ============================================================

// Mapear estatus interno → código CONAPE (APR, RI, RJ, CA, PE)
function mapearEstatusCONAPE(est) {
  switch (String(est || '').toUpperCase()) {
    case 'APR': return 'APR';
    case 'REP': return 'REP';
    case 'RI':  return 'RI';
    case 'RJ':  return 'RJ';
    case 'CNV': return 'CNV';
    case 'CA':  return 'CA';
    case 'PE':  return 'PE';
    default:    return 'PE';
  }
}

// Calcular número de periodo para 6-historial y 7-morosidad
// C1=1,C2=2,C3=3 / B1=1..B6=6
function calcularNumeroPeriodo(periodoCode, tipo) {
  var p = String(periodoCode || '').toUpperCase().trim();
  if (!p) return 1;
  // Quitar la letra del tipo si viene incluida (C1 → 1, B3 → 3)
  var num = parseInt(p.replace(/[^0-9]/g, ''));
  return isNaN(num) ? 1 : num;
}


// ============================================================
// getEstadoConape(cedula)                           — v4.3
// GET ?fn=getEstadoConape&cedula=117370599
//
// Para el dashboard del estudiante — su estado CONAPE actual
// ============================================================
function getEstadoConape(cedula) {
  if (!cedula) return { ok: false, error: 'cedula requerida' };

  var ss = SpreadsheetApp.openById(SHEET_ID);
  var ws = ss.getSheetByName('CONAPE_SYNC');
  if (!ws) return { ok: false, error: 'CONAPE_SYNC no inicializada. Ejecutar sincronizarCONAPE primero.' };

  var rows = ws.getDataRange().getValues();
  var h    = rows[0];
  var cedLimpia = _limpiarCedula(cedula); // v4.27.3

  for (var i = 1; i < rows.length; i++) {
    var ced = _limpiarCedula(rows[i][h.indexOf('CEDULA')]); // v4.27.3
    if (ced === cedLimpia) {
      var obj = {};
      h.forEach(function(col, j) { obj[col] = rows[i][j]; });

      // Interpretar estado para el dashboard
      var numDes = String(obj.NUM_DESEMBOLSO || '').trim();
      var mes    = String(obj.PERIODO_MES    || '').trim();
      var anio   = String(obj.PERIODO_ANIO   || '').trim();

      var mesesNombres = {
        '01':'Enero','03':'Marzo','05':'Mayo',
        '07':'Julio','09':'Setiembre','11':'Noviembre'
      };

      var estadoTexto = 'Aprobado — pendiente primer desembolso';
      var desembolsoTexto = '';

      if (numDes) {
        estadoTexto    = 'Al día — desembolso ' + numDes + ' recibido';
        desembolsoTexto = 'Desembolso ' + numDes + ' · ' + (mesesNombres[mes] || mes) + ' ' + anio;
      }

      return {
        ok:              true,
        cedula:          ced,
        nombre:          obj.NOMBRE,
        estadoTexto:     estadoTexto,
        desembolsoTexto: desembolsoTexto,
        numDesembolso:   numDes,
        periodoMes:      mes,
        periodoAnio:     anio,
        ultimoSync:      obj.ULTIMO_SYNC,
        vinculado:       obj.ESTADO_CAMPUS === 'VINCULADO',
      };
    }
  }

  return { ok: false, error: 'No encontrado en lista CONAPE', cedula: cedLimpia };
}

// ============================================================
// getMiEstadoCONAPE(params)                         — v4.24.0
// GET ?fn=getMiEstadoCONAPE&cedula=117370599
//
// Devuelve el panorama completo del prospecto para el dashboard
// de limbo del estudiante. Combina PROSPECTOS (etapa + fechas)
// y CONAPE_SYNC (info real de desembolsos).
//
// Returns:
//   {
//     ok, cedula, nombre,
//     financiamiento, programa, modalidad, grupo_tentativo,
//     etapa_actual,         // string ('LEAD'..'ACTIVO')
//     etapa_idx,            // 0..6 (índice en la timeline)
//     etapas: [             // las 7 etapas del proceso, con timestamps
//       { id, label, completada, fecha, es_actual }
//     ],
//     proximo_paso,         // texto descriptivo para mostrar al cliente
//     asesor,               // nombre del asesor que lo atendió
//     conape: {             // null si no aparece todavía en CONAPE_SYNC
//        vinculado, numDesembolso, periodoMes, periodoAnio, estadoTexto
//     }
//   }
// ============================================================
function getMiEstadoCONAPE(params) {
  var ced = String((params && params.cedula) || '').replace(/[-\s]/g,'').trim();
  if (!ced) return { ok: false, error: 'cedula requerida' };

  var ss = SpreadsheetApp.openById(SHEET_ID);
  var wsP = ss.getSheetByName('PROSPECTOS');
  if (!wsP) return { ok: false, error: 'PROSPECTOS no existe' };

  var rows = wsP.getDataRange().getValues();
  if (rows.length <= 1) return { ok: false, error: 'PROSPECTOS vacío' };

  var h = rows[0];
  var get = function(rowIdx, col) {
    var i = h.indexOf(col);
    return i >= 0 ? rows[rowIdx][i] : '';
  };

  // Encontrar fila del prospecto
  var iCed = h.indexOf('CEDULA');
  if (iCed < 0) return { ok: false, error: 'PROSPECTOS sin columna CEDULA' };

  var idxFila = -1;
  for (var i = 1; i < rows.length; i++) {
    var c = String(rows[i][iCed] || '').replace(/[-\s]/g,'').trim();
    if (c === ced) { idxFila = i; break; }
  }
  if (idxFila < 0) return { ok: false, error: 'No sos prospecto registrado', cedula: ced };

  var financiamiento = String(get(idxFila, 'FINANCIAMIENTO') || '').toUpperCase().trim();
  var etapaActual = String(get(idxFila, 'ETAPA') || 'LEAD').trim();

  // Construir timeline de 7 etapas. Para no-CONAPE, omitimos las etapas CONAPE.
  var esCONAPE = financiamiento === 'CONAPE';
  var pasosDef;
  if (esCONAPE) {
    pasosDef = [
      { id:'LEAD',              label:'Formulario recibido',     col:'F_LEAD' },
      { id:'CONAPE_SOLICITUD',  label:'Solicitud CONAPE',        col:'F_SOLICITUD' },
      { id:'CONAPE_DOCUMENTOS', label:'Documentos firmados',     col:'F_DOCUMENTOS' },
      { id:'CONAPE_APROBADO',   label:'Aprobado por CONAPE',     col:'F_APROBADO' },
      { id:'CONAPE_DESEMBOLSO', label:'Primer desembolso',       col:'F_DESEMBOLSO' },
      { id:'PAGO_ACADEMIA',     label:'Pago a la academia',      col:'F_PAGO_ACADEMIA' },
      { id:'ACTIVO',            label:'Activo en grupo',         col:'F_ACTIVO' },
    ];
  } else {
    pasosDef = [
      { id:'LEAD',          label:'Formulario recibido',     col:'F_LEAD' },
      { id:'PAGO_ACADEMIA', label:'Pago a la academia',      col:'F_PAGO_ACADEMIA' },
      { id:'ACTIVO',        label:'Activo en grupo',         col:'F_ACTIVO' },
    ];
  }

  var etapaIdx = -1;
  for (var k = 0; k < pasosDef.length; k++) {
    if (pasosDef[k].id === etapaActual) { etapaIdx = k; break; }
  }
  // Si la etapa actual no está en la lista (ej. CANCELADO), trato como 0
  if (etapaIdx < 0) etapaIdx = 0;

  var etapas = pasosDef.map(function(p, idx) {
    var fechaRaw = get(idxFila, p.col);
    var fechaTxt = '';
    if (fechaRaw instanceof Date && !isNaN(fechaRaw.getTime())) {
      fechaTxt = Utilities.formatDate(fechaRaw, 'America/Costa_Rica', 'dd/MM/yyyy HH:mm');
    } else if (fechaRaw) {
      fechaTxt = String(fechaRaw);
    }
    return {
      id:         p.id,
      label:      p.label,
      completada: idx < etapaIdx || (idx === etapaIdx && etapaActual === 'ACTIVO'),
      es_actual:  idx === etapaIdx && etapaActual !== 'CANCELADO',
      fecha:      fechaTxt
    };
  });

  // Próximo paso textual
  var proximoPaso = '';
  if (etapaActual === 'CANCELADO') {
    proximoPaso = 'Tu inscripción fue cancelada. Contactá a tu asesor para más información.';
  } else if (etapaActual === 'ACTIVO') {
    proximoPaso = '¡Listo! Ya estás activo en tu grupo. Revisá tu calendario y lecciones.';
  } else {
    var sig = pasosDef[etapaIdx + 1];
    if (sig) {
      var mapMsg = {
        'CONAPE_SOLICITUD':  'Llená la solicitud CONAPE en línea. Tu asesor te enviará el link.',
        'CONAPE_DOCUMENTOS': 'Firmá y entregá los documentos solicitados por CONAPE.',
        'CONAPE_APROBADO':   'CONAPE está revisando tu solicitud. Recibirás respuesta en ~15 días hábiles.',
        'CONAPE_DESEMBOLSO': 'Esperando el primer desembolso de CONAPE. Te notificamos cuando se acredite.',
        'PAGO_ACADEMIA':     'Realizá el pago de matrícula a la academia para confirmar tu cupo.',
        'ACTIVO':            'Tu cuenta será activada en cuanto se confirme tu pago.'
      };
      proximoPaso = mapMsg[sig.id] || ('Próximo paso: ' + sig.label);
    } else {
      proximoPaso = 'Esperando activación final.';
    }
  }

  // Datos de CONAPE_SYNC (si existe la fila)
  var conape = null;
  var conapeRes = getEstadoConape(ced);
  if (conapeRes && conapeRes.ok) {
    conape = {
      vinculado:       !!conapeRes.vinculado,
      numDesembolso:   conapeRes.numDesembolso || '',
      periodoMes:      conapeRes.periodoMes    || '',
      periodoAnio:     conapeRes.periodoAnio   || '',
      estadoTexto:     conapeRes.estadoTexto   || '',
      desembolsoTexto: conapeRes.desembolsoTexto || '',
      ultimoSync:      conapeRes.ultimoSync    || ''
    };
  }

  return {
    ok: true,
    cedula:           ced,
    nombre:           String(get(idxFila, 'NOMBRE') || '').trim(),
    correo:           String(get(idxFila, 'CORREO') || '').trim(),
    whatsapp:         String(get(idxFila, 'WHATSAPP') || '').trim(),
    financiamiento:   financiamiento,
    programa:         String(get(idxFila, 'PROGRAMA') || '').trim(),
    modalidad:        String(get(idxFila, 'MODALIDAD') || '').trim(),
    grupo_tentativo:  String(get(idxFila, 'GRUPO_TENTATIVO') || '').trim(),
    asesor:           String(get(idxFila, 'ASESOR_REF') || '').trim(),
    etapa_actual:     etapaActual,
    etapa_idx:        etapaIdx,
    etapas:           etapas,
    proximo_paso:     proximoPaso,
    conape:           conape,
    es_conape:        esCONAPE,
    estado_cuenta:    String(get(idxFila, 'ESTADO') || '').trim()
  };
}

// ============================================================
// marcarEtapaProspecto(body)                         — v4.24.0
// POST ?fn=marcarEtapaProspecto
//
// Permite a admin/superadmin/ventas marcar manualmente una etapa
// del prospecto. Útil para etapas que no se detectan automáticamente
// (CONAPE_SOLICITUD, CONAPE_DOCUMENTOS, PAGO_ACADEMIA, CANCELADO).
//
// Body: {
//   cedula,            // requerido
//   etapa,             // requerido — debe estar en PROSPECTO_ETAPAS
//   fecha,             // opcional, default = ahora
//   nota,              // opcional, se appendea a NOTAS
//   solicitante,       // requerido — cédula de quien hace el cambio
//   rol                // requerido — 'admin' | 'superadmin' | 'ventas'
// }
//
// Returns: { ok, cedula, etapa_anterior, etapa_nueva, fecha }
// ============================================================
function marcarEtapaProspecto(body) {
  if (!body || !body.cedula || !body.etapa) {
    return { ok: false, error: 'cedula y etapa son requeridos' };
  }
  // Validar permisos
  var rol = String(body.rol || '').toLowerCase().trim();
  if (['admin','superadmin','ventas'].indexOf(rol) < 0) {
    return { ok: false, error: 'rol_no_autorizado', mensaje: 'Solo admin, superadmin o ventas pueden marcar etapas.' };
  }
  // Validar etapa
  var etapaNueva = String(body.etapa).trim().toUpperCase();
  if (PROSPECTO_ETAPAS.indexOf(etapaNueva) < 0) {
    return { ok: false, error: 'etapa_invalida', mensaje: 'Etapa no reconocida: ' + etapaNueva, validas: PROSPECTO_ETAPAS };
  }

  var ced = String(body.cedula).replace(/[-\s]/g,'').trim();
  var ss = SpreadsheetApp.openById(SHEET_ID);
  var wsP = ss.getSheetByName('PROSPECTOS');
  if (!wsP) return { ok: false, error: 'PROSPECTOS no existe' };

  var rows = wsP.getDataRange().getValues();
  if (rows.length <= 1) return { ok: false, error: 'PROSPECTOS vacío' };

  var h = rows[0];
  var iCed   = h.indexOf('CEDULA');
  var iEtapa = h.indexOf('ETAPA');
  var iNotas = h.indexOf('NOTAS');
  if (iCed < 0 || iEtapa < 0) {
    return { ok: false, error: 'PROSPECTOS sin columnas requeridas (CEDULA, ETAPA). Reiniciá getOrCreateProspectos.' };
  }

  // Encontrar fila
  var filaNum = -1;
  var etapaAnt = '';
  for (var i = 1; i < rows.length; i++) {
    var c = String(rows[i][iCed] || '').replace(/[-\s]/g,'').trim();
    if (c === ced) {
      filaNum = i + 1;
      etapaAnt = String(rows[i][iEtapa] || '').trim();
      break;
    }
  }
  if (filaNum < 0) return { ok: false, error: 'Prospecto no encontrado: ' + ced };

  // Determinar fecha
  var fechaTxt;
  if (body.fecha) {
    fechaTxt = String(body.fecha).trim();
  } else {
    fechaTxt = Utilities.formatDate(new Date(), 'America/Costa_Rica', 'yyyy-MM-dd HH:mm:ss');
  }

  // Update ETAPA
  wsP.getRange(filaNum, iEtapa + 1).setValue(etapaNueva);

  // Update F_<etapa> si aplica (CANCELADO no tiene fecha propia)
  var colFecha = PROSPECTO_ETAPA_A_FECHA[etapaNueva];
  if (colFecha) {
    var iF = h.indexOf(colFecha);
    if (iF >= 0) {
      // Solo llenar si la celda está vacía (preservar primera marca)
      var actual = wsP.getRange(filaNum, iF + 1).getValue();
      if (!actual) {
        wsP.getRange(filaNum, iF + 1).setValue(fechaTxt);
      }
    }
  }

  // Append a NOTAS
  if (iNotas >= 0) {
    var notaPrev = String(rows[filaNum - 1][iNotas] || '').trim();
    var solicitante = String(body.solicitante || '').trim() || '?';
    var notaExtra = body.nota ? (' — ' + String(body.nota).trim()) : '';
    var linea = '[' + fechaTxt + '] ' + rol + ' ' + solicitante +
                ' marcó etapa ' + (etapaAnt || '∅') + ' → ' + etapaNueva + notaExtra;
    var nuevaNota = notaPrev ? (notaPrev + '\n' + linea) : linea;
    wsP.getRange(filaNum, iNotas + 1).setValue(nuevaNota);
  }

  return {
    ok: true,
    cedula:         ced,
    etapa_anterior: etapaAnt,
    etapa_nueva:    etapaNueva,
    fecha:          fechaTxt
  };
}

// ============================================================
// Trigger automático — instalar con installConapeSync()
// Corre cada 6 horas automáticamente
// ============================================================
function installConapeSync() {
  // Eliminar triggers existentes del mismo nombre
  ScriptApp.getProjectTriggers().forEach(function(t) {
    if (t.getHandlerFunction() === 'sincronizarCONAPE') {
      ScriptApp.deleteTrigger(t);
    }
  });
  // Crear trigger cada 6 horas
  ScriptApp.newTrigger('sincronizarCONAPE')
    .timeBased()
    .everyHours(6)
    .create();
  return 'Trigger instalado: sincronizarCONAPE cada 6 horas.';
}

// ============================================================
// getNovedadesConape()                              — v4.4
// GET ?fn=getNovedadesConape
//
// Lee CONAPE_SYNC y devuelve resumen + novedades recientes
// para el panel del admin.
// ============================================================
function getNovedadesConape() {
  var ss = SpreadsheetApp.openById(SHEET_ID);
  var ws = ss.getSheetByName('CONAPE_SYNC');

  if (!ws) {
    return {
      ok: true,
      ultimoSync: null,
      total: 0,
      sinVincular: 0,
      sinDesembolso: 0,
      novedades: [],
      mensaje: 'CONAPE_SYNC no inicializada. Ejecutar sincronizarCONAPE primero.',
    };
  }

  var rows = ws.getDataRange().getValues();
  if (rows.length <= 1) {
    return { ok: true, ultimoSync: null, total: 0, sinVincular: 0, sinDesembolso: 0, novedades: [] };
  }

  var h = rows[0];
  var iCed    = h.indexOf('CEDULA');
  var iNom    = h.indexOf('NOMBRE');
  var iNum    = h.indexOf('NUM_DESEMBOLSO');
  var iMes    = h.indexOf('PERIODO_MES');
  var iAnio   = h.indexOf('PERIODO_ANIO');
  var iGrp    = h.indexOf('GRUPO');
  var iCod    = h.indexOf('CODIGO_EST');
  var iEst    = h.indexOf('ESTADO_CAMPUS');
  var iSync   = h.indexOf('ULTIMO_SYNC');
  var iNov    = h.indexOf('NOVEDAD');

  var total        = 0;
  var sinVincular  = 0;
  var sinDesembolso = 0;
  var ultimoSync   = null;
  var novedades    = [];

  // Novedades = últimas 48 horas
  var hace48h = new Date();
  hace48h.setHours(hace48h.getHours() - 48);

  for (var i = 1; i < rows.length; i++) {
    var r = rows[i];
    total++;

    var estadoCampus = String(r[iEst] || '').trim();
    var numDes       = String(r[iNum] || '').trim();
    var novedad      = String(r[iNov] || '').trim();
    var syncStr      = String(r[iSync] || '').trim();

    if (estadoCampus === 'SIN_VINCULAR') sinVincular++;
    if (!numDes) sinDesembolso++;

    // Último sync global
    if (syncStr && (!ultimoSync || syncStr > ultimoSync)) ultimoSync = syncStr;

    // Novedades recientes
    if (novedad && novedad !== '' &&
        novedad !== 'APROBADO_SIN_DESEMBOLSO' &&
        syncStr >= Utilities.formatDate(hace48h, 'America/Costa_Rica', 'yyyy-MM-dd HH:mm:ss')) {

      var mes  = String(r[iMes]  || '').trim();
      var anio = String(r[iAnio] || '').trim();
      var mesesNombres = {
        '01':'Ene','02':'Feb','03':'Mar','04':'Abr','05':'May','06':'Jun',
        '07':'Jul','08':'Ago','09':'Set','10':'Oct','11':'Nov','12':'Dic'
      };

      novedades.push({
        cedula:     String(r[iCed] || '').trim(),
        nombre:     String(r[iNom] || '').trim(),
        grupo:      String(r[iGrp] || '').trim(),
        codigo:     String(r[iCod] || '').trim(),
        novedad:    novedad,
        desembolso: numDes,
        periodo:    (mesesNombres[mes] || mes) + ' ' + anio,
        sync:       syncStr,
      });
    }
  }

  // Ordenar novedades más recientes primero
  novedades.sort(function(a, b) { return b.sync > a.sync ? 1 : -1; });

  return {
    ok:           true,
    ultimoSync:   ultimoSync,
    total:        total,
    sinVincular:  sinVincular,
    sinDesembolso: sinDesembolso,
    novedades:    novedades,
  };
}

