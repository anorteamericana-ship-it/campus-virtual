    var s = validarSesion(token);
    return s && s.ok === true ? s : null;
  } catch (_) { return null; }
}

function _ccF85_actor_(body, fallback) {
  var ses = _ccF85_sesion_(body);
  if (ses) return String(ses.nombre || ses.usuario || ses.cedula || ses.codigo || fallback || 'SISTEMA').trim();
  return String(fallback || 'SISTEMA').trim();
}

function _ccF85_bool_(v) {
  return v === true || String(v == null ? '' : v).trim().toUpperCase() === 'TRUE' || String(v).trim() === '1';
}

function _ccF85_estadoNormalizado_(v) {
  var e = String(v || '').trim().toUpperCase();
  if (e === 'APROBADA') return 'APLICADA';
  if (e === 'DENEGADA') return 'RECHAZADA';
