// ============================================================
// sincronizarESTATUS_faltantes()
// Lee DATOS y GRUPOS, detecta estudiantes sin fila en ESTATUS,
// y crea las filas faltantes con estatus PE (proyectado) por defecto.
// Seguro de correr múltiples veces — no duplica filas existentes.
// Llamar manualmente o desde el campus con fn=sincronizarESTATUS_faltantes
// ============================================================
function sincronizarESTATUS_faltantes() {
  try {
    var ss       = SpreadsheetApp.openById(SHEET_ID);
    var wsDatos  = ss.getSheetByName(SH.DATOS);
    var wsEstatus= ss.getSheetByName(SH.ESTATUS);
    var wsGrupos = ss.getSheetByName(SH.GRUPOS);

    var datosRows  = wsDatos.getDataRange().getValues();
    var datosH     = datosRows[0];
    var iDCod      = datosH.indexOf('CODIGO');
    var iDGrupo    = datosH.indexOf('GRUPO');
    var iDNombre   = datosH.indexOf('NOMBRE');

    var estRows    = wsEstatus.getDataRange().getValues();
    var estH       = estRows[0];
    var iECod      = estH.indexOf('CODIGO');
    var iENiv      = estH.indexOf('NIVEL');
    var iEGrp      = estH.indexOf('GRUPO');
    var iEEst      = estH.indexOf('ESTATUS');
    var iELlave    = estH.indexOf('LLAVE');
    var iENota     = estH.indexOf('NOTA');
    var iEFecha    = estH.indexOf('FECHA DE MODIFICION');

    // Leer GRUPOS para saber el nivel de inicio por grupo
    var grpRows = wsGrupos.getDataRange().getValues();
    var grpH    = grpRows[0];
    var iGCod   = grpH.indexOf('CODIGO_GRUPO');
    var iGNiv   = grpH.indexOf('NIVEL_INICIO');

    // Mapa grupo → nivel de inicio (primera fila del grupo = nivel más bajo)
    var grupoNivelMap = {};
    for (var g = 1; g < grpRows.length; g++) {
      var gc = String(grpRows[g][iGCod] || '').trim();
      var gn = String(grpRows[g][iGNiv] || '').trim().toUpperCase();
      if (gc && gn && !grupoNivelMap[gc]) {
        grupoNivelMap[gc] = gn; // primer nivel encontrado = nivel de inicio
      }
    }

    // Construir set de (codigo + nivel) que ya existen en ESTATUS
    var existentes = {};
    for (var e = 1; e < estRows.length; e++) {
      var eCod = String(estRows[e][iECod] || '').trim();
      var eNiv = String(estRows[e][iENiv] || '').trim().toUpperCase();
      if (eCod && eNiv) existentes[eCod + '|' + eNiv] = true;
    }

    // Revisar cada estudiante en DATOS
    var agregados = [];
    var hoy = new Date();

    for (var d = 1; d < datosRows.length; d++) {
      var cod    = String(datosRows[d][iDCod]   || '').trim();
      var grupo  = String(datosRows[d][iDGrupo] || '').trim();
      var nombre = String(datosRows[d][iDNombre]|| '').trim();
      if (!cod || !grupo) continue;

      // Determinar nivel de inicio del grupo
      var nivelInicio = grupoNivelMap[grupo] || 'B1';

      // Verificar si ya tiene fila en ESTATUS para ese nivel
      var key = cod + '|' + nivelInicio;
      if (existentes[key]) continue; // ya existe, saltar

      // Crear fila nueva con PE (proyectado)
      var llave = cod + grupo + nivelInicio;
      var nuevaFila = new Array(estH.length).fill('');
      if (iELlave  > -1) nuevaFila[iELlave]  = llave;
      if (iECod    > -1) nuevaFila[iECod]    = cod;
      if (iENiv    > -1) nuevaFila[iENiv]    = nivelInicio;
      if (iEGrp    > -1) nuevaFila[iEGrp]    = grupo;
      if (iEEst    > -1) nuevaFila[iEEst]    = 'CA'; // CA porque ya están matriculados
      if (iENota   > -1) nuevaFila[iENota]   = 0;
      if (iEFecha  > -1) nuevaFila[iEFecha]  = hoy;

      wsEstatus.appendRow(nuevaFila);
      existentes[key] = true; // evitar duplicar en la misma corrida
      agregados.push({ codigo: cod, nombre: nombre, grupo: grupo, nivel: nivelInicio });

      // Sincronizar CONAPE para este estudiante también
      try { sincronizarCONAPE_estudiante(cod); } catch(eC) {}
    }

    return {
      ok: true,
      agregados: agregados.length,
      detalle: agregados,
      mensaje: agregados.length === 0
        ? 'Todos los estudiantes ya tienen fila en ESTATUS'
        : 'Se crearon ' + agregados.length + ' filas faltantes en ESTATUS'
    };
  } catch(err) {
    return { ok: false, error: err.toString() };
  }
}

