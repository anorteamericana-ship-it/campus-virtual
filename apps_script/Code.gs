  if (iN != null && String(row[iN] || '').trim().toUpperCase() !== niv) return false;
  if (iL != null && Number(row[iL]) !== Number(lec)) return false;
  return iG != null || iL != null;
}

function _ccF85_validarActividad_(ctx, targetOverride) {
  var target = targetOverride || ctx.target;
  var row = target.values;
  var idx = ctx.idx;
  if (idx.ASISTENCIA_REGISTRADA != null && _ccF85_bool_(row[idx.ASISTENCIA_REGISTRADA])) {
    return { ok:false, error:'La lección ya tiene asistencia registrada y no se puede mover.' };
  }

