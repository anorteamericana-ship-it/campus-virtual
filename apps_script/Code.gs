      if (String(g || '').trim() !== cod) continue;
      if (ai.NIVEL != null && String(ad[ar][ai.NIVEL] || '').trim().toUpperCase() !== niv) continue;
      if (ai.LECCION != null && Number(ad[ar][ai.LECCION]) !== lec) continue;
