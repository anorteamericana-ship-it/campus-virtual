function testGenerarProforma() {
  var resultado = generarProformaProspecto({ cedula: '112540973' });
  Logger.log(JSON.stringify(resultado, null, 2));
}

function activarEstudiante(body) {
  if (!body.cedula || !body.grupo) {
    return { ok: false, error: 'Faltan: cedula, grupo' };
  }

  var lock = LockService.getDocumentLock();
  if (!lock.tryLock(30000)) return { ok: false, error: 'Sistema ocupado, intentá de nuevo' };

  try {
    var ss        = SpreadsheetApp.openById(SHEET_ID);
    var cedLimpia = String(body.cedula).replace(/[-\s]/g,'').trim();
    var grupo     = String(body.grupo).trim();
    var asesor    = String(body.asesor || '').trim();
    var ahora     = Utilities.formatDate(new Date(), 'America/Costa_Rica', 'yyyy-MM-dd HH:mm:ss');
    var hoy       = Utilities.formatDate(new Date(), 'America/Costa_Rica', 'yyyy-MM-dd');

    // ── 1. Leer PROSPECTOS para obtener data completa ──────────
    var wsP    = ss.getSheetByName('PROSPECTOS');
    if (!wsP) return { ok: false, error: 'Hoja PROSPECTOS no encontrada' };
    var pRows  = wsP.getDataRange().getValues();
    var pH     = pRows[0];
    var iPCed  = pH.indexOf('CEDULA');
    var filaP  = -1;
    var prospecto = null;

    for (var i = 1; i < pRows.length; i++) {
      if (String(pRows[i][iPCed]).replace(/[-\s]/g,'').trim() === cedLimpia) {
        filaP = i + 1;
        prospecto = {};
        for (var j = 0; j < pH.length; j++) prospecto[pH[j]] = pRows[i][j];
        break;
      }
    }
    if (filaP === -1) return { ok: false, error: 'Prospecto no encontrado: ' + cedLimpia };

    // Validar que el grupo elegido coincida con el programa del prospecto
    var financiamiento = String(prospecto.FINANCIAMIENTO || '').trim().toUpperCase();
    var programa       = String(prospecto.PROGRAMA       || '').trim().toUpperCase();

    // ── 2. Generar consecutivo si no viene ─────────────────────
    var codigoEst = String(body.codigo_est || '').trim();
    if (!codigoEst) codigoEst = _generarConsecutivoEstudiante(ss);

    // Verificar que no exista ya en DATOS
    var wsDatos    = ss.getSheetByName(SH.DATOS);
    var datosRows  = wsDatos.getDataRange().getValues();
    var dH         = datosRows[0];
    var iDCodigo   = dH.indexOf('CODIGO');
    var iDCedula   = dH.indexOf('CEDULA');
    for (var i = 1; i < datosRows.length; i++) {
      if (String(datosRows[i][iDCodigo]).trim() === codigoEst) {
        return { ok: false, error: 'Código ' + codigoEst + ' ya existe en DATOS' };
      }
      if (String(datosRows[i][iDCedula]).replace(/[-\s]/g,'').trim() === cedLimpia) {
        return { ok: false, error: 'Cédula ' + cedLimpia + ' ya está en DATOS como estudiante activo' };
      }
    }

    // ── 3. Crear fila en USUARIOS ──────────────────────────────
    // v4.29.0: la fila NO existe todavía (crearUsuarioEstudiante ya no
    // escribe acá). Hacemos INSERT con todos los campos correctos,
    // leyendo la clave que el usuario eligió desde PROSPECTOS.CLAVE.
    var wsU     = ss.getSheetByName(SH.USUARIOS);
    if (!wsU) return { ok: false, error: 'Hoja USUARIOS no encontrada' };
    var usuRows = wsU.getDataRange().getValues();
    var usuH    = usuRows[0];

    // Por las dudas, verificar que no exista ya (race condition)
    var iUUser = -1;
    for (var k = 0; k < usuH.length; k++) {
      if (String(usuH[k]).trim().toLowerCase() === 'usuario') { iUUser = k; break; }
    }
    if (iUUser >= 0) {
      for (var i = 1; i < usuRows.length; i++) {
        var u = String(usuRows[i][iUUser] || '').replace(/[-\s]/g,'').trim();
        if (u === cedLimpia) {
          return { ok: false, error: 'Ya existe una cuenta en USUARIOS con cédula ' + cedLimpia };
        }
      }
    }

    // Helper case-insensitive para soportar columnas en minúscula o mayúscula
    function _setU(arr, header, colName, val) {
      var target = String(colName).trim().toLowerCase();
      for (var z = 0; z < header.length; z++) {
        if (String(header[z]).trim().toLowerCase() === target) { arr[z] = val; return; }
      }
    }

    var clavePropuesta = String(prospecto.CLAVE || '').trim();
    if (!clavePropuesta) {
      // Fallback: si el prospecto no trae clave (caso legacy), generamos una random
      // y el admin debe comunicarla al estudiante por WhatsApp.
      clavePropuesta = 'an' + Math.floor(1000 + Math.random() * 9000);
    }

    var filaU = new Array(usuH.length).fill('');
    _setU(filaU, usuH, 'usuario',        cedLimpia);
    _setU(filaU, usuH, 'clave',          clavePropuesta);
    _setU(filaU, usuH, 'rol',            'student');
    _setU(filaU, usuH, 'nombre',         String(prospecto.NOMBRE || '').trim().toUpperCase());
    _setU(filaU, usuH, 'grupo',          grupo);
    _setU(filaU, usuH, 'codigo',         codigoEst);
    _setU(filaU, usuH, 'activo',         true);
    _setU(filaU, usuH, 'CEDULA',         cedLimpia);
    _setU(filaU, usuH, 'CORREO',         String(prospecto.CORREO || '').trim().toLowerCase());
    _setU(filaU, usuH, 'FECHA_CREACION', ahora);
    _setU(filaU, usuH, 'ESTADO_CUENTA',  'ACTIVO');
    _setU(filaU, usuH, 'TELEFONO',       String(prospecto.WHATSAPP || prospecto.TELEFONO || '').trim());

    wsU.appendRow(filaU);

    // ── 4. Crear fila en DATOS con estado CA ───────────────────
    _crearFilaEnDatos(wsDatos, dH, prospecto, codigoEst, grupo, hoy);

    // ── 5. Crear fila en ESTATUS ──────────────────────────────
    _crearFilaEnEstatus(ss, codigoEst, cedLimpia, grupo, hoy);

    // ── 6. Si viene pago de matrícula, registrarlo ─────────────
    var pagoMatricula = null;
    if (body.monto_matricula && Number(body.monto_matricula) > 0) {
      pagoMatricula = {
        codigo:      codigoEst,
        monto:       Number(body.monto_matricula),
        comprobante: String(body.comprobante_matricula || '').trim(),
        fecha:       hoy,
        rubro:       'MATRICULA'
      };
      // Registrar en PAGOS — formato exacto depende del schema actual
      try {
        _registrarPagoMatricula(ss, codigoEst, cedLimpia, grupo,
                                pagoMatricula.monto, pagoMatricula.comprobante, hoy);
      } catch (errPago) {
        Logger.log('Pago de matrícula falló (no crítico): ' + errPago.message);
      }
    }

    // ── 7. Sincronizar con CONAPE_DRIVE (TODOS los estudiantes) ─
    var conapeOk = true;
    try {
      sincronizarCONAPE({ codigo: codigoEst });
    } catch (errC) {
      conapeOk = false;
      Logger.log('Sync CONAPE falló (no crítico): ' + errC.message);
    }

    // ── 8. Actualizar PROSPECTOS — etapa, comisión, código ─────
    var nuevaEtapa, nuevaFechaCol, comisionPagada;

    if (financiamiento === 'CONAPE') {
      // CONAPE: queda esperando primer desembolso. Comisión NO se activa aún.
      nuevaEtapa     = 'CONAPE_SOLICITUD';
      nuevaFechaCol  = 'F_SOLICITUD';
      comisionPagada = 'NO';
    } else {
      // Pago propio (o beca): matrícula registrada = comisión activa
      nuevaEtapa     = 'PAGO_ACADEMIA';
      nuevaFechaCol  = 'F_PAGO_ACADEMIA';
      comisionPagada = 'PENDIENTE'; // marca para liquidación, no se paga sola
    }

    var iPEtapa   = pH.indexOf('ETAPA');
    var iPFecha   = pH.indexOf(nuevaFechaCol);
    var iPCodigoE = pH.indexOf('CODIGO_ESTUDIANTE');
    var iPComPag  = pH.indexOf('COMISION_PAGADA');
    var iPEstadoC = pH.indexOf('ESTADO_CUENTA');

    if (iPEtapa   >= 0) wsP.getRange(filaP, iPEtapa   + 1).setValue(nuevaEtapa);
    if (iPFecha   >= 0) wsP.getRange(filaP, iPFecha   + 1).setValue(ahora);
    if (iPCodigoE >= 0) wsP.getRange(filaP, iPCodigoE + 1).setValue(codigoEst);
    if (iPComPag  >= 0) wsP.getRange(filaP, iPComPag  + 1).setValue(comisionPagada);
    if (iPEstadoC >= 0) wsP.getRange(filaP, iPEstadoC + 1).setValue('ACTIVO');

    // ── 9. Log de auditoría ───────────────────────────────────
    _logActivacion(ss, cedLimpia, codigoEst, grupo, asesor, financiamiento, ahora);

    return {
      ok:               true,
      cedula:           cedLimpia,
      codigo_estudiante: codigoEst,
      grupo:            grupo,
      etapa:            nuevaEtapa,
      financiamiento:   financiamiento,
      comision:         comisionPagada,
      pago_matricula:   pagoMatricula,
      conape_sync:      conapeOk,
      mensaje:          financiamiento === 'CONAPE'
        ? 'Estudiante activado. Esperando primer desembolso CONAPE para comisión.'
        : 'Estudiante activado. Comisión pendiente de liquidación.'
    };

  } catch (err) {
    return { ok: false, error: 'Error en activación: ' + err.message };
  } finally {
    lock.releaseLock();
  }
}

// ── HELPER: generar consecutivo de estudiante ────────────────
// Lee el máximo CODIGO numérico en DATOS y devuelve el siguiente
function _generarConsecutivoEstudiante(ss) {
  var ws    = ss.getSheetByName(SH.DATOS);
  var rows  = ws.getDataRange().getValues();
  var iCod  = rows[0].indexOf('CODIGO');
  var maxN  = 0;
  for (var i = 1; i < rows.length; i++) {
    var c = String(rows[i][iCod] || '').trim();
    var n = parseInt(c, 10);
    if (!isNaN(n) && n > maxN) maxN = n;
  }
  return String(maxN + 1);
}

// ── HELPER: crear fila en DATOS con estado CA ────────────────
function _crearFilaEnDatos(wsDatos, dH, prospecto, codigoEst, grupo, hoy) {
  var fila = new Array(dH.length).fill('');
  function set(col, val) { var idx = dH.indexOf(col); if (idx >= 0) fila[idx] = val; }

  set('CODIGO',      codigoEst);
  set('CEDULA',      String(prospecto.CEDULA).trim());
  set('NOMBRE',      String(prospecto.NOMBRE || '').trim().toUpperCase());
  set('CORREO',      String(prospecto.CORREO || '').trim().toLowerCase());
  set('TELEFONO',    String(prospecto.WHATSAPP || prospecto.TELEFONO || '').trim());
  set('SEXO',        String(prospecto.SEXO || '').trim().toUpperCase());
  set('FECHA_NAC',   String(prospecto.FECHA_NAC || '').trim());
  set('PROVINCIA',   String(prospecto.PROVINCIA || '').trim());
  set('CANTON',      String(prospecto.CANTON || '').trim());
  set('DIRECCION',   String(prospecto.DIRECCION || '').trim());
  set('GRUPO',       grupo);
  set('FECHA_INGRESO', hoy);
  set('CONVENIO',    String(prospecto.FINANCIAMIENTO || '').toUpperCase() === 'CONAPE' ? 'CONAPE' : '');
  set('PROGRAMA',    String(prospecto.PROGRAMA || '').trim());
  set('ESTADO',      'CA'); // Activo

  // Datos del tutor (si es menor)
  if (String(prospecto.ES_MENOR || '').toUpperCase() === 'SI') {
    set('TUTOR_NOMBRE', String(prospecto.TUTOR_NOMBRE || '').trim().toUpperCase());
    set('TUTOR_CEDULA', String(prospecto.TUTOR_CEDULA || '').trim());
    set('TUTOR_CORREO', String(prospecto.TUTOR_CORREO || '').trim().toLowerCase());
    set('TUTOR_TEL',    String(prospecto.TUTOR_TEL    || '').trim());
  }

  wsDatos.appendRow(fila);
}

// ── HELPER: crear fila en ESTATUS para el grupo ──────────────
function _crearFilaEnEstatus(ss, codigoEst, cedula, grupo, hoy) {
  var wsE = ss.getSheetByName(SH.ESTATUS);
  if (!wsE) return;
  var rows = wsE.getDataRange().getValues();
  var H    = rows[0];

  var fila = new Array(H.length).fill('');
  function set(col, val) { var idx = H.indexOf(col); if (idx >= 0) fila[idx] = val; }

  set('CODIGO',     codigoEst);
  set('CEDULA',     cedula);
  set('GRUPO',      grupo);
  set('NIVEL',      'B1'); // Por defecto arranca en Básico I
  set('ESTATUS',    'CA');
  set('FECHA',      hoy);
  set('OBSERVACION', 'Activación desde prospecto');

  wsE.appendRow(fila);
}

// ── HELPER: registrar pago de matrícula en PAGOS ─────────────
function _registrarPagoMatricula(ss, codigo, cedula, grupo, monto, comprobante, hoy) {
  var wsP = ss.getSheetByName(SH.PAGOS);
  if (!wsP) return;
  var rows = wsP.getDataRange().getValues();
  var H    = rows[0];

  var fila = new Array(H.length).fill('');
  function set(col, val) { var idx = H.indexOf(col); if (idx >= 0) fila[idx] = val; }

  set('CODIGO',      codigo);
  set('CEDULA',      cedula);
  set('GRUPO',       grupo);
  set('RUBRO',       'MATRICULA');
  set('MONTO',       monto);
  set('FECHA',       hoy);
  set('COMPROBANTE', comprobante);
  set('REGISTRADO_POR', 'sistema/activacion');

  wsP.appendRow(fila);
}

// ── HELPER: log de auditoría de activaciones ─────────────────
function _logActivacion(ss, cedula, codigo, grupo, asesor, financiamiento, ahora) {
  var ws = ss.getSheetByName('LOG_ACTIVACIONES');
  if (!ws) {
    ws = ss.insertSheet('LOG_ACTIVACIONES');
    ws.appendRow(['TIMESTAMP','CEDULA','CODIGO','GRUPO','ASESOR','FINANCIAMIENTO']);
    ws.setFrozenRows(1);
    ws.hideSheet();
  }
  ws.appendRow([ahora, cedula, codigo, grupo, asesor, financiamiento]);
}

// ════════════════════════════════════════════════════════════════════════════
// v4.32.0 — generarMatricula(body) [ENDPOINT NUEVO]
//
// Reemplaza activarEstudiante con un endpoint que respeta el schema REAL
// de APOLLO. El flujo de uso es:
//   1. Admin abre modal "Generar matrícula" para un prospecto
//   2. Admin confirma/cambia: grupo, beca (si aplica)
//   3. Modal llama generarMatricula({cedula, grupo, beca, beca_estado})
//   4. generarMatricula CREA: fila DATOS, fila USUARIOS, 4 filas ESTATUS
//      (B1=CA + B2/I1/I2=PE), actualiza PROSPECTOS, log
//   5. Frontend redirige a Aplicar Pago para la matrícula B1
//
// Diferencias con activarEstudiante (que queda deprecated):
//   * Schema correcto de DATOS: NUM_CEDULA, VENDEDOR, COSTO, CUOTAS,
//     MATRICULA, CERTIFICADO, ESTADO_EST, sexo, email, clave, doble CODIGO
//   * 4 filas en ESTATUS (no solo B1) con LLAVE={CODIGO}{GRUPO}{NIVEL}
//   * Precios leídos de GRUPOS según el código del grupo, con beca aplicada
//   * Comentario admin auto-generado con asesor + beca + financiamiento
//
// Body: {cedula, grupo, beca, beca_estado, codigo_est_opcional}
// Return: {ok, codigo_estudiante, costo:{...}, etapa, mensaje} | {ok:false, error}
// ════════════════════════════════════════════════════════════════════════════
function generarMatricula(body) {
  if (!body.cedula) return { ok: false, error: 'Falta cedula' };
  if (!body.grupo)  return { ok: false, error: 'Falta grupo' };

  var lock = LockService.getDocumentLock();
  if (!lock.tryLock(30000)) return { ok: false, error: 'Sistema ocupado, intentá de nuevo' };

  try {
    var ss        = SpreadsheetApp.openById(SHEET_ID);
    var cedLimpia = String(body.cedula).replace(/[-\s]/g,'').trim();
    var grupo     = String(body.grupo).trim();
    // v4.40.2: conservar input original para poder hacer fallback con PROSPECTOS
    // después de leer la fila. Antes, si el frontend mandaba beca vacía, DATOS
    // podía quedar sin BECA IMPACTA aunque el prospecto sí la tuviera aprobada.
    var becaRawInput    = String(body.beca || '').trim();
    var becaEstadoInput = String(body.beca_estado || '').trim();
    var beca      = becaRawInput.toUpperCase();         // '' | 'IMPACTA' | 'BECA IMPACTA' | 'MUJER'
    var becaEst   = becaEstadoInput.toUpperCase();      // 'APROBADA' | 'SOLICITADA' | ''
    var becaLabelDatos = '';                            // ej. BECA IMPACTA para DATOS/CONVENIO
    var ahora     = Utilities.formatDate(new Date(), 'America/Costa_Rica', 'yyyy-MM-dd HH:mm:ss');
    var hoyDmy    = Utilities.formatDate(new Date(), 'America/Costa_Rica', 'dd/MM/yyyy');

    // ── 1. Leer prospecto ──────────────────────────────────────
    var wsP = ss.getSheetByName('PROSPECTOS');
    if (!wsP) return { ok: false, error: 'Hoja PROSPECTOS no encontrada' };
    var pRows = wsP.getDataRange().getValues();
    var pH    = pRows[0];
    var iPCed = pH.indexOf('CEDULA');
    var filaP = -1, prospecto = null;

    for (var i = 1; i < pRows.length; i++) {
      if (String(pRows[i][iPCed]).replace(/[-\s]/g,'').trim() === cedLimpia) {
        filaP = i + 1;
        prospecto = {};
        for (var j = 0; j < pH.length; j++) prospecto[pH[j]] = pRows[i][j];
        break;
      }
    }
    if (filaP === -1) return { ok: false, error: 'Prospecto no encontrado: ' + cedLimpia };

    // v4.40.2 — fallback robusto: si el frontend no envió beca/estado,
    // usar la información que ya vive en PROSPECTOS. Esto evita que un
    // prospecto con BECA IMPACTA aprobada cree DATOS sin marca de beca.
    if (!beca && prospecto.BECA) {
      beca = String(prospecto.BECA || '').trim().toUpperCase();
    }
    if (!becaEst && prospecto.BECA_ESTADO) {
      becaEst = String(prospecto.BECA_ESTADO || '').trim().toUpperCase();
    }

    // ── 2. Verificar que no esté ya en DATOS ───────────────────
    var wsDatos = ss.getSheetByName(SH.DATOS);
    if (!wsDatos) return { ok: false, error: 'Hoja DATOS no encontrada' };
    var dRows = wsDatos.getDataRange().getValues();
    var dH    = dRows[0];
    var iDCed = dH.indexOf('NUM_CEDULA');
    if (iDCed < 0) iDCed = dH.indexOf('CEDULA');  // fallback legacy
    var iDCod = dH.indexOf('CODIGO');

    for (var i = 1; i < dRows.length; i++) {
      if (String(dRows[i][iDCed]).replace(/[-\s]/g,'').trim() === cedLimpia) {
        return { ok: false, error: 'Cédula ' + cedLimpia + ' ya está en DATOS como estudiante' };
      }
    }

    // ── 3. Leer precios de GRUPOS según código ─────────────────
    var precios = _leerPreciosDeGrupo(ss, grupo);
    if (!precios) return { ok: false, error: 'No se encontraron precios para el grupo: ' + grupo };

    // ── 4. Aplicar beca dinámicamente (v4.37.0) ──────────────
    // Lee de la hoja CONFIG_BECAS según el nombre/ID pasado. Cada beca define
    // su propio % por rubro (matrícula, cuota, certificado, título). Antes
    // estaba hardcoded a IMPACTA=25 y MUJER=50; ahora es configurable.
    // Beca solo aplica si beca_estado === 'APROBADA'.
    var pctMatricula   = 0;
    var pctCuota       = 0;
    var pctCertificado = 0;
    if (beca && becaEst === 'APROBADA') {
      var becaConfig = _getBecaPorNombre(ss, beca);
      if (!becaConfig) {
        return { ok: false, error: 'Beca no encontrada en CONFIG_BECAS: ' + beca };
      }
      if (!becaConfig.ACTIVA) {
        return { ok: false, error: 'Beca inactiva: ' + beca };
      }
      // v4.40.2 — nombre canónico para DATOS/CONVENIO/comentarios.
      // Ejemplos: IMPACTA, BECA_IMPACTA, Beca Impacta → BECA IMPACTA.
      becaLabelDatos = _formatearNombreBecaParaDatos_(becaConfig, beca);
      beca = becaLabelDatos || beca;

      pctMatricula   = parseFloat(becaConfig.PCT_MATRICULA)   || 0;
      pctCuota       = parseFloat(becaConfig.PCT_CUOTA)       || 0;
      pctCertificado = parseFloat(becaConfig.PCT_CERTIFICADO) || 0;
      // PCT_TITULO se aplica en otra parte del código (al cobrar título);
      // generarMatricula calcula costos de matrícula, cuotas y certificado.
    }


    // v4.39.8 — FIX generarMatricula: becaPct estaba referenciado pero no existía.
    // Usamos un % representativo para comentario/respuesta, sin cambiar cálculos.
    var becaPct = Math.max(pctMatricula, pctCuota, pctCertificado);

    var costoMatricula   = Math.round(precios.matricula   * (1 - pctMatricula   / 100));
    var costoCuota       = Math.round(precios.cuota       * (1 - pctCuota       / 100));
    var costoCertificado = Math.round(precios.certificado * (1 - pctCertificado / 100));

    // SUPUESTO 2: número total de cuotas según MODALIDAD (4 niveles del programa).
    //   INTENSIVO       = 4 cuotas/nivel × 4 niveles = 16 cuotas
    //   SUPER_INTENSIVO = 2 cuotas/nivel × 4 niveles = 8 cuotas
    // Aplica a INA y SIN INA por igual.
    var modalidad = String(prospecto.MODALIDAD || '').trim().toUpperCase();
    var totalCuotas = (modalidad === 'SUPER_INTENSIVO' || modalidad === 'SUPER INTENSIVO')
      ? 8
      : 16;  // default INTENSIVO
    var costoTotal  = costoCuota * totalCuotas;

    // ── 5. Generar consecutivo CODIGO ───────────────────────────
    var codigoEst = String(body.codigo_est_opcional || '').trim();
    if (!codigoEst) codigoEst = _generarConsecutivoEstudiante(ss);

    for (var i = 1; i < dRows.length; i++) {
      if (String(dRows[i][iDCod]).trim() === codigoEst) {
        return { ok: false, error: 'Código ' + codigoEst + ' ya existe en DATOS' };
      }
    }

    // ── 6. Construir comentario admin auto-generado ─────────────
    var asesor = String(prospecto.ASESOR_REF || '').trim();
    var financiamiento = String(prospecto.FINANCIAMIENTO || '').trim().toUpperCase();
    var comentario = 'Activación Campus Virtual ' + hoyDmy + ' - Asesor: ' + (asesor || 'sin asesor');
    if (becaPct > 0)              comentario += '; beca: ' + beca + ' ' + becaPct + '%';
    if (financiamiento === 'CONAPE') comentario += '; financiamiento CONAPE';

    // ── 7. Crear fila en DATOS con schema REAL ──────────────────
    _crearFilaEnDatosV2(wsDatos, dH, prospecto, codigoEst, grupo, hoyDmy,
                        asesor, costoTotal, costoCuota, costoMatricula, costoCertificado,
                        financiamiento, comentario, becaLabelDatos);

    // ── 8. Crear fila en USUARIOS ───────────────────────────────
    var wsU = ss.getSheetByName(SH.USUARIOS);
    if (!wsU) return { ok: false, error: 'Hoja USUARIOS no encontrada' };
    var clavePropuesta = String(prospecto.CLAVE || '').trim();
    if (!clavePropuesta) clavePropuesta = codigoEst;  // fallback: clave = código
    _crearFilaEnUsuariosV2(wsU, prospecto, codigoEst, grupo, clavePropuesta);

    // ── 9. Crear 4 filas en ESTATUS (B1=CA, B2/I1/I2=PE) ────────
    _crearFilasEstatusV2(ss, codigoEst, grupo, hoyDmy);

    // ── 10. Actualizar PROSPECTOS ───────────────────────────────
    // SUPUESTO 3: al "generar matrícula" (sin pago aún), el prospecto pasa a
    // PAGO_ACADEMIA (propio) o CONAPE_SOLICITUD (CONAPE). La comisión NO se
    // marca ganada hasta que el admin aplique el pago de matrícula B1 vía
    // aplicarPago (que escribe en OTROS_PAGOS.ncuenta=60).
    var nuevaEtapa, nuevaFechaCol;
    if (financiamiento === 'CONAPE') {
      nuevaEtapa     = 'CONAPE_SOLICITUD';
      nuevaFechaCol  = 'F_SOLICITUD';
    } else {
      nuevaEtapa     = 'PAGO_ACADEMIA';
      nuevaFechaCol  = 'F_PAGO_ACADEMIA';
    }

    var iPEtapa    = pH.indexOf('ETAPA');
    var iPFecha    = pH.indexOf(nuevaFechaCol);
    var iPCodE     = pH.indexOf('CODIGO_ESTUDIANTE');
    var iPEstadoC  = pH.indexOf('ESTADO_CUENTA');

    if (iPEtapa   >= 0) wsP.getRange(filaP, iPEtapa   + 1).setValue(nuevaEtapa);
    if (iPFecha   >= 0) wsP.getRange(filaP, iPFecha   + 1).setValue(ahora);
    if (iPCodE    >= 0) wsP.getRange(filaP, iPCodE    + 1).setValue(codigoEst);
    if (iPEstadoC >= 0) wsP.getRange(filaP, iPEstadoC + 1).setValue('ACTIVO');

    // ── 11. Sincronizar CONAPE_DRIVE ────────────────────────────
    var conapeOk = true;
    try { sincronizarCONAPE_estudiante(codigoEst); } catch (e) { conapeOk = false; }

    // ── 12. Log de auditoría ────────────────────────────────────
    _logActivacion(ss, cedLimpia, codigoEst, grupo, asesor, financiamiento, ahora);

    return {
      ok:                true,
      codigo_estudiante: codigoEst,
      cedula:            cedLimpia,
      grupo:             grupo,
      etapa:             nuevaEtapa,
      financiamiento:    financiamiento,
      beca:              becaLabelDatos || beca || '',
      beca_estado:       becaEst,
      costo: {
        total:           costoTotal,
        cuota:           costoCuota,
        matricula:       costoMatricula,
        certificado:     costoCertificado,
        beca_pct:        becaPct,
        total_cuotas:    totalCuotas,
      },
      conape_sync:       conapeOk,
      mensaje:           'Matrícula generada. Próximo paso: aplicar pago de matrícula B1 desde el campus.'
    };

  } catch (err) {
    return { ok: false, error: 'Error en generarMatricula: ' + err.message };
  } finally {
    lock.releaseLock();
  }
}

// ── HELPER v4.32.0: leer precios de un grupo específico ─────
function _leerPreciosDeGrupo(ss, codigoGrupo) {
  var wsG = ss.getSheetByName(SH.GRUPOS);
  if (!wsG) return null;
  var rows = wsG.getDataRange().getValues();
  var H = rows[0];

  var iCod  = H.indexOf('CODIGO_GRUPO');
  var iPC   = H.indexOf('PRECIO_CUOTA');
  var iPM   = H.indexOf('PRECIO_MATRICULA');
  var iPCer = H.indexOf('PRECIO_CERTIFICADO');
  var iPT   = H.indexOf('PRECIO_TITULO');

  if (iCod < 0 || iPC < 0) return null;

  for (var i = 1; i < rows.length; i++) {
    if (String(rows[i][iCod]).trim() === codigoGrupo) {
      return {
        cuota:       parseFloat(rows[i][iPC])   || 0,
        matricula:   parseFloat(rows[i][iPM])   || 0,
        certificado: parseFloat(rows[i][iPCer]) || 0,
        titulo:      parseFloat(rows[i][iPT])   || 0,
      };
    }
  }
  return null;
}

// ── HELPER v4.32.0: crear fila en DATOS con schema REAL ─────
// Schema confirmado contra APOLLO_G3:
//   CODIGO | NUM_CEDULA | NOMBRE | CONVENIO | CODIGO (duplicado) |
//   TELEFONO | TELEFONO2 | DIRECCION | FECHA_NAC | GRUPO |
//   FECHA_MATRICULA | VENDEDOR | COSTO | CUOTAS | MATRICULA | CERTIFICADO |
//   ESTADO_EST | COMENTARIO_ADMIN | sexo | email | clave
function _crearFilaEnDatosV2(wsDatos, dH, prospecto, codigoEst, grupo, hoyDmy,
                              asesor, costoTotal, costoCuota, costoMatricula, costoCertificado,
                              financiamiento, comentario, becaLabelDatos) {
  var fila = new Array(dH.length).fill('');

  // setAll = setea TODAS las columnas con ese nombre (necesario para CODIGO duplicado)
  function setAll(col, val) {
    var target = String(col).trim();
    for (var z = 0; z < dH.length; z++) {
      if (String(dH[z]).trim() === target) fila[z] = val;
    }
  }
  // set = solo la primera columna que matchea
  function set(col, val) {
    var target = String(col).trim();
    for (var z = 0; z < dH.length; z++) {
      if (String(dH[z]).trim() === target) { fila[z] = val; return; }
    }
  }

  var cedLimpia = String(prospecto.CEDULA).replace(/[-\s]/g,'').trim();
  var wa = String(prospecto.WHATSAPP || '').trim();
  var tel = String(prospecto.TELEFONO || '').trim();
  // TELEFONO = WhatsApp (canal principal); TELEFONO2 = TELEFONO solo si difiere
  var telPrincipal = wa || tel;
  var telSecund    = (tel && tel !== wa) ? tel : '';

  // Dirección concatenada: PROVINCIA, CANTON, DISTRITO, DIRECCION
  var dirParts = [];
  if (prospecto.PROVINCIA) dirParts.push(String(prospecto.PROVINCIA).trim());
  if (prospecto.CANTON)    dirParts.push(String(prospecto.CANTON).trim());
  if (prospecto.DISTRITO)  dirParts.push(String(prospecto.DISTRITO).trim());
  if (prospecto.DIRECCION) dirParts.push(String(prospecto.DIRECCION).trim());
  var direccion = dirParts.filter(function(x){return x;}).join(', ');

  // Fecha de nacimiento — si es Date, formatear DD/MM/YYYY
  var fNac = prospecto.FECHA_NAC;
  if (fNac instanceof Date) {
    fNac = Utilities.formatDate(fNac, 'America/Costa_Rica', 'dd/MM/yyyy');
  } else {
    fNac = String(fNac || '').trim();
  }

  // SUPUESTO 4: clave en DATOS = mismo valor que CODIGO (según ejemplo Bryan).
  // No se usa CLAVE del prospecto acá porque clave de DATOS es legacy.
  // La clave que eligió el usuario va a USUARIOS, NO a DATOS.

  setAll('CODIGO',           codigoEst);   // 2 columnas con este nombre
  set('NUM_CEDULA',          cedLimpia);
  set('NOMBRE',              String(prospecto.NOMBRE || '').trim().toUpperCase());

  // v4.40.2 — si no es CONAPE y trae beca aprobada, DATOS debe conservar
  // la marca canónica de beca (ej. BECA IMPACTA). En muchos reportes este
  // dato vive en la columna CONVENIO/columna B; si además existe una columna
  // BECA/BECA_APLICADA, también se llena.
  var convenioDatos = financiamiento === 'CONAPE' ? 'CONAPE' : (becaLabelDatos || '');
  set('CONVENIO',            convenioDatos);
  if (becaLabelDatos) {
    set('BECA',              becaLabelDatos);
    set('BECAS',             becaLabelDatos);
    set('BECA_APLICADA',     becaLabelDatos);
    set('TIPO_BECA',         becaLabelDatos);
    set('PROMOCION',         becaLabelDatos);
  }
  set('TELEFONO',            telPrincipal);
  set('TELEFONO2',           telSecund);
  set('DIRECCION',           direccion);
  set('FECHA_NAC',           fNac);
  set('GRUPO',               grupo);
  set('FECHA_MATRICULA',     hoyDmy);
  set('VENDEDOR',            asesor);                                // CRÍTICO
  set('COSTO',               costoTotal);
  set('CUOTAS',              costoCuota);
  set('MATRICULA',           costoMatricula);
  set('CERTIFICADO',         costoCertificado);
  // SUPUESTO 5: ESTADO_EST queda vacío. Es campo legacy del programa anterior
  // que Leonardo no usa actualmente; el estado real se ve en hoja ESTATUS.
  set('ESTADO_EST',          '');
  set('COMENTARIO_ADMIN',    comentario);
  set('sexo',                String(prospecto.SEXO || '').trim().toUpperCase());
  set('email',               String(prospecto.CORREO || '').trim().toLowerCase());
  set('clave',               codigoEst);

  wsDatos.appendRow(fila);
}

// ── HELPER v4.32.0: crear fila en USUARIOS con schema correcto ──
function _crearFilaEnUsuariosV2(wsU, prospecto, codigoEst, grupo, clave) {
  var usuH = wsU.getRange(1, 1, 1, wsU.getLastColumn()).getValues()[0];
  var fila = new Array(usuH.length).fill('');

  // Case-insensitive: usuario/clave/rol/nombre/grupo/codigo/activo están en minúsculas
  function setCI(col, val) {
    var target = String(col).trim().toLowerCase();
    for (var z = 0; z < usuH.length; z++) {
      if (String(usuH[z]).trim().toLowerCase() === target) { fila[z] = val; return; }
    }
  }

  var cedLimpia = String(prospecto.CEDULA).replace(/[-\s]/g,'').trim();

  setCI('usuario',  cedLimpia);
  setCI('clave',    clave);
  setCI('rol',      'student');
  setCI('nombre',   String(prospecto.NOMBRE || '').trim().toUpperCase());
  setCI('grupo',    grupo);
  setCI('codigo',   codigoEst);
  setCI('activo',   true);
  setCI('TELEFONO', String(prospecto.WHATSAPP || prospecto.TELEFONO || '').trim());

  wsU.appendRow(fila);
}

// ── HELPER v4.32.0: crear 4 filas en ESTATUS (uno por nivel) ──
// Schema confirmado:
//   A: LLAVE | B: GRUPO | C: CODIGO | D: ESTATUS | E: NIVEL |
//   F: FECHA DE MODIFICION | G-J: o1/o2/o3/o4 | K-L: e1/e2 | M: s1 |
//   N: NOTA (=REDONDEAR(SUMA(G:M,0)) | O: REG_CERTIFICADOS | P: email
//
// LLAVE = CODIGO + GRUPO + NIVEL (sin separadores, ej. "12730B1-KJ94-B6-0425B1")
// B1 con estatus 'CA' y fecha hoy; B2/I1/I2 con estatus 'PE' y fecha vacía
// NOTA es FÓRMULA, no número: la suma se recalcula cuando se llenan las notas.
function _crearFilasEstatusV2(ss, codigoEst, grupo, hoyDmy) {
  var wsE = ss.getSheetByName(SH.ESTATUS);
  if (!wsE) return;

  var H = wsE.getRange(1, 1, 1, wsE.getLastColumn()).getValues()[0];

  // Posición de la columna NOTA (para construir la fórmula correctamente)
  var iNota = -1;
  for (var z = 0; z < H.length; z++) {
    if (String(H[z]).trim().toUpperCase() === 'NOTA') { iNota = z; break; }
  }

  function buildFila(nivel, estatus, fecha, filaSheet) {
    var fila = new Array(H.length).fill('');
    function set(col, val) {
      var target = String(col).trim();
      for (var z = 0; z < H.length; z++) {
        if (String(H[z]).trim() === target) { fila[z] = val; return; }
      }
    }
    set('LLAVE',                codigoEst + grupo + nivel);
    set('GRUPO',                grupo);
    set('CODIGO',               codigoEst);
    set('ESTATUS',              estatus);
    set('NIVEL',                nivel);
    set('FECHA DE MODIFICION',  fecha);

    // SUPUESTO 6: NOTA es fórmula =REDONDEAR(SUMA(G{N}:M{N},0)) donde N
    // es el número de fila real. Las notas individuales (G:M) arrancan
    // vacías; cuando el docente llena las notas, NOTA se recalcula sola.
    if (iNota >= 0) {
      fila[iNota] = '=REDONDEAR(SUMA(G' + filaSheet + ':M' + filaSheet + ',0))';
    }
    return fila;
  }

  // SUPUESTO: B1=CA con fecha hoy. B2/I1/I2=PE con fecha vacía.
  // Cuando el estudiante avance, otro endpoint actualiza la fila del nivel.
  var firstRow = wsE.getLastRow() + 1;
  var filas = [
    buildFila('B1', 'CA', hoyDmy, firstRow + 0),
    buildFila('B2', 'PE', '',     firstRow + 1),
    buildFila('I1', 'PE', '',     firstRow + 2),
    buildFila('I2', 'PE', '',     firstRow + 3),
  ];

  // Insert batch usando setValues para garantizar consistencia
  wsE.getRange(firstRow, 1, filas.length, H.length).setValues(filas);
}

// ── HELPER: guardar foto base64 en Drive y devolver URL ──────
// v4.25.0 — DOCUMENTOS_ESTUDIANTES/{CEDULA}/INSCRIPCION/{tipo}.jpg
function _guardarFotoProspecto(cedula, tipo, base64Data) {
  if (!base64Data) return '';

  // Limpiar prefijo "data:image/...;base64,"
  var raw = String(base64Data);
  var comaPos = raw.indexOf(',');
  if (comaPos >= 0 && raw.substring(0, 5) === 'data:') raw = raw.substring(comaPos + 1);

  // Carpeta raíz del estudiante
  var rootFolder = DriveApp.getFolderById(DOCUMENTOS_FOLDER_ID);
  var cedFolder  = _getOrCreateChildFolder(rootFolder, cedula);
  var inscFolder = _getOrCreateChildFolder(cedFolder, 'INSCRIPCION');

  // Borrar foto anterior del mismo tipo si existe (re-subida)
  var nombre   = tipo + '.jpg';
  var existing = inscFolder.getFilesByName(nombre);
  while (existing.hasNext()) {
    var f = existing.next();
    f.setTrashed(true);
  }

  // Decodificar y guardar
  var bytes = Utilities.base64Decode(raw);
  var blob  = Utilities.newBlob(bytes, 'image/jpeg', nombre);
  var file  = inscFolder.createFile(blob);

  // Hacer accesible vía link para que el dashboard la muestre
  file.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);

  return 'https://lh3.googleusercontent.com/d/' + file.getId();
}

function _getOrCreateChildFolder(parentFolder, name) {
  var iter = parentFolder.getFoldersByName(name);
  if (iter.hasNext()) return iter.next();
  return parentFolder.createFolder(name);
}

// ============================================================
// cobrarMatriculaProspecto(body)                      — v4.25.0
// POST ?fn=cobrarMatriculaProspecto
// SOLO ADMIN/SUPERADMIN
//
// Wrapper que llama activarEstudiante con datos de pago.
// Usado desde el dashboard cuando el admin/asesor cierra
// un prospecto de pago propio.
//
// Body: { cedula, grupo, monto, comprobante, asesor }
// ============================================================
function cobrarMatriculaProspecto(body) {
  if (!body.cedula || !body.grupo || !body.monto || !body.comprobante) {
    return { ok: false, error: 'Faltan: cedula, grupo, monto, comprobante' };
  }

  return activarEstudiante({
    cedula:                body.cedula,
    grupo:                 body.grupo,
    asesor:                body.asesor || '',
    monto_matricula:       body.monto,
    comprobante_matricula: body.comprobante
  });
}

// ============================================================
// getProspectosAsesor(params)                         — v4.25.0
// GET ?fn=getProspectosAsesor&asesor=Fiorela+Salazar
// GET ?fn=getProspectosAsesor (sin filtro — para superadmin)
//
// Devuelve prospectos del asesor con campos limpios para
// el dashboard de ventas. NO devuelve fotos en base64 — solo URLs.
// ============================================================
function getProspectosAsesor(params) {
  var ss   = SpreadsheetApp.openById(SHEET_ID);
  var wsP  = ss.getSheetByName('PROSPECTOS');
  if (!wsP) return { ok: true, prospectos: [], total: 0 };

  var rows = wsP.getDataRange().getValues();
  if (rows.length <= 1) return { ok: true, prospectos: [], total: 0 };

  var H        = rows[0];
  var iAsesor  = H.indexOf('ASESOR_REF');
  var iEtapa   = H.indexOf('ETAPA');

  // v4.30.3 — Acepta 'asesor' (nombre) y/o 'cedula' (del asesor).
  // Si viene cedula, busca el nombre en USUARIOS y usa ese para filtrar.
  // El match es case-insensitive Y usa indexOf (tolerante a primer nombre
  // o variantes con/sin segundo apellido).
  var asesorRaw = params && params.asesor ? String(params.asesor).trim() : '';
  var cedulaRaw = params && params.cedula ? String(params.cedula).trim().replace(/[-\s]/g,'') : '';

  var nombreFiltro = '';

  if (cedulaRaw) {
    var wsU = ss.getSheetByName(SH.USUARIOS);
    if (wsU) {
      var uRows = wsU.getDataRange().getValues();
      var uH    = uRows[0];
      var iUUser = -1, iUNombre = -1, iUCed = -1;
      for (var k = 0; k < uH.length; k++) {
        var hn = String(uH[k]).trim().toLowerCase();
        if (hn === 'usuario')  iUUser   = k;
        if (hn === 'nombre')   iUNombre = k;
        if (hn === 'cedula')   iUCed    = k;
      }
      for (var u = 1; u < uRows.length; u++) {
        var cedU = String(uRows[u][iUCed >= 0 ? iUCed : iUUser] || '').replace(/[-\s]/g,'').trim();
        if (cedU === cedulaRaw && iUNombre >= 0) {
          nombreFiltro = String(uRows[u][iUNombre] || '').trim().toUpperCase();
          break;
        }
      }
    }
  } else if (asesorRaw) {
    nombreFiltro = asesorRaw.toUpperCase();
  }

  var etapa = params && params.etapa ? String(params.etapa).trim().toUpperCase() : '';

  var out = [];
  for (var i = 1; i < rows.length; i++) {
    var rowAsesor = String(rows[i][iAsesor] || '').trim().toUpperCase();
    var rowEtapa  = String(rows[i][iEtapa]  || '').trim().toUpperCase();

    // Match tolerante: "FIORELLA" matchea "FIORELLA SALAZAR" y viceversa
    if (nombreFiltro) {
      var matches = (rowAsesor === nombreFiltro)
                 || (nombreFiltro.length >= 4 && rowAsesor.indexOf(nombreFiltro) >= 0)
                 || (rowAsesor.length >= 4 && nombreFiltro.indexOf(rowAsesor) >= 0);
      if (!matches) continue;
    }
    if (etapa && rowEtapa !== etapa) continue;

    var obj = {};
    for (var j = 0; j < H.length; j++) obj[H[j]] = rows[i][j];
    out.push(obj);
  }

  return {
    ok:           true,
    prospectos:   out,
    total:        out.length,
    filtro_usado: nombreFiltro,   // v4.30.3 — para debug del frontend
  };
}

// ============================================================
// getProspectoDetalle(params)                         — v4.25.0
// GET ?fn=getProspectoDetalle&cedula=XXXXXXXXX
//
// Devuelve TODO sobre un prospecto:
//   - Datos del registro
//   - URLs de las 3 fotos
//   - Historial de notas
//   - Eventos CONAPE relacionados
//   - Documentos extra subidos
// ============================================================
function getProspectoDetalle(params) {
  if (!params || !params.cedula) return { ok: false, error: 'Falta cedula' };
  var cedLimpia = String(params.cedula).replace(/[-\s]/g,'').trim();

  var ss   = SpreadsheetApp.openById(SHEET_ID);
  var wsP  = ss.getSheetByName('PROSPECTOS');
  if (!wsP) return { ok: false, error: 'No hay tabla PROSPECTOS' };

  var rows = wsP.getDataRange().getValues();
  var H    = rows[0];
  var iCed = H.indexOf('CEDULA');

  var prospecto = null;
  for (var i = 1; i < rows.length; i++) {
    if (String(rows[i][iCed]).replace(/[-\s]/g,'').trim() === cedLimpia) {
      prospecto = {};
      for (var j = 0; j < H.length; j++) prospecto[H[j]] = rows[i][j];
      break;
    }
  }
  if (!prospecto) return { ok: false, error: 'Prospecto no encontrado' };

  // Notas
  var notas = [];
  var wsN = ss.getSheetByName('PROSPECTO_NOTAS');
  if (wsN) {
    var nRows = wsN.getDataRange().getValues();
    var nH    = nRows[0];
    var iNCed = nH.indexOf('CEDULA');
    for (var i = 1; i < nRows.length; i++) {
      if (String(nRows[i][iNCed]).replace(/[-\s]/g,'').trim() === cedLimpia) {
        var n = {};
        for (var j = 0; j < nH.length; j++) n[nH[j]] = nRows[i][j];
        notas.push(n);
      }
    }
    notas.sort(function(a,b) { return String(b.FECHA||'').localeCompare(String(a.FECHA||'')); });
  }

  // Documentos extra en Drive
  var docsExtra = [];
  try {
    var rootFolder = DriveApp.getFolderById(DOCUMENTOS_FOLDER_ID);
    var iter1 = rootFolder.getFoldersByName(cedLimpia);
    if (iter1.hasNext()) {
      var cedFolder = iter1.next();
      var iter2 = cedFolder.getFoldersByName('DOCUMENTOS_EXTRA');
      if (iter2.hasNext()) {
        var extraFolder = iter2.next();
        var fIter = extraFolder.getFiles();
        while (fIter.hasNext()) {
          var f = fIter.next();
          docsExtra.push({
            nombre: f.getName(),
            url:    'https://drive.google.com/file/d/' + f.getId() + '/view',
            fecha:  Utilities.formatDate(f.getDateCreated(), 'America/Costa_Rica', 'yyyy-MM-dd HH:mm')
          });
        }
      }
    }
  } catch (e) {}

  // Eventos CONAPE (si la tabla existe)
  var conapeEventos = [];
  var wsCE = ss.getSheetByName('CONAPE_EVENTOS');
  if (wsCE) {
    var cRows = wsCE.getDataRange().getValues();
    var cH    = cRows[0];
    var iCCed = cH.indexOf('CEDULA');
    for (var i = 1; i < cRows.length; i++) {
      if (String(cRows[i][iCCed]).replace(/[-\s]/g,'').trim() === cedLimpia) {
        var e = {};
        for (var j = 0; j < cH.length; j++) e[cH[j]] = cRows[i][j];
        conapeEventos.push(e);
      }
    }
  }

  return {
    ok:             true,
    prospecto:      prospecto,
    notas:          notas,
    docs_extra:     docsExtra,
    conape_eventos: conapeEventos
  };
}

// ============================================================
// agregarNotaProspecto(body)                          — v4.25.0
// POST ?fn=agregarNotaProspecto
//
// Body: { cedula, asesor, texto }
// ============================================================
function agregarNotaProspecto(body) {
  if (!body.cedula || !body.texto || !body.asesor) {
    return { ok: false, error: 'Faltan: cedula, asesor, texto' };
  }

  var ss = SpreadsheetApp.openById(SHEET_ID);
  var ws = ss.getSheetByName('PROSPECTO_NOTAS');
  if (!ws) {
    ws = ss.insertSheet('PROSPECTO_NOTAS');
    ws.appendRow(['ID','FECHA','CEDULA','ASESOR','TEXTO']);
    ws.setFrozenRows(1);
  }

  var ahora = Utilities.formatDate(new Date(), 'America/Costa_Rica', 'yyyy-MM-dd HH:mm:ss');
  var id    = Utilities.getUuid().substring(0, 8);
  var cedLimpia = String(body.cedula).replace(/[-\s]/g,'').trim();

  ws.appendRow([id, ahora, cedLimpia, String(body.asesor).trim(), String(body.texto).trim()]);

  return { ok: true, id: id, fecha: ahora };
}

// ============================================================
// subirDocumentoExtra(body)                           — v4.25.0
// POST ?fn=subirDocumentoExtra
//
// Sube cualquier documento adicional al folder del estudiante.
// DOCUMENTOS_ESTUDIANTES/{CEDULA}/DOCUMENTOS_EXTRA/
//
// Body: { cedula, nombre_archivo, mime_type, base64 }
// ============================================================
function subirDocumentoExtra(body) {
  if (!body.cedula || !body.base64 || !body.nombre_archivo) {
    return { ok: false, error: 'Faltan: cedula, nombre_archivo, base64' };
  }

  try {
    var cedLimpia = String(body.cedula).replace(/[-\s]/g,'').trim();
    var raw = String(body.base64);
    var coma = raw.indexOf(',');
    if (coma >= 0 && raw.substring(0, 5) === 'data:') raw = raw.substring(coma + 1);

    var rootFolder  = DriveApp.getFolderById(DOCUMENTOS_FOLDER_ID);
    var cedFolder   = _getOrCreateChildFolder(rootFolder, cedLimpia);
    var extraFolder = _getOrCreateChildFolder(cedFolder, 'DOCUMENTOS_EXTRA');

    var bytes = Utilities.base64Decode(raw);
    var blob  = Utilities.newBlob(bytes, body.mime_type || 'application/octet-stream', body.nombre_archivo);
    var file  = extraFolder.createFile(blob);
    file.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);

    return {
      ok:     true,
      url:    'https://drive.google.com/file/d/' + file.getId() + '/view',
      nombre: file.getName()
    };
  } catch (err) {
    return { ok: false, error: 'Error subiendo: ' + err.message };
  }
}

// ============================================================
// getResumenVentas(params)                            — v4.25.0
// GET ?fn=getResumenVentas&asesor=XXX  (vista asesor)
// GET ?fn=getResumenVentas             (vista superadmin)
//
// KPIs para el dashboard:
//   - total_prospectos
//   - por_etapa: { LEAD: 5, CONAPE_SOLICITUD: 3, ... }
//   - activados_mes: cuántos pasaron a ACTIVO este mes
//   - comisiones_pendientes
//   - alertas_no_leidas
// ============================================================
function getResumenVentas(params) {
  var ss   = SpreadsheetApp.openById(SHEET_ID);
  var wsP  = ss.getSheetByName('PROSPECTOS');
  if (!wsP) return { ok: true, vacio: true };

  var rows = wsP.getDataRange().getValues();
  if (rows.length <= 1) return { ok: true, vacio: true };

  var H        = rows[0];
  var filtro   = params && params.asesor ? String(params.asesor).trim().toUpperCase() : '';
  var iAsesor  = H.indexOf('ASESOR_REF');
  var iEtapa   = H.indexOf('ETAPA');
  var iFActivo = H.indexOf('F_ACTIVO');
  var iComPag  = H.indexOf('COMISION_PAGADA');
  var iFin     = H.indexOf('FINANCIAMIENTO');

  var total = 0;
  var porEtapa = {};
  var porFinanciamiento = {};
  var activadosMes = 0;
  var comisionesPendientes = 0;

  var ahora = new Date();
  var mesActual = ahora.getMonth();
  var anioActual = ahora.getFullYear();

  for (var i = 1; i < rows.length; i++) {
    var rowAsesor = String(rows[i][iAsesor] || '').trim().toUpperCase();
    if (filtro && rowAsesor !== filtro) continue;

    total++;
    var et = String(rows[i][iEtapa] || 'LEAD').trim().toUpperCase();
    porEtapa[et] = (porEtapa[et] || 0) + 1;

    var fin = String(rows[i][iFin] || 'PROPIO').trim().toUpperCase();
    porFinanciamiento[fin] = (porFinanciamiento[fin] || 0) + 1;

    var fAct = rows[i][iFActivo];
    if (fAct) {
      var d = new Date(fAct);
      if (!isNaN(d.getTime()) && d.getMonth() === mesActual && d.getFullYear() === anioActual) {
        activadosMes++;
      }
    }

    var cp = String(rows[i][iComPag] || '').trim().toUpperCase();
    if (cp === 'PENDIENTE') comisionesPendientes++;
  }

  return {
    ok:                     true,
    asesor:                 filtro || null,
    total_prospectos:       total,
    por_etapa:              porEtapa,
    por_financiamiento:     porFinanciamiento,
    activados_mes:          activadosMes,
    comisiones_pendientes:  comisionesPendientes,
    timestamp:              Utilities.formatDate(new Date(), 'America/Costa_Rica', 'yyyy-MM-dd HH:mm:ss')
  };
}

// ============================================================
// getProspectos()                                   — v4.2 (legacy)
// GET ?fn=getProspectos&estado=PENDIENTE_PAGO
// GET ?fn=getProspectos&estado=PENDIENTE_CONAPE
// GET ?fn=getProspectos  (todos)
//
// Para el panel de matrículas del admin
// ============================================================
function getProspectos(params) {
  var ss = SpreadsheetApp.openById(SHEET_ID);
  var ws = getOrCreateProspectos(ss);
  var rows = ws.getDataRange().getValues();
  if (rows.length <= 1) return { ok: true, prospectos: [], total: 0, resumen: _resumenMatriculasVacio(ss) };

  var h = rows[0];
  var filtroEstado = params && params.estado ? String(params.estado).trim() : null;

  // v4.35.2 — Decay opcional del panel PRE MATRÍCULA (admin).
  // El frontend del panel admin pasa decay_pre_matricula=true. En ese caso,
  // prospectos con matrícula B1 PAGADA en semanas previas (no en la actual)
  // se ocultan. Los CANCELADOS siempre se incluyen (el admin necesita verlos
  // con su detalle).
  var aplicarDecay = params && (params.decay_pre_matricula === true ||
                                String(params.decay_pre_matricula).toLowerCase() === 'true');
  var pagosB1   = null;
  var inicioSem = null;
  if (aplicarDecay) {
    pagosB1   = _indexarPagosB1(ss);
    inicioSem = _inicioSemanaComisiones();
  }

  var prospectos = [];

  // v4.30.1: contar PRE MATRÍCULA (prospectos con ESTADO_CUENTA != ACTIVO)
  // sobre TODA la hoja, no solo el filtro pedido (el resumen es global).
  var totalProspectosNoActivos = 0;
  var iEstadoCuenta = h.indexOf('ESTADO_CUENTA');
  var iEtapa        = h.indexOf('ETAPA');
  var iCodigoEst    = h.indexOf('CODIGO_ESTUDIANTE');

  for (var i = 1; i < rows.length; i++) {
    var obj = {};
    h.forEach(function(col, j) {
      if (col !== 'CLAVE_HASH' && col !== 'CLAVE') obj[col] = rows[i][j]; // No exponer la clave
    });

    // Contar el total global de no activos (antes de aplicar el filtro de salida)
    var estCuenta = iEstadoCuenta >= 0 ? String(rows[i][iEstadoCuenta] || '').trim().toUpperCase() : '';
    if (estCuenta !== 'ACTIVO') totalProspectosNoActivos++;

    if (filtroEstado && obj.ESTADO !== filtroEstado) continue;

    // v4.35.2 — Aplicar decay (si fue pedido). Cancelados siempre pasan.
    if (aplicarDecay) {
      var etapa  = String(rows[i][iEtapa] || '').trim().toUpperCase();
      if (etapa !== 'CANCELADO') {
        var codigo = iCodigoEst >= 0 ? String(rows[i][iCodigoEst] || '').trim() : '';
        if (codigo && pagosB1[codigo]) {
          if (pagosB1[codigo] < inicioSem) continue;  // matrícula pagada antes de esta semana → fuera
        }
      }
    }

    prospectos.push(obj);
  }

  return {
    ok:         true,
    prospectos: prospectos,
    total:      prospectos.length,
    resumen:    _calcularResumenMatriculas(ss, totalProspectosNoActivos),  // v4.30.1
  };
}

// ────────────────────────────────────────────────────────────
// v4.30.1 — Resumen para la vista Matrículas (Cambio 6)
// Devuelve activos por nivel (CA en ESTATUS, deduplicado por CODIGO),
// total de activos y de prospectos no activos, más tasa de conversión.
// ────────────────────────────────────────────────────────────
function _calcularResumenMatriculas(ss, totalProspectosNoActivos) {
  var wsE   = ss.getSheetByName(SH.ESTATUS);
  if (!wsE) return _resumenMatriculasVacio(ss);

  var rows  = wsE.getDataRange().getValues();
  var H     = rows[0];
  var iCod  = H.indexOf('CODIGO');
  var iNiv  = H.indexOf('NIVEL');
  var iEst  = H.indexOf('ESTATUS');
  if (iCod === -1 || iNiv === -1 || iEst === -1) return _resumenMatriculasVacio(ss);

  // Dedup: el mismo CODIGO en el mismo NIVEL solo cuenta 1 vez
  // (por si hay varias filas históricas con CA — aunque no debería).
  var seen = {};
  var porNivel = { B1: 0, B2: 0, I1: 0, I2: 0 };
  var totalActivos = 0;

  for (var i = 1; i < rows.length; i++) {
    var est = String(rows[i][iEst] || '').trim().toUpperCase();
    if (est !== 'CA') continue;
    var cod   = String(rows[i][iCod] || '').trim();
    var nivel = String(rows[i][iNiv] || '').trim().toUpperCase();
    if (!cod || !nivel) continue;

    var key = cod + '||' + nivel;
    if (seen[key]) continue;
    seen[key] = true;

    if (porNivel.hasOwnProperty(nivel)) porNivel[nivel]++;
    totalActivos++;
  }

  var totalParaConversion = totalActivos + (totalProspectosNoActivos || 0);
  var tasa = totalParaConversion > 0
    ? Math.round((totalActivos / totalParaConversion) * 1000) / 10  // 1 decimal
    : 0;

  return {
    activos_por_nivel:           porNivel,                  // {B1,B2,I1,I2} — para compatibilidad
    total_activos:               totalActivos,
    total_prospectos_no_activos: totalProspectosNoActivos || 0,
    tasa_conversion:             tasa,                      // ej. 38.5 (porcentaje)
    grupos_abiertos:             _calcularGruposAbiertos(ss),         // v4.30.2
    grupos_con_matriculados:     _calcularGruposConMatriculados(ss),  // v4.31.0
    asesores_resumen:            _calcularAsesoresResumen(ss),        // v4.31.0
  };
}

// ────────────────────────────────────────────────────────────
// v4.31.0 — Distribución de matriculados por grupo
// v4.33.1 — Refactor: usa ESTATUS (no DATOS) porque DATOS no tiene un campo
//           confiable de "estado activo" (ESTADO_EST está vacío en activación
//           nueva, y ESTADO simplemente no existe en el schema real de DATOS).
//           ESTATUS sí tiene ESTATUS=CA por estudiante+nivel.
// Lista de grupos con al menos 1 estudiante CA en ESTATUS, con cupo disponible.
// Un estudiante cuenta solo 1 vez por grupo (deduplicado por CODIGO+GRUPO),
// aunque tenga varios niveles activos (CA) en ese grupo.
// ────────────────────────────────────────────────────────────
function _calcularGruposConMatriculados(ss) {
  // v4.33.3 — Solo grupos con DISPONIBLE_INSCRIPCION=TRUE.
  // Regla absoluta: si DISPONIBLE_INSCRIPCION=FALSE, NO se muestra en ningún
  // lado de la vista Matrículas, independientemente de matriculados.
  var gruposVisibles = {};  // {codigo_grupo: capacidad}
  var wsG = ss.getSheetByName(SH.GRUPOS);
  if (wsG && wsG.getLastRow() > 1) {
    var gRows = wsG.getDataRange().getValues();
    var gH    = gRows[0];
    var iGCod = gH.indexOf('CODIGO_GRUPO');
    var iGCap = gH.indexOf('CAPACIDAD');
    var iGDis = gH.indexOf('DISPONIBLE_INSCRIPCION');
    for (var i = 1; i < gRows.length; i++) {
      var cod = String(gRows[i][iGCod] || '').trim();
      if (!cod || gruposVisibles[cod]) continue;
      if (iGDis >= 0) {
        var dispRaw = gRows[i][iGDis];
        var disp = dispRaw === true || String(dispRaw).trim().toUpperCase() === 'TRUE';
        if (!disp) continue;
      }
      gruposVisibles[cod] = parseInt(gRows[i][iGCap]) || 20;
    }
  }

  // Contar estudiantes ÚNICOS con al menos 1 fila CA en ESTATUS por grupo,
  // SOLO si el grupo está en la lista visible.
  var matPorGrupo = {};
  var wsE = ss.getSheetByName(SH.ESTATUS);
  if (wsE && wsE.getLastRow() > 1) {
    var eRows = wsE.getDataRange().getValues();
    var eH    = eRows[0];
    var iEGr  = eH.indexOf('GRUPO');
    var iECod = eH.indexOf('CODIGO');
    var iEEs  = -1;
    for (var k = 0; k < eH.length; k++) {
      if (String(eH[k]).trim().toUpperCase() === 'ESTATUS') { iEEs = k; break; }
    }

    if (iEGr >= 0 && iECod >= 0 && iEEs >= 0) {
      var vistos = {};
      for (var i = 1; i < eRows.length; i++) {
        var grupo  = String(eRows[i][iEGr]  || '').trim();
        if (!gruposVisibles[grupo]) continue;  // ignorar si no visible
        var codigo = String(eRows[i][iECod] || '').trim();
        var estado = String(eRows[i][iEEs]  || '').trim().toUpperCase();
        if (!codigo || estado !== 'CA') continue;

        var key = grupo + '|' + codigo;
        if (vistos[key]) continue;
        vistos[key] = true;

        matPorGrupo[grupo] = (matPorGrupo[grupo] || 0) + 1;
      }
    }
  }

  // Devolver TODOS los grupos visibles (con o sin matriculados — el frontend
  // los muestra todos, con conteo 0 si no hay matriculados aún)
  return Object.keys(gruposVisibles).map(function(cod) {
    var cap = gruposVisibles[cod];
    var mat = matPorGrupo[cod] || 0;
    return {
      codigo:          cod,
      capacidad:       cap,
      matriculados:    mat,
      cupo_disponible: Math.max(0, cap - mat),
    };
  }).sort(function(a, b) {
    return a.codigo.localeCompare(b.codigo);
  });
}

// ────────────────────────────────────────────────────────────
// v4.31.0 — Resumen por asesor (para vista Matrículas)
// Por cada asesor activo (rol='ventas' en USUARIOS), calcula:
//   - prospectos:  PROSPECTOS con ASESOR_REF=nombre, sin CODIGO_ESTUDIANTE,
//                  ETAPA != CANCELADO. O sea: leads / en proceso, no activados.
//   - mat_semana:  PROSPECTOS con ASESOR_REF=nombre, con CODIGO_ESTUDIANTE,
//                  cuya fecha de activación (la más reciente entre F_ACTIVO,
//                  F_PAGO_ACADEMIA, F_SOLICITUD) está dentro de los últimos 7d.
//   - mat_mes:     idem, dentro de los últimos 30d.
//   - rendimiento: mat_mes / (mat_mes + prospectos) * 100. Métrica simple
//                  que premia conversión sin penalizar a quien no tiene leads
//                  acumulados.
//
// Ordenado por mat_mes descendente.
// Match contra ASESOR_REF es case-insensitive con normalización mínima.
// ────────────────────────────────────────────────────────────
function _calcularAsesoresResumen(ss) {
  var wsU = ss.getSheetByName(SH.USUARIOS);
  if (!wsU || wsU.getLastRow() <= 1) return [];

  var uRows = wsU.getDataRange().getValues();
  var uH    = uRows[0];
  var iUUser = -1, iUNombre = -1, iURol = -1, iUActivo = -1;
  for (var k = 0; k < uH.length; k++) {
    var hn = String(uH[k]).trim().toLowerCase();
    if (hn === 'usuario') iUUser   = k;
    if (hn === 'nombre')  iUNombre = k;
    if (hn === 'rol')     iURol    = k;
    if (hn === 'activo')  iUActivo = k;
  }

  if (iUNombre === -1 || iURol === -1) return [];

  // Cargar asesores activos
  var asesoresMap = {};
  for (var u = 1; u < uRows.length; u++) {
    var rol = String(uRows[u][iURol] || '').trim().toLowerCase();
    if (rol !== 'ventas') continue;

    if (iUActivo >= 0) {
      var act = String(uRows[u][iUActivo] || '').trim().toUpperCase();
      if (act !== 'TRUE' && act !== 'SI' && act !== 'YES' && act !== '1') continue;
    }

    var nombre = String(uRows[u][iUNombre] || '').trim();
    if (!nombre) continue;

    var cedula = iUUser >= 0
      ? String(uRows[u][iUUser] || '').replace(/[-\s]/g,'').trim()
      : '';

    asesoresMap[nombre.toUpperCase()] = {
      nombre:      nombre,
      cedula:      cedula,
      prospectos:  0,    // sin código + con código pero sin pago de matrícula B1
      mat_semana:  0,    // pago de matrícula B1 en últimos 7 días
      mat_mes:     0,    // pago de matrícula B1 en últimos 30 días
      rendimiento: 0,
    };
  }

  // v4.33.0 — Indexar OTROS_PAGOS para encontrar pagos de matrícula B1 por
  // estudiante. ncuenta=60 es la huella de "matrícula B1 pagada" según el
  // schema de aplicarPago. Solo cuando existe esta fila, la comisión del
  // asesor se considera ganada.
  var pagosMatriculaB1 = {};  // {codigoEstudiante: fechaPagoMasReciente}
  var wsO = ss.getSheetByName(SH.OTROS_PAGOS);
  if (wsO && wsO.getLastRow() > 1) {
    var oRows = wsO.getDataRange().getValues();
    var oH    = oRows[0];

    // OTROS_PAGOS schema: LLAVE|nombre|descripcion|monto|fecha|USUARIO|RECIBO|grupo|ncuenta|Codigo|TipoRecibo
    var iOFecha = -1, iONcu = -1, iOCod = -1, iODesc = -1;
    for (var k = 0; k < oH.length; k++) {
      var hn = String(oH[k]).trim().toLowerCase();
      if (hn === 'fecha')        iOFecha = k;
      if (hn === 'ncuenta')      iONcu   = k;
      if (hn === 'codigo')       iOCod   = k;
      if (hn === 'descripcion')  iODesc  = k;
    }

    for (var i = 1; i < oRows.length; i++) {
      var nc = String(oRows[i][iONcu] || '').trim();
      // Fallback: si ncuenta no es 60 pero descripción contiene MATRICULA_B1,
      // también cuenta (compatibilidad con pagos viejos)
      var esMatB1 = (nc === '60');
      if (!esMatB1 && iODesc >= 0) {
        var desc = String(oRows[i][iODesc] || '').toUpperCase();
        esMatB1 = desc.indexOf('MATRICULA_B1') >= 0 || desc.indexOf('MATRICULA-B1') >= 0;
      }
      if (!esMatB1) continue;

      var codEst = String(oRows[i][iOCod] || '').trim();
      if (!codEst) continue;

      var raw = oRows[i][iOFecha];
      var fp = null;
      if (raw instanceof Date) fp = raw;
      else if (raw && String(raw).trim()) {
        fp = new Date(raw);
        if (isNaN(fp.getTime())) fp = null;
      }
      if (!fp) continue;

      // Quedarse con la fecha más reciente si hay múltiples pagos por el mismo código
      if (!pagosMatriculaB1[codEst] || fp > pagosMatriculaB1[codEst]) {
        pagosMatriculaB1[codEst] = fp;
      }
    }
  }

  // Recorrer PROSPECTOS, atribuyendo a cada asesor
  var wsP = ss.getSheetByName('PROSPECTOS');
  if (wsP && wsP.getLastRow() > 1) {
    var pRows = wsP.getDataRange().getValues();
    var pH    = pRows[0];
    var iPAse = pH.indexOf('ASESOR_REF');
    var iPCod = pH.indexOf('CODIGO_ESTUDIANTE');
    var iPEta = pH.indexOf('ETAPA');

    var ahora   = new Date();
    var hace7d  = new Date(ahora.getTime() - 7  * 24 * 60 * 60 * 1000);
    var hace30d = new Date(ahora.getTime() - 30 * 24 * 60 * 60 * 1000);

    for (var i = 1; i < pRows.length; i++) {
      var aseRaw = String(pRows[i][iPAse] || '').trim();
      if (!aseRaw) continue;
      var aseKey = aseRaw.toUpperCase();
      if (!asesoresMap[aseKey]) continue;

      var codigo = String(pRows[i][iPCod] || '').trim();
      var etapa  = String(pRows[i][iPEta] || '').trim().toUpperCase();
      if (etapa === 'CANCELADO') continue;

      // v4.33.0 — Lógica de clasificación corregida:
      //   1. Sin CODIGO_ESTUDIANTE → prospecto (lead/en proceso)
      //   2. Con CODIGO_ESTUDIANTE pero SIN pago de matrícula B1 → prospecto
      //      (matrícula generada pero no pagada, comisión aún NO ganada)
      //   3. Con CODIGO_ESTUDIANTE y CON pago de matrícula B1 → matrícula
      //      activa. Cuenta en mat_semana/mat_mes según fecha del pago.

      if (!codigo) {
        asesoresMap[aseKey].prospectos++;
        continue;
      }

      var fechaPago = pagosMatriculaB1[codigo];
      if (!fechaPago) {
        // Matrícula generada pero matrícula B1 sin pagar → sigue siendo prospecto
        asesoresMap[aseKey].prospectos++;
        continue;
      }

      // Matrícula B1 pagada — comisión ganada. Contar según fecha del pago.
      if (fechaPago >= hace30d) asesoresMap[aseKey].mat_mes++;
      if (fechaPago >= hace7d)  asesoresMap[aseKey].mat_semana++;
    }
  }

  // Calcular rendimiento y armar array
  var out = [];
  for (var ky in asesoresMap) {
    if (!asesoresMap.hasOwnProperty(ky)) continue;
    var a = asesoresMap[ky];
    var totalCarga = a.prospectos + a.mat_mes;
    a.rendimiento = totalCarga > 0
      ? Math.round((a.mat_mes / totalCarga) * 1000) / 10  // 1 decimal
      : 0;
    out.push(a);
  }

  return out.sort(function(a, b) {
    if (b.mat_mes !== a.mat_mes) return b.mat_mes - a.mat_mes;
    return b.prospectos - a.prospectos;
  });
}

// ────────────────────────────────────────────────────────────
// v4.30.2 — Lista de grupos abiertos para inscripción
// (FECHA_INICIO >= hoy en su primer nivel B1, con cupo real
// calculado contra estudiantes activos en DATOS y reservas en
// PROSPECTOS).
// Devuelve array ordenado por fecha_inicio ascendente.
// ────────────────────────────────────────────────────────────
function _calcularGruposAbiertos(ss) {
  var hoy = new Date();
  hoy.setHours(0,0,0,0);

  var wsG = ss.getSheetByName(SH.GRUPOS);
  if (!wsG) return [];
  var gRows = wsG.getDataRange().getValues();
  var gH    = gRows[0];

  var iCod   = gH.indexOf('CODIGO_GRUPO');
  var iNiv   = gH.indexOf('NIVEL_INICIO');
  var iFecha = gH.indexOf('FECHA_INICIO');
  var iCap   = gH.indexOf('CAPACIDAD');
  var iDias  = gH.indexOf('DIAS');
  var iHIni  = gH.indexOf('HORA_INI');
  var iHFin  = gH.indexOf('HORA_FIN');
  var iProg  = gH.indexOf('PROGRAMA');
  var iMod   = gH.indexOf('MODALIDAD');
  var iDoc   = gH.indexOf('DOCENTE');
  // v4.32.1 — precios desde GRUPOS para el modal Generar Matrícula
  var iPC    = gH.indexOf('PRECIO_CUOTA');
  var iPM    = gH.indexOf('PRECIO_MATRICULA');
  var iPCer  = gH.indexOf('PRECIO_CERTIFICADO');
  // v4.33.3 — fuente de verdad: solo grupos con DISPONIBLE_INSCRIPCION=TRUE
  var iDisp  = gH.indexOf('DISPONIBLE_INSCRIPCION');

  // v4.33.2 — Helper: deriva hora de inicio/fin del CÓDIGO del grupo, no de
  // la celda. Más confiable que leer Date desde Sheets (que tenía bugs raros
  // de timezone con offsets no-enteros).
  //
  // Segundo segmento del código contiene el código de horario:
  //   18 = 18:00 (6pm tarde — formato 24h)
  //   69 = 18:00 (6pm tarde — formato 12h "6 a 9")
  //   94 = 09:00 (9am mañana — formato 12h "9 a 12")
  //
  // Duración según modalidad: INTENSIVO=3h, SUPER_INTENSIVO=6h.
  //
  // Si el código no matchea (caso borde), fallback a leer la celda con
  // timezone CR. Si esa también falla, devuelve vacío.
  var HORAS_INICIO_CODIGO = {
    '18': 18, '69': 18,
    '94': 9,
  };

  function derivarHorasDeCodigo(codigoGrupo, modalidad) {
    var m = /^[A-Z]\d?-[A-Z]+(\d+)-/i.exec(String(codigoGrupo || ''));
    if (!m) return null;
    var hi = HORAS_INICIO_CODIGO[m[1]];
    if (typeof hi !== 'number') return null;
    var dur = (String(modalidad || '').trim().toUpperCase() === 'SUPER_INTENSIVO') ? 6 : 3;
    var hf = hi + dur;
    function fmt(h) { return (h < 10 ? '0' : '') + h + ':00'; }
    return { ini: fmt(hi), fin: fmt(hf) };
  }

  function fmtHora(v) {
    if (v instanceof Date) return Utilities.formatDate(v, 'America/Costa_Rica', 'HH:mm');
    return String(v || '').trim();
  }

  // Index: solo las filas del primer nivel del grupo (B1), con
  // DISPONIBLE_INSCRIPCION=TRUE (regla absoluta — fuente de verdad).
  var grupoMap = {};
  for (var i = 1; i < gRows.length; i++) {
    var cod = String(gRows[i][iCod] || '').trim();
    if (!cod) continue;
    var nivel = String(gRows[i][iNiv] || '').trim().toUpperCase();
    if (nivel !== 'B1') continue;  // solo fila de arranque del grupo

    // v4.33.3 — Regla absoluta: DISPONIBLE_INSCRIPCION=TRUE → se muestra; FALSE → no.
    if (iDisp >= 0) {
      var dispRaw = gRows[i][iDisp];
      var disp = dispRaw === true || String(dispRaw).trim().toUpperCase() === 'TRUE';
      if (!disp) continue;
    }

    var rawF  = gRows[i][iFecha];
    var fecha = new Date(rawF);
    if (isNaN(fecha.getTime())) continue;
    fecha.setHours(0,0,0,0);
    // v4.34.2 — Removido filtro `fecha < hoy`. Regla absoluta: solo manda
    // DISPONIBLE_INSCRIPCION. Si el director deja TRUE un grupo con fecha
    // pasada (porque aún le queda cupo abierto), aparece. Decisión del
    // superadmin, no del backend.

    var horasDerivadas = derivarHorasDeCodigo(cod, gRows[i][iMod]);

    grupoMap[cod] = {
      codigo:              cod,
      fecha_inicio:        Utilities.formatDate(fecha, 'America/Costa_Rica', 'yyyy-MM-dd'),
      capacidad:           parseInt(gRows[i][iCap]) || 20,
      dias:                String(gRows[i][iDias] || '').trim(),
      // v4.33.2 — preferir horas derivadas del código (más confiable que
      // la celda Date que tiene bugs raros de timezone)
      hora_ini:            horasDerivadas ? horasDerivadas.ini : fmtHora(gRows[i][iHIni]),
      hora_fin:            horasDerivadas ? horasDerivadas.fin : fmtHora(gRows[i][iHFin]),
      programa:            String(gRows[i][iProg] || '').trim().toUpperCase(),
      modalidad:           String(gRows[i][iMod]  || '').trim().toUpperCase(),
      docente:             String(gRows[i][iDoc]  || '').trim(),
      // v4.32.1 — precios base (sin beca) para preview en modal Generar Matrícula
      precio_cuota:        iPC   >= 0 ? (parseFloat(gRows[i][iPC])   || 0) : 0,
      precio_matricula:    iPM   >= 0 ? (parseFloat(gRows[i][iPM])   || 0) : 0,
      precio_certificado:  iPCer >= 0 ? (parseFloat(gRows[i][iPCer]) || 0) : 0,
      activos:             0,
      reservas:            0,
    };
  }

  // Contar reservas en PROSPECTOS (etapa != ACTIVO/CANCELADO)
  var wsP = ss.getSheetByName('PROSPECTOS');
  if (wsP && wsP.getLastRow() > 1) {
    var pRows = wsP.getDataRange().getValues();
    var pH    = pRows[0];
    var iPGT  = pH.indexOf('GRUPO_TENTATIVO');
    var iPET  = pH.indexOf('ETAPA');
    for (var i = 1; i < pRows.length; i++) {
      var grupo = String(pRows[i][iPGT] || '').trim();
      if (!grupoMap[grupo]) continue;
      var etapa = String(pRows[i][iPET] || '').trim().toUpperCase();
      if (etapa === 'ACTIVO' || etapa === 'CANCELADO') continue;
      grupoMap[grupo].reservas++;
    }
  }

  // v4.33.1 — Contar estudiantes ACTIVOS por grupo desde ESTATUS (no DATOS,
  // que no tiene ESTADO confiable). Deduplicado por CODIGO+GRUPO.
  // (Los grupos abiertos para inscripción raramente tendrán activos, pero
  // mantenemos el cálculo por consistencia con el cupo_disponible.)
  var wsE = ss.getSheetByName(SH.ESTATUS);
  if (wsE && wsE.getLastRow() > 1) {
    var eRows = wsE.getDataRange().getValues();
    var eH    = eRows[0];
    var iEGr  = eH.indexOf('GRUPO');
    var iECod = eH.indexOf('CODIGO');
    var iEEs  = -1;
    for (var k = 0; k < eH.length; k++) {
      if (String(eH[k]).trim().toUpperCase() === 'ESTATUS') { iEEs = k; break; }
    }
    if (iEGr >= 0 && iECod >= 0 && iEEs >= 0) {
      var vistosAct = {};  // grupo|codigo dedup
      for (var i = 1; i < eRows.length; i++) {
        var grupo  = String(eRows[i][iEGr]  || '').trim();
        if (!grupoMap[grupo]) continue;
        var codigo = String(eRows[i][iECod] || '').trim();
        var estado = String(eRows[i][iEEs]  || '').trim().toUpperCase();
        if (!codigo || estado !== 'CA') continue;
        var key = grupo + '|' + codigo;
        if (vistosAct[key]) continue;
        vistosAct[key] = true;
        grupoMap[grupo].activos++;
      }
    }
  }

  // Calcular cupo disponible y devolver ordenado por fecha
  var arr = Object.keys(grupoMap).map(function(cod) {
    var g = grupoMap[cod];
    g.cupo_disponible = Math.max(0, g.capacidad - g.activos - g.reservas);
    return g;
  });
  arr.sort(function(a, b) {
    return a.fecha_inicio.localeCompare(b.fecha_inicio);
  });
  return arr;
}

function _resumenMatriculasVacio(ss) {
  return {
    activos_por_nivel:           { B1: 0, B2: 0, I1: 0, I2: 0 },
    total_activos:               0,
    total_prospectos_no_activos: 0,
    tasa_conversion:             0,
  };
}

// ============================================================
// INTEGRACIÓN CONAPE                                — v4.3
// ============================================================
//
// URL API: https://online.conape.go.cr/apex/conaws/WS/GetEstudiantesFinanciados
//          ?pusuario=<en Script Properties: CONAPE_USR>
//          &pclave=<en Script Properties: CONAPE_PWD>
//          (configurar con configurarConapeCredenciales)
//
// Respuesta XML:
//   <PRESTATARIOS>
//     <PRESTATARIO>
//       <NOMBRE_SEDE>ACADEMIA NORTEAMERICANA</NOMBRE_SEDE>
//       <CEDULA>117370599</CEDULA>
//       <NOMBRE>ABARCA CORDERO RAQUEL JAZMIN</NOMBRE>
//       <FECHA_ULT_DESEMBOLSO>01/05/2026</FECHA_ULT_DESEMBOLSO>
//       <NOM_CARRERA>INGLES CONVERSACIONAL</NOM_CARRERA>
//     </PRESTATARIO>
//   </PRESTATARIOS>
//
// FECHA_ULT_DESEMBOLSO formato: DD/MM/YYYY
//   DD = número de desembolso del período (01,02,03)
//   MM = mes del período (01=ene, 05=may, 09=sep, 11=nov)
//   YYYY = año
//   Vacío = aprobado sin desembolsos
//
// Hoja destino: CONAPE_SYNC en APOLLO_G3
// ============================================================

// ════════════════════════════════════════════════════════════════════
// CONAPE — credenciales en Script Properties (B1, v4.23.12)
// Antes (v4.23.11 y anteriores): URL completa con usuario/clave hardcodeada.
// Ahora: la URL se arma leyendo de PropertiesService → las credenciales
// quedan fuera del código fuente (no se filtran al compartir el .gs).
//
// PARA CONFIGURAR (correr UNA vez desde el editor):
//   configurarConapeCredenciales('TU_USUARIO', 'TU_CLAVE')
// Después, todas las llamadas a getConapeUrl() funcionan normal.
// ════════════════════════════════════════════════════════════════════
function getConapeUrl() {
  var props = PropertiesService.getScriptProperties();
  var usr = props.getProperty('CONAPE_USR');
  var pwd = props.getProperty('CONAPE_PWD');
  if (!usr || !pwd) {
    throw new Error('CONAPE no configurado. Corré configurarConapeCredenciales(usr, pwd) desde el editor.');
  }
  return 'https://online.conape.go.cr/apex/conaws/WS/GetEstudiantesFinanciados'
       + '?pusuario=' + encodeURIComponent(usr)
       + '&pclave='   + encodeURIComponent(pwd);
}

// Helper para guardar las credenciales (correr una sola vez desde el editor).
function configurarConapeCredenciales(usr, pwd) {
  if (!usr || !pwd) return { ok:false, error:'usr y pwd requeridos' };
  PropertiesService.getScriptProperties()
    .setProperty('CONAPE_USR', usr)
    .setProperty('CONAPE_PWD', pwd);
  return { ok:true, msg:'Credenciales CONAPE guardadas en Script Properties' };
}

var CONAPE_SYNC_HEADERS = [
  'CEDULA','NOMBRE','NUM_DESEMBOLSO','PERIODO_MES','PERIODO_ANIO',
  'FECHA_RAW','CODIGO_EST','GRUPO','ESTADO_CAMPUS',
  'ULTIMO_SYNC','NOVEDAD'
];

// ── Inicializar hoja CONAPE_SYNC ─────────────────────────────
function getOrCreateConapeSyncSheet(ss) {
  var ws = ss.getSheetByName('CONAPE_SYNC');
  if (!ws) {
    ws = ss.insertSheet('CONAPE_SYNC');
    ws.appendRow(CONAPE_SYNC_HEADERS);
    var hRange = ws.getRange(1, 1, 1, CONAPE_SYNC_HEADERS.length);
    hRange.setFontWeight('bold');
    hRange.setBackground('#0d47a1');
    hRange.setFontColor('#ffffff');
    ws.setFrozenRows(1);
    ws.setColumnWidth(2, 240); // NOMBRE
    ws.setColumnWidth(11, 180); // NOVEDAD
  }
  return ws;
}

// ── Parsear XML de CONAPE ────────────────────────────────────
function parsearXmlConape(xmlText) {
  var doc = XmlService.parse(xmlText);
  var root = doc.getRootElement();
  var prestatarios = root.getChildren('PRESTATARIO');
  var resultado = [];

  prestatarios.forEach(function(p) {
    var cedula     = (p.getChildText('CEDULA')             || '').trim();
    var nombre     = (p.getChildText('NOMBRE')             || '').trim();
    var fechaRaw   = (p.getChildText('FECHA_ULT_DESEMBOLSO')|| '').trim();

    var numDesembolso = '';
    var periodoMes    = '';
    var periodoAnio   = '';

    if (fechaRaw) {
      var partes = fechaRaw.split('/');
      if (partes.length === 3) {
        numDesembolso = partes[0]; // "01","02","03"
        periodoMes    = partes[1]; // "05" = mayo
        periodoAnio   = partes[2]; // "2026"
      }
    }

    resultado.push({
      cedula:         cedula,
      nombre:         nombre,
      numDesembolso:  numDesembolso,
      periodoMes:     periodoMes,
      periodoAnio:    periodoAnio,
      fechaRaw:       fechaRaw,
    });
  });

  return resultado;
}

// ── Cruzar con DATOS de APOLLO para obtener codigo y grupo ──
function cruzarConApollo(ss, prestatarios) {
  var wsDatos = ss.getSheetByName(SH.DATOS);
  var datRows = wsDatos.getDataRange().getValues();
  var datH    = datRows[0];
  var iCed    = datH.indexOf('CEDULA');
  var iCod    = datH.indexOf('CODIGO');
  var iGrp    = datH.indexOf('GRUPO');

  // Mapa cédula → {codigo, grupo}
  var mapaApollo = {};
  for (var i = 1; i < datRows.length; i++) {
    var ced = String(datRows[i][iCed] || '').replace(/[-\s]/g,'').trim();
    if (ced) {
      mapaApollo[ced] = {
        codigo: String(datRows[i][iCod] || '').trim(),
        grupo:  String(datRows[i][iGrp] || '').trim(),
      };
    }
  }

  prestatarios.forEach(function(p) {
    var ced = p.cedula.replace(/[-\s]/g,'');
    var match = mapaApollo[ced] || { codigo:'', grupo:'' };
    p.codigoEst = match.codigo;
    p.grupo     = match.grupo;
  });

  return prestatarios;
}

