  var wsAct = ssOp.getSheetByName('EXAM_ACTIVATIONS');
  var activationIds = {};
  if (wsAct && wsAct.getLastRow() >= 2) {
    var ad = wsAct.getDataRange().getValues();
    var ai = _ccF84_idxMap_(ad[0] || []);
