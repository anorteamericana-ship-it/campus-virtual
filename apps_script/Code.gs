  };
}

// ============================================================
// 1. getEstudiante(codigo)
// ============================================================
function getEstudiante(codigo) {
  if (!codigo) return { error: 'codigo requerido' };
  var ss = SpreadsheetApp.openById(SHEET_ID);

  var wsDatos     = ss.getSheetByName(SH.DATOS);
  var datosRows   = wsDatos.getDataRange().getValues();
  var datosHeader = datosRows[0];
  var estudiante  = null;

  // DATOS usa CODIGO como código de expediente (ej: 17024)
  // La columna CODIGO es el código de expediente
  var iRecM = datosHeader.indexOf('CODIGO');
  if (iRecM === -1) iRecM = datosHeader.indexOf('CODIGO'); // fallback

  for (var i = 1; i < datosRows.length; i++) {
    var cod = String(datosRows[i][iRecM] || '').trim();
    if (cod === String(codigo).trim()) {
      estudiante = {};
      for (var j = 0; j < datosHeader.length; j++) {
        estudiante[datosHeader[j]] = datosRows[i][j];
      }
      // Exponer como 'codigo' para el frontend
      estudiante['codigo_interno'] = cod;
      break;
    }
  }
  if (!estudiante) return { error: 'Estudiante no encontrado: ' + codigo };

  var wsEstatus     = ss.getSheetByName(SH.ESTATUS);
  var estatusRows   = wsEstatus.getDataRange().getValues();
  var estatusHeader = estatusRows[0];
  var niveles = {};

  for (var i = 1; i < estatusRows.length; i++) {
    var recM = String(estatusRows[i][estatusHeader.indexOf('CODIGO')] || '').trim();
    if (recM === String(codigo).trim()) {
      var nivel = String(estatusRows[i][estatusHeader.indexOf('NIVEL')] || '').trim();
      niveles[nivel] = {
        estatus:  estatusRows[i][estatusHeader.indexOf('ESTATUS')],
        nota:     estatusRows[i][estatusHeader.indexOf('NOTA')],
        llave:    estatusRows[i][estatusHeader.indexOf('LLAVE')],
        grupo:    estatusRows[i][estatusHeader.indexOf('GRUPO')],
        fechaMod: formatFecha(estatusRows[i][estatusHeader.indexOf('FECHA DE MODIFICION')]),
      };
    }
  }

  var wsPagos     = ss.getSheetByName(SH.PAGOS);
  var pagosRows   = wsPagos.getDataRange().getValues();
  var pagosHeader = pagosRows[0];
  var pagos = [];

  // FIX v4.23.4: la columna real se llama 'Concepto' (C mayús, resto minús).
  // indexOf('CONCEPTO') daba -1 → concepto vacío → cuotas no reconocidas.
  // Resolvemos el índice una vez, con fallback, igual que el resto del código.
  var _iPConc = pagosHeader.indexOf('Concepto');
  if (_iPConc === -1) _iPConc = pagosHeader.indexOf('CONCEPTO');
  if (_iPConc === -1) _iPConc = pagosHeader.indexOf('concepto');

  for (var i = 1; i < pagosRows.length; i++) {
    var cod2 = String(pagosRows[i][pagosHeader.indexOf('CODIGO')] || '').trim();
    if (cod2 === String(codigo).trim()) {
      pagos.push({
        fecha:    formatFecha(pagosRows[i][pagosHeader.indexOf('FECHA')]),
        recibo:   pagosRows[i][pagosHeader.indexOf('RECIBO')],
        monto:    pagosRows[i][pagosHeader.indexOf('PAGO')],
        grupo:    pagosRows[i][pagosHeader.indexOf('GRUPO')],
        concepto: _iPConc > -1 ? pagosRows[i][_iPConc] : '',
      });
    }
  }

  var wsOtros     = ss.getSheetByName(SH.OTROS_PAGOS);
  var otrosRows   = wsOtros.getDataRange().getValues();
  var otrosHeader = otrosRows[0];
  var otrosPagos  = [];

  // v4.15: leer por indexOf con fallback a índice fijo según schema real
  // Schema: [LLAVE?, nombre, descripcion, monto, fecha, USUARIO, recibo, grupo, ncuenta, Codigo, TipoRecibo]
  // Con LLAVE en col A (filas nuevas): A=LLAVE, B=nombre, C=desc, D=monto, E=fecha, F=usr, G=recibo, H=grupo, I=ncuenta, J=Codigo
  // Sin LLAVE (filas legacy):          A=nombre, B=desc, C=monto, D=fecha, E=usr, F=recibo, G=grupo, H=ncuenta, I=Codigo
  var _iOCod  = otrosHeader.indexOf('Codigo');
  if (_iOCod  === -1) _iOCod  = otrosHeader.indexOf('CODIGO');
  var _iODesc = otrosHeader.indexOf('descripcion');
  if (_iODesc === -1) _iODesc = otrosHeader.indexOf('DESCRIPCION');
  var _iOMon  = otrosHeader.indexOf('monto');
  if (_iOMon  === -1) _iOMon  = otrosHeader.indexOf('MONTO');
  var _iOFec  = otrosHeader.indexOf('fecha');
  if (_iOFec  === -1) _iOFec  = otrosHeader.indexOf('FECHA');
  var _iORec  = otrosHeader.indexOf('RECIBO');
  var _iOGrp  = otrosHeader.indexOf('grupo');
  if (_iOGrp  === -1) _iOGrp  = otrosHeader.indexOf('GRUPO');
  var _iONct  = otrosHeader.indexOf('ncuenta');

  for (var i = 1; i < otrosRows.length; i++) {
    var cod3 = _iOCod > -1 ? String(otrosRows[i][_iOCod] || '').trim() : '';
    if (cod3 === String(codigo).trim()) {
      otrosPagos.push({
        descripcion: _iODesc > -1 ? otrosRows[i][_iODesc] : '',
        monto:       _iOMon  > -1 ? otrosRows[i][_iOMon]  : 0,
        fecha:       formatFecha(_iOFec > -1 ? otrosRows[i][_iOFec] : ''),
        recibo:      _iORec  > -1 ? otrosRows[i][_iORec]  : '',
        grupo:       _iOGrp  > -1 ? otrosRows[i][_iOGrp]  : '',
        ncuenta:     _iONct  > -1 ? otrosRows[i][_iONct]  : '',
      });
    }
  }

  var wsGrupos     = ss.getSheetByName(SH.GRUPOS);
  var gruposRows   = wsGrupos.getDataRange().getValues();
  var gruposHeader = gruposRows[0];
  var grupoCode    = String(estudiante['GRUPO'] || '').trim();
  var grupoInfo    = null;

  for (var i = 1; i < gruposRows.length; i++) {
    var gc = String(gruposRows[i][gruposHeader.indexOf('CODIGO_GRUPO')] || '').trim();
    if (gc !== grupoCode) continue;
    if (!grupoInfo) grupoInfo = {};
    // Recoger todas las filas del grupo para calcular nivel activo HOY por fecha
    var rawFechaG = gruposRows[i][gruposHeader.indexOf('FECHA_INICIO')];
    var fechaGDate = new Date(rawFechaG);
    fechaGDate.setHours(0,0,0,0);
    var nivelG = String(gruposRows[i][gruposHeader.indexOf('NIVEL_INICIO')] || '').trim();
    if (!grupoInfo.__filas) grupoInfo.__filas = [];
    grupoInfo.__filas.push({ fecha: fechaGDate, nivel: nivelG });
    // Siempre actualizar con la última fila leída (para tener docente, días, etc.)
    for (var j = 0; j < gruposHeader.length; j++) {
      var val = gruposRows[i][j];
      if (gruposHeader[j] === 'HORA_INI' || gruposHeader[j] === 'HORA_FIN') {
        val = val instanceof Date
          ? (val.getUTCHours()<10?'0':'')+val.getUTCHours()+':'+(val.getUTCMinutes()<10?'0':'')+val.getUTCMinutes()
          : String(val).trim();
      }
      grupoInfo[gruposHeader[j]] = val;
    }
  }

  if (grupoInfo && grupoInfo.__filas) {
    // Nivel activo = fila con FECHA_INICIO <= hoy con mayor fecha
    var hoyG = new Date(); hoyG.setHours(0,0,0,0);
    var levelMap2 = { 'B1':'Básico I', 'B2':'Básico II', 'I1':'Intermedio I', 'I2':'Intermedio II' };
    grupoInfo.__filas.sort(function(a,b){ return a.fecha - b.fecha; });
    var nivelActivo = grupoInfo.__filas[0];
    grupoInfo.__filas.forEach(function(f) { if (f.fecha <= hoyG) nivelActivo = f; });
    grupoInfo.NIVEL_ACTUAL    = levelMap2[nivelActivo.nivel] || nivelActivo.nivel;
    grupoInfo.NIVEL_ACTUAL_ID = nivelActivo.nivel;
    grupoInfo.PERIODO_ACTUAL  = calcularPeriodoActual(grupoInfo);
    grupoInfo.PROXIMO_PERIODO = calcularProximoPeriodo(grupoInfo);
    delete grupoInfo.__filas;
  }

  var pendientes = calcularPendientes(estudiante, pagos, otrosPagos, niveles);

  // Calcular nivel_activo aquí para que el frontend no tenga que hacerlo
  var ORDEN_NIVE = ['B1','B2','I1','I2'];
  var nivel_activo =
    ORDEN_NIVE.find(function(n){ return (typeof niveles[n]==='object'?niveles[n].estatus:niveles[n])==='CA'; }) ||
    ORDEN_NIVE.slice().reverse().find(function(n){
      var s = typeof niveles[n]==='object'?niveles[n].estatus:niveles[n];
      return s==='APR'||s==='CNV';
    }) || '';
  var estatus_activo = nivel_activo ? (typeof niveles[nivel_activo]==='object'?niveles[nivel_activo].estatus:niveles[nivel_activo]) : '';

  // v4.40.7: contactos dinámicos desde USUARIOS por contexto del estudiante.
  // No se inventan teléfonos; si el rol no existe o no tiene teléfono válido, vuelve null.
  var contactosCampus = _an4407_getContactosCampusParaEstudiante_(estudiante);

  return {
    ok: true,
    estudiante:    estudiante,
    niveles:       niveles,
    nivel_activo:  nivel_activo,
    estatus_activo:estatus_activo,
    pagos:         pagos,
    otrosPagos:    otrosPagos,
    grupo:         grupoInfo,
    cod_grupo:     grupoCode,   // string del código del grupo — usar para pagos
    pendientes:    pendientes,
    contactos_campus: contactosCampus,
    contacto_administracion: contactosCampus.contacto_administracion,
    contacto_academico: contactosCampus.contacto_academico,
    contacto_cobros: contactosCampus.contacto_cobros,
    contacto_ventas: contactosCampus.contacto_ventas,
    contacto_supervisor_ventas: contactosCampus.supervisor_ventas,
  };
}

// ============================================================
// 2. getComprobantes()
// ============================================================
// getComprobantes()
// Devuelve todos los comprobantes de BDBANCARIO con saldo disponible.
// El comprobante NO está vinculado al estudiante — el admin decide a quién aplicar.
// La columna 'estudiante' en BDBANCARIO se llena DESPUÉS de aplicar el pago.
// Un mismo comprobante puede usarse para pagar a distintos estudiantes
// (ej: una madre que paga por 2 hijos — aplica en 2 operaciones separadas).
function getComprobantes(params) {
  params = params || {};
  var ss     = SpreadsheetApp.openById(SHEET_ID);
  var ws     = ss.getSheetByName(SH.BDBANCARIO);
  var rows   = ws.getDataRange().getValues();
  var header = rows[0];

  var iDoc = -1, iFecha = -1, iDesc = -1;
  var iCredito = -1, iAplicado = -1, iEstud = -1;

  for (var c = 0; c < header.length; c++) {
    var h = String(header[c]).trim();
    if (h === 'estudiante')              iEstud    = c;
    if (h === 'Fecha Contable')          iFecha    = c;
    if (h === 'MONTO_APLICADO')          iAplicado = c;
    if (h.indexOf('Documento') > -1)     iDoc      = c;
    if (h.indexOf('scripci') > -1)       iDesc     = c;
    if (h.indexOf('dito') > -1 && h.substring(0,1) !== 'D') iCredito = c;
  }

  var comprobantes = [];
  for (var i = 1; i < rows.length; i++) {
    var credito  = parseFloat(rows[i][iCredito])  || 0;
    var aplicado = parseFloat(rows[i][iAplicado]) || 0;
    var saldo    = credito - aplicado;
    if (credito > 0 && saldo > 0) {
      comprobantes.push({
        rowIndex:    i + 1,
        doc:         String(rows[i][iDoc]   || '').trim(),
        fecha:       formatFecha(rows[i][iFecha]),
        descripcion: String(rows[i][iDesc]  || '').trim(),
        credito:     credito,
        aplicado:    aplicado,
        saldo:       saldo,
        estudiante:  String(rows[i][iEstud] || '').trim(),
      });
    }
  }
  return { ok: true, total: comprobantes.length, comprobantes: comprobantes };
}

