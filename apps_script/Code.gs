  var iReg = h.indexOf('REG_CERTIFICADOS');
  var iFecha = h.indexOf('FECHA DE MODIFICION');
  if (iCodigo < 0 || iNivel < 0 || iEstatus < 0 || iReg < 0) {
    return { ok:false, error:'ESTATUS no tiene columnas requeridas para certificados.' };
  }

  var llaveBuscar = codigo + grupo + nivel;
  for (var i = 1; i < rows.length; i++) {
    var r = rows[i];
    var ll = iLlave > -1 ? String(r[iLlave] || '').trim() : '';
    var cc = String(r[iCodigo] || '').trim();
    var gg = iGrupo > -1 ? String(r[iGrupo] || '').trim() : '';
    var nn = String(r[iNivel] || '').trim().toUpperCase();
    if (cc !== codigo || nn !== nivel) continue;
    if (grupo && gg && gg !== grupo && ll !== llaveBuscar) continue;
    return {
      ok:true,
      row:i + 1,
      ws:wsEst,
      headers:h,
      estatus:String(r[iEstatus] || '').trim().toUpperCase(),
      registro:String(r[iReg] || '').trim(),
      grupo: gg || grupo,
      indexRegistro:iReg,
      indexFecha:iFecha,
      raw:r
    };
  }
  return { ok:false, error:'No se encontró registro de ' + nivel + ' para el estudiante ' + codigo + '.' };
}

function buscarCertificadoExistente(data) {
  data = data || {};
  var codigo = String(data.codigo || data.cod_estudiante || data.rec_m || '').trim();
  var nivel  = String(data.nivel || '').trim().toUpperCase();
  var grupo  = String(data.grupo || data.cod_grupo || '').trim();
  var registro = String(data.registro || data.reg_certificados || '').trim();
  if (!codigo || !nivel) return { ok:false, error:'codigo y nivel son requeridos' };

  var ss = SpreadsheetApp.openById(SHEET_ID);
  var estData = getEstudiante(codigo);
  if (!estData || !estData.ok) return { ok:false, error: estData && estData.error ? estData.error : 'No se encontró estudiante.' };
  var est = estData.estudiante || {};
  var nombre = String(est.NOMBRE || est['NOMBRE'] || '').trim();
  var cedula = String(est.NUM_CEDULA || est.CEDULA || est['NUM_CEDULA'] || '').trim();
  var nombreOficial = _certF25NombreOficial_(nivel, codigo, cedula);

  if (!registro) {
    var loc = _certF25LocalizarEstatus_(ss, codigo, nivel, grupo);
    if (loc && loc.ok) {
      registro = String(loc.registro || '').trim();
      if (!grupo) grupo = String(loc.grupo || '').trim();
    }
  }

  var encontrados = [];
  var folder = null;
  try {
    folder = obtenerOCrearCarpeta(codigo, nombre, grupo, nivel);
  } catch(e) {
    folder = null;
  }

  // 1) Búsqueda exacta en carpeta oficial del grupo/nivel.
  if (folder) {
    var exactIt = folder.getFilesByName(nombreOficial);
    while (exactIt.hasNext()) encontrados.push(exactIt.next());

    // 2) Fallback dentro de la carpeta: mismo estudiante/nivel aunque el nombre tenga firmado/sellado.
    if (!encontrados.length) {
      var filesIt = folder.getFiles();
      var nKey = _certF25NivelNombre_(nivel).replace(/\s+/g, '');
      while (filesIt.hasNext()) {
        var f = filesIt.next();
        var nm = String(f.getName() || '').toUpperCase();
        var nmCompact = nm.replace(/\s+/g, '');
        if (nm.indexOf('CERTIFICADO') > -1 && nm.indexOf(codigo.toUpperCase()) > -1 && nmCompact.indexOf(nKey.toUpperCase()) > -1) {
          encontrados.push(f);
        } else if (cedula && nm.indexOf('CERTIFICADO') > -1 && nm.indexOf(cedula.toUpperCase()) > -1 && nmCompact.indexOf(nKey.toUpperCase()) > -1) {
          encontrados.push(f);
        }
      }
    }
  }

  // 3) Fallback global Drive por nombre exacto. Útil si subieron el firmado fuera de la carpeta.
  if (!encontrados.length) {
    try {
      var q = "title = '" + nombreOficial.replace(/'/g, "\\'") + "' and trashed = false";
      var searchIt = DriveApp.searchFiles(q);
      while (searchIt.hasNext()) encontrados.push(searchIt.next());
    } catch(e2) {}
  }

  var elegido = _certF25ElegirMasReciente_(encontrados);
  if (!elegido) {
    return {
      ok:false,
      error:'certificado_no_encontrado',
      mensaje:'No encontré un PDF con el nombre oficial. Verifique si el certificado firmado fue subido a Drive con el mismo nombre.',
      nombre_esperado:nombreOficial,
      registro:registro,
      search_url:_certF25DriveSearchUrl_(nombreOficial)
    };
  }

  var info = _certF25ArchivoInfo_(elegido);
  var duplicados = encontrados.length;
  var nombreUp = String(info.nombre || '').toUpperCase();
  var firmadoProbable = duplicados > 1 || nombreUp.indexOf('FIRM') > -1 || nombreUp.indexOf('SELL') > -1 || nombreUp.indexOf('SELLO') > -1;
  return {
    ok:true,
    existente:true,
    url:info.url,
    file_id:info.id,
    nombre:info.nombre,
    nombre_esperado:nombreOficial,
    registro:registro,
    nivel:nivel,
    codigo:codigo,
    duplicados:duplicados,
    firmado_probable:firmadoProbable,
    mensaje: duplicados > 1
      ? 'Se encontraron ' + duplicados + ' PDFs; se abrió el más reciente para respetar el firmado/sellado.'
      : 'PDF existente localizado. No se generó una copia nueva.'
  };
}

// Override seguro de generarCertificado.
// Si existe REG_CERTIFICADOS, NO regenera: busca el PDF existente.
// Para regenerar con el mismo número, se debe enviar forzar_generar:true explícitamente.
function generarCertificado(data) {
  data = data || {};
  var codigo = String(data.codigo || '').trim();
  var nivel  = String(data.nivel  || '').trim().toUpperCase();
  var grupo  = String(data.grupo  || '').trim();
  if (!codigo || !nivel) return { ok:false, error:'codigo y nivel son requeridos' };

  var ss = SpreadsheetApp.openById(SHEET_ID);
  var loc = _certF25LocalizarEstatus_(ss, codigo, nivel, grupo);
  if (!loc.ok) return loc;
  if (loc.estatus !== 'APR') return { ok:false, error:'El nivel ' + nivel + ' debe estar APR para generar certificado. Estado actual: ' + loc.estatus };

  if (loc.registro) {
    var buscado = buscarCertificadoExistente({ codigo:codigo, nivel:nivel, grupo:grupo || loc.grupo, registro:loc.registro });
    if (buscado.ok) return buscado;
    if (data.forzar_generar === true) {
      var regen = generarPdfCertificado(ss, codigo, nivel, grupo || loc.grupo, loc.registro);
      if (!regen.ok) return regen;
      return { ok:true, url:regen.url, registro:loc.registro, nombre:regen.nombre, nivel:nivel, codigo:codigo, regenerado:true, mensaje:'PDF regenerado con el mismo registro existente. No se creó consecutivo nuevo.' };
    }
    buscado.registro = loc.registro;
    buscado.puede_regenerar_mismo_registro = true;
    return buscado;
  }

  // Calcular siguiente consecutivo por año usando todos los REG_CERTIFICADOS existentes.
  var wsEst = loc.ws;
  var rows = wsEst.getDataRange().getValues();
  var h = rows[0];
  var iReg = h.indexOf('REG_CERTIFICADOS');
  var anio = new Date().getFullYear();
  var maxSeq = 0;
  for (var i = 1; i < rows.length; i++) {
    var reg = String(rows[i][iReg] || '').trim();
    if (!reg) continue;
    var p = reg.split('-');
    if (p.length === 3 && (parseInt(p[2], 10) || 0) === anio) {
      var seq = parseInt(p[1], 10) || 0;
      if (seq > maxSeq) maxSeq = seq;
    }
  }
  var seqStr = String(maxSeq + 1);
  while (seqStr.length < 4) seqStr = '0' + seqStr;
  var nuevoReg = 'SJ01-' + seqStr + '-' + anio;

  if (loc.row > 0 && loc.indexRegistro > -1) {
    wsEst.getRange(loc.row, loc.indexRegistro + 1).setValue(nuevoReg);
    if (loc.indexFecha > -1) wsEst.getRange(loc.row, loc.indexFecha + 1).setValue(new Date());
  }

  var res = generarPdfCertificado(ss, codigo, nivel, grupo || loc.grupo, nuevoReg);
  if (!res.ok) return res;
  return { ok:true, url:res.url, registro:nuevoReg, nombre:res.nombre, nivel:nivel, codigo:codigo, creado:true, mensaje:'Certificado creado por primera vez.' };
}

// F32 limpieza: definición duplicada anterior de generarCertificadosNivel eliminada; se conserva la última definición activa.



// ============================================================
// CALGRUPO_F26_20260617_CERTIFICADOS_MASIVOS_SEGUROS_CONFIRMACION
// Certificados masivos seguros por nivel:
// - Primero permite vista previa/dry-run sin escribir nada.
// - Ejecuta solo si confirmar:true o modo:'ejecutar'.
// - Usa LockService para proteger el consecutivo durante el lote.
// - Nunca crea consecutivo nuevo si ya existe REG_CERTIFICADOS.
// - Los registrados sin PDF se reportan como sin_pdf; no se regeneran.
// ============================================================
function _certF26Bool_(v) {
  if (v === true) return true;
  if (v === false || v == null) return false;
  var s = String(v).trim().toUpperCase();
  if (!s || ['NO','FALSE','FALSO','0','PENDIENTE','—','-','N/A'].indexOf(s) > -1) return false;
  if (['SI','SÍ','TRUE','VERDADERO','PAGO','PAGADO','OK','1','X','✓'].indexOf(s) > -1) return true;
  var n = parseFloat(s.replace(',', '.'));
  return !isNaN(n) && n > 0;
}

function _certF26DetalleBase_(e, nivel, grupo) {
  e = e || {};
  return {
    codigo: String(e.codigo || e.CODIGO || e.cod_estudiante || '').trim(),
    nombre: String(e.nombre || e.display || e.NOMBRE || '').trim(),
    cedula: String(e.cedula || e.identificacion || e.NUM_CEDULA || '').trim(),
    grupo: String(e.grupo || e.GRUPO || grupo || '').trim(),
    nivel: nivel,
    estatus: String(e.estatus || e.status_actual || e.ESTATUS || '').trim().toUpperCase(),
    certificado_pagado: _certF26Bool_(e.certificado_pagado != null ? e.certificado_pagado : (e.certificadoPago != null ? e.certificadoPago : e.cert_pago)),
    registro: String(e.cert_num || e.reg_certificados || e.REG_CERTIFICADOS || e.registro_certificado || '').trim()
  };
}

function _certF26AnalizarNivel_(grupo, nivel, limite) {
  grupo = String(grupo || '').trim();
  nivel = String(nivel || '').trim().toUpperCase();
  limite = parseInt(limite || 0, 10) || 0;
  var rad = getRadiografiaGrupo(grupo);
  if (!rad || !rad.ok) return rad || { ok:false, error:'No se pudo leer radiografía del grupo.' };
  var lista = (rad.niveles && rad.niveles[nivel]) ? rad.niveles[nivel] : [];
  var resumen = {
    revisados:0,
    por_generar:0,
    generables:0,
    generados:0,
    ya_existentes:0,
    no_aptos:0,
    sin_pdf:0,
    errores:0
  };
  var detalle = [];

  for (var i = 0; i < lista.length; i++) {
    if (limite && resumen.revisados >= limite) break;
    var base = _certF26DetalleBase_(lista[i], nivel, grupo);
    resumen.revisados++;

    if (!base.codigo) {
      resumen.no_aptos++;
      base.ok = false;
      base.estado = 'no_apto';
      base.razon = 'Sin código de estudiante.';
      detalle.push(base);
      continue;
    }
    if (base.estatus !== 'APR' || !base.certificado_pagado) {
      resumen.no_aptos++;
      base.ok = false;
      base.estado = 'no_apto';
      base.razon = 'Requiere APR + certificado pagado.';
      detalle.push(base);
      continue;
    }

    if (base.registro) {
      var b = buscarCertificadoExistente({ codigo:base.codigo, nivel:nivel, grupo:base.grupo || grupo, registro:base.registro });
      if (b && b.ok) {
        resumen.ya_existentes++;
        base.ok = true;
        base.estado = 'existente';
        base.url = b.url || '';
        base.nombre_pdf = b.nombre || '';
        base.duplicados = b.duplicados || 0;
        base.firmado_probable = !!b.firmado_probable;
      } else {
        resumen.sin_pdf++;
        base.ok = false;
        base.estado = 'sin_pdf';
        base.error = (b && (b.mensaje || b.error)) || 'Tiene registro, pero no se localizó PDF.';
        base.search_url = b && b.search_url ? b.search_url : _certF25DriveSearchUrl_(_certF25NombreOficial_(nivel, base.codigo, base.cedula));
      }
      detalle.push(base);
      continue;
    }

    resumen.por_generar++;
    resumen.generables++;
    base.ok = true;
    base.estado = 'por_generar';
    base.razon = 'APR + certificado pagado + sin REG_CERTIFICADOS.';
    detalle.push(base);
  }

  return {
    ok:true,
    grupo:grupo,
    nivel:nivel,
    resumen:resumen,
    detalle:detalle,
    preview:true,
    requiere_confirmacion:true,
    mensaje:'Vista previa preparada. No se generó ningún certificado.'
  };
}

// Override F26 de generarCertificadosNivel.
// Llamada segura recomendada:
//   1) generarCertificadosNivel({grupo,nivel,dry_run:true})
//   2) generarCertificadosNivel({grupo,nivel,confirmar:true,modo:'ejecutar'})
function generarCertificadosNivel(data) {
  data = data || {};
  var grupo = String(data.grupo || data.cod_grupo || '').trim();
  var nivel = String(data.nivel || '').trim().toUpperCase();
  var limite = parseInt(data.limite || data.max || 0, 10) || 0;
  if (!grupo || !nivel) return { ok:false, error:'grupo y nivel son requeridos' };

  var confirmar = data.confirmar === true || String(data.confirmar || '').toUpperCase() === 'TRUE' || String(data.modo || '').toLowerCase() === 'ejecutar';
  var dryRun = data.dry_run === true || String(data.dry_run || '').toUpperCase() === 'TRUE' || !confirmar;

  var analisis = _certF26AnalizarNivel_(grupo, nivel, limite);
  if (!analisis || analisis.ok !== true) return analisis;

  if (dryRun) {
    analisis.dry_run = true;
    analisis.ejecucion = false;
    analisis.mensaje = 'Vista previa de certificados masivos. No se escribió nada. Confirmar para ejecutar.';
    return analisis;
  }

  var lock = LockService.getScriptLock();
  try {
    if (!lock.tryLock(30000)) {
      return { ok:false, error:'No se pudo obtener bloqueo de seguridad para certificados. Intente de nuevo en unos segundos.' };
    }

    var resumen = {
      revisados:0,
      por_generar: analisis.resumen.por_generar || 0,
      generados:0,
      ya_existentes:0,
      no_aptos:0,
      sin_pdf:0,
      errores:0
    };
    var detalle = [];
    var src = analisis.detalle || [];

    for (var i = 0; i < src.length; i++) {
      var d = src[i] || {};
      resumen.revisados++;

      if (d.estado === 'no_apto') {
        resumen.no_aptos++;
        detalle.push(d);
        continue;
      }
      if (d.estado === 'existente') {
        resumen.ya_existentes++;
        detalle.push(d);
        continue;
      }
      if (d.estado === 'sin_pdf') {
        resumen.sin_pdf++;
        detalle.push(d);
        continue;
      }
      if (d.estado !== 'por_generar') {
        resumen.errores++;
        d.ok = false;
        d.estado = 'error';
        d.error = d.error || 'Estado no reconocido para generación masiva.';
        detalle.push(d);
        continue;
      }

      try {
        var g = generarCertificado({ codigo:d.codigo, nivel:nivel, grupo:d.grupo || grupo });
        if (g && g.ok && g.creado) {
          resumen.generados++;
          d.ok = true;
          d.estado = 'generado';
          d.registro = g.registro || d.registro || '';
          d.url = g.url || '';
          d.nombre_pdf = g.nombre || '';
        } else if (g && g.ok) {
          // Si otro proceso lo generó entre la vista previa y la ejecución,
          // generarCertificado devuelve existente sin crear consecutivo nuevo.
          resumen.ya_existentes++;
          d.ok = true;
          d.estado = 'existente';
          d.registro = g.registro || d.registro || '';
          d.url = g.url || '';
          d.nombre_pdf = g.nombre || '';
        } else {
          resumen.errores++;
          d.ok = false;
          d.estado = 'error';
          d.error = (g && (g.mensaje || g.error)) || 'No se pudo generar certificado.';
        }
        detalle.push(d);
      } catch(err) {
        resumen.errores++;
        d.ok = false;
        d.estado = 'error';
        d.error = err && err.message ? err.message : String(err);
        detalle.push(d);
      }
    }

    return {
      ok:true,
      grupo:grupo,
      nivel:nivel,
      resumen:resumen,
      detalle:detalle,
      ejecucion:true,
      mensaje:'Generación masiva segura finalizada. Registros existentes no crearon consecutivo nuevo; registrados sin PDF quedaron reportados.'
    };
  } catch(e) {
    return { ok:false, error: e && e.message ? e.message : String(e) };
  } finally {
    try { lock.releaseLock(); } catch(_) {}
  }
}


