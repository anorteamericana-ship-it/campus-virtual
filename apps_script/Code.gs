      if (String(vals[r][iG] || '').trim() !== String(codGrupo || '').trim()) continue;
      if (iN >= 0 && nivel && _anF65_levelId_(vals[r][iN]) !== _anF65_levelId_(nivel)) continue;
      if (iT >= 0 && _anF65_text_(vals[r][iT]) === 'ICAN') continue;
