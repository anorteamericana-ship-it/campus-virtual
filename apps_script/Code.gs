    { order:5, fn:'examStartAttempt', payload:{ activation_id:'<ACTIVATION_ID_REAL>' }, expected:'crea intento propio solo si cronograma/rol/estudiante aplica.' },
    { order:6, fn:'examHeartbeatAttempt', payload:{ attempt_id:'<ATTEMPT_ID_REAL>' }, expected:'devuelve server_now, can_save/can_submit y tiempo restante coherente.' },
    { order:7, fn:'examSubmitAttempt', payload:{ attempt_id:'<ATTEMPT_ID_REAL>', answers:{}, auto_submit:'NO' }, expected:'entrega solo intento propio y dentro de tiempo.' }
  ];

  var result = {
    ok:true,
    version:'F49',
    server_now:_examNow_(),
    readonly:true,
    decision:decision,
    status_counts:statusCounts,
    area_summary:_examF49AreaSummary_(items),
    items:items,
    blockers:blockers,
    warnings:warnings,
    diagnostic_snapshot:{ counts:counts, issues:diagIssues, config:{ STUDENT_EXAMS_ENABLED:(config.STUDENT_EXAMS_ENABLED && config.STUDENT_EXAMS_ENABLED.value) || '', EXAM_PUSH_TO_NOTAS_ENABLED:(config.EXAM_PUSH_TO_NOTAS_ENABLED && config.EXAM_PUSH_TO_NOTAS_ENABLED.value) || '' } },
    signal_snapshot:{ total:signalRows.length, summary:signalSummary, top:signalRows.slice(0, 10) },
    manual_probes:manualProbes,
    final_note:'F49 no sustituye la prueba real. Solo indica si la estructura está lista para una única pasada QA manual.'
  };
  _examAudit_('QA_READINESS_READ', 'qa_readiness', 'F49', { decision:decision, status_counts:statusCounts, blockers:blockers.length, warnings:warnings.length }, actor, body);
  return result;
}


