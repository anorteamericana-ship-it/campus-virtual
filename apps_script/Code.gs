// ============================================================
// getPagosCampus(body)                              — v4.1
// GET ?fn=getPagosCampus&codigo_est=17055
// GET ?fn=getPagosCampus&grupo=B1-LM69-C3-0125
// GET ?fn=getPagosCampus&mes=2026-05   (YYYY-MM)
//
// Devuelve lista de pagos filtrada + resumen
// ============================================================
function getPagosCampus(params) {
  var ss = SpreadsheetApp.openById(SHEET_ID);
  var ws = getOrCreatePagosCampus(ss);
  var rows = ws.getDataRange().getValues();
  if (rows.length <= 1) return { ok: true, pagos: [], total: 0, count: 0 };

  var h = rows[0];
  var iTs   = h.indexOf('TIMESTAMP');
  var iFech = h.indexOf('FECHA');
  var iCod  = h.indexOf('CODIGO_EST');
  var iNom  = h.indexOf('NOMBRE');
  var iGrp  = h.indexOf('GRUPO');
  var iNiv  = h.indexOf('NIVEL');
  var iTipo = h.indexOf('TIPO');
  var iDesc = h.indexOf('DESCRIPCION');
  var iMon  = h.indexOf('MONTO');
  var iRec  = h.indexOf('RECIBO');
  var iBan  = h.indexOf('BANCO');
  var iRef  = h.indexOf('REF_BANCO');
  var iResp = h.indexOf('RESPONSABLE');
  var iConv = h.indexOf('CONVENIO');
  var iPer  = h.indexOf('PERIODO');

  var filtros = params || {};
  var pagos = [];
  var total = 0;

  for (var i = 1; i < rows.length; i++) {
    var r = rows[i];
    // Filtros opcionales
    if (filtros.codigo_est && String(r[iCod]).trim() !== String(filtros.codigo_est).trim()) continue;
    if (filtros.grupo      && String(r[iGrp]).trim() !== String(filtros.grupo).trim()) continue;
    if (filtros.mes) {
      var fechaStr = String(r[iFech]).trim();
      if (fechaStr.indexOf(filtros.mes) !== 0) continue;
    }
    if (filtros.tipo && String(r[iTipo]).trim() !== String(filtros.tipo).trim().toUpperCase()) continue;

    var monto = parseFloat(r[iMon]) || 0;
    total += monto;
    pagos.push({
      timestamp:   r[iTs],
      fecha:       r[iFech],
      codigo_est:  r[iCod],
      nombre:      r[iNom],
      grupo:       r[iGrp],
      nivel:       r[iNiv],
      tipo:        r[iTipo],
      descripcion: r[iDesc],
      monto:       monto,
      recibo:      r[iRec],
      banco:       r[iBan],
      ref_banco:   r[iRef],
      responsable: r[iResp],
      convenio:    r[iConv],
      periodo:     r[iPer],
    });
  }

  return { ok: true, pagos: pagos, total: total, count: pagos.length };
}

// ============================================================
// getResumenPagosCampus()                           — v4.1
// GET ?fn=getResumenPagosCampus
//
// KPIs financieros reales para el admin dashboard:
// ingresoMes, ingresoTotal, pagosPorTipo, pagosPorGrupo
// ============================================================
function getResumenPagosCampus() {
  var ss = SpreadsheetApp.openById(SHEET_ID);
  var ws = getOrCreatePagosCampus(ss);
  var rows = ws.getDataRange().getValues();
  if (rows.length <= 1) {
    return { ok: true, ingresoMes: 0, ingresoTotal: 0, pagosPorTipo: {}, pagosPorGrupo: {} };
  }

  var h = rows[0];
  var iFech = h.indexOf('FECHA');
  var iGrp  = h.indexOf('GRUPO');
  var iTipo = h.indexOf('TIPO');
  var iMon  = h.indexOf('MONTO');

  var hoy       = new Date();
  var mesActual = Utilities.formatDate(hoy, 'America/Costa_Rica', 'yyyy-MM');
  var ingresoMes   = 0;
  var ingresoTotal = 0;
  var porTipo  = {};
  var porGrupo = {};

  for (var i = 1; i < rows.length; i++) {
    var monto = parseFloat(rows[i][iMon]) || 0;
    var fecha = String(rows[i][iFech] || '').trim();
    var tipo  = String(rows[i][iTipo] || '').trim();
    var grupo = String(rows[i][iGrp]  || '').trim();

    ingresoTotal += monto;
    if (fecha.indexOf(mesActual) === 0) ingresoMes += monto;
    porTipo[tipo]   = (porTipo[tipo]   || 0) + monto;
    porGrupo[grupo] = (porGrupo[grupo] || 0) + monto;
  }

  return {
    ok:          true,
    ingresoMes:  ingresoMes,
    ingresoTotal: ingresoTotal,
    pagosPorTipo:  porTipo,
    pagosPorGrupo: porGrupo,
    mes:         mesActual,
  };
}

