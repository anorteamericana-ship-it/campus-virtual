// crearUsuarioEstudiante(body)                      — v4.2
// POST ?fn=crearUsuarioEstudiante
//
// Crea usuario en USUARIOS + prospecto en PROSPECTOS
// Valida que la cédula no exista ya como usuario
//
// Body:
// {
//   cedula, nombre, correo, whatsapp, clave,
//   provincia, canton, direccion, fecha_nac, mayor_edad,
//   rep_nombre, rep_cedula, rep_correo, rep_tel,
//   programa,       // INA | SIN_INA
//   financiamiento, // CONAPE | BECA_IMPACTA | PROPIO
//   beca,           // BECA_IMPACTA | blank
//   modalidad,      // CUATRIMESTRE | BIMESTRE
//   grupo_tentativo,
//   conape_toeic, conape_laptop, conape_sostenimiento, conape_monto_sos,
//   como_entero, asesor_ref
// }
// ============================================================
// ============================================================
// crearUsuarioEstudiante(body)                      — v4.29.0
// POST ?fn=crearUsuarioEstudiante
//
// v4.29.0: YA NO escribe en USUARIOS. La cuenta de USUARIOS se
// crea recién en activarEstudiante. La clave que el usuario eligió
// se guarda en PROSPECTOS.CLAVE hasta la activación.
//
// Bug histórico arreglado: antes buscaba columnas en MAYÚSCULAS
// (USUARIO/CLAVE/ROL/...) que en la hoja USUARIOS están en
// minúsculas, generando filas mochas con solo CEDULA/CORREO/
// FECHA_CREACION/ESTADO_CUENTA llenos.
//
// Validación de duplicados: case-insensitive contra
// PROSPECTOS.CEDULA y USUARIOS.usuario (columna real).
// ============================================================
function crearUsuarioEstudiante(body) {
  if (!body.cedula || !body.nombre || !body.clave) {
    return { ok: false, error: 'Faltan campos requeridos: cedula, nombre, clave' };
  }

  var ss  = SpreadsheetApp.openById(SHEET_ID);
  var cedLimpia = String(body.cedula).replace(/[-\s]/g,'').trim();

  // ── Verificar duplicado en DATOS (estudiante ya matriculado) ─
  // v4.40.3: la inscripción pública debe bloquear primero contra DATOS.
  var wsDatosDup = ss.getSheetByName(SH.DATOS);
  if (wsDatosDup && wsDatosDup.getLastRow() > 1) {
    var dDupRows = wsDatosDup.getDataRange().getValues();
    var dDupH = dDupRows[0];
    var iDupCed = _insFindHeader_(dDupH, ['NUM_CEDULA', 'CEDULA', 'cedula', 'NUMCEDULA', 'NUM CEDULA']);
    if (iDupCed >= 0) {
      for (var d = 1; d < dDupRows.length; d++) {
        var dCed = _insNormCedula_(dDupRows[d][iDupCed]);
        if (dCed === cedLimpia) {
          return {
            ok: false,
            error: 'cedula_duplicada_datos',
            mensaje: 'Esta cédula ya tiene un registro activo en la academia.'
          };
        }
      }
    }
  }

  // ── Verificar duplicado en USUARIOS (estudiantes activos) ────
  var wsU = ss.getSheetByName(SH.USUARIOS);
  if (wsU) {
    var usuRows  = wsU.getDataRange().getValues();
    var usuH     = usuRows[0];
    // Buscar la columna 'usuario' case-insensitive (la hoja tiene minúsculas)
    var iUsuarioU = -1;
    for (var k = 0; k < usuH.length; k++) {
      if (String(usuH[k]).trim().toLowerCase() === 'usuario') { iUsuarioU = k; break; }
    }
    if (iUsuarioU >= 0) {
      for (var i = 1; i < usuRows.length; i++) {
        var uExist = String(usuRows[i][iUsuarioU] || '').replace(/[-\s]/g,'').trim();
        if (uExist === cedLimpia) {
          return {
            ok: false,
            error: 'cedula_duplicada_usuario',
            mensaje: 'Esta cédula ya tiene una cuenta activa. Iniciá sesión.'
          };
        }
      }
    }
  }

  // ── Verificar duplicado en PROSPECTOS (inscripciones previas) ─
  // v4.40.3: si el prospecto previo está CANCELADO/CERRADO/DESCARTADO,
  // se permite iniciar una nueva inscripción. Si está activo/en proceso,
  // se bloquea para evitar duplicados.
  var wsPCheck = ss.getSheetByName('PROSPECTOS');
  if (wsPCheck) {
    var pCheckRows = wsPCheck.getDataRange().getValues();
    var pCheckH    = pCheckRows[0];
    var iPCed      = pCheckH.indexOf('CEDULA');
    var iPEtapa    = pCheckH.indexOf('ETAPA');
    var iPEstado   = pCheckH.indexOf('ESTADO_CUENTA');
    var iPCancel   = pCheckH.indexOf('CANCELADO_MOTIVO');
    if (iPCed >= 0) {
      for (var j = pCheckRows.length - 1; j >= 1; j--) {
        var pExist = String(pCheckRows[j][iPCed] || '').replace(/[-\s]/g,'').trim();
        if (pExist !== cedLimpia) continue;

        var estadoPrevio = [
          iPEtapa >= 0 ? pCheckRows[j][iPEtapa] : '',
          iPEstado >= 0 ? pCheckRows[j][iPEstado] : '',
          iPCancel >= 0 ? pCheckRows[j][iPCancel] : ''
        ].join(' ');

        if (_insIsCancelado_(estadoPrevio)) {
          // Hay registro previo cancelado; no bloquea. Puede existir uno más
          // antiguo activo, por eso seguimos revisando hacia arriba.
          continue;
        }

        return {
          ok: false,
          error: 'cedula_duplicada_prospecto',
          mensaje: 'Esta cédula ya tiene una inscripción en proceso. Comunicate con tu asesor.'
        };
      }
    }
  }

  // Estado inicial según financiamiento
  var financiamiento = String(body.financiamiento || 'PROPIO').trim().toUpperCase();
  var estadoCuenta   = financiamiento === 'CONAPE' ? 'PENDIENTE_CONAPE' : 'PENDIENTE_PAGO';

  var ahora = Utilities.formatDate(new Date(), 'America/Costa_Rica', 'yyyy-MM-dd HH:mm:ss');

  // ── USUARIOS: NO se escribe acá. Se crea recién en activarEstudiante.
  //   La clave del usuario se guarda en PROSPECTOS.CLAVE (al final del filaP).

  // ── PROSPECTOS ────────────────────────────────────────────
  var wsP = getOrCreateProspectos(ss);

  var esMenor     = body.es_menor === true || body.es_menor === 'true' || body.es_menor === 'SI';
  var tutorNombre = esMenor ? String(body.tutor_nombre || '').trim().toUpperCase() : '';
  var tutorCedula = esMenor ? String(body.tutor_cedula || '').trim()               : '';
  var tutorCorreo = esMenor ? String(body.tutor_correo || '').trim().toLowerCase() : '';
  var tutorTel    = esMenor ? String(body.tutor_tel    || '').trim()               : '';

  var conapeEquipo = String(body.conape_equipo || 'NINGUNO').trim().toUpperCase();
  var conapeToeic  = body.conape_toeic === true || body.conape_toeic === 'true' || body.conape_toeic === 'SI';
  // CALGRUPO_F55_20260618_TOEIC_MONTO_PROSPECTO_DESDE_GRUPO
  var conapeToeicMonto = conapeToeic ? (parseFloat(body.conape_toeic_monto || body.toeic_monto) || 0) : 0;
  var conapeSos    = String(body.conape_sostenimiento || '').trim();

  // v4.25.0 — Guardar fotos del prospecto en Drive
  // Estructura: DOCUMENTOS_ESTUDIANTES/{CEDULA}/INSCRIPCION/{tipo}.jpg
  var urlFotoCedFrente = '';
  var urlFotoCedDorso  = '';
  var urlFotoTitulo    = '';

  try {
    if (body.foto_ced_frente) {
      urlFotoCedFrente = _guardarFotoProspecto(cedLimpia, 'cedula_frente', body.foto_ced_frente);
    }
    if (body.foto_ced_dorso) {
      urlFotoCedDorso = _guardarFotoProspecto(cedLimpia, 'cedula_dorso', body.foto_ced_dorso);
    }
    if (body.foto_titulo) {
      urlFotoTitulo = _guardarFotoProspecto(cedLimpia, 'titulo', body.foto_titulo);
    }
  } catch (errFoto) {
    // Si fallan las fotos, no abortar el registro — solo loguear
    Logger.log('Error guardando fotos para ' + cedLimpia + ': ' + errFoto.message);
  }

  // v4.27.0 — Validar cupo del grupo antes de aceptar (tope 1.5×)
  var grupoElegido = String(body.grupo_tentativo || '').trim();
  if (grupoElegido) {
    var estadoCupo = _calcularEstadoCupoGrupo(ss, grupoElegido);
    if (estadoCupo === 'CERRADO') {
      return { ok: false, error: 'Grupo ' + grupoElegido + ' cerrado por cupo lleno. Elegí otro grupo.' };
    }
    if (estadoCupo === 'LISTA_ESPERA' && body.aceptar_lista_espera !== true) {
      return { ok: false, error: 'Grupo ' + grupoElegido + ' lleno de reservas (1.5× cupo). Esperá apertura siguiente.', estado_cupo: 'LISTA_ESPERA' };
    }
  }

  // v4.27.1 — Si trae beca elegida (sea cualquier financiamiento que la permita),
  // validar cupo y reservar antes de escribir. Las becas SOLO se aplican cuando
  // financiamiento es PROPIO (regla de negocio: CONAPE y becas son excluyentes).
  var becaElegida = String(body.beca || body.beca_propio || '').trim().toUpperCase();
  var becaEstado  = '';
  if (becaElegida && financiamiento === 'PROPIO') {
    var reservaBeca = _consumirCupoBeca(ss, becaElegida);
    if (!reservaBeca.ok) {
      return { ok: false, error: reservaBeca.error };
    }
    becaEstado = 'SOLICITADA'; // admin la aprueba a dedo después
  } else if (becaElegida && financiamiento !== 'PROPIO') {
    // Si vino beca pero financiamiento no es PROPIO, ignorar la beca silenciosamente
    becaElegida = '';
  }

  var filaP = [
    ahora,                                                           // TIMESTAMP
    cedLimpia,                                                       // CEDULA
    String(body.nombre          || '').trim().toUpperCase(),         // NOMBRE
    String(body.correo          || '').trim().toLowerCase(),         // CORREO
    String(body.whatsapp        || '').trim(),                       // WHATSAPP
    String(body.telefono        || '').trim(),                       // TELEFONO
    String(body.tipo_id         || 'CEDULA_NACIONAL').trim(),        // TIPO_ID
    String(body.sexo            || '').trim().toUpperCase(),         // SEXO
    String(body.provincia       || '').trim(),                       // PROVINCIA
    String(body.canton          || '').trim(),                       // CANTON
    String(body.distrito        || '').trim(),                       // DISTRITO  ← v4.27.0
    String(body.direccion       || '').trim(),                       // DIRECCION
    String(body.fecha_nac       || '').trim(),                       // FECHA_NAC
    esMenor ? 'SI' : 'NO',                                          // ES_MENOR
    tutorNombre,                                                     // TUTOR_NOMBRE
    tutorCedula,                                                     // TUTOR_CEDULA
    tutorCorreo,                                                     // TUTOR_CORREO
    tutorTel,                                                        // TUTOR_TEL
    String(body.programa        || '').trim(),                       // PROGRAMA
    String(body.modalidad       || '').trim().toUpperCase(),         // MODALIDAD  ← v4.27.0
    financiamiento,                                                  // FINANCIAMIENTO
    becaElegida,                                                     // BECA       ← v4.27.0
    becaEstado,                                                      // BECA_ESTADO← v4.27.0
    grupoElegido,                                                    // GRUPO_TENTATIVO
    conapeEquipo,                                                    // CONAPE_EQUIPO
    conapeToeic ? 'SI' : 'NO',                                      // CONAPE_TOEIC
    conapeToeicMonto,                                                // CONAPE_TOEIC_MONTO ← F55 precio tomado del grupo seleccionado
    conapeSos,                                                       // CONAPE_SOSTENIMIENTO
    String(body.como_entero     || '').trim(),                       // COMO_ENTERO
    String(body.asesor_ref      || '').trim(),                       // ASESOR_REF
    String(body.conocimientos_previos || '').trim(),                 // CONOCIMIENTOS_PREVIOS
    estadoCuenta,                                                    // ESTADO_CUENTA
    '',                                                              // NOTAS
    'LEAD',                                                          // ETAPA
    ahora,                                                           // F_LEAD
    '', '', '', '', '', '',                                          // F_SOLICITUD..F_ACTIVO
    urlFotoCedFrente,                                                // FOTO_CED_FRENTE
    urlFotoCedDorso,                                                 // FOTO_CED_DORSO
    urlFotoTitulo,                                                   // FOTO_TITULO
    'NO',                                                            // COMISION_PAGADA
    '',                                                              // COMISION_FECHA
    '',                                                              // CODIGO_ESTUDIANTE
    '',                                                              // PROFORMA_URL
    '',                                                              // PROFORMA_EQUIPO_URL
    String(body.clave || '').trim(),                                 // CLAVE  ← v4.29.0
    '',                                                              // CONAPE_WS_ULTIMO_DESEMBOLSO ← v4.30.0
    ''                                                               // CONAPE_WS_ULTIMA_CONSULTA   ← v4.30.0
  ];

  wsP.appendRow(filaP);

  return {
    ok:      true,
    usuario: cedLimpia,
    estado:  estadoCuenta,
    mensaje: estadoCuenta === 'PENDIENTE_CONAPE'
      ? 'Registro exitoso. Tu solicitud CONAPE está en proceso. Un asesor te contactará pronto.'
      : 'Registro exitoso. Completá el pago de matrícula para activar tu cuenta.'
  };
}


// ============================================================
// verificarCedulaInscripcion(params)                  — v4.40.3
// GET/POST ?fn=verificarCedulaInscripcion&cedula=XXXXXXXXX
//
// Filtro requerido para inscripción pública:
// 1) Primero DATOS: si ya existe como estudiante, bloquea.
// 2) Luego PROSPECTOS: si existe activo/en proceso, bloquea.
// 3) Excepción: si el prospecto está CANCELADO/CERRADO/DESCARTADO,
//    permite iniciar una nueva inscripción.
// Devuelve shape enriquecido consumido por inscripcion.jsx.
// ============================================================
function _insNormCedula_(v) {
  return String(v || '').replace(/[-\s]/g, '').trim();
}

function _insFindHeader_(headers, names) {
  var lower = {};
  for (var i = 0; i < headers.length; i++) {
    lower[String(headers[i] || '').trim().toLowerCase()] = i;
  }
  for (var j = 0; j < names.length; j++) {
    var k = String(names[j]).trim().toLowerCase();
    if (lower[k] !== undefined) return lower[k];
  }
  return -1;
}

function _insIsCancelado_(estado) {
  var s = String(estado || '').toUpperCase().trim();
  if (!s) return false;
  var toks = ['CANCELAD', 'CANCELAR', 'DESCARTAD', 'CERRAD', 'RECHAZAD', 'ANULAD', 'PROSPECTO_CANCELADO'];
  for (var i = 0; i < toks.length; i++) {
    if (s.indexOf(toks[i]) !== -1) return true;
  }
  return false;
}

function _insGetAsesorInfo_(ss, asesorNombre) {
  var out = { asesorNombre: String(asesorNombre || '').trim(), asesorWhatsapp: '' };
  if (!out.asesorNombre) return out;

  try {
    var ws = ss.getSheetByName(SH.USUARIOS);
    if (!ws || ws.getLastRow() < 2) return out;
    var rows = ws.getDataRange().getValues();
    var h = rows[0];

    var iNombre = _insFindHeader_(h, ['nombre', 'NOMBRE']);
    var iRol = _insFindHeader_(h, ['rol', 'ROL']);
    var iActivo = _insFindHeader_(h, ['activo', 'ACTIVO']);
    var iTel = _insFindHeader_(h, ['TELEFONO', 'telefono', 'WHATSAPP', 'whatsapp']);
    if (iNombre < 0) return out;

    var target = out.asesorNombre.toLowerCase();
    for (var i = 1; i < rows.length; i++) {
      var nombre = String(rows[i][iNombre] || '').trim();
      if (!nombre || nombre.toLowerCase() !== target) continue;

      // Si las columnas existen, preferir rol ventas activo TRUE/SI.
      if (iRol >= 0) {
        var rol = String(rows[i][iRol] || '').trim().toLowerCase();
        if (rol && rol !== 'ventas') continue;
      }
      if (iActivo >= 0) {
        var activo = rows[i][iActivo];
        var ok = activo === true || String(activo).trim().toUpperCase() === 'TRUE' || String(activo).trim().toUpperCase() === 'SI';
        if (!ok) continue;
      }

      out.asesorWhatsapp = iTel >= 0 ? String(rows[i][iTel] || '').trim() : '';
      return out;
    }
  } catch (_) {}
  return out;
}

function verificarCedulaInscripcion(params) {
  try {
    params = params || {};
    var ced = _insNormCedula_(params.cedula);
    if (!ced) {
      return { ok: false, puedeContinuar: false, motivo: 'CEDULA_REQUERIDA', error: 'Falta cedula' };
    }

    var ss = SpreadsheetApp.openById(SHEET_ID);

    // 1) DATOS primero.
    var wsD = ss.getSheetByName(SH.DATOS);
    if (wsD && wsD.getLastRow() > 1) {
      var dRows = wsD.getDataRange().getValues();
      var dH = dRows[0];
      var iDCed = _insFindHeader_(dH, ['NUM_CEDULA', 'CEDULA', 'cedula', 'NUMCEDULA', 'NUM CEDULA']);
      if (iDCed >= 0) {
        for (var i = 1; i < dRows.length; i++) {
          var dCed = _insNormCedula_(dRows[i][iDCed]);
          if (dCed === ced) {
            return {
              ok: true,
              puedeContinuar: false,
              motivo: 'ESTUDIANTE_EXISTE',
              existeEnDatos: true,
              existeEnProspectos: false,
              estadoProspecto: '',
              asesorNombre: '',
              asesorWhatsapp: ''
            };
          }
        }
      }
    }

    // Safety: USUARIOS estudiante activo/cuenta existente.
    var legacy = verificarCedulaExiste({ cedula: ced });
    if (legacy && legacy.existe === true && legacy.es_prospecto !== true) {
      return {
        ok: true,
        puedeContinuar: false,
        motivo: 'ESTUDIANTE_EXISTE',
        existeEnDatos: true,
        existeEnProspectos: false,
        estadoProspecto: String(legacy.estado || ''),
        asesorNombre: '',
        asesorWhatsapp: ''
      };
    }

    // 2) PROSPECTOS.
    var wsP = ss.getSheetByName('PROSPECTOS');
    if (wsP && wsP.getLastRow() > 1) {
      var pRows = wsP.getDataRange().getValues();
      var pH = pRows[0];
      var iPCed = _insFindHeader_(pH, ['CEDULA', 'cedula']);
      var iEtapa = _insFindHeader_(pH, ['ETAPA', 'estado', 'ESTADO_CUENTA']);
      var iEstCuenta = _insFindHeader_(pH, ['ESTADO_CUENTA']);
      var iAsesor = _insFindHeader_(pH, ['ASESOR_REF', 'ASESOR', 'VENDEDOR']);
      var iCancelMot = _insFindHeader_(pH, ['CANCELADO_MOTIVO']);
      var matchCancelado = null;

      if (iPCed >= 0) {
        // Recorremos de abajo hacia arriba para priorizar el proceso más reciente.
        for (var j = pRows.length - 1; j >= 1; j--) {
          var pCed = _insNormCedula_(pRows[j][iPCed]);
          if (pCed !== ced) continue;

          var etapa = iEtapa >= 0 ? String(pRows[j][iEtapa] || '') : '';
          var estCuenta = iEstCuenta >= 0 ? String(pRows[j][iEstCuenta] || '') : '';
          var estadoCompuesto = [etapa, estCuenta, (iCancelMot >= 0 ? pRows[j][iCancelMot] : '')].join(' ');
          var asesor = iAsesor >= 0 ? String(pRows[j][iAsesor] || '').trim() : '';
          var asesorInfo = _insGetAsesorInfo_(ss, asesor);

          if (_insIsCancelado_(estadoCompuesto)) {
            matchCancelado = {
              ok: true,
              puedeContinuar: true,
              motivo: 'PROSPECTO_CANCELADO',
              existeEnDatos: false,
              existeEnProspectos: true,
              estadoProspecto: etapa || estCuenta || 'CANCELADO',
              asesorNombre: asesorInfo.asesorNombre,
              asesorWhatsapp: asesorInfo.asesorWhatsapp
            };
            continue;
          }

          return {
            ok: true,
            puedeContinuar: false,
            motivo: 'PROSPECTO_ACTIVO',
            existeEnDatos: false,
            existeEnProspectos: true,
            estadoProspecto: etapa || estCuenta || 'EN_PROCESO',
            asesorNombre: asesorInfo.asesorNombre,
            asesorWhatsapp: asesorInfo.asesorWhatsapp
          };
        }
      }

      if (matchCancelado) return matchCancelado;
    }

    return {
      ok: true,
      puedeContinuar: true,
      motivo: 'LIBRE',
      existeEnDatos: false,
      existeEnProspectos: false,
      estadoProspecto: '',
      asesorNombre: '',
      asesorWhatsapp: ''
    };

  } catch (err) {
    return {
      ok: false,
      puedeContinuar: false,
      motivo: 'ERROR_VERIFICACION',
      error: String(err && err.message ? err.message : err),
      mensaje: 'No pudimos verificar la cédula. Intentá de nuevo.'
    };
  }
}

// ============================================================
// verificarCedulaExiste(params)                     — v4.24.1
// GET ?fn=verificarCedulaExiste&cedula=XXXXXXXXX
//
// Verifica si una cédula ya tiene cuenta en USUARIOS.
// Usado en el formulario público de inscripción antes
// de mostrar el resto del formulario.
// ============================================================
function verificarCedulaExiste(params) {
  if (!params || !params.cedula) return { ok: false, error: 'Falta cedula' };

  var cedLimpia = String(params.cedula).replace(/[-\s]/g,'').trim();
  if (!cedLimpia) return { ok: false, error: 'Cedula vacía' };

  var ss  = SpreadsheetApp.openById(SHEET_ID);
  var wsU = ss.getSheetByName(SH.USUARIOS);
  if (!wsU) return { ok: true, existe: false };

  var rows = wsU.getDataRange().getValues();
  var h    = rows[0];
  // v4.29.0: buscar columnas case-insensitive porque la hoja USUARIOS
  // tiene los nombres en minúsculas ('usuario') pero el código histórico
  // usaba mayúsculas.
  var iUsu = -1, iEst = -1;
  for (var k = 0; k < h.length; k++) {
    var hn = String(h[k]).trim().toLowerCase();
    if (hn === 'usuario')        iUsu = k;
    if (hn === 'estado_cuenta')  iEst = k;
  }
  if (iUsu === -1) return { ok: true, existe: false };

  for (var i = 1; i < rows.length; i++) {
    var u = String(rows[i][iUsu] || '').replace(/[-\s]/g,'').trim();
    if (u === cedLimpia) {
      return {
        ok:     true,
        existe: true,
        estado: iEst >= 0 ? String(rows[i][iEst] || '') : ''
      };
    }
  }

  // v4.29.0: también verificar PROSPECTOS (inscripciones pendientes de activar)
  var wsP = ss.getSheetByName('PROSPECTOS');
  if (wsP) {
    var pRows = wsP.getDataRange().getValues();
    var pH    = pRows[0];
    var iPCed = pH.indexOf('CEDULA');
    var iPEst = pH.indexOf('ESTADO_CUENTA');
    if (iPCed >= 0) {
      for (var j = 1; j < pRows.length; j++) {
        var ced = String(pRows[j][iPCed] || '').replace(/[-\s]/g,'').trim();
        if (ced === cedLimpia) {
          return {
            ok:     true,
            existe: true,
            es_prospecto: true,
            estado: iPEst >= 0 ? String(pRows[j][iPEst] || '') : ''
          };
        }
      }
    }
  }

  return { ok: true, existe: false };
}

// ============================================================
// buscarEnPadron(params)                            — v4.24.1
// GET ?fn=buscarEnPadron&cedula=XXXXXXXXX
//
// Consulta la API pública del TSE de Costa Rica.
// Retorna nombre, fecha_nac, provincia, canton, sexo.
// Solo aplica para cédulas nacionales (9 dígitos).
// Fallo silencioso — el formulario sigue sin datos
// prellenados si la API no responde.
// ============================================================
// ============================================================
// buscarEnPadron(params)                            — v4.24.2
// GET ?fn=buscarEnPadron&cedula=XXXXXXXXX
//
// Búsqueda binaria sobre PADRON_COMPLETO.txt en Drive.
// El archivo está ordenado por cédula numérica ascendente.
// Formato de cada línea (del TSE):
//   cedula,col2,col3,...,colN,APELLIDO2,APELLIDO1,NOMBRE
//   (los últimos 3 tokens no vacíos = ap2, ap1, nombre)
//
// Solo aplica para cédulas nacionales (9 dígitos).
// Fallo silencioso — el formulario sigue sin datos si hay error.
// ============================================================
// ============================================================
// PADRÓN ELECTORAL — Configuración                  — v4.24.3
// Carpeta en Drive con archivos padron_XXX.txt
// (XXX = primeros 3 dígitos de la cédula)
// ============================================================
var PADRON_FOLDER_ID = '1Z4N0TM5tFYT_aHUiUklKX3fJvPNArw2K';
var PADRON_CACHE_KEY = 'PADRON_FILE_MAP';

// ── Obtener el mapa prefijo→fileId, con caché en Script Properties ──
function _padronGetFileMap() {
  var props = PropertiesService.getScriptProperties();
  var cached = props.getProperty(PADRON_CACHE_KEY);
  if (cached) {
    try { return JSON.parse(cached); } catch(e) {}
  }

  // Construir el mapa escaneando la carpeta
  var folder = DriveApp.getFolderById(PADRON_FOLDER_ID);
  var files   = folder.getFilesByName; // no disponible — usar iterator
  var iter    = folder.getFiles();
  var map     = {};

  while (iter.hasNext()) {
    var file = iter.next();
    var name = file.getName(); // 'padron_112.txt'
    var match = name.match(/^padron_(\d{3})\.txt$/);
    if (match) {
      map[match[1]] = file.getId();
    }
  }

  props.setProperty(PADRON_CACHE_KEY, JSON.stringify(map));
  return map;
}

// ── Invalidar caché del padrón (correr manualmente si actualizás archivos) ──
function padronInvalidarCache() {
  PropertiesService.getScriptProperties().deleteProperty(PADRON_CACHE_KEY);
  Logger.log('Caché del padrón eliminado. Se reconstruirá en la próxima consulta.');
}

// ============================================================
// buscarEnPadron(params)                            — v4.24.3
// GET ?fn=buscarEnPadron&cedula=XXXXXXXXX
//
// Busca en el archivo padron_XXX.txt correspondiente
// usando búsqueda binaria sobre el texto.
//
// Formato del padrón (TSE):
//   cedula,cod_lugar, ,fecha_exp,00000,NOMBRE,APELLIDO1,APELLIDO2
// Nombre completo retornado: APELLIDO1 APELLIDO2 NOMBRE
//
// Solo aplica para cédulas nacionales (9 dígitos).
// Fallo silencioso — el formulario sigue sin datos si hay error.
// ============================================================
function buscarEnPadron(params) {
  if (!params || !params.cedula) return { ok: false, error: 'Falta cedula' };

  var cedLimpia = String(params.cedula).replace(/[-\s]/g,'').trim();

  // Solo cédulas nacionales de 9 dígitos
  if (!/^\d{9}$/.test(cedLimpia)) {
    return { ok: true, encontrado: false, motivo: 'No es cédula nacional' };
  }

  try {
    // Determinar el archivo correcto por los primeros 3 dígitos
    var prefijo  = cedLimpia.substring(0, 3);
    var fileMap  = _padronGetFileMap();
    var fileId   = fileMap[prefijo];

    if (!fileId) {
      return { ok: true, encontrado: false, motivo: 'Prefijo ' + prefijo + ' no encontrado' };
    }

    // Leer el archivo
    var file  = DriveApp.getFileById(fileId);
    var texto = file.getBlob().getDataAsString('UTF-8');

    // Quitar BOM si existe
    if (texto.charCodeAt(0) === 0xFEFF) texto = texto.substring(1);

    // Búsqueda binaria
    var linea = _padronBinarySearch(texto, cedLimpia);

    if (!linea) {
      return { ok: true, encontrado: false, motivo: 'Cédula no encontrada' };
    }

    return _padronParsearLinea(linea, cedLimpia);

  } catch (err) {
    return { ok: true, encontrado: false, motivo: 'Error: ' + err.message };
  }
}

// ── Búsqueda binaria sobre texto del padrón ──────────────────
// El archivo está ordenado por cédula numérica ascendente.
function _padronBinarySearch(texto, cedula) {
  var largo = texto.length;
  var lo = 0, hi = largo;
  var cedNum = parseInt(cedula, 10);

  for (var iter = 0; iter < 60; iter++) {
    if (lo >= hi) break;

    var mid = Math.floor((lo + hi) / 2);

    // Retroceder al inicio de la línea
    var ini = mid;
    while (ini > 0 && texto[ini - 1] !== '\n') ini--;

    // Avanzar al fin de la línea
    var fin = texto.indexOf('\n', ini);
    if (fin === -1) fin = largo;

    var linea = texto.substring(ini, fin).replace(/\r$/, '').trim();
    if (!linea) { lo = fin + 1; continue; }

    // Extraer cédula de esta línea
    var coma     = linea.indexOf(',');
    var cedLinea = coma >= 0 ? linea.substring(0, coma).trim() : linea;
    var linNum   = parseInt(cedLinea, 10);

    if (linNum === cedNum) return linea;
    else if (linNum < cedNum) lo = fin + 1;
    else hi = ini;
  }

  return null;
}

// ── Parsear línea del padrón ──────────────────────────────────
// Formato: cedula,cod_lugar, ,fecha_exp,00000,NOMBRE,APELLIDO1,APELLIDO2
// Cols 5,6,7 = NOMBRE, APELLIDO1, APELLIDO2
function _padronParsearLinea(linea, cedula) {
  var toks = linea.split(',');

  if (toks.length < 8) {
    return { ok: true, encontrado: false, motivo: 'Formato inesperado: ' + toks.length + ' cols' };
  }

  var nombre   = toks[5].trim().toUpperCase();
  var apellido1 = toks[6].trim().toUpperCase();
  var apellido2 = toks[7].trim().toUpperCase();

  // Nombre completo: APELLIDO1 APELLIDO2 NOMBRE
  var nombreCompleto = [apellido1, apellido2, nombre]
    .filter(function(s) { return s.length > 0; })
    .join(' ');

  return {
    ok:         true,
    encontrado: true,
    nombre:     nombreCompleto,
    fecha_nac:  '',   // El padrón TSE no incluye fecha de nacimiento
    provincia:  '',
    canton:     '',
    sexo:       ''
  };
}

// ── Test — correr desde el editor con tu cédula ──────────────
function testPadron() {
  var resultado = buscarEnPadron({ cedula: '112540973' });
  Logger.log(JSON.stringify(resultado, null, 2));
}

// ============================================================
// getGruposDisponibles()                            — v4.27.0
// GET ?fn=getGruposDisponibles&programa=INA
// GET ?fn=getGruposDisponibles&programa=SIN_INA
// GET ?fn=getGruposDisponibles&modalidad=INTENSIVO
//
// Devuelve solo grupos con DISPONIBLE_INSCRIPCION=TRUE
// con cálculo de cupo:
//   - CA  (estudiantes activos en DATOS con estado CA)
//   - Reservas (prospectos con GRUPO_TENTATIVO, etapa != ACTIVO/CANCELADO)
//   - Estado: DISPONIBLE / LISTA_ESPERA / CERRADO
//   - Reglas:
//      CA  ≥ capacidad             → CERRADO
//      Reservas ≥ capacidad × 1.5  → LISTA_ESPERA
//      Otherwise                   → DISPONIBLE
//
// También devuelve días/horas/fechas en español listas para mostrar.
// ============================================================
function getGruposDisponibles(params) {
  var ss = SpreadsheetApp.openById(SHEET_ID);
  var ws = ss.getSheetByName(SH.GRUPOS);
  var rows = ws.getDataRange().getValues();
  var h = rows[0];

  var iCod  = h.indexOf('CODIGO_GRUPO');
  var iNiv  = h.indexOf('NIVEL_INICIO');
  var iDias = h.indexOf('DIAS');
  var iDoc  = h.indexOf('DOCENTE');
  var iCap  = h.indexOf('CAPACIDAD');
  var iProg = h.indexOf('PROGRAMA');
  var iFech = h.indexOf('FECHA_INICIO');
  var iDisp = h.indexOf('DISPONIBLE_INSCRIPCION');
  var iModalidad     = h.indexOf('MODALIDAD');
  var iHoraIni       = h.indexOf('HORA_INICIO');
  var iHoraFin       = h.indexOf('HORA_FIN');
  var iPrecioCuota   = h.indexOf('PRECIO_CUOTA');
  var iPrecioMat     = h.indexOf('PRECIO_MATRICULA');
  var iPrecioCert    = h.indexOf('PRECIO_CERTIFICADO');
  var iPrecioTitulo  = h.indexOf('PRECIO_TITULO');
  var iCertB1Monto   = h.indexOf('CERT_B1_MONTO');
  var iCertB1Oblig   = h.indexOf('CERT_B1_OBLIG');
  var iCertB2Monto   = h.indexOf('CERT_B2_MONTO');
  var iCertB2Oblig   = h.indexOf('CERT_B2_OBLIG');
  var iCertI1Monto   = h.indexOf('CERT_I1_MONTO');
  var iCertI1Oblig   = h.indexOf('CERT_I1_OBLIG');
  var iCertI2Monto   = h.indexOf('CERT_I2_MONTO');
  var iCertI2Oblig   = h.indexOf('CERT_I2_OBLIG');
  var iRubrosExtra   = h.indexOf('RUBROS_EXTRA_JSON');
  var iToeic         = h.indexOf('TOEIC');
  var iToeicMonto    = h.indexOf('TOEIC_MONTO');
  // CALGRUPO_F53_20260617_INSCRIPCION_HORARIO_COMERCIAL_ICAN_BACKEND
  var iIcanAplica    = _anF53_firstHeaderIndex_(h, ['ICAN_APLICA','CLUB_ICAN_APLICA','APLICA_ICAN','ICAN']);
  var iIcanDias      = _anF53_firstHeaderIndex_(h, ['ICAN_DIAS','CLUB_ICAN_DIAS','DIAS_ICAN','DIA_ICAN']);
  var iIcanHoraIni   = _anF53_firstHeaderIndex_(h, ['ICAN_HORA_INICIO','CLUB_ICAN_HORA_INICIO','HORA_INICIO_ICAN']);
  var iIcanHoraFin   = _anF53_firstHeaderIndex_(h, ['ICAN_HORA_FIN','CLUB_ICAN_HORA_FIN','HORA_FIN_ICAN']);
  var iIcanHorario   = _anF53_firstHeaderIndex_(h, ['ICAN_HORARIO','CLUB_ICAN_HORARIO','HORARIO_ICAN','HORA_ICAN']);

  if (iDisp === -1) {
    var lastCol = ws.getLastColumn() + 1;
    ws.getRange(1, lastCol).setValue('DISPONIBLE_INSCRIPCION');
    iDisp = lastCol - 1;
  }

  var hoy = new Date(); hoy.setHours(0,0,0,0);
  var levelMap = { B1:'Básico I', B2:'Básico II', I1:'Intermedio I', I2:'Intermedio II' };
  var filtroPrograma  = (params && params.programa)  ? String(params.programa).trim().toUpperCase()  : null;
  var filtroModalidad = (params && params.modalidad) ? String(params.modalidad).trim().toUpperCase() : null;
  // CALGRUPO_F55_20260618_TOEIC_PRECIO_DEFAULT_CONFIG
  var insConfigF55 = _insF55GetConfig_();
  var toeicDefaultF55 = Number((insConfigF55 && insConfigF55.precios && insConfigF55.precios.toeic_default) || 0) || 0;

  // Contar CA por grupo desde DATOS (estado CA)
  var wsDatos = ss.getSheetByName(SH.DATOS);
  var datRows = wsDatos.getDataRange().getValues();
  var datH    = datRows[0];
  var iDGrupo = datH.indexOf('GRUPO');
  var iDEst   = datH.indexOf('ESTADO');
  var caPorGrupo = {};
  for (var i = 1; i < datRows.length; i++) {
    var g = String(datRows[i][iDGrupo] || '').trim();
    var e = String(datRows[i][iDEst]   || '').trim().toUpperCase();
    if (g && e === 'CA') caPorGrupo[g] = (caPorGrupo[g] || 0) + 1;
  }

  // Contar Reservas por grupo desde PROSPECTOS (prospectos vivos)
  var reservasPorGrupo = {};
  var wsP = ss.getSheetByName('PROSPECTOS');
  if (wsP && wsP.getLastRow() > 1) {
    var pRows = wsP.getDataRange().getValues();
    var pH    = pRows[0];
    var iPGT  = pH.indexOf('GRUPO_TENTATIVO');
    var iPET  = pH.indexOf('ETAPA');
    for (var i = 1; i < pRows.length; i++) {
      var g  = String(pRows[i][iPGT] || '').trim();
      var et = String(pRows[i][iPET] || '').trim().toUpperCase();
      if (g && et !== 'ACTIVO' && et !== 'CANCELADO') {
        reservasPorGrupo[g] = (reservasPorGrupo[g] || 0) + 1;
      }
    }
  }

  var getCell = function(row, idx) { return idx >= 0 ? row[idx] : ''; };

  // Agrupar filas por código y determinar nivel activo
  var grupoMap = {};
  for (var i = 1; i < rows.length; i++) {
    var cod = String(rows[i][iCod] || '').trim();
    if (!cod) continue;
    var rawF = iFech >= 0 ? rows[i][iFech] : '';
    var fechaIsoF52 = _anF52_courseDateIso_(rawF);
    var fechaD = _anF52_parseIsoDate_(fechaIsoF52);
    var fechaSortF52 = fechaD || new Date(2999, 0, 1);
    var disp = rows[i][iDisp];
    var disponible = (disp === true || String(disp).toUpperCase() === 'TRUE' ||
                     String(disp).toUpperCase() === 'SI' || disp === 1);

    if (!grupoMap[cod]) {
      var precioCuota   = parseFloat(getCell(rows[i], iPrecioCuota))   || 0;
      var precioMat     = parseFloat(getCell(rows[i], iPrecioMat))     || 0;
      var precioCert    = parseFloat(getCell(rows[i], iPrecioCert))    || 0;
      var precioTitulo  = parseFloat(getCell(rows[i], iPrecioTitulo))  || 0;
      var toeicDisp     = _truthyBool(getCell(rows[i], iToeic));
      var toeicMontoRaw = parseFloat(getCell(rows[i], iToeicMonto));
      var toeicMonto    = !isNaN(toeicMontoRaw) && toeicMontoRaw > 0 ? toeicMontoRaw : (toeicDisp ? toeicDefaultF55 : 0);
      var modalidad     = String(getCell(rows[i], iModalidad) || '').trim().toUpperCase();
      var horaIni       = _anF53_timeHHmm_(getCell(rows[i], iHoraIni));
      var horaFin       = _anF53_timeHHmm_(getCell(rows[i], iHoraFin));
      var icanAplicaRaw = getCell(rows[i], iIcanAplica);
      var icanDias      = String(getCell(rows[i], iIcanDias) || '').trim();
      var icanHoraIni   = _anF53_timeHHmm_(getCell(rows[i], iIcanHoraIni));
      var icanHoraFin   = _anF53_timeHHmm_(getCell(rows[i], iIcanHoraFin));
      var icanHorario   = String(getCell(rows[i], iIcanHorario) || '').trim();
      var rubrosExtraRaw = String(getCell(rows[i], iRubrosExtra) || '').trim();
      var rubrosExtra = [];
      if (rubrosExtraRaw) {
        try { rubrosExtra = JSON.parse(rubrosExtraRaw); } catch (e) { rubrosExtra = []; }
      }
      var certs = {
        B1: { monto: parseFloat(getCell(rows[i], iCertB1Monto)) || 0, obligatorio: _truthyBool(getCell(rows[i], iCertB1Oblig)) },
        B2: { monto: parseFloat(getCell(rows[i], iCertB2Monto)) || 0, obligatorio: _truthyBool(getCell(rows[i], iCertB2Oblig)) },
        I1: { monto: parseFloat(getCell(rows[i], iCertI1Monto)) || 0, obligatorio: _truthyBool(getCell(rows[i], iCertI1Oblig)) },
        I2: { monto: parseFloat(getCell(rows[i], iCertI2Monto)) || 0, obligatorio: _truthyBool(getCell(rows[i], iCertI2Oblig)) },
      };

      grupoMap[cod] = {
        cod: cod,
        dias: String(rows[i][iDias] || '').trim(),
        docente: String(rows[i][iDoc] || '').trim(),
        capacidad: parseInt(rows[i][iCap]) || 20,
        programa: String(rows[i][iProg] || '').trim().toUpperCase(),
        disponible: disponible,
        modalidad: modalidad,
        horaInicio: horaIni,
        horaFin: horaFin,
        icanAplica: _truthyBool(icanAplicaRaw) || !!icanDias || !!icanHoraIni || !!icanHoraFin || !!icanHorario,
        icanDias: icanDias,
        icanHoraInicio: icanHoraIni,
        icanHoraFin: icanHoraFin,
        icanHorario: icanHorario,
        precioCuota: precioCuota,
        precioMatricula: precioMat,
        precioCertificado: precioCert,
        precioTitulo: precioTitulo,
        toeicDisponible: toeicDisp,
        toeicMonto: toeicMonto,
        certificados: certs,
        rubrosExtra: rubrosExtra,
        filas: [],
      };
    }
    if (disponible) grupoMap[cod].disponible = true;
    grupoMap[cod].filas.push({ fecha: fechaD, fechaIso: fechaIsoF52, fechaSort: fechaSortF52, nivel: String(rows[i][iNiv]||'').trim() });
  }

  var grupos = [];
  Object.keys(grupoMap).forEach(function(cod) {
    var g = grupoMap[cod];
    if (!g.disponible) return;
    if (filtroPrograma  && g.programa !== filtroPrograma)   return;
    if (filtroModalidad && g.modalidad !== filtroModalidad) return;

    g.filas.sort(function(a,b){ return (a.fechaSort || new Date(2999,0,1)) - (b.fechaSort || new Date(2999,0,1)); });
    var activo = g.filas[0];
    g.filas.forEach(function(f) { if (f.fecha && f.fecha <= hoy) activo = f; });

    // Calcular cupo CA y reservas
    var caCount       = caPorGrupo[cod]       || 0;
    var reservasCount = reservasPorGrupo[cod] || 0;
    var cupoMax       = g.capacidad;
    var topeReservas  = Math.ceil(cupoMax * 1.5);

    var estadoCupo;
    if (caCount >= cupoMax) {
      estadoCupo = 'CERRADO';
      return; // No mostrar grupos cerrados
    } else if (reservasCount >= topeReservas) {
      estadoCupo = 'LISTA_ESPERA';
    } else {
      estadoCupo = 'DISPONIBLE';
    }

    // Texto legible
    var diasLetras    = _diasEnLetras(g.dias);
    var horaLetras    = _horaEnLetras(g.horaInicio, g.horaFin, g.dias);
    var modalidadLet  = g.modalidad === 'SUPER INTENSIVO' || g.modalidad === 'SUPER_INTENSIVO'
                        ? 'Súper Intensivo (12h/semana)'
                        : 'Intensivo (6h/semana)';
    var fechaInicioLet = activo.fecha ? _fechaEnLetrasCR(activo.fecha) : '';
    var periodoLet     = activo.fecha ? _periodoDelGrupoEnLetras(cod, activo.fecha) : '';
    var lecsPorSem     = g.modalidad === 'SUPER INTENSIVO' || g.modalidad === 'SUPER_INTENSIVO' ? 4 : 2;
    var duracionLet    = (g.modalidad === 'SUPER INTENSIVO' || g.modalidad === 'SUPER_INTENSIVO')
                         ? '8 meses para completar los 4 niveles'
                         : '16 meses para completar los 4 niveles';

    grupos.push({
      // Identificadores
      code:       cod,
      codigo:     cod,

      // Nivel activo
      nivel:      levelMap[activo.nivel] || activo.nivel,
      nivelId:    activo.nivel,

      // Programa / modalidad
      programa:        g.programa,
      modalidad:       g.modalidad,
      modalidad_label: modalidadLet,
      lecs_x_semana:   lecsPorSem,
      duracion_label:  duracionLet,

      // Días / horas / fechas legibles
      dias_raw:       g.dias,
      dias:           diasLetras,
      dias_label:     diasLetras,
      hora:           horaLetras,
      hora_label:     horaLetras,
      schedule:       diasLetras + ', ' + horaLetras,
      hora_inicio:    g.horaInicio,
      hora_fin:       g.horaFin,
      ican_aplica:    g.icanAplica,
      ican_dias:      g.icanDias,
      ican_dias_label:_diasEnLetras(g.icanDias),
      ican_hora_inicio: g.icanHoraInicio,
      ican_hora_fin:    g.icanHoraFin,
      ican_horario:     g.icanHorario,
      fecha_inicio:   activo.fechaIso || '',
      fecha_inicio_label: fechaInicioLet,
      periodo_label:  periodoLet,

      // Docente
      docente:    g.docente,

      // Cupos (v4.27.0)
      capacidad:        cupoMax,
      ca:               caCount,
      reservas:         reservasCount,
      tope_reservas:    topeReservas,
      cupo_disponible:  cupoMax - caCount,
      estado_cupo:      estadoCupo, // DISPONIBLE | LISTA_ESPERA
      // Compatibilidad con frontend viejo
      inscritos:        caCount,
      cupoDisp:         cupoMax - caCount,
      cupo:             cupoMax - caCount,
      cupos:            cupoMax - caCount,

      // Precios reales del grupo
      precio_cuota:        g.precioCuota,
      precio_matricula:    g.precioMatricula,
      precio_certificado:  g.precioCertificado,
      precio_titulo:       g.precioTitulo,
      toeic_disponible:    g.toeicDisponible,
      toeic_monto:         g.toeicMonto,
      certificados:        g.certificados,
      rubros_extra:        g.rubrosExtra,
    });
  });

  // Ordenar por fecha de inicio
  grupos.sort(function(a,b){ return a.fecha_inicio > b.fecha_inicio ? 1 : -1; });

  return { ok: true, grupos: grupos, total: grupos.length };
}

// ── HELPER: días en letras CR ────────────────────────────────
// LM=Lun/Mié, KJ=Mar/Jue, LJ=Lun a Jue (4 días), SA=Sábado, MV=Mar/Vie, etc.
function _diasEnLetras(codigo) {
  var raw = String(codigo || '').replace(/\d/g,'').toUpperCase().trim();
  var mapa = {
    'LM': 'Lunes y Miércoles',
    'KJ': 'Martes y Jueves',
    'MJ': 'Martes y Jueves',
    'LJ': 'Lunes, Martes, Miércoles y Jueves',
    'SA': 'Sábado',
    'DO': 'Domingo',
    'MV': 'Miércoles y Viernes',
    'KV': 'Martes y Viernes',
    'LV': 'Lunes y Viernes'
  };
  return mapa[raw] || raw || 'Sin definir';
}

// ── HELPER: horario en letras CR ─────────────────────────────
function _horaEnLetras(horaIni, horaFin, codigoDias) {
  // Si tenemos HORA_INICIO / HORA_FIN, formatear desde ahí
  if (horaIni && horaFin) {
    return _formatearHora(horaIni) + ' a ' + _formatearHora(horaFin);
  }
  // Fallback al código (ej "LM18" → horario 18?)
  var nums = String(codigoDias || '').replace(/[^0-9]/g,'');
  if (nums === '69') return '6:00 p.m. a 9:00 p.m.';
  if (nums === '94') return '9:00 a.m. a 12:00 p.m.';
  if (nums === '18') return '6:00 p.m. a 9:00 p.m.'; // asumido
  return '';
}

function _formatearHora(h) {
  var s = String(h).trim();
  // Soportar "18:00", "18:00:00", "06:00 PM", "6:00 pm"
  var m = s.match(/(\d{1,2}):(\d{2})/);
  if (!m) return s;
  var hh = parseInt(m[1], 10), mm = m[2];
  var ampm = hh >= 12 ? 'p.m.' : 'a.m.';
  var h12 = hh > 12 ? hh - 12 : (hh === 0 ? 12 : hh);
  return h12 + ':' + mm + ' ' + ampm;
}


function _anF53_firstHeaderIndex_(header, names) {
  for (var i = 0; i < names.length; i++) {
    var idx = header.indexOf(names[i]);
    if (idx > -1) return idx;
  }
  return -1;
}

function _anF53_timeHHmm_(value) {
  if (value === null || value === undefined || value === '') return '';
  if (Object.prototype.toString.call(value) === '[object Date]') {
    if (isNaN(value.getTime())) return '';
    return Utilities.formatDate(value, 'America/Costa_Rica', 'HH:mm');
  }
  if (typeof value === 'number') {
    // Sheets hora pura: fracción de día.
    var frac = value % 1;
    if (frac < 0) frac += 1;
    var totalMin = Math.round(frac * 24 * 60);
    var hh = Math.floor(totalMin / 60) % 24;
    var mm = totalMin % 60;
    return ('0' + hh).slice(-2) + ':' + ('0' + mm).slice(-2);
  }
  var s = String(value || '').trim();
  if (!s || /1899|GMT|hora est.ndar|standard/i.test(s)) return '';
  var m = s.match(/(\d{1,2}):(\d{2})/);
  if (m) return ('0' + Number(m[1])).slice(-2) + ':' + m[2];
  return '';
}

// CALGRUPO_F52_20260617_FIX_BACKEND_FECHA_CURSO_1899
function _anF52_courseDateIso_(value) {
  if (value === null || value === undefined || value === '') return '';
  var d = null;

  if (Object.prototype.toString.call(value) === '[object Date]') {
    d = value;
  } else if (typeof value === 'number') {
    // Sheets serial date. 1 = 1899-12-31 aprox.; rechazamos seriales antiguos/hora pura.
    if (value < 30000) return '';
    d = new Date(Math.round((value - 25569) * 86400 * 1000));
  } else {
    var s = String(value || '').trim();
    if (!s) return '';

    var m = s.match(/^(\d{4})[-\/](\d{1,2})[-\/](\d{1,2})/);
    if (m) {
      var y0 = Number(m[1]), mo0 = Number(m[2]), da0 = Number(m[3]);
      if (y0 >= 2020 && y0 <= 2100 && mo0 >= 1 && mo0 <= 12 && da0 >= 1 && da0 <= 31) {
        return y0 + '-' + String(mo0).padStart(2, '0') + '-' + String(da0).padStart(2, '0');
      }
      return '';
    }

    m = s.match(/^(\d{1,2})[-\/](\d{1,2})[-\/](\d{4})$/);
    if (m) {
      var da1 = Number(m[1]), mo1 = Number(m[2]), y1 = Number(m[3]);
      if (y1 >= 2020 && y1 <= 2100 && mo1 >= 1 && mo1 <= 12 && da1 >= 1 && da1 <= 31) {
        return y1 + '-' + String(mo1).padStart(2, '0') + '-' + String(da1).padStart(2, '0');
      }
      return '';
    }

    if (/GMT|standard|est.ndar|hora/i.test(s)) {
      var yr = (s.match(/\b(\d{4})\b/) || [])[1];
      if (!yr || Number(yr) < 2020 || Number(yr) > 2100) return '';
    }
    d = new Date(s);
  }

  if (!d || isNaN(d.getTime())) return '';
  var y = d.getFullYear();
  if (y < 2020 || y > 2100) return '';
  var mo = d.getMonth() + 1;
  var da = d.getDate();
  return y + '-' + String(mo).padStart(2, '0') + '-' + String(da).padStart(2, '0');
}

function _anF52_parseIsoDate_(iso) {
  if (!iso) return null;
  var p = String(iso).split('-').map(Number);
  if (p.length < 3 || !p[0] || !p[1] || !p[2]) return null;
  var d = new Date(p[0], p[1] - 1, p[2]);
  d.setHours(0, 0, 0, 0);
  return d;
}

// ── HELPER: fecha en letras CR (ej "14 de septiembre, 2026") ──
function _fechaEnLetrasCR(fecha) {
  var meses = ['enero','febrero','marzo','abril','mayo','junio',
               'julio','agosto','septiembre','octubre','noviembre','diciembre'];
  if (!(fecha instanceof Date) || isNaN(fecha.getTime())) return '';
  return fecha.getDate() + ' de ' + meses[fecha.getMonth()] + ', ' + fecha.getFullYear();
}

// ── HELPER: período "Cuatrimestre 3 — Septiembre a Diciembre 2026" ──
function _periodoDelGrupoEnLetras(codigoGrupo, fechaInicio) {
  // Patrón: X-XXXX-C3-0726 o X-XXXX-B5-0925
  var m = String(codigoGrupo || '').match(/-([CB])(\d)-/);
  if (!m || !(fechaInicio instanceof Date)) return '';
  var tipo = m[1] === 'C' ? 'Cuatrimestre' : 'Bimestre';
  var num  = m[2];
  var meses = ['Enero','Febrero','Marzo','Abril','Mayo','Junio',
               'Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'];
  var mesIni = fechaInicio.getMonth();
  var dur    = m[1] === 'C' ? 4 : 2;
  var mesFin = (mesIni + dur - 1) % 12;
  return tipo + ' ' + num + ' — ' + meses[mesIni] + ' a ' + meses[mesFin] + ' ' + fechaInicio.getFullYear();
}

// ── HELPER: calcular estado de cupo de un grupo (DISPONIBLE/LISTA_ESPERA/CERRADO) ──
function _calcularEstadoCupoGrupo(ss, codigoGrupo) {
  var wsG = ss.getSheetByName(SH.GRUPOS);
  var gRows = wsG.getDataRange().getValues();
  var gH    = gRows[0];
  var iCod  = gH.indexOf('CODIGO_GRUPO');
  var iCap  = gH.indexOf('CAPACIDAD');

  var capacidad = 20;
  for (var i = 1; i < gRows.length; i++) {
    if (String(gRows[i][iCod]).trim() === codigoGrupo) {
      capacidad = parseInt(gRows[i][iCap]) || 20;
      break;
    }
  }

  // Contar CA en DATOS
  var wsD = ss.getSheetByName(SH.DATOS);
  var dRows = wsD.getDataRange().getValues();
  var dH    = dRows[0];
  var iDGr  = dH.indexOf('GRUPO');
  var iDEs  = dH.indexOf('ESTADO');
  var ca = 0;
  for (var i = 1; i < dRows.length; i++) {
    if (String(dRows[i][iDGr]).trim() === codigoGrupo &&
        String(dRows[i][iDEs] || '').trim().toUpperCase() === 'CA') ca++;
  }
  if (ca >= capacidad) return 'CERRADO';

  // Contar reservas en PROSPECTOS
  var reservas = 0;
  var wsP = ss.getSheetByName('PROSPECTOS');
  if (wsP && wsP.getLastRow() > 1) {
    var pRows = wsP.getDataRange().getValues();
    var pH    = pRows[0];
    var iPGT  = pH.indexOf('GRUPO_TENTATIVO');
    var iPET  = pH.indexOf('ETAPA');
    for (var i = 1; i < pRows.length; i++) {
      var et = String(pRows[i][iPET] || '').trim().toUpperCase();
      if (String(pRows[i][iPGT]).trim() === codigoGrupo &&
          et !== 'ACTIVO' && et !== 'CANCELADO') reservas++;
    }
  }
  return reservas >= Math.ceil(capacidad * 1.5) ? 'LISTA_ESPERA' : 'DISPONIBLE';
}
// v4.24.0 — helper truthy bool para certificados obligatorios
function _truthyBool(v) {
  if (v === true || v === 1) return true;
  var s = String(v || '').trim().toUpperCase();
  return s === 'TRUE' || s === 'SI' || s === '1' || s === 'YES';
}

// ============================================================
// BECAS — Configuración y manejo                    — v4.27.0
//
// Hoja CONFIG_BECAS con:
//   ID | NOMBRE | DESCRIPCION | PORCENTAJE | CUPO_TOTAL | CUPO_USADO | ACTIVA | F_CREADA
//
// El admin gestiona becas DIRECTO EN LA HOJA (no hay endpoints
// de gestión). El frontend solo lee las activas con cupo disponible.
//
// Lógica del cupo:
//   - cupo_disponible = CUPO_TOTAL - CUPO_USADO (CUPO_USADO incrementa
//     al solicitar, NO al aprobar)
//   - Si el admin rechaza una beca, libera el cupo (CUPO_USADO -1)
// ============================================================

var BECAS_SHEET_NAME = 'CONFIG_BECAS';
// v4.37.0 — Schema expandido para soportar % distinto por rubro,
// vigencia, visibilidad en inscripción, y compatibilidades.
// Las columnas viejas (ID, NOMBRE, DESCRIPCION, PORCENTAJE, CUPO_TOTAL,
// CUPO_USADO, ACTIVA, F_CREADA) se MANTIENEN para no romper.
// Las nuevas se agregan al final automáticamente vía _migrarBecasSchema.
var BECAS_HEADERS = [
  'ID','NOMBRE','DESCRIPCION','PORCENTAJE','CUPO_TOTAL','CUPO_USADO','ACTIVA','F_CREADA',
  // v4.37.0 — nuevos
  'PCT_MATRICULA','PCT_CUOTA','PCT_CERTIFICADO','PCT_TITULO',
  'VISIBLE_INSCRIPCION','FECHA_INICIO','FECHA_FIN',
  'COMPATIBLE_INA','COMPATIBLE_SIN_INA',
  'CREADO_POR','NOTAS'
];

// ── Migrar hoja existente al schema nuevo ───────────────────
// Si la hoja tiene columnas viejas pero no las nuevas, las agrega al final.
// Auto-pobla PCT_MATRICULA y PCT_CUOTA desde el viejo PORCENTAJE.
function _migrarBecasSchema(ws) {
  var headerRow = ws.getRange(1, 1, 1, Math.max(ws.getLastColumn(), 1)).getValues()[0];
  var existing = {};
  headerRow.forEach(function(h, i) { if (h) existing[String(h).trim()] = i; });

  var faltantes = BECAS_HEADERS.filter(function(h) { return !(h in existing); });
  if (faltantes.length === 0) return;  // nada que migrar

  var startCol = ws.getLastColumn() + 1;
  ws.getRange(1, startCol, 1, faltantes.length).setValues([faltantes]);
  ws.getRange(1, 1, 1, ws.getLastColumn()).setFontWeight('bold');

  // Auto-poblar valores para filas existentes según defaults razonables
  if (ws.getLastRow() < 2) return;

  var allHeader = ws.getRange(1, 1, 1, ws.getLastColumn()).getValues()[0];
  var idxN = {}; allHeader.forEach(function(h, i) { if (h) idxN[String(h).trim()] = i; });

  var iPctOld  = idxN['PORCENTAJE'];
  var iPctMat  = idxN['PCT_MATRICULA'];
  var iPctCuo  = idxN['PCT_CUOTA'];
  var iPctCert = idxN['PCT_CERTIFICADO'];
  var iPctTit  = idxN['PCT_TITULO'];
  var iVis     = idxN['VISIBLE_INSCRIPCION'];
  var iCompIna = idxN['COMPATIBLE_INA'];
  var iCompSin = idxN['COMPATIBLE_SIN_INA'];

  var nRows = ws.getLastRow() - 1;
  var range = ws.getRange(2, 1, nRows, ws.getLastColumn());
  var data  = range.getValues();
  var dirty = false;

  for (var r = 0; r < data.length; r++) {
    var pctOld = iPctOld >= 0 ? parseFloat(data[r][iPctOld]) || 0 : 0;
    // PORCENTAJE viejo era 0..1 (ej 0.50) → llevar a 0..100
    var pctPct = pctOld > 1 ? pctOld : pctOld * 100;

    if (iPctMat  >= 0 && !data[r][iPctMat])  { data[r][iPctMat]  = pctPct; dirty = true; }
    if (iPctCuo  >= 0 && !data[r][iPctCuo])  { data[r][iPctCuo]  = pctPct; dirty = true; }
    if (iPctCert >= 0 && data[r][iPctCert] === '') { data[r][iPctCert] = 0; dirty = true; }
    if (iPctTit  >= 0 && data[r][iPctTit]  === '') { data[r][iPctTit]  = 0; dirty = true; }
    if (iVis     >= 0 && data[r][iVis]     === '') { data[r][iVis] = 'SI'; dirty = true; }
    if (iCompIna >= 0 && data[r][iCompIna] === '') { data[r][iCompIna] = 'SI'; dirty = true; }
    if (iCompSin >= 0 && data[r][iCompSin] === '') { data[r][iCompSin] = 'SI'; dirty = true; }
  }

  if (dirty) range.setValues(data);

  // Corregir Impacta a 25% si quedó migrado mal (en data vieja estaba 50)
  // Solo lo hago si la fila Impacta tiene exactamente PCT_MATRICULA=50 y se nota
  // que era el seed viejo. Esto es defensivo: si Leonardo ya lo cambió manualmente,
  // no lo toco.
  if (iPctMat >= 0 && iPctCuo >= 0) {
    var iId = idxN['ID'];
    for (var r2 = 0; r2 < data.length; r2++) {
      if (String(data[r2][iId]).toUpperCase() === 'IMPACTA' &&
          parseFloat(data[r2][iPctMat]) === 50 &&
          parseFloat(data[r2][iPctCuo]) === 50) {
        ws.getRange(r2 + 2, iPctMat + 1).setValue(25);
        ws.getRange(r2 + 2, iPctCuo + 1).setValue(25);
      }
    }
  }
}

// ── Asegurar que la hoja existe con valores seed ─────────────
function _getOrCreateBecas(ss) {
  var ws = ss.getSheetByName(BECAS_SHEET_NAME);
  if (!ws) {
    ws = ss.insertSheet(BECAS_SHEET_NAME);
    ws.getRange(1, 1, 1, BECAS_HEADERS.length).setValues([BECAS_HEADERS]);
    ws.setFrozenRows(1);
    ws.getRange(1, 1, 1, BECAS_HEADERS.length).setFontWeight('bold');
    // v4.37.0 — Seed con Impacta (25%) y Mujer (50%) ya en formato nuevo.
    var ahora = Utilities.formatDate(new Date(), 'America/Costa_Rica', 'yyyy-MM-dd HH:mm:ss');
    ws.appendRow([
      'IMPACTA','Beca Impacta','Descuento del 25% en matrícula y cuotas — cupo limitado',
      0.25, 100, 0, 'SI', ahora,
      25, 25, 0, 0,         // PCT_MATRICULA, PCT_CUOTA, PCT_CERTIFICADO, PCT_TITULO
      'SI', '', '',          // VISIBLE_INSCRIPCION, FECHA_INICIO, FECHA_FIN
      'SI', 'SI',            // COMPATIBLE_INA, COMPATIBLE_SIN_INA
      'SISTEMA', 'Auto-creada en migración v4.37.0'
    ]);
    ws.appendRow([
      'MUJER','Beca Mujer','Descuento del 50% en matrícula y cuotas — solo mujeres',
      0.50, 100, 0, 'SI', ahora,
      50, 50, 0, 0,
      'SI', '', '',
      'SI', 'SI',
      'SISTEMA', 'Auto-creada en migración v4.37.0'
    ]);
  } else {
    _migrarBecasSchema(ws);
  }
  return ws;
}

// ============================================================
// getBecasDisponibles()                              — v4.27.0
// GET ?fn=getBecasDisponibles
//
// Lista becas activas con cupo disponible.
// El frontend muestra esto en el paso de financiamiento.
// ============================================================
function getBecasDisponibles(params) {
  var ss = SpreadsheetApp.openById(SHEET_ID);
  var ws = _getOrCreateBecas(ss);
  var rows = ws.getDataRange().getValues();
  if (rows.length <= 1) return { ok: true, becas: [] };

  var H = rows[0];
  var iID    = H.indexOf('ID');
  var iNom   = H.indexOf('NOMBRE');
  var iDesc  = H.indexOf('DESCRIPCION');
  var iPct   = H.indexOf('PORCENTAJE');
  var iCT    = H.indexOf('CUPO_TOTAL');
  var iCU    = H.indexOf('CUPO_USADO');
  var iAct   = H.indexOf('ACTIVA');

  var becas = [];
  for (var i = 1; i < rows.length; i++) {
    var activa = String(rows[i][iAct] || '').trim().toUpperCase();
    if (activa !== 'SI' && activa !== 'TRUE') continue;

    var total    = parseInt(rows[i][iCT] || 0, 10);
    var usado    = parseInt(rows[i][iCU] || 0, 10);
    var disp     = total - usado;

    becas.push({
      id:               String(rows[i][iID] || '').trim().toUpperCase(),
      nombre:           String(rows[i][iNom] || '').trim(),
      descripcion:      String(rows[i][iDesc] || '').trim(),
      porcentaje:       parseFloat(rows[i][iPct]) || 0,
      cupo_total:       total,
      cupo_usado:       usado,
      cupo_disponible:  disp,
      disponible:       disp > 0
    });
  }

  return { ok: true, becas: becas, total: becas.length };
}

// ── HELPER: consumir cupo de una beca (atomically) ────────────
// Se llama al guardar un prospecto con financiamiento=BECA
// Si no hay cupo, devuelve { ok: false, error }
function _consumirCupoBeca(ss, idBeca) {
  if (!idBeca) return { ok: false, error: 'Beca no especificada' };

  var ws = _getOrCreateBecas(ss);
  var rows = ws.getDataRange().getValues();
  var H    = rows[0];
  var iID  = H.indexOf('ID');
  var iCT  = H.indexOf('CUPO_TOTAL');
  var iCU  = H.indexOf('CUPO_USADO');
  var iAct = H.indexOf('ACTIVA');

  for (var i = 1; i < rows.length; i++) {
    if (String(rows[i][iID]).trim().toUpperCase() === idBeca) {
      var activa = String(rows[i][iAct] || '').trim().toUpperCase();
      if (activa !== 'SI' && activa !== 'TRUE') {
        return { ok: false, error: 'Beca ' + idBeca + ' no está activa' };
      }
      var total = parseInt(rows[i][iCT] || 0, 10);
      var usado = parseInt(rows[i][iCU] || 0, 10);
      if (usado >= total) {
        return { ok: false, error: 'Beca ' + idBeca + ' sin cupo disponible' };
      }
      ws.getRange(i + 1, iCU + 1).setValue(usado + 1);
      return { ok: true, cupo_restante: total - usado - 1 };
    }
  }

  return { ok: false, error: 'Beca ' + idBeca + ' no encontrada' };
}

// ── HELPER: liberar cupo de beca (cuando admin rechaza) ───────
function _liberarCupoBeca(ss, idBeca) {
  if (!idBeca) return;
  var ws = _getOrCreateBecas(ss);
  var rows = ws.getDataRange().getValues();
  var H    = rows[0];
  var iID  = H.indexOf('ID');
  var iCU  = H.indexOf('CUPO_USADO');
  for (var i = 1; i < rows.length; i++) {
    if (String(rows[i][iID]).trim().toUpperCase() === idBeca) {
      var usado = parseInt(rows[i][iCU] || 0, 10);
      if (usado > 0) ws.getRange(i + 1, iCU + 1).setValue(usado - 1);
      return;
    }
  }
}

// ============================================================
// aprobarBecaProspecto(body)                         — v4.27.0
// POST ?fn=aprobarBecaProspecto
//
// Body: { cedula, decision: 'APROBADA'|'RECHAZADA', admin }
//
// - APROBADA: BECA_ESTADO=APROBADA (mantiene cupo consumido)
// - RECHAZADA: BECA_ESTADO=RECHAZADA, libera cupo, cambia
//              FINANCIAMIENTO a PROPIO (estudiante paga normal)
// ============================================================
function aprobarBecaProspecto(body) {
  if (!body.cedula || !body.decision) {
    return { ok: false, error: 'Faltan: cedula, decision' };
  }
  var decision = String(body.decision).trim().toUpperCase();
  if (decision !== 'APROBADA' && decision !== 'RECHAZADA') {
    return { ok: false, error: 'decision debe ser APROBADA o RECHAZADA' };
  }

  var ss = SpreadsheetApp.openById(SHEET_ID);
  var wsP = ss.getSheetByName('PROSPECTOS');
  if (!wsP) return { ok: false, error: 'No existe PROSPECTOS' };

  var rows = wsP.getDataRange().getValues();
  var H    = rows[0];
  var iCed = H.indexOf('CEDULA');
  var iBec = H.indexOf('BECA');
  var iEst = H.indexOf('BECA_ESTADO');
  var iFin = H.indexOf('FINANCIAMIENTO');
  var cedLimpia = String(body.cedula).replace(/[-\s]/g,'').trim();

  for (var i = 1; i < rows.length; i++) {
    if (String(rows[i][iCed]).replace(/[-\s]/g,'').trim() === cedLimpia) {
      wsP.getRange(i + 1, iEst + 1).setValue(decision);
      if (decision === 'RECHAZADA') {
        var becaId = String(rows[i][iBec] || '').trim().toUpperCase();
        _liberarCupoBeca(ss, becaId);
        wsP.getRange(i + 1, iFin + 1).setValue('PROPIO');
      }
      return { ok: true, cedula: cedLimpia, decision: decision };
    }
  }
  return { ok: false, error: 'Prospecto no encontrado' };
}

