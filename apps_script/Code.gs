// ============================================================
// EXAMENES V10B — Backend base de activaciones
// ------------------------------------------------------------
// Alcance intencional:
// - Admin/superadmin crea, lista, edita, abre, cierra o cancela activaciones.
// - Crea las hojas operativas necesarias en CAMPUS_OPERATIVO.
// - No habilita estudiante real.
// - No guarda intentos reales.
// - No conecta Mis Notas.
// - No devuelve respuestas correctas, accepted answers ni scripts al estudiante.
// ============================================================
var EXAM_SH = {
  ACTIVATIONS: 'EXAM_ACTIVATIONS',
  ATTEMPTS:    'EXAM_ATTEMPTS',
  REVIEW:      'EXAM_REVIEW',
  AUDIT:       'EXAM_AUDIT_LOG',
  CONFIG:      'EXAM_CONFIG'
};

function _examNow_() {
  var tz = 'America/Costa_Rica';
  try { tz = Session.getScriptTimeZone() || tz; } catch (_) {}
  return Utilities.formatDate(new Date(), tz, 'yyyy-MM-dd HH:mm:ss');
}

function _examClean_(v) {
  return String(v == null ? '' : v).trim();
}

function _examUpper_(v) {
  return _examClean_(v).toUpperCase();
}

function _examBoolSiNo_(v) {
  var x = _examUpper_(v);
  return (x === 'SI' || x === 'SÍ' || x === 'YES' || x === 'TRUE' || x === '1') ? 'SI' : 'NO';
}

function _examJson_(obj) {
  try { return JSON.stringify(obj || {}); } catch (_) { return '{}'; }
}

function _examUuid_(prefix) {
  var tz = 'America/Costa_Rica';
  try { tz = Session.getScriptTimeZone() || tz; } catch (_) {}
  var stamp = Utilities.formatDate(new Date(), tz, 'yyyyMMdd-HHmmss');
  var rnd = Utilities.getUuid().split('-')[0].toUpperCase();
  return String(prefix || 'ID') + '-' + stamp + '-' + rnd;
}

function _examActor_(body) {
  body = body || {};
  var token = _examClean_(body.token || body.session_token);
  if (!token) return { id: '', role: '', nombre: '' };
  try {
    var s = validarSesion(token);
    if (s && s.ok === true) {
      var actor = {};
      for (var k in s) { if (s.hasOwnProperty(k)) actor[k] = s[k]; }
      actor.id = _examClean_(s.usuario || s.email || s.cedula || s.codigo || s.nombre);
      actor.role = _examClean_(s.rol);
      actor.nombre = _examClean_(s.nombre || s.usuario);
      return actor;
    }
  } catch (_) {}
  return { id: '', role: '', nombre: '' };
}

