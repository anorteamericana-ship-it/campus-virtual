  if (destEnd.getTime() <= new Date().getTime()) return { ok:false, error:'La fecha/hora destino debe estar en el futuro.' };

  var idx = ctx.idx, d = ctx.data;
  var prev = null, next = null;
  for (var r = 1; r < d.length; r++) {
    if (r === ctx.target.row) continue;
    if (String(d[r][idx.COD_GRUPO] || '').trim() !== ctx.cod) continue;
    if (String(d[r][idx.NIVEL] || '').trim().toUpperCase() !== ctx.niv) continue;
    if (!_ccF84_esRiel_(d[r][idx.TIPO_LECCION], ctx.riel)) continue;
    var n = Number(d[r][idx.LECCION]);
    if (!n) continue;
    var est = String(d[r][idx.ESTADO] || '').trim().toUpperCase();
    if (est === 'LIBRE') continue;
    var itv = _ccF84_intervaloFila_(d[r], idx, ctx.meta);
    var iso = _ccF84_iso_(d[r][idx.FECHA]);
    if (!itv || !iso) continue;
    var st = _ccF84_fechaHora_(iso, _ccF84_minHora_(itv.ini));
    var en = _ccF84_fechaHora_(iso, _ccF84_minHora_(itv.fin));
    if (n < ctx.lec && (!prev || n > prev.leccion)) prev = { leccion:n, start:st, end:en };
    if (n > ctx.lec && (!next || n < next.leccion)) next = { leccion:n, start:st, end:en };
  }
  if (prev && destStart.getTime() < prev.end.getTime()) return { ok:false, error:'La nueva fecha rompe el orden académico: debe ser posterior a la lección ' + prev.leccion + '.' };
  if (next && destEnd.getTime() > next.start.getTime()) return { ok:false, error:'La nueva fecha cae después o encima de la siguiente lección. En ese caso corresponde solicitar suspensión.' };

  var targetTeacher = _normalizarNombre(ctx.meta.docente || ctx.target.values[idx.DOCENTE] || '');
  for (var q = 1; q < d.length; q++) {
    if (q === ctx.target.row) continue;
    var estado = String(d[q][idx.ESTADO] || '').trim().toUpperCase();
    if (!estado || estado === 'LIBRE') continue;
    if (_ccF84_iso_(d[q][idx.FECHA]) !== fechaDestino) continue;
    var codQ = String(d[q][idx.COD_GRUPO] || '').trim();
    var nivQ = String(d[q][idx.NIVEL] || '').trim().toUpperCase();
    var metaQ = ctx.cat[codQ + '|' + nivQ];
    var intQ = _ccF84_intervaloFila_(d[q], idx, metaQ);
    var sameGroup = codQ === ctx.cod;
    var teacherQ = _normalizarNombre((metaQ && metaQ.docente) || d[q][idx.DOCENTE] || '');
    var sameTeacher = targetTeacher && teacherQ && targetTeacher === teacherQ;
    if (sameGroup && _ccF84_esRiel_(d[q][idx.TIPO_LECCION], ctx.riel)) {
      return { ok:false, error:'El grupo ya tiene otra lección regular en esa fecha. Para mover toda la secuencia corresponde solicitar una suspensión.' };
    }
    if (!sameTeacher) continue;
    if (!intQ) return { ok:false, error:'Hay otra clase del mismo docente en la fecha destino y no se pudo verificar su horario.' };
    if (iniMin < intQ.fin && finMin > intQ.ini) return { ok:false, error:'La reprogramación choca con otra clase del mismo docente (' + _ccF84_minHora_(intQ.ini) + '–' + _ccF84_minHora_(intQ.fin) + ').' };
  }

  ctx.fechaDestino = fechaDestino;
  ctx.horaDestinoInicio = horaIni;
  ctx.horaDestinoFin = horaFin;
  ctx.destStart = destStart;
  ctx.destEnd = destEnd;
  return ctx;
}

function solicitarSuspension(body) {
