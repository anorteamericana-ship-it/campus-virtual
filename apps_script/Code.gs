  if (e === 'PREMIUM' || e === 'PLAN PREMIUM' || e === 'PLAN_PREMIUM') return 'PLAN PREMIUM';
  if (e === 'BASICO'  || e === 'PLAN BASICO'  || e === 'PLAN_BASICO')  return 'PLAN BASICO';
  return null; // sin equipo
}

// ── Convertir número a letras en español (para "trescientos sesenta mil COLONES") ─
function _numeroALetras(num) {
  if (num === 0) return 'cero COLONES.';
  var unidades   = ['','un','dos','tres','cuatro','cinco','seis','siete','ocho','nueve','diez',
                    'once','doce','trece','catorce','quince','dieciséis','diecisiete','dieciocho','diecinueve','veinte',
                    'veintiuno','veintidós','veintitrés','veinticuatro','veinticinco','veintiséis','veintisiete','veintiocho','veintinueve'];
  var decenas    = ['','','','treinta','cuarenta','cincuenta','sesenta','setenta','ochenta','noventa'];
  var centenas   = ['','ciento','doscientos','trescientos','cuatrocientos','quinientos','seiscientos','setecientos','ochocientos','novecientos'];

  function abajoDeMil(n) {
    if (n === 0)    return '';
    if (n === 100)  return 'cien';
    if (n < 30)     return unidades[n];
    if (n < 100) {
      var d = Math.floor(n / 10), u = n % 10;
      return decenas[d] + (u ? ' y ' + unidades[u] : '');
    }
    var c = Math.floor(n / 100), resto = n % 100;
    return centenas[c] + (resto ? ' ' + abajoDeMil(resto) : '');
  }

  function abajoDelMillon(n) {
    if (n === 0) return '';
    var miles = Math.floor(n / 1000);
    var resto = n % 1000;
    var texto = '';
    if (miles > 0) {
      if (miles === 1) texto = 'mil';
      else             texto = abajoDeMil(miles) + ' mil';
    }
    if (resto > 0) texto += (texto ? ' ' : '') + abajoDeMil(resto);
    return texto;
  }

  var entero    = Math.floor(num);
  var millones  = Math.floor(entero / 1000000);
  var restoMill = entero % 1000000;

  var texto = '';
  if (millones > 0) {
    if (millones === 1) texto = 'un millón';
    else                texto = abajoDeMil(millones) + ' millones';
  }
  if (restoMill > 0) {
    texto += (texto ? ' ' : '') + abajoDelMillon(restoMill);
  }

  return texto + ' COLONES.';
}

// ============================================================
// generarProformaProspecto(params)                  — v4.26.0
// GET ?fn=generarProformaProspecto&cedula=XXXXXXXXX
//
// Genera 1 o 2 PDFs (programa + equipo opcional) leyendo:
//   - datos del prospecto desde PROSPECTOS
//   - precios y modalidad desde APOLLO.GRUPOS (col W-AL)
//
// Guarda los PDFs en:
//   DOCUMENTOS_ESTUDIANTES/{CEDULA}/PROFORMAS/Nº{consec}_{cliente}.pdf
//
// Actualiza PROSPECTOS con URLs de los PDFs generados.
// ============================================================
function generarProformaProspecto(params) {
  if (!params || !params.cedula) return { ok: false, error: 'Falta cedula' };
  var cedLimpia = String(params.cedula).replace(/[-\s]/g,'').trim();

  // v4.30.0: tipo de proforma a generar
  //   'curso'  → solo programa
  //   'equipo' → solo equipo (requiere CONAPE_EQUIPO != NINGUNO)
  //   'ambas'  → ambas (comportamiento legacy, default)
  var tipoProforma = String(params.tipo || 'ambas').toLowerCase().trim();
  if (['curso','equipo','ambas'].indexOf(tipoProforma) === -1) tipoProforma = 'ambas';

  var lock = LockService.getDocumentLock();
  if (!lock.tryLock(30000)) return { ok: false, error: 'Sistema ocupado' };

  try {
    var ss = SpreadsheetApp.openById(SHEET_ID);

    // ── 1. Leer prospecto ─────────────────────────────────────
    var wsP    = ss.getSheetByName('PROSPECTOS');
    if (!wsP) return { ok: false, error: 'No existe hoja PROSPECTOS' };
    var pRows  = wsP.getDataRange().getValues();
    var pH     = pRows[0];
    var iPCed  = pH.indexOf('CEDULA');
    var prospecto = null;
    var filaP = -1;

    for (var i = 1; i < pRows.length; i++) {
      if (String(pRows[i][iPCed]).replace(/[-\s]/g,'').trim() === cedLimpia) {
        filaP = i + 1;
        prospecto = {};
        for (var j = 0; j < pH.length; j++) prospecto[pH[j]] = pRows[i][j];
        break;
      }
    }
    if (!prospecto) return { ok: false, error: 'Prospecto no encontrado: ' + cedLimpia };

    var grupoCodigo = String(prospecto.GRUPO_TENTATIVO || '').trim();
    if (!grupoCodigo) return { ok: false, error: 'Prospecto sin GRUPO_TENTATIVO' };

    // ── 2. Leer grupo desde APOLLO.GRUPOS ─────────────────────
    var wsG    = ss.getSheetByName(SH.GRUPOS);
    var gRows  = wsG.getDataRange().getValues();
    var gH     = gRows[0];
    var iGCod  = gH.indexOf('CODIGO_GRUPO');
    var grupo  = null;

    for (var i = 1; i < gRows.length; i++) {
      if (String(gRows[i][iGCod]).trim() === grupoCodigo) {
        grupo = {};
        for (var j = 0; j < gH.length; j++) grupo[gH[j]] = gRows[i][j];
        break;
      }
    }
    if (!grupo) return { ok: false, error: 'Grupo no encontrado: ' + grupoCodigo };

    // ── 3. Validar datos necesarios del grupo ─────────────────
    var precioCuota   = Number(grupo.PRECIO_CUOTA       || 0);
    var precioMatric  = Number(grupo.PRECIO_MATRICULA   || 0);
    var precioCert    = Number(grupo.PRECIO_CERTIFICADO || 0);
    var precioTitulo  = Number(grupo.PRECIO_TITULO      || 0);
    var toeicMonto    = Number(grupo.TOEIC_MONTO        || 0);
    if (!precioCuota || !precioMatric || !precioCert) {
      return { ok: false, error: 'Grupo sin precios completos (CUOTA/MATRICULA/CERTIFICADO)' };
    }

    var programa  = String(grupo.PROGRAMA || 'INA').toUpperCase().trim();   // INA | LIBRE
    var modalidad = String(grupo.MODALIDAD || 'INTENSIVO').toUpperCase().trim();
    var tipoPer   = String(grupo.TIPO_PERIODO || 'C').toUpperCase().trim(); // C=cuatri B=bimestre

    // Cuotas por nivel: cuatrimestre=4, bimestre=2
    var cuotasPorNivel = tipoPer === 'B' ? 2 : 4;
    var montoMensual   = precioCuota; // monto del PRECIO_CUOTA es por mes
    var montoModulo    = precioCuota * cuotasPorNivel;

    var conTOEIC = String(prospecto.CONAPE_TOEIC || '').toUpperCase().trim() === 'SI';

    // ── 4. Generar consecutivos según tipo ────────────────────
    var equipoNombre = _decidirPlantillaEquipo(prospecto.CONAPE_EQUIPO);

    // Validar coherencia: tipo=equipo requiere que el prospecto tenga equipo
    if (tipoProforma === 'equipo' && !equipoNombre) {
      return {
        ok: false,
        error: 'El prospecto no tiene equipo CONAPE configurado. No se puede generar proforma de equipo.'
      };
    }

    // Consecutivos: solo pedir el que vamos a usar (no desperdiciar números)
    var generarPrograma = (tipoProforma === 'curso'  || tipoProforma === 'ambas');
    var generarEquipo   = (tipoProforma === 'equipo' || (tipoProforma === 'ambas' && equipoNombre));

    var consecProg   = generarPrograma ? _obtenerSiguienteConsecutivoProforma() : null;
    var consecEquipo = generarEquipo   ? _obtenerSiguienteConsecutivoProforma() : null;

    // ── 5. Inyectar datos del cliente en CREAR PROFORMA (siempre) ──
    // Tanto la plantilla de programa como las de equipo leen estos
    // datos por fórmula, así que se inyectan independientemente del
    // tipo de proforma a generar.
    var ssProf = SpreadsheetApp.openById(PROFORMAS_SHEET_ID);
    var wsCP   = ssProf.getSheetByName('CREAR PROFORMA');
    if (!wsCP) return { ok: false, error: 'No existe hoja CREAR PROFORMA en Sheet de plantillas' };

    // Datos del cliente — las plantillas leen estas celdas por fórmula
    var nombreCli = String(prospecto.NOMBRE || '').trim();
    var correoCli = String(prospecto.CORREO || '').trim().toLowerCase();
    var asesorCli = String(prospecto.ASESOR_REF || '').trim();
    var telCli    = String(prospecto.WHATSAPP || prospecto.TELEFONO || '').trim();

    // Cédula formateada X-XXXX-XXXX (para mostrar en C11 de plantillas)
    var cedFmt = cedLimpia;
    if (/^\d{9}$/.test(cedLimpia)) {
      cedFmt = cedLimpia.substring(0, 1) + '-' + cedLimpia.substring(1, 5) + '-' + cedLimpia.substring(5, 9);
    }

    // Dirección completa concatenada
    var direccionCompleta = [
      prospecto.PROVINCIA, prospecto.CANTON, prospecto.DISTRITO || '', prospecto.DIRECCION
    ].filter(function(s) { return s && String(s).trim(); })
     .map(function(s) { return String(s).trim(); })
     .join(', ');

    // Inyectar datos del cliente en CREAR PROFORMA
    wsCP.getRange('D4').setValue(telCli);
    wsCP.getRange('E4').setValue(telCli);
    wsCP.getRange('D6').setValue(cedFmt);
    wsCP.getRange('D7').setValue(asesorCli);
    wsCP.getRange('D8').setValue(nombreCli);
    wsCP.getRange('C10').setValue(nombreCli); // out_Nombre
    wsCP.getRange('D9').setValue(correoCli);
    wsCP.getRange('D11').setValue(programa === 'INA'
      ? (modalidad === 'INTENSIVO' ? 'INTENSIVO 128H' : 'SUPER INTENSIVO 128H')
      : (modalidad === 'INTENSIVO' ? 'INTENSIVO 96H'  : 'SUPER INTENSIVO 96H'));
    // Consecutivos: solo setear el(los) que vamos a generar
    if (consecProg) {
      wsCP.getRange('E12').setValue('Nº' + consecProg);
      wsCP.getRange('F12').setValue(consecProg);
    }
    wsCP.getRange('D14').setValue(equipoNombre || 'SIN EQUIPO');
    if (consecEquipo) {
      wsCP.getRange('E14').setValue('Nº' + consecEquipo);
      wsCP.getRange('F14').setValue(consecEquipo);
    } else {
      wsCP.getRange('E14').clearContent();
      wsCP.getRange('F14').clearContent();
    }
    wsCP.getRange('E15').setValue(conTOEIC ? 'SI' : 'NO');
    wsCP.getRange('D17').setValue(String(prospecto.PROVINCIA || '').trim());
    wsCP.getRange('D18').setValue(String(prospecto.CANTON || '').trim());
    wsCP.getRange('D19').setValue(String(prospecto.DISTRITO || '').trim());
    wsCP.getRange('D20').setValue(String(prospecto.DIRECCION || '').trim());
    wsCP.getRange('E20').setValue(direccionCompleta);
    wsCP.getRange('B17').setValue(direccionCompleta);

    // ── 6-7. Generar PROFORMA DE PROGRAMA (solo si corresponde) ──
    var urlPDFProg = null;
    var nombrePlantillaPrograma = null;
    var totalPrograma = 0;
    var totalLetras = '';

    if (generarPrograma) {
    // ── 6. Inyectar precios netos en la plantilla de programa ──
    nombrePlantillaPrograma = _decidirPlantillaPrograma(programa, modalidad, conTOEIC);
    var wsPlantPrograma = ssProf.getSheetByName(nombrePlantillaPrograma);
    if (!wsPlantPrograma) {
      return { ok: false, error: 'Plantilla no existe: ' + nombrePlantillaPrograma };
    }

    // Calcular netos (precio incluye IVA, neto = total/1.02 para educación)
    var IVA_EDU = 0.02;
    var netoMatric     = precioMatric  / (1 + IVA_EDU);    // por nivel
    var netoModulo     = montoModulo   / (1 + IVA_EDU);    // por nivel (precioCuota × cuotas)
    var netoCert       = precioCert    / (1 + IVA_EDU);    // por nivel
    var totalTituloDos = precioTitulo + precioCert;        // 45K + 15K = 60K total
    var netoTituloUni  = (totalTituloDos / 2) / (1 + IVA_EDU); // B30=2, F30=neto unitario promedio
    var netoToeic      = conTOEIC ? (toeicMonto / 1.13) : 0;

    // Filas 19-31 — patrón: matric / programa / cert × 4 niveles + título + TOEIC
    var filas = [
      { fila: 19, valor: netoMatric  }, // matricula B1
      { fila: 20, valor: netoModulo  }, // programa  B1
      { fila: 21, valor: netoCert    }, // cert      B1
      { fila: 22, valor: netoMatric  }, // matricula B2
      { fila: 23, valor: netoModulo  }, // programa  B2
      { fila: 24, valor: netoCert    }, // cert      B2
      { fila: 25, valor: netoMatric  }, // matricula I1
      { fila: 26, valor: netoModulo  }, // programa  I1
      { fila: 27, valor: netoCert    }, // cert      I1
      { fila: 28, valor: netoMatric  }, // matricula I2
      { fila: 29, valor: netoModulo  }, // programa  I2
      { fila: 30, valor: netoTituloUni } // título I2 + completo (B30=2)
    ];
    filas.forEach(function(f) {
      wsPlantPrograma.getRange('F' + f.fila).setValue(f.valor);
    });
    // TOEIC solo si la plantilla "CON TOEIC"
    if (conTOEIC) {
      wsPlantPrograma.getRange('F31').setValue(netoToeic);
    }

    // Calcular total para el monto en letras
    totalPrograma =
      (precioMatric + montoModulo + precioCert) * 4 // 4 niveles
      + totalTituloDos                              // título final
      + (conTOEIC ? toeicMonto : 0);
    totalLetras = _numeroALetras(Math.round(totalPrograma));

    // El monto en letras va en una fila después del subtotal
    // Inyección simple: poner el monto en letras en una celda fija detectable
    // El Excel lo tenía en F36 (con TOEIC) o F35 (sin TOEIC)
    var filaLetras = conTOEIC ? 36 : 35;
    wsPlantPrograma.getRange('F' + filaLetras).setValue(totalLetras);

    SpreadsheetApp.flush();
    Utilities.sleep(500); // dar tiempo a que se calculen las fórmulas

    // ── 7. Exportar PDF de programa ───────────────────────────
    var nombreArchivoProg = 'Nº' + consecProg + '_proforma_' +
      _sanitizarNombre(nombreCli) + '_' + cedLimpia + '.pdf';

    urlPDFProg = _exportarHojaComoPDF(
      ssProf.getId(), wsPlantPrograma.getSheetId(),
      cedLimpia, nombreArchivoProg
    );
    } // fin if(generarPrograma) — v4.30.0

    // ── 8. Generar PROFORMA DE EQUIPO (solo si corresponde) ────
    var urlPDFEquipo = null;
    if (generarEquipo && equipoNombre) {
      var wsPlantEquipo = ssProf.getSheetByName(equipoNombre);
      if (wsPlantEquipo) {
        // Las plantillas de equipo tienen precios fijos en F19,G19,H19
        // y monto en letras en F24
        var totalEquipoVal = equipoNombre === 'PLAN PREMIUM' ? 360000 : 319000;
        wsPlantEquipo.getRange('F24').setValue(_numeroALetras(totalEquipoVal));

        SpreadsheetApp.flush();
        Utilities.sleep(500);

        var nombreArchivoEq = 'Nº' + consecEquipo + '_equipo_' +
          _sanitizarNombre(nombreCli) + '_' + cedLimpia + '.pdf';
        urlPDFEquipo = _exportarHojaComoPDF(
          ssProf.getId(), wsPlantEquipo.getSheetId(),
          cedLimpia, nombreArchivoEq
        );
      }
    }

    // ── 9. Actualizar PROSPECTOS con URLs ─────────────────────
    var iPProfProg   = pH.indexOf('PROFORMA_URL');
    var iPProfEquipo = pH.indexOf('PROFORMA_EQUIPO_URL');
    if (iPProfProg < 0) {
      // Agregar columnas si no existen
      var nuevoCol = pH.length + 1;
      wsP.getRange(1, nuevoCol).setValue('PROFORMA_URL');
      wsP.getRange(1, nuevoCol + 1).setValue('PROFORMA_EQUIPO_URL');
      iPProfProg   = nuevoCol - 1;
      iPProfEquipo = nuevoCol;
    }
    // v4.30.0: solo actualizar la URL del tipo que se generó (no sobreescribir
    // la otra con null si solo se pidió una)
    if (urlPDFProg)   wsP.getRange(filaP, iPProfProg + 1).setValue(urlPDFProg);
    if (urlPDFEquipo) wsP.getRange(filaP, iPProfEquipo + 1).setValue(urlPDFEquipo);

    return {
      ok:                  true,
      tipo:                tipoProforma,
      cedula:              cedLimpia,
      grupo:               grupoCodigo,
      plantilla_programa:  nombrePlantillaPrograma,
      plantilla_equipo:    equipoNombre || null,
      consecutivo_programa: consecProg,
      consecutivo_equipo:  consecEquipo,
      url_programa:        urlPDFProg,
      url_equipo:          urlPDFEquipo,
      total_programa:      totalPrograma,
      total_letras:        totalLetras
    };

  } catch (err) {
    return { ok: false, error: 'Error generando proforma: ' + err.message + ' | ' + err.stack };
  } finally {
    lock.releaseLock();
  }
}

// ── HELPER: sanitizar nombre para archivo ────────────────────
function _sanitizarNombre(s) {
  return String(s).replace(/[\\\/:\*\?"<>\|]/g, '').replace(/\s+/g, '_').substring(0, 40);
}

// ── HELPER: exportar hoja específica como PDF y guardar en Drive ─
// Parámetros equivalentes al "Archivo → Imprimir → Guardar como PDF" de Sheets:
//   scale=4              "Ajustar al tamaño de la página" (NO fitw=true)
//   portrait=true        Vertical
//   size=letter          Carta (21.6 × 27.9 cm)
//   horizontal_alignment Centrado
//   vertical_alignment   Arriba
//   gridlines=false      Sin líneas de cuadrícula
//   printtitle=false     Sin título de hoja
//   sheetnames=false     Sin nombres de hoja
//   pagenum=UNDEFINED    Sin números de página
//   Márgenes en pulgadas (1cm ≈ 0.3937")
function _exportarHojaComoPDF(spreadsheetId, sheetGid, cedula, nombreArchivo) {
  var url = 'https://docs.google.com/spreadsheets/d/' + spreadsheetId + '/export?' +
    'format=pdf' +
    '&gid=' + sheetGid +
    '&size=letter' +
    '&portrait=true' +
    '&scale=4' +                          // Ajustar al tamaño de página (no fitw)
    '&horizontal_alignment=CENTER' +
    '&vertical_alignment=TOP' +
    '&top_margin=0' +                     // 0 cm
    '&bottom_margin=0' +                  // 0 cm
    '&left_margin=0.787' +                // 2 cm
    '&right_margin=0.340' +               // 0.864 cm
    '&gridlines=false' +
    '&printtitle=false' +
    '&sheetnames=false' +
    '&pagenum=UNDEFINED' +
    '&printnotes=false' +
    '&attachment=true';

  var token = ScriptApp.getOAuthToken();
  var resp = UrlFetchApp.fetch(url, {
    headers: { 'Authorization': 'Bearer ' + token },
    muteHttpExceptions: true
  });

  if (resp.getResponseCode() !== 200) {
    throw new Error('Export PDF falló: HTTP ' + resp.getResponseCode());
  }

  // Guardar en DOCUMENTOS_ESTUDIANTES/{CEDULA}/PROFORMAS/
  var rootFolder    = DriveApp.getFolderById(DOCUMENTOS_FOLDER_ID);
  var cedFolder     = _getOrCreateChildFolder(rootFolder, cedula);
  var proformaFolder = _getOrCreateChildFolder(cedFolder, 'PROFORMAS');

  // Si existe un archivo con el mismo nombre, borrarlo (regenerar)
  var existing = proformaFolder.getFilesByName(nombreArchivo);
  while (existing.hasNext()) existing.next().setTrashed(true);

  var blob = resp.getBlob().setName(nombreArchivo);
  var file = proformaFolder.createFile(blob);
  file.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);

  return 'https://drive.google.com/file/d/' + file.getId() + '/view';
}

