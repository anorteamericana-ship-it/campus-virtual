};

// Meses en español
var MESES_ES = [
  'enero','febrero','marzo','abril','mayo','junio',
  'julio','agosto','septiembre','octubre','noviembre','diciembre'
];

var DIAS_SEMANA_ES = ['Domingo','Lunes','Martes','Miércoles','Jueves','Viernes','Sábado'];
function fechaLarga(d) {
  if (!d) return '';
  try {
    var f = new Date(d);
    return DIAS_SEMANA_ES[f.getDay()] + ' ' + f.getDate() + ' de ' + MESES_ES[f.getMonth()] + ' de ' + f.getFullYear();
  } catch(e) { return String(d); }
}

function mesAnio(d) {
  if (!d) return '';
  try {
    var f = new Date(d);
    var m = MESES_ES[f.getMonth()];
    return m.charAt(0).toUpperCase() + m.slice(1) + ' - ' + f.getFullYear();
  } catch(e) { return String(d); }
}


function _ventasDocNormalizarTipo_(tipo) {
  var t = String(tipo || '').trim().toUpperCase();
  if (t === 'HOJA_MATRICULA' || t === 'MATRICULA' || t === 'INSCRIPCION' || t === 'CERTIFICADO') return 'CERTIFICADO';
  if (t === 'CONAPE' || t === 'CARTA_NO_DEUDA' || t === 'MATRICULA_2') return 'MATRICULA_2';
  return '';
}

function _ventasDocNombrePdf_(tipo, codigo, cedula) {
  var TIPO_NOMBRE = { CERTIFICADO: 'INSCRIPCION', MATRICULA_2: 'CARTA_NO_DEUDA' };
  return (TIPO_NOMBRE[tipo] || tipo) + '_' + codigo + '_' + cedula + '.pdf';
}

function _ventasDocExtraerFileId_(url) {
  var s = String(url || '');
  var m = s.match(/\/d\/([a-zA-Z0-9_-]+)/);
  if (m && m[1]) return m[1];
  m = s.match(/[?&]id=([a-zA-Z0-9_-]+)/);
  return m && m[1] ? m[1] : '';
}

function _ventasDocPublicarSiSePuede_(url) {
  try {
    var id = _ventasDocExtraerFileId_(url);
    if (!id) return;
    DriveApp.getFileById(id).setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
  } catch (_) {}
}

function _ventasDocBuscarExistente_(tipo, codigo, cedula, grupo, nivel, nombreEst) {
  try {
    var nombrePdf = _ventasDocNombrePdf_(tipo, codigo, cedula);
    var carpeta = obtenerOCrearCarpeta(codigo, nombreEst || '', grupo || '', nivel || 'B1');
    var it = carpeta.getFilesByName(nombrePdf);
    if (it.hasNext()) {
      var f = it.next();
      try { f.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW); } catch (_) {}
      return { ok: true, url: f.getUrl(), nombre: f.getName(), tipo: tipo, nivel: nivel, codigo: codigo, existente: true };
    }
  } catch (_) {}
  return null;
}

function _ventasDocValidarConapeNivel_(estData, nivel) {
  if (nivel === 'B1') {
    return { ok: false, error: 'CONAPE no disponible para B1: no existe nivel anterior aprobado.' };
  }
  var prevMap = { B2: 'B1', I1: 'B2', I2: 'I1' };
  var prev = prevMap[nivel] || '';
  var niveles = (estData && estData.niveles) || {};
  var prevData = prev ? niveles[prev] : null;
  var estatusPrev = String((prevData && prevData.estatus) || '').trim().toUpperCase();
  if (estatusPrev !== 'APR' && estatusPrev !== 'CNV') {
    return { ok: false, error: 'CONAPE requiere nivel anterior aprobado. Estado ' + prev + ': ' + (estatusPrev || 'sin registro') };
  }
  return { ok: true };
}

// VENTAS-DOC-002-A — Wrapper seguro para que ventas obtenga PDFs de
// matrícula/CONAPE sin abrir generarDocumento directamente al rol ventas.
// Body: { token, tipo:'CERTIFICADO'|'MATRICULA_2'|'HOJA_MATRICULA'|'CONAPE', codigo|cedula, nivel }
function generarDocumentoVentas(body) {
  body = body || {};
  var token = String(body.token || body.session_token || '').trim();
  if (!token) return { ok: false, error: 'sesion_requerida' };

  var sesion = validarSesion(token);
  if (!sesion || sesion.ok !== true) return sesion || { ok: false, error: 'sesion_invalida' };

  var rol = String(sesion.rol || '').trim().toLowerCase();
  if (rol !== 'ventas' && rol !== 'admin' && rol !== 'superadmin') {
    return { ok: false, error: 'no_autorizado' };
  }

  var tipo = _ventasDocNormalizarTipo_(body.tipo || body.documento);
  if (!tipo) return { ok: false, error: 'tipo_no_permitido', mensaje: 'Use CERTIFICADO/HOJA_MATRICULA o MATRICULA_2/CONAPE.' };

  var codigo = String(body.codigo || body.codigo_estudiante || body.CODIGO_ESTUDIANTE || '').trim();
  var cedula = _sec006cCedulaProp_(body.cedula);
  var pResp = codigo ? _sec006cProspectoPorCodigo_(codigo) : _sec006cProspectoPorCedula_(cedula);
  if (!pResp.ok) return { ok: false, error: 'prospecto_no_encontrado' };

  var prospecto = pResp.prospecto;
  if (rol === 'ventas' && !_sec006cVentasPuedeProspecto_(sesion, prospecto)) {
    return { ok: false, error: 'no_autorizado_recurso', mensaje: 'El prospecto no pertenece a este asesor.' };
  }

  if (!_sec006cProspectoListoDocumentosVentas_(prospecto)) {
    return { ok: false, error: 'prospecto_no_finalizado', mensaje: 'Los documentos se habilitan cuando el admin ya finalizó/facturó el caso.' };
  }

  codigo = String(prospecto.CODIGO_ESTUDIANTE || codigo || '').trim();
  cedula = _sec006cCedulaProp_(prospecto.CEDULA || cedula);
  if (!codigo) return { ok: false, error: 'sin_codigo_estudiante', mensaje: 'El prospecto aún no tiene CODIGO_ESTUDIANTE.' };

  var nivel = String(body.nivel || 'B1').trim().toUpperCase();
  var estData = getEstudiante(codigo);
  if (!estData || estData.ok !== true) return { ok: false, error: (estData && estData.error) || 'estudiante_no_encontrado' };

  if (tipo === 'MATRICULA_2') {
    var valConape = _ventasDocValidarConapeNivel_(estData, nivel);
    if (!valConape.ok) return valConape;
  }

  var est = estData.estudiante || {};
  var grupo = String(body.grupo || est.GRUPO || estData.cod_grupo || '').trim();
  var nombre = String(est.NOMBRE || prospecto.NOMBRE || '').trim();

  var existente = _ventasDocBuscarExistente_(tipo, codigo, cedula, grupo, nivel, nombre);
  if (existente) return existente;

  var resp = generarDocumento({ tipo: tipo, codigo: codigo, nivel: nivel, grupo: grupo });
  if (resp && resp.ok && resp.url) _ventasDocPublicarSiSePuede_(resp.url);
  if (resp && resp.ok) resp.generado_por = rol === 'ventas' ? 'ventas' : rol;
  return resp;
}

// Devuelve URL del PDF generado (o error)
function generarDocumento(data) {
  var tipo      = String(data.tipo || '').toUpperCase(); // MATRICULA_1, MATRICULA_2, PROMOVER, CERTIFICADO
  var codigo    = String(data.codigo || '');
  var nivel     = String(data.nivel  || 'B1').toUpperCase();

  if (!tipo || !codigo || !nivel) return { error: 'tipo, codigo y nivel son requeridos' };

  // 1. Obtener datos del estudiante
  var estData = getEstudiante(codigo);
  if (!estData.ok) return { error: estData.error };

  var est     = estData.estudiante;
  var niveles = estData.niveles;
  var grupoI  = estData.grupo || {};

  var nombre  = String(est['NOMBRE']     || '').trim();
  var cedula  = String(est['NUM_CEDULA'] || est['CEDULA'] || '').trim();
  var grupo   = String(data.grupo || est['GRUPO'] || '').trim();
  var modulo  = NIVEL_NOMBRE[nivel] || nivel;

  // Fechas del grupo
  var hoy      = new Date();
  var fechaHoy = fechaLarga(hoy);

  // Leer datos reales directamente de la hoja GRUPOS
  var ss2 = SpreadsheetApp.openById(SHEET_ID);
  var wsGrpMain = ss2.getSheetByName(SH.GRUPOS);

  var diasTexto = '', horaTexto = '', horaSimple = '';
  var periodoIni = '', anioGrp = hoy.getFullYear(), tipoPerGrp = 'C';
  var modalidadGrp = 'CUATRIMESTRE', durMeses = '4 meses';
  var fechaInicioGrp = hoy;

  var DIAS_NOMBRE = { LM:'lunes y miércoles', KJ:'martes y jueves', SA:'sábados', LJ:'lunes, martes, miércoles y jueves', L4:'lunes, martes, miércoles y jueves' };

  if (wsGrpMain) {
    var gMainRows = wsGrpMain.getDataRange().getValues();
    var gMainH    = gMainRows[0];
    var igmCod   = gMainH.indexOf('CODIGO_GRUPO');
    var igmNivI  = gMainH.indexOf('NIVEL_INICIO');
    var igmPer   = gMainH.indexOf('PERIODO_INICIO');
    var igmAnio  = gMainH.indexOf('AÑO_INICIO');
    var igmTipo  = gMainH.indexOf('TIPO_PERIODO');
    var igmMod   = gMainH.indexOf('MODALIDAD');
    var igmDias  = gMainH.indexOf('DIAS');
    var igmHIni  = gMainH.indexOf('HORA_INI');
    var igmHFin  = gMainH.indexOf('HORA_FIN');
    var igmFec   = gMainH.indexOf('FECHA_INICIO');

    for (var gmi = 1; gmi < gMainRows.length; gmi++) {
      if (String(gMainRows[gmi][igmCod] ||'').trim() !== grupo) continue;
      if (String(gMainRows[gmi][igmNivI]||'').trim().toUpperCase() !== nivel) continue;

      periodoIni   = String(gMainRows[gmi][igmPer] ||'').trim();
      anioGrp      = parseInt(gMainRows[gmi][igmAnio]) || hoy.getFullYear();
      tipoPerGrp   = String(gMainRows[gmi][igmTipo]||'C').trim().toUpperCase();
      modalidadGrp = String(gMainRows[gmi][igmMod] ||'CUATRIMESTRE').trim();
      durMeses     = tipoPerGrp === 'C' ? '4 meses' : '2 meses';

      // DIAS: leer columna DIAS y convertir a texto
      var diasCod = String(gMainRows[gmi][igmDias]||'').trim().toUpperCase();
      diasTexto   = DIAS_NOMBRE[diasCod] || diasCod;

      // HORA: leer HORA_INI y HORA_FIN en formato HH:MM (18:00, 21:00)
      // Convertir hora "18:00" → "6:00 p.m."
      function fmt24(h) {
        if (!h && h !== 0) return '';
        var s = String(h).trim();
        var hr, mn;
        if (s.indexOf(':') > -1) {
          var p = s.split(':');
          hr = parseInt(p[0]); mn = p[1] || '00';
        } else if (!isNaN(Number(s))) {
          // Número decimal tipo 0.75 = 18:00
          var totalMin = Math.round(Number(s) * 24 * 60);
          hr = Math.floor(totalMin / 60);
          mn = String(totalMin % 60).padStart(2,'0');
        } else {
          return s;
        }
        var pm = hr >= 12;
        var hr12 = hr > 12 ? hr - 12 : (hr === 0 ? 12 : hr);
        return hr12 + ':' + String(mn).padStart(2,'0') + ' ' + (pm ? 'p.m.' : 'a.m.');
      }
      // Hora simple: "18:00"→"6pm", "21:00"→"9pm"
      // Google Sheets puede enviar hora como string "18:00" o número decimal 0.75
      function horaSimpleFmt(h) {
        if (!h && h !== 0) return '';
        var hr = -1;
        if (h instanceof Date) {
          hr = h.getHours();
        } else {
          var s = String(h).trim();
          if (s.indexOf(':') > -1) {
            hr = parseInt(s.split(':')[0]);
          } else {
            var n = parseFloat(s);
            if (!isNaN(n) && n < 1) hr = Math.round(n * 24);
          }
        }
        if (hr < 0) return String(h);
        if (hr === 0) return '12am';
        if (hr < 12) return hr + 'am';
        if (hr === 12) return '12pm';
        return (hr - 12) + 'pm';
      }
      var hIni = fmt24(gMainRows[gmi][igmHIni]);
      var hFin = fmt24(gMainRows[gmi][igmHFin]);
      horaTexto = hIni && hFin ? hIni + ' a ' + hFin : hIni || hFin || '6:00 p.m. a 9:00 p.m.';
      horaSimple = horaSimpleFmt(gMainRows[gmi][igmHIni]) + ' a ' + horaSimpleFmt(gMainRows[gmi][igmHFin]);

      // FECHA_INICIO real del nivel
      var fdGrp = gMainRows[gmi][igmFec];
      if (fdGrp instanceof Date) fechaInicioGrp = fdGrp;
      else if (fdGrp) { try { var fp = new Date(fdGrp); if (!isNaN(fp)) fechaInicioGrp = fp; } catch(e){} }

      break;
    }
  }

  // Texto del periodo: "Cuatrimestral Enero - Abril 2026"
  var PER_INI_T = { C1:'Enero',C2:'Mayo',C3:'Septiembre', B1:'Enero',B2:'Marzo',B3:'Mayo',B4:'Julio',B5:'Septiembre',B6:'Noviembre' };
  var PER_FIN_T = { C1:'Abril',C2:'Agosto',C3:'Diciembre', B1:'Febrero',B2:'Abril',B3:'Junio',B4:'Agosto',B5:'Octubre',B6:'Diciembre' };
  var PER_FIN_MES2 = { C1:3,C2:7,C3:11, B1:1,B2:3,B3:5,B4:7,B5:9,B6:11 };
  var PER_INI_MES2 = { C1:0,C2:4,C3:8, B1:0,B2:2,B3:4,B4:6,B5:8,B6:10 };

  var perClave2  = periodoIni;  // periodoIni ya incluye el tipo: 'C1','C2','C3','B1'...'B6'
  var tipoTexto  = modalidadGrp === 'BIMESTRE' ? 'Bimestral' : 'Cuatrimestral';
  var periodoT   = tipoTexto + ' ' + (PER_INI_T[perClave2]||'') + ' - ' + (PER_FIN_T[perClave2]||'') + ' ' + anioGrp;
  var periodoM   = durMeses + ' (' + durMeses.replace(' meses','') + ' meses x nivel)';

  // Fecha inicio real desde GRUPOS_FECHAS (lección 1 del nivel)
  var wsGF2 = ss2.getSheetByName('GRUPOS FECHAS');
  var inicioReal = hoy;
  if (wsGF2) {
    var gf2Rows = wsGF2.getDataRange().getValues();
    var gf2H = gf2Rows[0];
    var igf2Grp = gf2H.indexOf('GRUPO');
    var igf2Lec = gf2H.indexOf('LECCION');
    var igf2Niv = gf2H.indexOf('NIVEL');
    var igf2Fec = gf2H.indexOf('FECHA');
    for (var gf2i = 1; gf2i < gf2Rows.length; gf2i++) {
      if (String(gf2Rows[gf2i][igf2Grp]||'').trim() !== grupo) continue;
      if (String(gf2Rows[gf2i][igf2Niv]||'').trim().toUpperCase() !== nivel) continue;
      if (parseInt(gf2Rows[gf2i][igf2Lec]) !== 1) continue;
      var fd2 = gf2Rows[gf2i][igf2Fec];
      if (fd2 instanceof Date) { inicioReal = fd2; break; }
    }
  }

  var mesFinP2 = PER_FIN_MES2[perClave2];
  var finDate2 = mesFinP2 !== undefined ? new Date(anioGrp, mesFinP2+1, 0) : hoy;

  var inicio   = fechaLarga(fechaInicioGrp);
  var fin      = mesAnio(finDate2);

  // Nivel anterior
  var nivelAntMap = { B2:'B1', I1:'B2', I2:'I1' };
  var nivAnt      = nivelAntMap[nivel] || '';
  var datAnt      = nivAnt && niveles[nivAnt] ? niveles[nivAnt] : null;
  var nota_ant    = datAnt ? String(datAnt.nota || '') : '';
  var modulo_ant  = nivAnt ? (NIVEL_NOMBRE[nivAnt] || nivAnt) : '';

  // Registro de certificado
  var certNum = datAnt ? String(datAnt.cert || '') : '';
  if (!certNum && niveles[nivel]) certNum = String(niveles[nivel].cert || '');

  // Texto del periodo anterior para la Carta No Deuda
  var periodoAntTexto = '';
  if (nivAnt && wsGrpMain) {
    var gPARows = wsGrpMain.getDataRange().getValues();
    var gPAH    = gPARows[0];
    var igpCod  = gPAH.indexOf('CODIGO_GRUPO');
    var igpNiv  = gPAH.indexOf('NIVEL_INICIO');
    var igpPer  = gPAH.indexOf('PERIODO_INICIO');
    var igpAnio = gPAH.indexOf('AÑO_INICIO');
    var igpTipo = gPAH.indexOf('TIPO_PERIODO');
    for (var pa = 1; pa < gPARows.length; pa++) {
      if (String(gPARows[pa][igpCod]||'').trim() !== grupo) continue;
      if (String(gPARows[pa][igpNiv]||'').trim().toUpperCase() !== nivAnt) continue;
      var paP = String(gPARows[pa][igpPer]||'').trim();
      var paA = parseInt(gPARows[pa][igpAnio]) || hoy.getFullYear();
      var paT = String(gPARows[pa][igpTipo]||'C').trim().toUpperCase();
      var paK = paP;  // paP ya es 'C1','C2','C3','B1'...'B6' — no concatenar tipo
      var PER_INI_PA = { C1:'Enero',C2:'Mayo',C3:'Septiembre', B1:'Enero',B2:'Marzo',B3:'Mayo',B4:'Julio',B5:'Septiembre',B6:'Noviembre' };
      var PER_FIN_PA = { C1:'Abril',C2:'Agosto',C3:'Diciembre', B1:'Febrero',B2:'Abril',B3:'Junio',B4:'Agosto',B5:'Octubre',B6:'Diciembre' };
      var tiT = paT === 'C' ? 'Cuatrimestral' : 'Bimestral';
      periodoAntTexto = tiT + ' ' + (PER_INI_PA[paK]||'') + ' - ' + (PER_FIN_PA[paK]||'') + ' ' + paA;
      break;
    }
  }

  // 2. Seleccionar plantilla
  var plantillaId = PLANTILLA_IDS[tipo];
  if (!plantillaId) return { error: 'Plantilla no configurada: ' + tipo };

  // 3. Copiar plantilla y rellenar campos
  try {
    var plantilla = DriveApp.getFileById(plantillaId);
    var copia     = plantilla.makeCopy('TEMP_' + tipo + '_' + codigo + '_' + nivel, DriveApp.getFolderById(PLANTILLAS_FOLDER_ID));
    var doc       = DocumentApp.openById(copia.getId());
    var body      = doc.getBody();

    // Campos comunes a todos los tipos
    var campos = {
      // Campos comunes
      '{{FECHA}}':              fechaHoy,
      '{{FECHA_EMISION}}':      fechaHoy,
      '{{NOMBRE}}':             nombre,
      '{{NUM_CEDULA}}':         cedula,
      '{{CEDULA}}':             cedula,
      '{{CODIGO}}':             codigo,
      '{{MODULO}}':             modulo,
      '{{NIVEL}}':              modulo,
      '{{INICIO}}':             inicio,
      '{{FIN}}':                fin,
      // Carta No Deuda CONAPE (MATRICULA_2)
      '{{DIAS}}':               diasTexto,                  // "lunes y miércoles"
      '{{HORA_INI}}':           horaTexto,                  // "6:00 p.m. a 9:00 p.m."
      '{{PERIODO_TEXTO}}':      periodoT,
      '{{NIVEL_ANTERIOR}}':     modulo_ant,
      '{{PERIODO_TEXTO_ANT}}':  periodoAntTexto,
      '{{NOTA_ANTERIOR}}':      nota_ant,
      '{{PERIODO_TEXTO_NUEVO}}': periodoT,
      // Documento de Inscripción (CERTIFICADO tipo)
      '{{F_DE_PAGO}}':          diasTexto,
      '{{MESxNIVEL}}':          durMeses,
      '{{CONVENIO}}':           String(est['CONVENIO'] || 'REGULAR'),
      '{{F.PAGO}}':             'Completo por nivel',
      // Campos adicionales
      '{{registro}}':           certNum,
      '{{entrega}}':            mesAnio(hoy),
    };

    // Usar Docs API batchUpdate — igual que generarPdfCertificado
    var requests2 = Object.keys(campos).map(function(k) {
      return {
        replaceAllText: {
          containsText: { text: k, matchCase: true },
          replaceText: String(campos[k] || '')
        }
      };
    });
    Docs.Documents.batchUpdate({ requests: requests2 }, copia.getId());

    // Exportar como PDF via Drive API
    var pdfResp = UrlFetchApp.fetch(
      'https://www.googleapis.com/drive/v3/files/' + copia.getId() + '/export?mimeType=application/pdf',
      { headers: { Authorization: 'Bearer ' + ScriptApp.getOAuthToken() }, muteHttpExceptions: true }
    );

    copia.setTrashed(true);

    if (pdfResp.getResponseCode() !== 200) {
      return { error: 'Error exportando PDF: ' + pdfResp.getContentText().substring(0,200) };
    }

    var TIPO_NOMBRE = {
      CERTIFICADO: 'INSCRIPCION',
      MATRICULA_2: 'CARTA_NO_DEUDA',
    };
    var nombre_pdf = (TIPO_NOMBRE[tipo] || tipo) + '_' + codigo + '_' + cedula + '.pdf';
    var carpetaEst = obtenerOCrearCarpeta(codigo, nombre, grupo, nivel);
    var pdf = carpetaEst.createFile(pdfResp.getBlob().setName(nombre_pdf).setContentType('application/pdf'));

    return {
      ok:       true,
      url:      pdf.getUrl(),
      nombre:   nombre_pdf,
      tipo:     tipo,
      nivel:    nivel,
      codigo:   codigo,
    };

  } catch(e) {
    return { error: 'Error generando documento: ' + e.message };
  }
}

function obtenerOCrearCarpeta(codigo, nombre, grupo, nivel) {
  // Estructura: DOCUMENTOS_ESTUDIANTES / GRUPO / NIVEL / archivos
  var raiz    = DriveApp.getFolderById(DOCUMENTOS_FOLDER_ID);
  var docsIt  = raiz.getFoldersByName('DOCUMENTOS_ESTUDIANTES');
  var docsCarpeta = docsIt.hasNext() ? docsIt.next() : raiz.createFolder('DOCUMENTOS_ESTUDIANTES');

  // Subcarpeta por GRUPO (si se pasa)
  var carpetaNivel = docsCarpeta;
  if (grupo) {
    var gIt = docsCarpeta.getFoldersByName(grupo);
    var gCarpeta = gIt.hasNext() ? gIt.next() : docsCarpeta.createFolder(grupo);
    // Subcarpeta por NIVEL dentro del grupo
    if (nivel) {
      var NIVEL_CARPETA = { B1:'BASICO_1', B2:'BASICO_2', I1:'INTERMEDIO_1', I2:'INTERMEDIO_2' };
      var nNombre = NIVEL_CARPETA[nivel.toUpperCase()] || nivel;
      var nIt = gCarpeta.getFoldersByName(nNombre);
      carpetaNivel = nIt.hasNext() ? nIt.next() : gCarpeta.createFolder(nNombre);
    } else {
      carpetaNivel = gCarpeta;
    }
  }
  return carpetaNivel;
}

// ============================================================
// generarCertificado(data)                         — v4.10
// POST ?fn=generarCertificado
//
// Genera el PDF del título/certificado de nivel para un estudiante.
// Asigna número consecutivo global por año (SJ01-XXXX-YYYY).
// Guarda el número en REG_CERTIFICADOS (col O) de ESTATUS.
//
// Body: { codigo, nivel, grupo }
// Retorna: { ok, url, registro, nombre, nivel, codigo }
// ============================================================
// F32 limpieza: definición duplicada anterior de generarCertificado eliminada; se conserva la última definición activa.

// ── Helper: genera el PDF usando la plantilla CERTIFICACION ──
// Usa Docs REST API (batchUpdate) para respetar el formato del template
function generarPdfCertificado(ss, codigo, nivel, grupo, registro) {
  var plantillaId = PLANTILLA_IDS['CERTIFICACION'];
  if (!plantillaId) return { ok: false, error: 'Plantilla CERTIFICACION no configurada.' };

  var estData = getEstudiante(codigo);
  if (!estData.ok) return { ok: false, error: estData.error };

  var est    = estData.estudiante;
  var grupoI = estData.grupo || {};
  var nombre = String(est['NOMBRE'] || '').trim();
  var cedula = String(est['NUM_CEDULA'] || est['CEDULA'] || '').trim();

  var NL = { B1:'BÁSICO I', B2:'BÁSICO II', I1:'INTERMEDIO I', I2:'INTERMEDIO II' };
  var modulo = NL[nivel] || nivel;

  var ME = ['enero','febrero','marzo','abril','mayo','junio','julio','agosto','septiembre','octubre','noviembre','diciembre'];
  function fL(d) {
    if (!d) return '';
    try { var f=d instanceof Date?d:new Date(d); return f.getDate()+' de '+ME[f.getMonth()]+' de '+f.getFullYear(); }
    catch(e){return String(d);}
  }
  function mA(d) {
    if (!d) return '';
    try { var f=d instanceof Date?d:new Date(d); var m=ME[f.getMonth()]; return m.charAt(0).toUpperCase()+m.slice(1)+' '+f.getFullYear(); }
    catch(e){return String(d);}
  }

  var hoy = new Date();

  // Calcular INICIO y FIN reales respetando el periodo académico
  // FIN = último mes del periodo (no la fecha real de finalización)
  // C1=Abril, C2=Agosto, C3=Diciembre
  // B1=Feb, B2=Abr, B3=Jun, B4=Ago, B5=Oct, B6=Dic
  // Mes FINAL de cada periodo (índice 0-based: 0=Ene, 3=Abr, 7=Ago, 11=Dic)
  var PERIODO_FIN_MES = {
    'C1': 3,  // Abril
    'C2': 7,  // Agosto
    'C3': 11, // Diciembre
    'B1': 1,  // Febrero
    'B2': 3,  // Abril
    'B3': 5,  // Junio
    'B4': 7,  // Agosto
    'B5': 9,  // Octubre
    'B6': 11, // Diciembre
  };
  // Mes INICIAL de cada periodo
  var PERIODO_INI_MES = {
    'C1': 0,  // Enero
    'C2': 4,  // Mayo
    'C3': 8,  // Septiembre
    'B1': 0,  // Enero
    'B2': 2,  // Marzo
    'B3': 4,  // Mayo
    'B4': 6,  // Julio
    'B5': 8,  // Septiembre
    'B6': 10, // Noviembre
  };

  var wsGrupos = ss.getSheetByName(SH.GRUPOS);
  var fechaIni = '', fechaFin = '';
  var finDate = hoy;

  // Leer fechas reales desde GRUPOS_FECHAS
  // Leccion 1 = fecha inicio real, Leccion 32 = fecha fin real
  // El mes del FIN siempre corresponde al periodo académico
  var PER_FIN_C = { C1:3,C2:7,C3:11, B1:1,B2:3,B3:5,B4:7,B5:9,B6:11 };

  // Leer SIEMPRE de GRUPOS principal — tiene PERIODO_INICIO y AÑO_INICIO correctos por nivel
  // GRUPOS_FECHAS tiene AÑO del grupo original (ej: 2025) que no corresponde al nivel actual
  if (wsGrupos && grupo) {
    var gMainR = wsGrupos.getDataRange().getValues();
    var gMainHH = gMainR[0];
    var igmC2  = gMainHH.indexOf('CODIGO_GRUPO');
    var igmN2  = gMainHH.indexOf('NIVEL_INICIO');
    var igmP2  = gMainHH.indexOf('PERIODO_INICIO');
    var igmA2  = gMainHH.indexOf('AÑO_INICIO');
    var igmT2  = gMainHH.indexOf('TIPO_PERIODO');
    var igmF2  = gMainHH.indexOf('FECHA_INICIO');

    for (var gj = 1; gj < gMainR.length; gj++) {
      if (String(gMainR[gj][igmC2]||'').trim() !== grupo) continue;
      if (String(gMainR[gj][igmN2]||'').trim().toUpperCase() !== nivel) continue;

      // Fecha inicio real del nivel
      var fdReal = gMainR[gj][igmF2];
      if (fdReal instanceof Date) {
        fechaIni = fL(fdReal);
      } else if (fdReal) {
        try { var fdp = new Date(fdReal); if (!isNaN(fdp)) fechaIni = fL(fdp); } catch(e){}
      }

      // Periodo y año CORRECTOS del nivel
      var per2  = String(gMainR[gj][igmP2]||'').trim();
      var anioG = parseInt(gMainR[gj][igmA2]) || hoy.getFullYear();
      var tipoG = String(gMainR[gj][igmT2]||'C').trim().toUpperCase();
      var perClave = tipoG + per2;

      // FIN = mes inicio + 3 (cuatri) o + 1 (bimestre)
      var mesesDur = tipoG === 'C' ? 3 : 1;
      var mesIniP2 = parseInt(per2) - 1; // C1=0, C2=4, C3=8 — NO, mejor usar fecha inicio
      // Usar FECHA_INICIO del nivel y sumar meses de duración
      var fdIni2 = gMainR[gj][igmF2];
      if (!(fdIni2 instanceof Date)) { try { fdIni2 = new Date(fdIni2); } catch(e){ fdIni2 = hoy; } }
      finDate = new Date(fdIni2.getFullYear(), fdIni2.getMonth() + mesesDur, 1);
      fechaFin = mA(finDate);
      break;
    }
  }

  if (!fechaIni) fechaIni = fL(grupoI.FECHA_INICIO || hoy);
  if (!fechaFin) { fechaFin = mA(hoy); finDate = hoy; }

  // Entrega = mes siguiente al FIN
  var entregaDate = new Date(finDate.getFullYear(), finDate.getMonth() + 1, 1);
  var entrega = mA(entregaDate);

  var campos = {
    '{{registro}}':   registro,
    '{{MODULO}}':     modulo,
    '{{NOMBRE}}':     nombre,
    '{{CEDULA}}':     cedula,
    '{{NUM_CEDULA}}': cedula,
    '{{INICIO}}':     fechaIni,
    '{{FIN}}':        fechaFin,
    '{{entrega}}':    entrega,
    '{{FECHA}}':      fL(hoy),
  };

  try {
    // 1. Copiar plantilla
    var carpetaEst = obtenerOCrearCarpeta(codigo, nombre, grupo, nivel);
    var copia = DriveApp.getFileById(plantillaId)
                  .makeCopy('TEMP_CERT_'+codigo+'_'+nivel+'_'+Date.now(),
                             DriveApp.getFolderById(DOCUMENTOS_FOLDER_ID));
    var copiaId = copia.getId();

    // 2. Reemplazar con Docs API batchUpdate — respeta el formato del template
    var requests = Object.keys(campos).map(function(k) {
      return {
        replaceAllText: {
          containsText: { text: k, matchCase: true },
          replaceText: campos[k] || ''
        }
      };
    });

    Docs.Documents.batchUpdate({ requests: requests }, copiaId);

    // 3. Exportar como PDF directamente desde Drive API
    var pdfResponse = UrlFetchApp.fetch(
      'https://www.googleapis.com/drive/v3/files/' + copiaId + '/export?mimeType=application/pdf',
      { headers: { Authorization: 'Bearer ' + ScriptApp.getOAuthToken() }, muteHttpExceptions: true }
    );

    if (pdfResponse.getResponseCode() !== 200) {
      copia.setTrashed(true);
      return { ok: false, error: 'Error exportando PDF: ' + pdfResponse.getContentText().substring(0,200) };
    }

    var nPdf = 'CERTIFICADO ' +
      (nivel==='B1'?'BASICO 1':nivel==='B2'?'BASICO 2':nivel==='I1'?'INTERMEDIO 1':'INTERMEDIO 2') +
      ' - ' + codigo + ' - ' + cedula + '.pdf';

    var pdf = carpetaEst.createFile(pdfResponse.getBlob().setName(nPdf).setContentType('application/pdf'));

    // 4. Borrar copia temporal
    copia.setTrashed(true);

    return { ok: true, url: pdf.getUrl(), nombre: nPdf };

  } catch(e) {
    return { ok: false, error: 'Error generando PDF: ' + e.message };
  }
}

// ============================================================
// getContenidoLeccion(params)
// GET ?fn=getContenidoLeccion&nivel=BASICO_I&leccion_num=5
//
// Retorna el detalle de una lección desde LECCIONES_CONTENIDO
// en CAMPUS_OPERATIVO. Niveles: BASICO_I | BASICO_II |
// INTERMEDIO_I | INTERMEDIO_II
// ============================================================
function getContenidoLeccion(params) {
  var nivel_param = String(params.nivel     || '').trim().toUpperCase().replace(/ /g,'_');
  var lec_num     = parseInt(params.leccion_num || 0);
  if (!nivel_param || !lec_num) return { ok:false, error:'nivel y leccion_num requeridos' };

  // Normalizar nivel: acepta B1/B2/I1/I2 o BASICO_I etc.
  var NIVEL_MAP = {
    'B1':'BASICO I', 'B2':'BASICO II', 'I1':'INTERMEDIO I', 'I2':'INTERMEDIO II',
    'BASICO_I':'BASICO I', 'BASICO_II':'BASICO II',
    'INTERMEDIO_I':'INTERMEDIO I', 'INTERMEDIO_II':'INTERMEDIO II',
    'BASICO I':'BASICO I', 'BASICO II':'BASICO II',
    'INTERMEDIO I':'INTERMEDIO I', 'INTERMEDIO II':'INTERMEDIO II',
  };
  var nivel_largo = NIVEL_MAP[nivel_param];
  if (!nivel_largo) return { ok:false, error:'Nivel no reconocido: '+nivel_param };

  try {
    var ss = SpreadsheetApp.openById(OPERATIVO_ID);
    var ws = ss.getSheetByName('LECCIONES_CONTENIDO');
    if (!ws) return { ok:false, error:'Hoja LECCIONES_CONTENIDO no encontrada' };

    var data = ws.getDataRange().getValues();
    var h    = data[0];
    var iId  = h.indexOf('id_leccion');
    var iNiv = h.indexOf('nivel');
    var iLec = h.indexOf('leccion_num');
    var iEti = h.indexOf('etiqueta');
    var iNom = h.indexOf('nombre_completo');
    var iDet = h.indexOf('detalle');
    var iAsi = h.indexOf('asignatura');
    var iObj = h.indexOf('objetivo');
    var iSpk = h.indexOf('speaking');
    var iGra = h.indexOf('grammar');
    var iPro = h.indexOf('pronunciacion');
    var iWri = h.indexOf('writing');
    var iPdf = h.indexOf('pdf_drive_id');

    for (var i = 1; i < data.length; i++) {
      var n = String(data[i][iNiv] || '').trim().toUpperCase();
      var l = parseInt(data[i][iLec]);
      if (n !== nivel_largo.toUpperCase()) continue;
      if (l !== lec_num) continue;

      var pdfId = String(data[i][iPdf] || '').trim();
      return {
        ok: true,
        leccion: {
          id_leccion:    String(data[i][iId]  || '').trim(),
          etiqueta:      String(data[i][iEti] || '').trim(),
          nombre_completo: String(data[i][iNom] || '').trim(),
          detalle:       String(data[i][iDet] || '').trim(),
          asignatura:    String(data[i][iAsi] || '').trim(),
          objetivo:      String(data[i][iObj] || '').trim(),
          speaking:      String(data[i][iSpk] || '').trim(),
          grammar:       String(data[i][iGra] || '').trim(),
          pronunciacion: String(data[i][iPro] || '').trim(),
          writing:       String(data[i][iWri] || '').trim(),
          pdf_drive_id:  pdfId,
          pdf_view_url:  pdfId ? 'https://drive.google.com/file/d/'+pdfId+'/view' : '',
          pdf_dl_url:    pdfId ? 'https://drive.google.com/uc?export=download&id='+pdfId : '',
        }
      };
    }
    return { ok:false, error:'Lección no encontrada: '+nivel_largo+' #'+lec_num };
  } catch(e) {
    return { ok:false, error:'Error: '+e.toString() };
  }
}

// ============================================================
// getAsistenciaEstudiante(params)
// GET ?fn=getAsistenciaEstudiante&cod_grupo=X&cod_estudiante=Y
//
// Retorna la asistencia real del estudiante desde ASISTENCIA
// en CAMPUS_OPERATIVO.
// ============================================================
function getAsistenciaGrupoEst(params) {
  var cod_grupo    = String(params.cod_grupo    || '').trim();
  var cod_est      = String(params.cod_estudiante || '').trim();
  if (!cod_grupo || !cod_est) return { ok:false, error:'cod_grupo y cod_estudiante requeridos' };

  try {
    var ss = SpreadsheetApp.openById(OPERATIVO_ID);
    var ws = ss.getSheetByName(OP.ASISTENCIA);
    if (!ws) return { ok:false, error:'Hoja ASISTENCIA no encontrada' };

    var data = ws.getDataRange().getValues();
    var h    = data[0];
    var iGrp = h.indexOf('cod_grupo');
    var iEst = h.indexOf('cod_estudiante');
    var iLec = h.indexOf('leccion_num');
    var iPre = h.indexOf('presente');
    var iFec = h.indexOf('fecha_leccion');

    var asistencia = [];
    for (var i = 1; i < data.length; i++) {
      if (String(data[i][iGrp] || '').trim() !== cod_grupo) continue;
      if (String(data[i][iEst] || '').trim() !== cod_est)   continue;
      asistencia.push({
        leccion_num:   parseInt(data[i][iLec]) || 0,
        presente:      data[i][iPre] === true || String(data[i][iPre]).toUpperCase() === 'TRUE',
        fecha_leccion: String(data[i][iFec] || '').trim(),
      });
    }
    return { ok:true, asistencia:asistencia };
  } catch(e) {
    return { ok:false, error:'Error: '+e.toString() };
  }
}

// ============================================================
// CALENDARIO DE LECCIONES — v4.14
// Las siguientes funciones leen/escriben en CALENDARIO_LECCIONES
// de CAMPUS_OPERATIVO (OPERATIVO_ID).
// Requiere que poblarCalendarioLecciones() se haya ejecutado previamente.
// ============================================================

// getFechasGrupo(cod_grupo, nivel, rielFiltro opcional)
// Retorna {ok, lecciones:[{leccion,fecha,dia,turno,tipo,estado}]}
// Usar desde router GET ?fn=getFechasGrupo
function getFechasGrupo(cod_grupo, nivel, rielFiltro) {
  var ss = SpreadsheetApp.openById(OPERATIVO_ID);
  var ws = ss.getSheetByName(SH_CALENDARIO);
  if (!ws) return { ok:false, error:'CALENDARIO_LECCIONES no existe. Correr poblarCalendarioLecciones().' };

  var data = ws.getDataRange().getValues();
  var h = data[0];
  var iG=h.indexOf('COD_GRUPO'), iN=h.indexOf('NIVEL'),
      iL=h.indexOf('LECCION'),  iF=h.indexOf('FECHA'),
      iD=h.indexOf('DIA_SEMANA'),iT=h.indexOf('TURNO'),
      iK=h.indexOf('TIPO_LECCION'),iE=h.indexOf('ESTADO'),
      iHI=h.indexOf('HORA_INICIO'), iHF=h.indexOf('HORA_FIN'),
      iRP=h.indexOf('REPROGRAMADA'), iFO=h.indexOf('FECHA_ORIGINAL'),
      iEV=h.indexOf('EVENTO_ID');

  var filtroRiel = String(rielFiltro || '').trim().toLowerCase();
  // F87: repara una sola vez las horas regulares dañadas y devuelve siempre
  // el intervalo efectivo. Las reprogramaciones conservan su horario especial.
  _ccF87_normalizarHorasGrupoNivel_(ws, data, h, cod_grupo, nivel);
  var idxCalF87 = _ccF84_idxMap_(h);
  var catF87 = _ccF84_catalogoGrupos_(SpreadsheetApp.openById(SHEET_ID));
  var metaF87 = catF87[String(cod_grupo || '').trim() + '|' + String(nivel || '').trim().toUpperCase()] || null;
  var result = [];
  for (var i=1; i<data.length; i++) {
    if (String(data[i][iG]).trim() !== String(cod_grupo).trim()) continue;
    if (String(data[i][iN]).trim() !== String(nivel).trim())     continue;
    var tipoFila = String(data[i][iK] || 'CLASE').trim().toUpperCase();
    var rielFila = tipoFila === 'ICAN' ? 'ican' : 'curso';
    if ((filtroRiel === 'curso' || filtroRiel === 'ican') && rielFila !== filtroRiel) continue;
    var f = data[i][iF];
    var intervaloF87 = _ccF84_intervaloFila_(data[i], idxCalF87, metaF87);
    result.push({
      leccion: parseInt(data[i][iL], 10) || 0,
      fecha:   f instanceof Date ? Utilities.formatDate(f,'America/Costa_Rica','yyyy-MM-dd') : String(f),
      dia:     String(data[i][iD] || ''),
      turno:   String(data[i][iT] || ''),
      tipo:    tipoFila,
      riel:    rielFila,
      estado:  String(data[i][iE] || 'PROGRAMADA'),
      hora_inicio: intervaloF87 ? _ccF84_minHora_(intervaloF87.ini) : (iHI >= 0 ? _ccF84_hora_(data[i][iHI]) : ''),
      hora_fin: intervaloF87 ? _ccF84_minHora_(intervaloF87.fin) : (iHF >= 0 ? _ccF84_hora_(data[i][iHF]) : ''),
      reprogramada: iRP >= 0 ? String(data[i][iRP] || '').toUpperCase() === 'TRUE' : false,
      fecha_original: iFO >= 0 ? _ccF84_iso_(data[i][iFO]) : '',
      evento_id: iEV >= 0 ? String(data[i][iEV] || '') : '',
    });
  }

  // CALGRUPO_F53_20260617_CRONOGRAMA_COMPLETAR_32_LECCIONES
  // Si CALENDARIO_LECCIONES trae solo las primeras filas reales, completamos
  // visualmente hasta 32 usando el patrón del grupo. No escribe en la hoja.
  if (filtroRiel !== 'ican') result = _anF53_completarLecciones32_(result, cod_grupo, nivel);
  else result.sort(function(a,b){ return (a.leccion||0)-(b.leccion||0); });
  result.forEach(function(x) {
    x.cod_grupo = String(cod_grupo || '').trim();
    x.nivel = String(nivel || '').trim().toUpperCase();
  });
  return { ok:true, version:'F87', riel:filtroRiel || 'todos', lecciones:result };
}

function _anF53_completarLecciones32_(rows, codGrupo, nivel) {
  rows = Array.isArray(rows) ? rows.slice() : [];
  var cursoRows = [];
  var icanRows = [];
  rows.forEach(function(r) {
    if (!r || !Number(r.leccion)) return;
    var riel = String(r.riel || '').trim().toLowerCase();
    var tipo = String(r.tipo || '').trim().toUpperCase();
    if (riel === 'ican' || tipo === 'ICAN') icanRows.push(r);
    else cursoRows.push(r);
  });

  var meta = _anF53_metaGrupoCalendario_(codGrupo);
  var dias = _anF53_weekdaysGrupo_(codGrupo, meta.dias);
  var porDia = (dias.length === 1 && dias[0] === 6) ? 2 : 1; // sábado: 2 lecciones por jornada
  var byNum = {};
  cursoRows.forEach(function(r){ if (r && r.leccion) byNum[Number(r.leccion)] = r; });

  var clean = [];
  Object.keys(byNum).forEach(function(k){ clean.push(byNum[k]); });
  clean.sort(function(a,b){ return (a.leccion||0)-(b.leccion||0); });

  if (dias.length && clean.length < 32) {
    var maxNum = 0;
    var lastIso = '';
    for (var i=0; i<clean.length; i++) {
      if (Number(clean[i].leccion) > maxNum) maxNum = Number(clean[i].leccion);
      if (clean[i].fecha && (!lastIso || String(clean[i].fecha) > lastIso)) lastIso = String(clean[i].fecha);
    }
    if (!lastIso) lastIso = meta.fechaInicio || _anF53_isoToday_();
    var nextDate = lastIso;
    var n = maxNum + 1;
    while (n <= 32) {
      nextDate = _anF53_nextWeekdayAfter_(nextDate, dias);
      for (var slot=0; slot<porDia && n<=32; slot++) {
        clean.push({
          leccion: n,
          fecha: nextDate,
          dia: _anF53_diaCorto_(nextDate),
          turno: meta.turno || '',
          tipo: _anF53_tipoLeccion_(n),
          riel: 'curso',
          estado: _anF53_estadoVisualFecha_(nextDate),
          proyectada: true
        });
        n++;
      }
    }
  }

  clean.sort(function(a,b){ return (a.leccion||0)-(b.leccion||0); });
  icanRows.sort(function(a,b){
    return String(a.fecha || '').localeCompare(String(b.fecha || '')) || (a.leccion||0)-(b.leccion||0);
  });
  // Compatibilidad: `lecciones` conserva curso + I CAN, pero ya no permite que
  // I CAN sobrescriba las lecciones 1–16 del curso por compartir numeración.
  return clean.concat(icanRows);
}

function _anF53_metaGrupoCalendario_(codGrupo) {
  var out = { dias:'', fechaInicio:'', turno:'' };
  try {
    var ss = SpreadsheetApp.openById(SHEET_ID);
    var ws = ss.getSheetByName(SH.GRUPOS);
    if (!ws) return out;
    var data = ws.getDataRange().getValues();
    var h = data[0];
    var iCod=h.indexOf('CODIGO_GRUPO'), iDias=h.indexOf('DIAS'), iFecha=h.indexOf('FECHA_INICIO'), iTurno=h.indexOf('TURNO');
    for (var i=1; i<data.length; i++) {
      if (String(data[i][iCod] || '').trim() !== String(codGrupo || '').trim()) continue;
      out.dias = iDias > -1 ? String(data[i][iDias] || '').trim() : '';
      out.fechaInicio = iFecha > -1 ? _anF52_courseDateIso_(data[i][iFecha]) : '';
      out.turno = iTurno > -1 ? String(data[i][iTurno] || '').trim() : '';
      return out;
    }
  } catch(e) {}
  return out;
}

function _anF53_weekdaysGrupo_(codGrupo, diasRaw) {
  var seg = String(codGrupo || '').toUpperCase().split('-')[1] || '';
  var raw = String(diasRaw || seg || '').toUpperCase();
  if (/^SA/.test(raw)) return [6];
  if (/^LJ/.test(raw)) return [1,2,3,4];
  var map = { L:1, K:2, M:3, J:4, V:5, S:6, D:0 };
  var out = [];
  raw.replace(/[^LKMJVSD]/g,'').split('').forEach(function(ch){
    if (map[ch] !== undefined && out.indexOf(map[ch]) === -1) out.push(map[ch]);
  });
  out.sort(function(a,b){ return a-b; });
  return out;
}

function _anF53_nextWeekdayAfter_(iso, dias) {
  var d = _anF53_parseIsoLocal_(iso) || new Date();
  d.setDate(d.getDate() + 1);
  for (var guard=0; guard<14; guard++) {
    if (dias.indexOf(d.getDay()) !== -1) return Utilities.formatDate(d, 'America/Costa_Rica', 'yyyy-MM-dd');
    d.setDate(d.getDate() + 1);
  }
  return Utilities.formatDate(d, 'America/Costa_Rica', 'yyyy-MM-dd');
}

function _anF53_parseIsoLocal_(iso) {
  var m = String(iso || '').match(/^(\d{4})-(\d{2})-(\d{2})$/);
  if (!m) return null;
  return new Date(Number(m[1]), Number(m[2])-1, Number(m[3]));
}
function _anF53_isoToday_() {
  return Utilities.formatDate(new Date(), 'America/Costa_Rica', 'yyyy-MM-dd');
}
function _anF53_diaCorto_(iso) {
  var d = _anF53_parseIsoLocal_(iso);
  var a = ['Dom','Lun','Mar','Mié','Jue','Vie','Sáb'];
  return d ? a[d.getDay()] : '';
}
function _anF53_estadoVisualFecha_(iso) {
  var hoy = _anF53_isoToday_();
  if (iso === hoy) return 'HOY';
  return String(iso || '') < hoy ? 'CALCULADA' : 'PROGRAMADA';
}
function _anF53_tipoLeccion_(n) {
  n = Number(n);
  if (n === 9 || n === 17 || n === 25 || n === 31) return 'EVAL_ORAL';
  if (n === 18 || n === 32) return 'EVAL_ESCRITO';
  return 'CLASE';
}

// getLeccionActual(cod_grupo, nivel)
// Retorna ultima_cerrada, proxima, leccion_hoy, total_cerradas, total_feriados
function getLeccionActual(cod_grupo, nivel) {
  var res = getFechasGrupo(cod_grupo, nivel, 'curso');
  if (!res.ok) return res;
  var lec  = res.lecciones;
  var cerr = lec.filter(function(l){ return l.estado==='CERRADA'; });
  var calc = lec.filter(function(l){ return l.estado==='CALCULADA'||l.estado==='HOY'; });
  var hoy  = lec.filter(function(l){ return l.estado==='HOY'; });
  return {
    ok:             true,
    ultima_cerrada: cerr.length ? cerr[cerr.length-1] : null,
    proxima:        calc.length ? calc[0]             : null,
    leccion_hoy:    hoy.length  ? hoy[0]              : null,
    total_cerradas: cerr.length,
    total_feriados: lec.filter(function(l){ return l.estado==='FERIADO'; }).length,
  };
}

// actualizarFechaLeccion(cod_grupo, nivel, leccion_num, nueva_fecha)
// Congela la fecha de una lección. Solo cambia esa fila.
// Llamar via POST ?fn=actualizarFechaLeccion
function actualizarFechaLeccion(cod_grupo, nivel, leccion_num, nueva_fecha) {
  if (!cod_grupo || !nivel || !leccion_num || !nueva_fecha) {
    return { ok:false, error:'Faltan parámetros: cod_grupo, nivel, leccion_num, nueva_fecha' };
  }
  var ss = SpreadsheetApp.openById(OPERATIVO_ID);
  var ws = ss.getSheetByName(SH_CALENDARIO);
  if (!ws) return { ok:false, error:'CALENDARIO_LECCIONES no encontrada' };

  var data = ws.getDataRange().getValues();
  var h    = data[0];
  var iG=h.indexOf('COD_GRUPO'),iN=h.indexOf('NIVEL'),
      iL=h.indexOf('LECCION'),  iF=h.indexOf('FECHA'),
      iD=h.indexOf('DIA_SEMANA'),iE=h.indexOf('ESTADO');

  var DIAS = ['Dom','Lun','Mar','Mié','Jue','Vie','Sáb'];
  var fd   = new Date(String(nueva_fecha) + 'T12:00:00');

  for (var i=1; i<data.length; i++) {
    if (String(data[i][iG]).trim() !== String(cod_grupo).trim()) continue;
    if (String(data[i][iN]).trim() !== String(nivel).trim())     continue;
    if (parseInt(data[i][iL])      !== parseInt(leccion_num))    continue;
    var fila = i+1;
    ws.getRange(fila, iF+1).setValue(String(nueva_fecha));
    ws.getRange(fila, iD+1).setValue(DIAS[fd.getDay()]);
    ws.getRange(fila, iE+1).setValue('CERRADA');
    Logger.log('actualizarFechaLeccion: '+cod_grupo+' '+nivel+' Lec '+leccion_num+' → '+nueva_fecha);
    return { ok:true, grupo:cod_grupo, nivel:nivel, leccion:parseInt(leccion_num), nueva_fecha:String(nueva_fecha) };
  }
  return { ok:false, error:'Lección no encontrada: '+cod_grupo+' '+nivel+' #'+leccion_num };
}

// marcarLeccionCerrada(cod_grupo, nivel, leccion_num)
// Marca la lección como CERRADA con la fecha de hoy.
// Se llama automáticamente al registrar asistencia.
function marcarLeccionCerrada(cod_grupo, nivel, leccion_num) {
  var hoy = Utilities.formatDate(new Date(), 'America/Costa_Rica', 'yyyy-MM-dd');
  return actualizarFechaLeccion(cod_grupo, nivel, leccion_num, hoy);
}

// ============================================================
// getUsuarioEstudiante(usuario, clave)                — v4.14
// Fallback de login: usuario = cédula, clave = código.
// Busca en hoja DATOS de APOLLO_G3.
// Si encuentra match: retorna sesión student con grupo activo.
// ============================================================
function getUsuarioEstudiante(usuario, clave) {
  try {
    var ss    = SpreadsheetApp.openById(SHEET_ID);
    var ws    = ss.getSheetByName(SH.DATOS);
    if (!ws) return { ok: false, error: 'credenciales_invalidas' };

    var rows = ws.getDataRange().getValues();
    var h    = rows[0];
    var iCed  = h.indexOf('NUM_CEDULA');
    var iCod  = h.indexOf('CODIGO');
    var iNom  = h.indexOf('NOMBRE');
    var iGrp  = h.indexOf('GRUPO');
    var iProg = h.indexOf('PROGRAMA');

    if (iCed === -1 || iCod === -1) return { ok: false, error: 'credenciales_invalidas' };

    var uStr = String(usuario || '').trim();
    var cStr = String(clave   || '').trim();

    for (var i = 1; i < rows.length; i++) {
      var cedula = String(rows[i][iCed] || '').trim();
      var codigo = String(rows[i][iCod] || '').trim();
      if (cedula !== uStr) continue;
      if (codigo !== cStr) {
        return { ok: false, error: 'credenciales_invalidas' };
      }
      // Match encontrado
      var grupo   = String(rows[i][iGrp]  || '').trim();
      var nombre  = String(rows[i][iNom]  || '').trim();
      // Programa: leer del grupo en GRUPOS (fuente de verdad), con
      // fallback a DATOS.PROGRAMA si el grupo no aparece en GRUPOS.
      var programa = _programaDeGrupo(ss, grupo);
      if (programa === 'SIN_INA' && iProg > -1) {
        var pDatos = String(rows[i][iProg] || '').trim().toUpperCase();
        if (pDatos === 'INA') programa = 'INA';
      }
      return {
        ok:       true,
        rol:      'student',
        nombre:   nombre,
        grupo:    grupo  || null,
        codigo:   codigo || null,
        cedula:   cedula,
        programa: programa,
      };
    }
    return { ok: false, error: 'credenciales_invalidas' };
  } catch(e) {
    return { ok: false, error: 'error_interno' };
  }
}

// ============================================================
// getLeccionDetalle(id_leccion)                       — v4.14
// Lee la fila de LECCIONES_CONTENIDO en CAMPUS_OPERATIVO
// para el id dado (L001..L128 o IC001..IC064).
// Retorna título, tipo, objetivo, temas, pdf_drive_id.
// ============================================================
// ════════════════════════════════════════════════════════════════════
// _estadoEstudianteEnGrupo(ss, codigo, cod_grupo, nivel)   — v4.22.4
// Lee ESTATUS y devuelve el estado REAL del estudiante en ese grupo+nivel
// (CA, APR, CNV, REP, RET, PE, etc.). '' si no se encuentra.
// Fuente de verdad para permisos — el frontend NO puede falsearlo.
// ════════════════════════════════════════════════════════════════════
function _estadoEstudianteEnGrupo(ss, codigo, cod_grupo, nivel) {
  var wsEst = ss.getSheetByName(SH.ESTATUS);
  if (!wsEst) return '';
  var rows = wsEst.getDataRange().getValues();
  var H = rows[0];
  var iCod = H.indexOf('CODIGO');
  var iNiv = H.indexOf('NIVEL');
  var iGrp = H.indexOf('GRUPO');
  var iEst = H.indexOf('ESTATUS');
  if (iCod === -1 || iEst === -1) return '';
  var cg = String(cod_grupo || '').trim();
  var nv = String(nivel || '').trim().toUpperCase();
  var cd = String(codigo || '').trim();
  for (var i = 1; i < rows.length; i++) {
    if (String(rows[i][iCod] || '').trim() !== cd) continue;
    if (cg && String(rows[i][iGrp] || '').trim() !== cg) continue;
    if (nv && String(rows[i][iNiv] || '').trim().toUpperCase() !== nv) continue;
    return String(rows[i][iEst] || '').trim().toUpperCase();
  }
  return '';
}

// Estados de estudiante que SÍ pueden ver el material PDF.
var _ESTADOS_VEN_PDF = { 'CA': true, 'APR': true, 'CNV': true };

// ════════════════════════════════════════════════════════════════════
// getMaterialLeccion(params)                                — v4.22.4
// Devuelve el PDF de una lección APLICANDO PERMISOS en el backend.
// El PDF del profe NUNCA viaja a un estudiante (seguridad).
//
// params: {
//   nivel, leccion, riel,        // qué lección
//   rol,                         // 'teacher' | 'student' | 'admin'
//   codigo, cod_grupo            // (solo estudiante) para verificar estado
// }
//
// Reglas:
//   - teacher / admin → ven pdf_profe SIEMPRE, todas las 32 lecciones.
//   - student → ve pdf_estudiante de TODAS las lecciones SOLO si su
//     estado real en ESTATUS es CA, APR o CNV. Si no, no recibe PDF.
// ════════════════════════════════════════════════════════════════════
function getMaterialLeccion(params) {
  params = params || {};
  var nivel   = String(params.nivel || '').trim().toUpperCase();
  var leccion = params.leccion;
  var riel    = String(params.riel || 'curso').toLowerCase();
  var rol     = String(params.rol || '').trim().toLowerCase();

  if (!nivel || leccion == null) {
    return { ok: false, error: 'nivel y leccion obligatorios' };
  }

  // Traer el detalle (título, ambos PDFs)
  var det = getLeccionDetalle(nivel, leccion, riel);
  if (!det.ok) return det;
  var L = det.leccion;

  // Decidir según rol
  if (rol === 'teacher' || rol === 'admin' || rol === 'superadmin') {
    return {
      ok: true,
      acceso: true,
      rol: rol,
      titulo: L.titulo_unidad,
      unidad: L.unidad,
      leccion: L.leccion_num,
      pdf_id:  L.pdf_profe,
      pdf_url: L.pdf_profe_url,
      tipo_pdf: 'profe'
    };
  }

  if (rol === 'student') {
    var ss = SpreadsheetApp.openById(SHEET_ID);
    var estado = _estadoEstudianteEnGrupo(ss, params.codigo, params.cod_grupo, nivel);
    if (!_ESTADOS_VEN_PDF[estado]) {
      return {
        ok: true,
        acceso: false,
        rol: 'student',
        estado: estado || '(sin estado)',
        motivo: 'El material está disponible solo para estudiantes activos (matriculados, aprobados o convalidados).',
        titulo: L.titulo_unidad,
        unidad: L.unidad,
        leccion: L.leccion_num
      };
    }
    return {
      ok: true,
      acceso: true,
      rol: 'student',
      estado: estado,
      titulo: L.titulo_unidad,
      unidad: L.unidad,
      leccion: L.leccion_num,
      pdf_id:  L.pdf_estudiante,
      pdf_url: L.pdf_estudiante_url,
      tipo_pdf: 'estudiante'
    };
  }

  return { ok: false, error: 'rol no reconocido: ' + rol };
}


// ════════════════════════════════════════════════════════════════════
// _NIVEL_A_CONTENIDO — mapeo del código de nivel (B1/B2/I1/I2) al texto
// del campo "nivel" en LECCIONES_CONTENIDO, y al offset de id_leccion.
//   B1 → BASICO I,      curso L001-L032, ican IC001-IC016
//   B2 → BASICO II,     curso L033-L064, ican IC017-IC032
//   I1 → INTERMEDIO I,  curso L065-L096, ican IC033-IC048
//   I2 → INTERMEDIO II, curso L097-L128, ican IC049-IC064
// ════════════════════════════════════════════════════════════════════
var _NIVEL_A_CONTENIDO = {
  'B1': { texto:'BASICO I',      offCurso:0,  offIcan:0  },
  'B2': { texto:'BASICO II',     offCurso:32, offIcan:16 },
  'I1': { texto:'INTERMEDIO I',  offCurso:64, offIcan:32 },
  'I2': { texto:'INTERMEDIO II', offCurso:96, offIcan:48 }
};

// Construye el id_leccion a partir de nivel + número + riel.
//   _idLeccion('I1', 3, 'curso') → 'L067'
//   _idLeccion('B1', 5, 'ican')  → 'IC005'
function _idLeccion(nivel, num, riel) {
  var m = _NIVEL_A_CONTENIDO[String(nivel||'').trim().toUpperCase()];
  if (!m) return null;
  var n = Number(num);
  if (!n || n < 1) return null;
  if (String(riel||'curso').toLowerCase() === 'ican') {
    var gi = m.offIcan + n;
    return 'IC' + ('00' + gi).slice(-3);
  }
  var gc = m.offCurso + n;
  return 'L' + ('00' + gc).slice(-3);
}


// ════════════════════════════════════════════════════════════════════
// getLeccionDetalle(id_leccion)  o  getLeccionDetalle(nivel, num, riel)
// Lee LECCIONES_CONTENIDO en CAMPUS_OPERATIVO con los nombres de columna
// REALES de la hoja. Acepta:
//   - un id directo: getLeccionDetalle('L067')
//   - nivel+num+riel: getLeccionDetalle('I1', 3, 'curso')  (resuelve el id)
// Devuelve título de unidad, nombre de la lección, unidad, objetivo,
// temas y pdf_drive_id.
// ════════════════════════════════════════════════════════════════════
function getLeccionDetalle(arg1, arg2, arg3) {
  // Resolver el id: si arg1 parece nivel (B1/B2/I1/I2) y viene arg2, mapear.
  var id_leccion;
  var a1 = String(arg1 || '').trim();
  if (/^(B1|B2|I1|I2)$/i.test(a1) && arg2 != null) {
    id_leccion = _idLeccion(a1, arg2, arg3 || 'curso');
    if (!id_leccion) return { ok: false, error: 'No se pudo resolver id para ' + a1 + ' lec ' + arg2 };
  } else {
    id_leccion = a1;
  }
  if (!id_leccion) return { ok: false, error: 'id_leccion requerido' };

  try {
    var ss = SpreadsheetApp.openById(OPERATIVO_ID); // CAMPUS_OPERATIVO
    var ws = ss.getSheetByName('LECCIONES_CONTENIDO');
    if (!ws) return { ok: false, error: 'LECCIONES_CONTENIDO no encontrada' };

    var rows = ws.getDataRange().getValues();
    var h    = rows[0];

    // Nombres de columna REALES de la hoja (confirmados por diagnóstico):
    // id_leccion, nivel, unidad, titulo_unidad, leccion_num, leccion_global,
    // tipo, etiqueta, nombre_completo, detalle, pag_sb, pag_wb, pag_tb,
    // asignatura, objetivo, speaking, grammar, pronunciacion, writing, pdf_drive_id
    var iId    = h.indexOf('id_leccion');
    var iNivel = h.indexOf('nivel');
    var iUnid  = h.indexOf('unidad');
    var iTitU  = h.indexOf('titulo_unidad');
    var iNum   = h.indexOf('leccion_num');
    var iGlob  = h.indexOf('leccion_global');
    var iTipo  = h.indexOf('tipo');
    var iEtiq  = h.indexOf('etiqueta');
    var iNomC  = h.indexOf('nombre_completo');
    var iDet   = h.indexOf('detalle');
    var iAsig  = h.indexOf('asignatura');
    var iObj   = h.indexOf('objetivo');
    var iSpk   = h.indexOf('speaking');
    var iGra   = h.indexOf('grammar');
    var iPro   = h.indexOf('pronunciacion');
    var iWri   = h.indexOf('writing');
    var iPdf   = h.indexOf('pdf_drive_id');
    var iPdfP  = h.indexOf('pdf_profe');        // v4.22.3
    var iPdfE  = h.indexOf('pdf_estudiante');   // v4.22.3

    var target = String(id_leccion).trim().toUpperCase();

    for (var i = 1; i < rows.length; i++) {
      var rowId = String(rows[i][iId] || '').trim().toUpperCase();
      if (rowId !== target) continue;

      var pdfId    = iPdf  > -1 ? String(rows[i][iPdf]  || '').trim() : '';
      var pdfProfe = iPdfP > -1 ? String(rows[i][iPdfP] || '').trim() : '';
      var pdfEst   = iPdfE > -1 ? String(rows[i][iPdfE] || '').trim() : '';

      function _urlDrive(id) { return id ? ('https://drive.google.com/file/d/' + id + '/view') : ''; }

      return {
        ok: true,
        leccion: {
          id:            rowId,
          nivel:         iNivel > -1 ? String(rows[i][iNivel] || '') : '',
          unidad:        iUnid  > -1 ? String(rows[i][iUnid]  || '') : '',
          titulo_unidad: iTitU  > -1 ? String(rows[i][iTitU]  || '') : '',
          titulo:        iTitU  > -1 ? String(rows[i][iTitU]  || '') : '', // alias para compatibilidad frontend
          leccion_num:   iNum   > -1 ? Number(rows[i][iNum] || 0) : 0,
          leccion_global:iGlob  > -1 ? Number(rows[i][iGlob] || 0) : 0,
          tipo:          iTipo  > -1 ? String(rows[i][iTipo]  || '') : '',
          etiqueta:      iEtiq  > -1 ? String(rows[i][iEtiq]  || '') : '',
          nombre_completo: iNomC > -1 ? String(rows[i][iNomC] || '') : '',
          detalle:       iDet   > -1 ? String(rows[i][iDet]   || '') : '',
          asignatura:    iAsig  > -1 ? String(rows[i][iAsig]  || '') : '',
          objetivo:      iObj   > -1 ? String(rows[i][iObj]   || '') : '',
          speaking:      iSpk   > -1 ? String(rows[i][iSpk]   || '') : '',
          grammar:       iGra   > -1 ? String(rows[i][iGra]   || '') : '',
          pronunciacion: iPro   > -1 ? String(rows[i][iPro]   || '') : '',
          writing:       iWri   > -1 ? String(rows[i][iWri]   || '') : '',
          // PDFs: profe y estudiante por separado (v4.22.3)
          pdf_profe:        pdfProfe,
          pdf_estudiante:   pdfEst,
          pdf_profe_url:      _urlDrive(pdfProfe),
          pdf_estudiante_url: _urlDrive(pdfEst),
          // compat: pdf_drive_id viejo (= profe si existe, si no el campo legacy)
          pdf_drive_id:  pdfProfe || pdfId,
          pdf_url:       _urlDrive(pdfProfe || pdfId)
        }
      };
    }
    return { ok: false, error: 'Lección no encontrada: ' + id_leccion };
  } catch(e) {
    return { ok: false, error: e.toString() };
  }
}
// ============================================================
// registrarNotaEstatus(body)                        — v4.15
// POST ?fn=registrarNotaEstatus
// Guarda una nota directamente en ESTATUS por LLAVE
// Recalcula NOTA = suma de todos los componentes
//
// Body: { llave, cod_estudiante, grupo, nivel, programa, tipo_eval, nota }
// tipo_eval: ORAL_1|ORAL_2|ORAL_3|ORAL_4|ESCRITO_1|ESCRITO_2|SOCIAL
//
// SIN_INA: o1+o2+o3+o4+e1+e2+s1 (máx 100)
// INA:     o1+o2+o3+o4+e1+e2+s1+ican (máx 100, s1 e ican calculados de asistencia)
// ============================================================
function registrarNotaEstatus(body) {
  var llave   = body.llave || (String(body.cod_estudiante||'') + String(body.grupo||'') + String(body.nivel||'').toUpperCase());
  var tipo    = String(body.tipo_eval || '').toUpperCase();
  var nota    = parseFloat(body.nota);
  var comentario = String(body.comentario || '').trim();

  if (!llave || isNaN(nota)) return { ok: false, error: 'Faltan: llave y nota' };

  // Mapa tipo_eval → columna en ESTATUS
  var COL_MAP = {
    ORAL_1: 'o1', ORAL_2: 'o2', ORAL_3: 'o3', ORAL_4: 'o4',
    ESCRITO_1: 'e1', ESCRITO_2: 'e2',
    SOCIAL: 's1',
  };
  var colName = COL_MAP[tipo];
  if (!colName) return { ok: false, error: 'tipo_eval inválido: ' + tipo };

  var ss = SpreadsheetApp.openById(SHEET_ID);
  var ws = ss.getSheetByName(SH.ESTATUS);
  var rows   = ws.getDataRange().getValues();
  var header = rows[0];

  var iLlave  = header.indexOf('LLAVE');
  var iCodigo = header.indexOf('CODIGO');
  var iGrupo  = header.indexOf('GRUPO');
  var iNivel  = header.indexOf('NIVEL');
  var iO1 = header.indexOf('o1'), iO2 = header.indexOf('o2');
  var iO3 = header.indexOf('o3'), iO4 = header.indexOf('o4');
  var iE1 = header.indexOf('e1'), iE2 = header.indexOf('e2');
  var iS1 = header.indexOf('s1');
  var iNota = header.indexOf('NOTA');
  var iCol  = header.indexOf(colName);
  var iFecha = header.indexOf('FECHA DE MODIFICION');

  if (iCol === -1) return { ok: false, error: 'Columna ' + colName + ' no existe en ESTATUS' };

  var rowIdx = -1;
  for (var i = 1; i < rows.length; i++) {
    var ll = String(rows[i][iLlave]  || '').trim();
    var cc = String(rows[i][iCodigo] || '').trim();
    var nn = String(rows[i][iNivel]  || '').trim().toUpperCase();
    var gg = String(rows[i][iGrupo]  || '').trim();
    if (iLlave > -1 && ll === llave) { rowIdx = i; break; }
    if (cc === String(body.cod_estudiante||'').trim() && nn === String(body.nivel||'').toUpperCase() && gg === String(body.grupo||'').trim()) { rowIdx = i; break; }
  }

  if (rowIdx === -1) return { ok: false, error: 'Registro no encontrado: ' + llave };

  // Escribir la nota
  ws.getRange(rowIdx + 1, iCol + 1).setValue(nota);

  // Recalcular NOTA = suma de componentes disponibles
  var row = ws.getRange(rowIdx + 1, 1, 1, header.length).getValues()[0];
  var programa = body.programa || 'SIN_INA';
  var esINA = programa === 'INA';

  function v(idx) { return idx > -1 ? (parseFloat(row[idx]) || 0) : 0; }
  var notaCalc = v(iO1) + v(iO2) + v(iO3) + v(iO4) + v(iE1) + v(iE2) + v(iS1);
  // Para INA: s1 e ican se calculan de asistencia (no se suman aquí manualmente)
  // Se guardan en s1 cuando se calcula la asistencia

  notaCalc = Math.min(100, Math.round(notaCalc * 10) / 10);
  if (iNota  > -1) ws.getRange(rowIdx + 1, iNota  + 1).setValue(notaCalc);
  if (iFecha > -1) ws.getRange(rowIdx + 1, iFecha + 1).setValue(new Date());

  // Guardar retroalimentación si viene
  if (comentario) {
    registrarRetroalimentacion({
      cod_grupo:      body.grupo,
      leccion_num:    body.leccion_num || '',
      fecha_leccion:  body.fecha_leccion || '',
      lista:          [{ cod_estudiante: body.cod_estudiante, comentario: comentario }],
      registrado_por: body.registrado_por || 'DOCENTE',
      programa:       programa,
    });
  }

  return { ok: true, llave: llave, col: colName, nota: nota, nota_total: notaCalc };
}

// ============================================================
// getICANEstudiante(codigo)                          — v4.15
// GET ?fn=getICANEstudiante&codigo=17065
// Cuenta sesiones I CAN presentes desde hoja ASISTENCIA
// filtrando tipo_leccion = 'ICAN'
// ============================================================
function getICANEstudiante(codigo) {
  if (!codigo) return { ok: false, error: 'codigo requerido' };
  try {
    var ss = SpreadsheetApp.openById(OPERATIVO_ID);
    var ws = ss.getSheetByName(OP.ASISTENCIA);
    if (!ws) return { ok: false, error: 'Hoja ASISTENCIA no encontrada' };

    var rows = ws.getDataRange().getValues();
    var h    = rows[0];
    var iEst  = h.indexOf('cod_estudiante');
    var iPre  = h.indexOf('presente');
    var iTipo = h.indexOf('tipo_leccion');

    var total = 0, presentes = 0;
    for (var i = 1; i < rows.length; i++) {
      var est  = String(rows[i][iEst] || '').trim();
      if (est !== String(codigo).trim()) continue;
      var tipo = iTipo > -1 ? String(rows[i][iTipo] || '').trim().toUpperCase() : '';
      if (tipo !== 'ICAN') continue;
      total++;
      var pre = rows[i][iPre];
      if (pre === true || String(pre).toUpperCase() === 'TRUE') presentes++;
    }

    var requeridas = 16;
    var pct = total > 0 ? Math.round((presentes / requeridas) * 100) : 0;
    return {
      ok: true, codigo: codigo,
      asistidas: presentes, requeridas: requeridas,
      total_sesiones: total,
      pct: pct,
      puntaje_ican: Math.round((presentes / requeridas) * 20 * 10) / 10, // proporcional sobre 20
    };
  } catch(e) {
    return { ok: false, error: e.toString() };
  }
}

// ============================================================
// getRetroalimentacionEstudiante(codigo)             — v4.16
// GET ?fn=getRetroalimentacionEstudiante&codigo=17065
// Devuelve retroalimentación + progress check del estudiante
// Para que el estudiante vea los comentarios del profe por lección
// ============================================================
function getRetroalimentacionEstudiante(codigo) {
  if (!codigo) return { ok: false, error: 'codigo requerido' };
  try {
    var ss  = SpreadsheetApp.openById(OPERATIVO_ID);
    var resultado = [];

    // Retroalimentación por lección
    var wsRetro = ss.getSheetByName(OP.RETROALIMENTACION);
    if (wsRetro) {
      var retroRows = wsRetro.getDataRange().getValues();
      var rh = retroRows[0];
      var riEst = rh.indexOf('cod_estudiante');
      var riLec = rh.indexOf('leccion_num');
      var riCom = rh.indexOf('comentario');
      var riFec = rh.indexOf('fecha_leccion');
      var riGrp = rh.indexOf('cod_grupo');
      for (var i = 1; i < retroRows.length; i++) {
        if (String(retroRows[i][riEst]||'').trim() !== String(codigo).trim()) continue;
        var com = String(retroRows[i][riCom]||'').trim();
        if (!com) continue;
        resultado.push({
          tipo:        'retro',
          leccion_num: parseInt(retroRows[i][riLec]) || 0,
          comentario:  com,
          fecha:       String(retroRows[i][riFec]||'').trim(),
          cod_grupo:   String(retroRows[i][riGrp]||'').trim(),
        });
      }
    }

    // Progress Check
    var wsPC = ss.getSheetByName(OP.PROGRESS_CHECK);
    if (wsPC) {
      var pcRows = wsPC.getDataRange().getValues();
      var ph = pcRows[0];
      var piEst = ph.indexOf('cod_estudiante');
      var piLec = ph.indexOf('leccion_num');
      var piCom = ph.indexOf('comentario');
      var piFec = ph.indexOf('fecha_leccion');
      var piGrp = ph.indexOf('cod_grupo');
      for (var j = 1; j < pcRows.length; j++) {
        if (String(pcRows[j][piEst]||'').trim() !== String(codigo).trim()) continue;
        var com2 = String(pcRows[j][piCom]||'').trim();
        if (!com2) continue;
        resultado.push({
          tipo:        'progress_check',
          leccion_num: parseInt(pcRows[j][piLec]) || 0,
          comentario:  com2,
          fecha:       String(pcRows[j][piFec]||'').trim(),
          cod_grupo:   String(pcRows[j][piGrp]||'').trim(),
        });
      }
    }

    // Ordenar por lección
    resultado.sort(function(a,b){ return a.leccion_num - b.leccion_num; });

    return { ok: true, total: resultado.length, retroalimentacion: resultado };
  } catch(e) {
    return { ok: false, error: e.toString() };
  }
}

// ============================================================
// getAsistenciaGrupoCompleta(cod_grupo)              — v4.16
// GET ?fn=getAsistenciaGrupoCompleta&cod_grupo=B1-LM69-C3-0125
// Devuelve asistencia % por estudiante para el roster del docente
// ============================================================
function getAsistenciaGrupoCompleta(cod_grupo) {
  if (!cod_grupo) return { ok: false, error: 'cod_grupo requerido' };
  try {
    var ss = SpreadsheetApp.openById(OPERATIVO_ID);
    var ws = ss.getSheetByName(OP.ASISTENCIA);
    if (!ws) return { ok: true, asistencia: {} };

    var rows = ws.getDataRange().getValues();
    var h    = rows[0];
    var iGrp = h.indexOf('cod_grupo');
    var iEst = h.indexOf('cod_estudiante');
    var iPre = h.indexOf('presente');
    var iTip = h.indexOf('tipo_leccion');

    // Contar presentes y totales por estudiante (solo lecciones CLASE, no ICAN)
    var mapa = {}; // { codigo: { presentes, total } }
    for (var i = 1; i < rows.length; i++) {
      if (String(rows[i][iGrp]||'').trim() !== String(cod_grupo).trim()) continue;
      var tipo = iTip > -1 ? String(rows[i][iTip]||'CLASE').trim().toUpperCase() : 'CLASE';
      if (tipo === 'ICAN') continue; // I CAN se cuenta aparte
      var est  = String(rows[i][iEst]||'').trim();
      if (!est) continue;
      if (!mapa[est]) mapa[est] = { presentes: 0, total: 0 };
      mapa[est].total++;
      var pre = rows[i][iPre];
      if (pre === true || String(pre).toUpperCase() === 'TRUE') mapa[est].presentes++;
    }

    // Calcular %
    var resultado = {};
    Object.keys(mapa).forEach(function(est) {
      var m = mapa[est];
      resultado[est] = {
        presentes: m.presentes,
        total:     m.total,
        pct:       m.total > 0 ? Math.round(m.presentes / m.total * 100) : 0,
      };
    });

    return { ok: true, asistencia: resultado };
  } catch(e) {
    return { ok: false, error: e.toString() };
  }
}


