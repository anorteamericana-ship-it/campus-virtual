// ============================================================
// getTodosEstudiantes()                             — v4.5
// GET ?fn=getTodosEstudiantes
//
// Devuelve todos los estudiantes de la hoja DATOS con su
// estado actual desde ESTATUS. Optimizado para el padrón.
// ============================================================
function getTodosEstudiantes() {
  var ss     = SpreadsheetApp.openById(SHEET_ID);
  var wsDat  = ss.getSheetByName(SH.DATOS);
  var wsEst  = ss.getSheetByName(SH.ESTATUS);
  var wsGrp  = ss.getSheetByName(SH.GRUPOS);

  if (!wsDat) return { ok: false, error: 'Hoja DATOS no encontrada' };

  // ── DATOS ──────────────────────────────────────────────
  var datRows = wsDat.getDataRange().getValues();
  var dH      = datRows[0];

  var iRec  = dH.indexOf('CODIGO');
  var iCed  = dH.indexOf('NUM_CEDULA');
  var iNom  = dH.indexOf('NOMBRE');
  var iConv = dH.indexOf('CONVENIO');
  var iCod  = dH.indexOf('CODIGO');
  var iTel  = dH.indexOf('TELEFONO');
  var iGrp  = dH.indexOf('GRUPO');
  var iVen  = dH.indexOf('VENDEDOR');
  var iCos  = dH.indexOf('COSTO');
  var iFec  = dH.indexOf('FECHA_MATRICULA');
  var iSex  = dH.indexOf('sexo');
  var iMail = dH.indexOf('email');

  // ── ESTATUS — índice por CODIGO ────────────────────────
  var estatusMap = {};
  if (wsEst) {
    var estRows = wsEst.getDataRange().getValues();
    var eH      = estRows[0];
    var ieRec   = eH.indexOf('CODIGO');
    var ieEst   = eH.indexOf('ESTATUS');
    var ieNiv   = eH.indexOf('NIVEL');
    var ieNota  = eH.indexOf('NOTA');
    var ieGrp   = eH.indexOf('GRUPO');

    for (var i = 1; i < estRows.length; i++) {
      var r    = estRows[i];
      var rec  = String(r[ieRec] || '').trim();
      var est  = String(r[ieEst] || '').trim();
      var niv  = String(r[ieNiv] || '').trim();
      if (!rec) continue;

      // Guardar el estado más relevante: CA > APR > REP > RI > RJ > PE
      var prioridad = { CA:6, APR:5, REP:4, RI:3, RJ:2, CNV:1, PE:0 };
      var existing  = estatusMap[rec];
      var pActual   = prioridad[est] !== undefined ? prioridad[est] : -1;
      var pExist    = existing ? (prioridad[existing.estatus] || -1) : -1;

      if (!existing || pActual > pExist) {
        estatusMap[rec] = {
          estatus:         est,
          nivel_actual:    niv,
          nota:            r[ieNota] || '',
          grupo_estatus:   String(r[ieGrp] || '').trim(),
        };
      }
    }
  }

  // ── GRUPOS — nivel real HOY por código ─────────────────
  var grupoNivelMap = {};
  if (wsGrp) {
    var gruRows = wsGrp.getDataRange().getValues();
    var gH      = gruRows[0];
    var igCod   = gH.indexOf('CODIGO_GRUPO');
    var igNiv   = gH.indexOf('NIVEL_INICIO');
    var igFec   = gH.indexOf('FECHA_INICIO');

    var hoy = new Date(); hoy.setHours(0,0,0,0);
    var mapa = {};

    for (var j = 1; j < gruRows.length; j++) {
      var g   = gruRows[j];
      var cod = String(g[igCod] || '').trim();
      if (!cod) continue;
      var rawF = g[igFec];
      var fec  = rawF instanceof Date ? rawF : new Date(rawF);
      fec.setHours(0,0,0,0);
      if (isNaN(fec.getTime()) || fec > hoy) continue;

      if (!mapa[cod] || fec > mapa[cod].fecha) {
        mapa[cod] = { fecha: fec, nivel: String(g[igNiv] || '').trim() };
      }
    }
    Object.keys(mapa).forEach(function(k) {
      grupoNivelMap[k] = mapa[k].nivel;
    });
  }

  // ── Construir resultado ────────────────────────────────
  var nivMap = { B1:'Básico I', B2:'Básico II', I1:'Intermedio I', I2:'Intermedio II' };
  var result = [];

  for (var r = 1; r < datRows.length; r++) {
    var row  = datRows[r];
    var rec  = String(row[iRec]  || '').trim();
    var cod  = String(row[iCod]  || '').trim();
    var grp  = String(row[iGrp]  || '').trim();
    if (!rec && !cod) continue;

    var estInfo      = estatusMap[rec] || {};
    var nivelCodigo  = grupoNivelMap[grp] || estInfo.nivel_actual || 'B1';
    var nivelNombre  = nivMap[nivelCodigo] || nivelCodigo;

    result.push({
      codigo:           rec,
      cedula:           String(row[iCed]  || '').trim(),
      nombre:           String(row[iNom]  || '').trim(),
      convenio:         String(row[iConv] || '').trim(),
      codigo:           cod,
      telefono:         String(row[iTel]  || '').trim(),
      grupo:            grp,
      vendedor:         String(row[iVen]  || '').trim(),
      costo:            row[iCos]  || 0,
      fecha_matricula:  row[iFec]  ? Utilities.formatDate(new Date(row[iFec]), 'America/Costa_Rica', 'dd/MM/yyyy') : '',
      sexo:             String(row[iSex]  || '').trim(),
      email:            String(row[iMail] || '').trim(),
      // Estado real
      status_actual:    estInfo.estatus      || 'PE',
      nivel_actual:     nivelCodigo,
      nivel_nombre:     nivelNombre,
      nota_actual:      estInfo.nota         || '',
      // Para display en tabla
      display:          String(row[iNom] || '').trim(),
    });
  }

  return {
    ok:    true,
    total: result.length,
    estudiantes: result,
  };
}

// ============================================================
// getRadiografiaGrupo(cod_grupo)                    — v4.5
// GET ?fn=getRadiografiaGrupo&cod_grupo=B1-KJ94-B6-0425
//
// Devuelve la radiografía completa de un grupo:
// todos los estudiantes con TODOS sus niveles (B1/B2/I1/I2),
// pagos reales y notas de ESTATUS.
// ============================================================
// ════════════════════════════════════════════════════════════════════
// _estaEnMora() — REGLA ÚNICA de morosidad (compartida)
// La usan getRadiografiaGrupo (panel Estudiantes) Y getGruposActivos (calendario)
// para que el conteo de morosos NUNCA se desincronice entre pantallas.
//
// Reglas definitivas:
//   PE  → NO  (no empezó, sin obligación)
//   CNV → NO  (convalidado, exonerado)
//   RI/RJ → depende de pagos (un retirado queda moroso si debía algo al retirarse)
//   CA  → SI si debe matrícula O cuotas O certificado (cualquier pendiente)
//   APR/REP → SI si debe certificado
//   El certificado SIEMPRE genera mora hasta pagarse.
//   Mora desaparece SOLO con matrícula + cuotas + cert todos cubiertos.
//   Si no hay registro de pago = debe (nunca se asume pagado).
// ════════════════════════════════════════════════════════════════════
function _estaEnMora(estatus, matPagada, certPagado, cuotasPagadas, cuotasEsperadas) {
  var est = String(estatus || '').trim().toUpperCase();
  // PE y CNV nunca son morosos
  if (est === 'PE' || est === 'CNV') return false;
  // RI/RJ: la regla unificada de la radiografía los trata según pagos.
  // (Si en el futuro se decide que RI/RJ nunca son morosos, se cambia AQUÍ, un solo lugar.)
  var cuotasAlDia = (cuotasPagadas || 0) >= (cuotasEsperadas || 0);
  // Moroso = falta cualquier pago registrado
  return !(matPagada && cuotasAlDia && certPagado);
}

function getRadiografiaGrupo(cod_grupo) {
  if (!cod_grupo) return { ok: false, error: 'missing_param' };

  var ss      = SpreadsheetApp.openById(SHEET_ID);
  var wsDatos = ss.getSheetByName(SH.DATOS);
  var wsEst   = ss.getSheetByName(SH.ESTATUS);
  var wsOtros = ss.getSheetByName(SH.OTROS_PAGOS);
  var wsPagos = ss.getSheetByName(SH.PAGOS);
  var wsGrps  = ss.getSheetByName(SH.GRUPOS);

  if (!wsDatos) return { ok: false, error: 'DATOS no encontrada' };

  // ── 0. Leer info del grupo: TIPO_PERIODO + periodo textual por nivel ──
  // Fuente de verdad: FECHA_INICIO de GRUPOS (no PERIODO_INICIO que puede estar mal ingresado).
  // Duración: cuatrimestre (C) = 4 meses, bimestre (B) = 2 meses.
  // Resultado: periodoMap[nivel] = { texto, cuotas_esperadas, estado, fecha_ini, fecha_fin, programa }
  var MESES_CORTO = ['Ene','Feb','Mar','Abr','May','Jun','Jul','Ago','Set','Oct','Nov','Dic'];
  var tipoPeriodo = 'C'; // default cuatrimestral
  var programaGrupo = 'SIN_INA'; // default
  var periodoMap  = {};  // { B1:{texto,cuotas_esperadas,estado,...}, B2:{...}, ... }

  if (wsGrps) {
    var grpRows = wsGrps.getDataRange().getValues();
    var gH      = grpRows[0];
    var igCod   = gH.indexOf('CODIGO_GRUPO');
    var igNiv   = gH.indexOf('NIVEL_INICIO');
    var igFech  = gH.indexOf('FECHA_INICIO');
    var igTipo  = gH.indexOf('TIPO_PERIODO');
    var igProg  = gH.indexOf('PROGRAMA');

    var hoyG = new Date(); hoyG.setHours(0,0,0,0);

    for (var i = 1; i < grpRows.length; i++) {
      if (String(grpRows[i][igCod]||'').trim() !== String(cod_grupo).trim()) continue;

      var tp   = String(grpRows[i][igTipo]||'C').trim().toUpperCase();
      tipoPeriodo = tp;

      // Leer PROGRAMA (INA / SIN_INA) — una sola vez es suficiente
      if (igProg > -1 && grpRows[i][igProg]) {
        programaGrupo = String(grpRows[i][igProg]).trim().toUpperCase();
      }

      var niv  = String(grpRows[i][igNiv] ||'').trim().toUpperCase();
      if (!niv) continue;

      // Calcular fecha de inicio desde FECHA_INICIO real
      var rawFech = grpRows[i][igFech];
      if (!rawFech) continue;
      var dIni = rawFech instanceof Date ? new Date(rawFech) : new Date(String(rawFech));
      if (isNaN(dIni.getTime())) continue;
      dIni.setHours(0,0,0,0);

      // Calcular fecha de fin: +4 meses (C) o +2 meses (B), último día del mes de cierre
      var mesesDuracion = tp === 'C' ? 4 : 2;
      var dFin = new Date(dIni.getFullYear(), dIni.getMonth() + mesesDuracion, 0);
      dFin.setHours(23,59,59,0);

      var anioIni = dIni.getFullYear();
      var anioFin = dFin.getFullYear();

      var texto = MESES_CORTO[dIni.getMonth()] +
        (anioIni !== anioFin ? ' ' + anioIni : '') +
        ' - ' + MESES_CORTO[dFin.getMonth()] + ' ' + anioFin;

      var estado = 'Proyectado';
      if (dIni <= hoyG) {
        estado = dFin < hoyG ? 'Cerrado' : 'En curso';
      }

      var cuotasEsp = tp === 'C' ? 4 : 2;
      periodoMap[niv] = {
        texto:            texto,
        cuotas_esperadas: cuotasEsp,
        estado:           estado,
        fecha_ini:        Utilities.formatDate(dIni, 'America/Costa_Rica', 'yyyy-MM-dd'),
        fecha_fin:        Utilities.formatDate(new Date(dFin.getFullYear(), dFin.getMonth(), dFin.getDate()), 'America/Costa_Rica', 'yyyy-MM-dd'),
        mes_ini:          dIni.getMonth(),
        anio_ini:         anioIni,
        mes_fin:          dFin.getMonth(),
        anio_fin:         anioFin,
      };
    }
  }

  // ── 1. Estudiantes del grupo ────────────────────────────
  var datRows = wsDatos.getDataRange().getValues();
  var dH = datRows[0];
  var iRec  = dH.indexOf('CODIGO');
  var iCed  = dH.indexOf('NUM_CEDULA');
  var iNom  = dH.indexOf('NOMBRE');
  var iConv = dH.indexOf('CONVENIO');
  var iCod  = dH.indexOf('CODIGO');
  var iTel  = dH.indexOf('TELEFONO');
  var iGrp  = dH.indexOf('GRUPO');
  var iCos  = dH.indexOf('COSTO');
  var iMat  = dH.indexOf('MATRICULA');
  var iCer  = dH.indexOf('CERTIFICADO');

  // ── Paso 1: obtener códigos desde ESTATUS (no desde DATOS) ──
  // DATOS tiene el grupo original de matrícula (B1) pero en B2/I1/I2
  // los estudiantes siguen con el código de grupo viejo en DATOS.
  // ESTATUS tiene el grupo correcto por nivel.
  var codigos = [];
  var codigosSet = {};

  if (wsEst) {
    var estRowsPre = wsEst.getDataRange().getValues();
    var eHPre = estRowsPre[0];
    var ieRecPre = eHPre.indexOf('CODIGO');
    var ieGrpPre = eHPre.indexOf('GRUPO');
    for (var i = 1; i < estRowsPre.length; i++) {
      var rec = String(estRowsPre[i][ieRecPre] || '').trim();
      var grp = String(estRowsPre[i][ieGrpPre] || '').trim();
      if (grp !== String(cod_grupo).trim()) continue;
      if (rec && !codigosSet[rec]) {
        codigosSet[rec] = true;
        codigos.push(rec);
      }
    }
  }

  // ── Paso 2: construir estudiantesMap desde DATOS por CODIGO ──
  // Primero indexar DATOS por CODIGO para búsqueda O(1)
  var datosIdx = {};
  for (var i = 1; i < datRows.length; i++) {
    var rec = String(datRows[i][iRec] || '').trim();
    var cod = String(datRows[i][iCod] || '').trim();
    var key = rec || cod;
    if (key) datosIdx[key] = i;
  }

  var estudiantesMap = {};
  codigos.forEach(function(key) {
    var i = datosIdx[key];
    if (i === undefined) return;
    var r = datRows[i];
    estudiantesMap[key] = {
      codigo:   String(r[iRec]  || '').trim(),
      codigo:   String(r[iCod]  || '').trim(),
      cedula:   String(r[iCed]  || '').trim(),
      nombre:   String(r[iNom]  || '').trim(),
      convenio: String(r[iConv] || '').trim(),
      telefono: String(r[iTel]  || '').trim(),
      costo:    r[iCos] || 0,
      mat_base: r[iMat] || 0,
      cer_base: r[iCer] || 0,
      CUOTAS:   r[dH.indexOf('CUOTAS')] || 0,
    };
  });

  if (codigos.length === 0) {
    return { ok: true, cod_grupo: cod_grupo, total: 0, niveles: {} };
  }

  // ── 2. Todos los niveles de ESTATUS para estos estudiantes ─
  // Estructura: nivelData[nivel] = [ { codigo, estatus, nota, cert, o1..o4, e1, e2, s1 } ]
  var nivelData = { B1: [], B2: [], I1: [], I2: [] };

  if (wsEst) {
    var estRows = wsEst.getDataRange().getValues();
    var eH = estRows[0];
    var ieRec  = eH.indexOf('CODIGO');
    var ieGrp  = eH.indexOf('GRUPO');
    var ieEst  = eH.indexOf('ESTATUS');
    var ieNiv  = eH.indexOf('NIVEL');
    var ieO1   = eH.indexOf('O1');
    var ieO2   = eH.indexOf('O2');
    var ieO3   = eH.indexOf('O3');
    var ieO4   = eH.indexOf('O4');
    var ieE1   = eH.indexOf('E1');
    var ieE2   = eH.indexOf('E2');
    var ieS1   = eH.indexOf('S1');
    var ieNota = eH.indexOf('NOTA');
    var ieCert = eH.indexOf('REG_CERTIFICADOS');

    for (var i = 1; i < estRows.length; i++) {
      var r    = estRows[i];
      var rec  = String(r[ieRec] || '').trim();
      var grpe = String(r[ieGrp] || '').trim();
      var niv  = String(r[ieNiv] || '').trim();
      var est  = String(r[ieEst] || '').trim();

      // Solo si es del grupo actual
      if (grpe !== String(cod_grupo).trim()) continue;
      // Solo si está en el mapa
      if (!estudiantesMap[rec]) continue;
      // Solo niveles válidos
      if (!nivelData[niv]) continue;

      var nota = parseFloat(r[ieNota]) || 0;
      nivelData[niv].push({
        codigo:   rec,
        grupo:    grpe,  // grupo del registro ESTATUS para construir LLAVE
        estatus:  est,
        nota:     nota,
        cert:     String(r[ieCert] || '').trim(),
        o1: parseFloat(r[ieO1]) || 0,
        o2: parseFloat(r[ieO2]) || 0,
        o3: parseFloat(r[ieO3]) || 0,
        o4: parseFloat(r[ieO4]) || 0,
        e1: parseFloat(r[ieE1]) || 0,
        e2: parseFloat(r[ieE2]) || 0,
        s1: parseFloat(r[ieS1]) || 0,
      });
    }
  }

  // ── 3. Pagos desde OTROS_PAGOS (matrícula, certificado) ──
  // Mapa: codigo → { matriculas: {B1:bool, B2:bool...}, certificados: {B1:bool...} }
  var pagosMap = {};
  codigos.forEach(function(c) { pagosMap[c] = { mat:{}, cert:{} }; });

  var nivelDescrMap = {
    'BASICO I': 'B1', 'BASICO II': 'B2',
    'INTERMEDIO I': 'I1', 'INTERMEDIO II': 'I2',
    'B1': 'B1', 'B2': 'B2', 'I1': 'I1', 'I2': 'I2',
  };

  // ncuenta map: MAT=60-63, CERT=43-46 (índice = nivel B1=0,B2=1,I1=2,I2=3)
  var ncuentaMatMap  = { '60':'B1','61':'B2','62':'I1','63':'I2' };
  var ncuentaCertMap = { '43':'B1','44':'B2','45':'I1','46':'I2' };

  if (wsOtros) {
    var oRows = wsOtros.getDataRange().getValues();
    var oH = oRows[0];
    // Buscar columna Codigo (puede ser 'Codigo' o 'CODIGO')
    var ioCod  = oH.indexOf('Codigo');
    if (ioCod === -1) ioCod = oH.indexOf('CODIGO');
    var ioDesc = oH.indexOf('descripcion');
    if (ioDesc === -1) ioDesc = oH.indexOf('DESCRIPCION');
    var ioMon  = oH.indexOf('monto');
    if (ioMon === -1) ioMon = oH.indexOf('MONTO');
    var ionc   = oH.indexOf('ncuenta');

    for (var i = 1; i < oRows.length; i++) {
      var r    = oRows[i];
      var cod  = String(r[ioCod]  || '').trim();
      var mon  = parseFloat(r[ioMon]) || 0;
      if (!pagosMap[cod] || mon <= 0) continue;

      // Prioridad 1: usar ncuenta para detectar nivel y tipo
      if (ionc > -1) {
        var nc = String(r[ionc] || '').trim();
        if (ncuentaMatMap[nc])  { pagosMap[cod].mat[ncuentaMatMap[nc]]   = true; continue; }
        if (ncuentaCertMap[nc]) { pagosMap[cod].cert[ncuentaCertMap[nc]] = true; continue; }
      }

      // Fallback: usar descripción
      var desc = String(r[ioDesc] || '').toUpperCase();
      var nivelPago = null;
      Object.keys(nivelDescrMap).forEach(function(k) {
        if (desc.indexOf(k) > -1) nivelPago = nivelDescrMap[k];
      });
      var matchNiv = desc.match(/(?:MATRICULA|CERTIFICADO|CERTIF)[_\s]([A-Z][0-9])/);
      if (matchNiv) nivelPago = matchNiv[1];
      if (!nivelPago) nivelPago = 'B1';

      if (desc.indexOf('MATRICULA') > -1 || desc.indexOf('MATR') > -1) {
        pagosMap[cod].mat[nivelPago] = true;
      }
      if (desc.indexOf('CERTIF') > -1 || desc.indexOf('CERT') > -1) {
        pagosMap[cod].cert[nivelPago] = true;
      }
    }
  }

  // ── 4. Cuotas desde PAGOS — monto total ÷ cuota individual ──
  // Si paga ₡299,200 y su cuota individual es ₡59,800 → 5 cuotas pagadas
  // Así un pago único de módulo completo muestra ✓✓✓✓ correctamente
  var montosMap = {};
  codigos.forEach(function(c) { montosMap[c] = { B1:0, B2:0, I1:0, I2:0 }; });

  if (wsPagos) {
    var pRows = wsPagos.getDataRange().getValues();
    var pH    = pRows[0];
    var ipCod = pH.indexOf('CODIGO');
    var ipCon = pH.indexOf('Concepto');
    if (ipCon === -1) ipCon = pH.indexOf('CONCEPTO');
    var ipPag = pH.indexOf('PAGO');

    for (var i = 1; i < pRows.length; i++) {
      var r   = pRows[i];
      var cod = String(r[ipCod] || '').trim();
      if (!montosMap[cod]) continue;
      var con = String(r[ipCon] || '').toUpperCase();
      if (con.indexOf('CUOTA') === -1) continue;
      var mon = parseFloat(r[ipPag]) || 0;
      if (mon <= 0) continue;
      // Formato: CUOTA_B1-BCR-... o CUOTA_B2-... o CUOTA_I1-...
      var m = con.match(/CUOTA[_\s]*([BI][0-9])/);
      if (m) {
        var niv = m[1];
        if (montosMap[cod][niv] !== undefined) {
          montosMap[cod][niv] += mon;
        }
      }
    }
  }

  // Dividir monto acumulado entre cuota individual pactada en DATOS (columna CUOTAS)
  var cuotasMap = {};
  codigos.forEach(function(c) {
    var est   = estudiantesMap[c] || {};
    var cuota = parseFloat(est['CUOTAS']) || 0;
    cuotasMap[c] = {};
    ['B1','B2','I1','I2'].forEach(function(niv) {
      var monto = montosMap[c][niv] || 0;
      if (cuota > 0 && monto > 0) {
        cuotasMap[c][niv] = Math.floor(monto / cuota);
      } else {
        cuotasMap[c][niv] = 0;
      }
    });
  });

  // ── 5. Construir respuesta por nivel ───────────────────
  var niveles = {};
  ['B1','B2','I1','I2'].forEach(function(niv) {
    if (nivelData[niv].length === 0) return;
    niveles[niv] = nivelData[niv].map(function(e) {
      var base = estudiantesMap[e.codigo] || {};
      var pm   = pagosMap[e.codigo]  || { mat:{}, cert:{} };
      var qm   = cuotasMap[e.codigo] || {};
      return {
        codigo:   e.codigo,
        grupo:    e.grupo || cod_grupo,  // grupo del registro ESTATUS — clave para LLAVE
        cedula:   base.cedula   || '',
        nombre:   base.nombre   || '',
        convenio: base.convenio || '',
        telefono: base.telefono || '',
        estatus:  e.estatus,
        nota:     e.nota,
        cert_num: e.cert,
        o1: e.o1, o2: e.o2, o3: e.o3, o4: e.o4,
        e1: e.e1, e2: e.e2, s1: e.s1,
        matricula_pagada:   !!pm.mat[niv],
        certificado_pagado: !!pm.cert[niv],
        cuotas_pagadas:     qm[niv] || 0,
        cuotas_esperadas:   (periodoMap[niv] || {}).cuotas_esperadas || (tipoPeriodo === 'C' ? 4 : 2),
        periodo_texto:      (periodoMap[niv] || {}).texto || '',
        nivel_estado:       (periodoMap[niv] || {}).estado || '',
        // ── Mora — reglas definitivas (función compartida _estaEnMora) ──────────
        // Una sola fuente de verdad: la radiografía Y el calendario (getGruposActivos)
        // usan la MISMA función, para que los números nunca se desincronicen.
        mora: _estaEnMora(
          e.estatus,
          !!pm.mat[niv],
          !!pm.cert[niv],
          (qm[niv] || 0),
          ((periodoMap[niv] || {}).cuotas_esperadas || (tipoPeriodo === 'C' ? 4 : 2))
        ),
      };
    });
  });

  // ── Filtro definitivo de proyección ───────────────────
  // Regla: para aparecer en nivel N, el estudiante DEBE tener
  // APR, CA o CNV en el nivel N-1 directamente en ESTATUS.
  // No usar niveles[] ya filtrado — leer estatus directamente del raw.
  //
  // Construir mapa plano: estStatusMap[codigo][nivel] = estatus
  var estStatusMap = {};
  Object.keys(nivelData).forEach(function(niv) {
    nivelData[niv].forEach(function(e) {
      if (!estStatusMap[e.codigo]) estStatusMap[e.codigo] = {};
      estStatusMap[e.codigo][niv] = e.estatus;
    });
  });

  var ordenNiveles  = ['B1','B2','I1','I2'];
  var nivAnteriorMap = { B2:'B1', I1:'B2', I2:'I1' };
  var puedeProyectar = { APR:true, CA:true, CNV:true };

  ordenNiveles.forEach(function(niv) {
    if (niv === 'B1') return; // B1 siempre aparece si está en el grupo
    if (!niveles[niv]) return;

    var nivAnt = nivAnteriorMap[niv];

    niveles[niv] = niveles[niv].filter(function(e) {
      var estAnt = estStatusMap[e.codigo] && estStatusMap[e.codigo][nivAnt];
      // Si no tiene registro en el nivel anterior → no proyectar
      if (!estAnt) return false;
      // Solo APR, CA o CNV en el nivel anterior justifican estar en este nivel
      return !!puedeProyectar[estAnt];
    });

    if (niveles[niv].length === 0) delete niveles[niv];
  });

  // ── 6. Estadísticas de calendario por nivel desde CAMPUS_OPERATIVO ──────
  // Modelo simple v4.20.0:
  //   TIPO_LECCION = TEORICA | PRACTICA | ICAN | LIBRE
  //   - TEORICA + PRACTICA = las 32 lecciones del curso (chip "X/32 lecciones")
  //   - ICAN = 16 lecciones I CAN (solo programas INA)
  //   - LIBRE = día bloqueado por feriado/suspensión/cambio. NO cuenta como lección.
  //   PRACTICA dentro del programa son los exámenes: 4 orales (lec 9,17,25,31) +
  //   2 escritos (lec 18,32) por nivel.
  //   ESTADO considerado "realizado" para conteo: CERRADA o CALCULADA.
  //
  // Para el chip de exámenes mantenemos la distinción ORAL/ESCRITO usando el
  // número de lección (no un TIPO_LECCION aparte como antes).
  try {
    var ssOp  = SpreadsheetApp.openById(OPERATIVO_ID);
    var wsCal = ssOp.getSheetByName(SH_CALENDARIO);
    if (wsCal) {
      var calData = wsCal.getDataRange().getValues();
      var cH      = calData[0];
      var icG = cH.indexOf('COD_GRUPO');
      var icN = cH.indexOf('NIVEL');
      var icL = cH.indexOf('LECCION');
      var icK = cH.indexOf('TIPO_LECCION');
      var icE = cH.indexOf('ESTADO');

      // Lecciones que son exámenes ORAL y ESCRITO (mismo para todos los niveles).
      var LEC_ORAL    = { 9:1, 17:2, 25:3, 31:4 };
      var LEC_ESCRITO = { 18:1, 32:2 };

      // Acumuladores por nivel
      var calStats = {};
      ['B1','B2','I1','I2'].forEach(function(n) {
        calStats[n] = {
          lec_dadas:    0, lec_total:    0, // todas las TEORICA+PRACTICA
          oral_dadas:   0, oral_total:   0,
          escrito_dadas:0, escrito_total:0,
          ican_dadas:   0, ican_total:   0,
        };
      });

      var REALIZADAS = { 'CERRADA':true, 'CALCULADA':true };
      var esINA = programaGrupo === 'INA';

      for (var i = 1; i < calData.length; i++) {
        var fG = String(calData[i][icG] || '').trim();
        if (fG !== String(cod_grupo).trim()) continue;
        var fN = String(calData[i][icN] || '').trim().toUpperCase();
        if (!calStats[fN]) continue;

        var fK = String(calData[i][icK] || '').trim().toUpperCase();
        var fE = String(calData[i][icE] || '').trim().toUpperCase();
        var fL = Number(calData[i][icL]) || 0;
        var hecho = !!REALIZADAS[fE];

        if (fK === 'TEORICA' || fK === 'PRACTICA') {
          calStats[fN].lec_total++;
          if (hecho) calStats[fN].lec_dadas++;
          // PRACTICA con número de lección oral/escrito → contar como examen
          if (fK === 'PRACTICA') {
            if (LEC_ORAL[fL]) {
              calStats[fN].oral_total++;
              if (hecho) calStats[fN].oral_dadas++;
            } else if (LEC_ESCRITO[fL]) {
              calStats[fN].escrito_total++;
              if (hecho) calStats[fN].escrito_dadas++;
            }
          }
        } else if (fK === 'ICAN' || fK === 'I CAN') {
          calStats[fN].ican_total++;
          if (hecho) calStats[fN].ican_dadas++;
        }
        // TIPO_LECCION === 'LIBRE' → no cuenta para nada
      }

      Object.keys(calStats).forEach(function(niv) {
        var s = calStats[niv];

        // Si el calendario no tiene filas reales para este nivel, no mostrar nada.
        var tieneFilasCalendario = (s.lec_total + s.ican_total) > 0;
        if (!tieneFilasCalendario) return;

        // Construir array de exámenes
        var examenes = [];
        for (var o = 1; o <= s.oral_total; o++) {
          examenes.push({ tipo: 'ORAL_' + o, hecho: o <= s.oral_dadas });
        }
        for (var e = 1; e <= s.escrito_total; e++) {
          examenes.push({ tipo: 'ESCRITO_' + e, hecho: e <= s.escrito_dadas });
        }
        if (esINA && s.ican_total > 0) {
          examenes.push({ tipo: 'ICAN', hecho: s.ican_dadas > 0,
                          dadas: s.ican_dadas, total: s.ican_total });
        }

        if (periodoMap[niv]) {
          periodoMap[niv].lecciones_dadas = s.lec_dadas;
          periodoMap[niv].lecciones_total = s.lec_total;
          periodoMap[niv].examenes        = examenes;
          periodoMap[niv].examenes_dados  = s.oral_dadas + s.escrito_dadas;
          periodoMap[niv].examenes_total  = s.oral_total + s.escrito_total;
          periodoMap[niv].ican_dadas      = s.ican_dadas;
          periodoMap[niv].ican_total      = esINA ? s.ican_total : 0;
        }
      });
    }
  } catch(eCalendario) {
    Logger.log('getRadiografiaGrupo: error leyendo CALENDARIO_LECCIONES: ' + eCalendario);
    // No es fatal — el resto de la radiografía sigue igual
  }

  // Info del grupo para el frontend
  var grupoInfo = {
    tipo_periodo:  tipoPeriodo,
    programa:      programaGrupo,
    cuotas_nivel:  tipoPeriodo === 'C' ? 4 : 2,
    periodos:      periodoMap,
  };

  return {
    ok:        true,
    cod_grupo: cod_grupo,
    total:     codigos.length,
    niveles:   niveles,
    grupo:     grupoInfo,
  };
}


