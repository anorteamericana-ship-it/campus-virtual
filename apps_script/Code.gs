// ============================================================
// F45 — Bandeja unificada de revisión docente/admin
// - Une intentos + revisión + estado Mis Notas en una sola respuesta.
// - No crea, no cierra y no sincroniza: solo lectura operativa.
// - Docente queda limitado a grupo propio.
// ============================================================
function examReviewInbox(body) {
  body = body || {};
  var actor = _examActor_(body);
  _examSetupSheetsInternal_(actor);

  var role = _examClean_(actor.role).toLowerCase();
  var codGrupoFilter = _examUpper_(body.cod_grupo || body.COD_GRUPO || body.grupo);
  if (role === 'teacher') {
    if (!codGrupoFilter) return { ok:false, error:'cod_grupo_requerido', mensaje:'Docente debe filtrar por un grupo propio.' };
    try {
      if (!_sec006cTeacherPuedeGrupo_(actor, codGrupoFilter)) return { ok:false, error:'no_autorizado', mensaje:'El docente no tiene acceso a este grupo.' };
    } catch (_) {
      return { ok:false, error:'no_autorizado', mensaje:'No se pudo validar propiedad docente.' };
    }
  }

  var filters = {
    cod_grupo: codGrupoFilter,
    nivel: _examUpper_(body.nivel || body.NIVEL),
    attempt_status: _examUpper_(body.attempt_status || body.ATTEMPT_STATUS || body.status || body.STATUS),
    review_status: _examUpper_(body.review_status || body.REVIEW_STATUS),
    pushed_to_notas: _examUpper_(body.pushed_to_notas || body.PUSHED_TO_NOTAS),
    queue: _examUpper_(body.queue || body.QUEUE || 'ALL'),
    search: _examUpper_(body.search || body.q || body.buscar)
  };
  var limit = Number(body.limit || body.LIMIT || 50);
  if (isNaN(limit) || limit <= 0) limit = 50;
  if (limit > 200) limit = 200;

  var ss = _examSs_();
  var wsA = ss.getSheetByName(EXAM_SH.ATTEMPTS);
  var wsR = ss.getSheetByName(EXAM_SH.REVIEW);
  var attemptsValues = wsA ? wsA.getDataRange().getValues() : [];
  var reviewValues = wsR ? wsR.getDataRange().getValues() : [];
  var reviewMap = {};
  if (reviewValues.length > 1) {
    var rh = reviewValues[0].map(function(h){ return _examClean_(h); });
    var rAttemptIdx = rh.indexOf('ATTEMPT_ID');
    for (var r = 1; r < reviewValues.length; r++) {
      var robj = _examRowObj_(rh, reviewValues[r]);
      var ra = _examClean_(rAttemptIdx >= 0 ? reviewValues[r][rAttemptIdx] : robj.ATTEMPT_ID);
      if (ra) reviewMap[ra] = robj;
    }
  }

  var summary = {
    total_attempts: 0,
    started: 0,
    submitted_without_review: 0,
    in_review: 0,
    closed_not_pushed: 0,
    pushed_to_notas: 0,
    void_cancelled: 0,
    needs_action: 0
  };
  var rows = [];
  if (attemptsValues.length > 1) {
    var ah = attemptsValues[0].map(function(h){ return _examClean_(h); });
    for (var i = 1; i < attemptsValues.length; i++) {
      var a = _examRowObj_(ah, attemptsValues[i]);
      var attId = _examClean_(a.ATTEMPT_ID);
      var rev = reviewMap[attId] || null;
      var attStatus = _examUpper_(a.STATUS || '');
      var revStatus = rev ? _examUpper_(rev.REVIEW_STATUS || '') : '';
      var pushed = rev ? _examBoolSiNo_(rev.PUSHED_TO_NOTAS) : 'NO';
      var grupo = _examUpper_(a.COD_GRUPO || '');
      var nivel = _examUpper_(a.NIVEL || '');

      if (filters.cod_grupo && grupo !== filters.cod_grupo) continue;
      if (filters.nivel && nivel !== filters.nivel) continue;
      if (filters.attempt_status && attStatus !== filters.attempt_status) continue;
      if (filters.review_status) {
        if (filters.review_status === 'PENDING' || filters.review_status === 'SIN_REVISION') {
          if (rev) continue;
        } else if (revStatus !== filters.review_status) continue;
      }
      if (filters.pushed_to_notas && pushed !== _examBoolSiNo_(filters.pushed_to_notas)) continue;
      if (filters.search) {
        var haystack = _examUpper_([
          a.ATTEMPT_ID, a.ACTIVATION_ID, a.CODIGO, a.NOMBRE, a.CEDULA, a.COD_GRUPO,
          a.NIVEL, a.EXAM_ID, a.TEST_CODE, rev && rev.REVIEW_ID
        ].join(' '));
        if (haystack.indexOf(filters.search) < 0) continue;
      }

      var bucket = 'OTHER';
      if (attStatus === 'STARTED') bucket = 'STARTED';
      else if (attStatus === 'VOID' || attStatus === 'CANCELLED') bucket = 'VOID';
      else if (pushed === 'SI') bucket = 'PUSHED';
      else if (!rev && attStatus === 'SUBMITTED') bucket = 'SUBMITTED_WITHOUT_REVIEW';
      else if (revStatus === 'IN_REVIEW') bucket = 'IN_REVIEW';
      else if (revStatus === 'CLOSED' && pushed !== 'SI') bucket = 'CLOSED_NOT_PUSHED';
      else if (attStatus === 'REVIEWED' && pushed !== 'SI') bucket = 'CLOSED_NOT_PUSHED';

      summary.total_attempts++;
      if (bucket === 'STARTED') summary.started++;
      else if (bucket === 'SUBMITTED_WITHOUT_REVIEW') summary.submitted_without_review++;
      else if (bucket === 'IN_REVIEW') summary.in_review++;
      else if (bucket === 'CLOSED_NOT_PUSHED') summary.closed_not_pushed++;
      else if (bucket === 'PUSHED') summary.pushed_to_notas++;
      else if (bucket === 'VOID') summary.void_cancelled++;
      if (bucket === 'SUBMITTED_WITHOUT_REVIEW' || bucket === 'IN_REVIEW' || bucket === 'CLOSED_NOT_PUSHED') summary.needs_action++;

      if (filters.queue === 'NEEDS_ACTION' && !(bucket === 'SUBMITTED_WITHOUT_REVIEW' || bucket === 'IN_REVIEW' || bucket === 'CLOSED_NOT_PUSHED')) continue;
      if (filters.queue === 'PENDING' && bucket !== 'SUBMITTED_WITHOUT_REVIEW') continue;
      if (filters.queue === 'IN_REVIEW' && bucket !== 'IN_REVIEW') continue;
      if (filters.queue === 'CLOSED_NOT_PUSHED' && bucket !== 'CLOSED_NOT_PUSHED') continue;
      if (filters.queue === 'PUSHED' && bucket !== 'PUSHED') continue;
      if (filters.queue === 'STARTED' && bucket !== 'STARTED') continue;

      rows.push({
        bucket: bucket,
        needs_action: (bucket === 'SUBMITTED_WITHOUT_REVIEW' || bucket === 'IN_REVIEW' || bucket === 'CLOSED_NOT_PUSHED') ? 'SI' : 'NO',
        ATTEMPT_ID: attId,
        ATTEMPT_STATUS: attStatus,
        ACTIVATION_ID: a.ACTIVATION_ID || '',
        CODIGO: a.CODIGO || '',
        NOMBRE: a.NOMBRE || '',
        CEDULA: a.CEDULA || '',
        COD_GRUPO: a.COD_GRUPO || '',
        NIVEL: a.NIVEL || '',
        EXAM_ID: a.EXAM_ID || '',
        TEST_CODE: a.TEST_CODE || '',
        WEIGHT_PERCENT: a.WEIGHT_PERCENT || '',
        STARTED_AT: a.STARTED_AT || '',
        SUBMITTED_AT: a.SUBMITTED_AT || '',
        UPDATED_AT: a.UPDATED_AT || '',
        FINAL_SCORE_100: a.FINAL_SCORE_100 || (rev && rev.FINAL_SCORE_100) || '',
        WEIGHTED_SCORE: a.WEIGHTED_SCORE || (rev && rev.WEIGHTED_SCORE) || '',
        REVIEW_ID: rev ? rev.REVIEW_ID || '' : '',
        REVIEW_STATUS: rev ? rev.REVIEW_STATUS || '' : 'PENDING',
        REVIEWED_AT: rev ? rev.REVIEWED_AT || '' : '',
        REVIEWER_ROLE: rev ? rev.REVIEWER_ROLE || '' : '',
        LOCKED: rev ? rev.LOCKED || 'NO' : 'NO',
        PUSHED_TO_NOTAS: pushed,
        PUSHED_AT: rev ? rev.PUSHED_AT || '' : '',
        PUSHED_BY: rev ? rev.PUSHED_BY || '' : ''
      });
    }
  }

  rows.sort(function(a, b) {
    var da = _examClean_(a.SUBMITTED_AT || a.UPDATED_AT || a.STARTED_AT);
    var db = _examClean_(b.SUBMITTED_AT || b.UPDATED_AT || b.STARTED_AT);
    if (da < db) return 1;
    if (da > db) return -1;
    return _examClean_(b.ATTEMPT_ID).localeCompare(_examClean_(a.ATTEMPT_ID));
