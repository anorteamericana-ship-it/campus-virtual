        if (!resultado || !resultado.ok) return { ok:false, error:'No se pudo aplicar el cambio: ' + (resultado && resultado.error || 'error desconocido'), solicitud_sigue:'PENDIENTE' };
      }
    }

    var row = sol.slice();
    row[i.ESTADO] = accion === 'aprobar' ? 'APLICADA' : 'RECHAZADA';
    row[i.REVISADO_POR] = actor;
    row[i.REVISADO_AT] = new Date();
    row[i.RESPUESTA_ADMIN] = String(body.nota_resolucion || '');
    if (accion === 'aprobar') {
      row[i.APLICADO_AT] = new Date();
