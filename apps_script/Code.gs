}

function _ccF85_nextRegularSlot_(ctx, lastRow) {
  var info = _leerFilaGrupoNivel(ctx.ssApollo, ctx.cod, ctx.niv);
  if (!info || !(info.fechaInicio instanceof Date)) return { ok:false, error:'No se encontró la configuración del nivel en GRUPOS.' };
  var feriados = leerFeriadosDelGrupo(ctx.cod);
