// ============================================================
// EVALUACIONES
// INA:     ORAL×4=60, ESCRITO×2=10, SOCIAL=10, ICAN=20
// SIN_INA: ORAL×4=60, ESCRITO×2=30, SOCIAL=10, SIN ICAN
// ============================================================
function getPesoMaximo(tipo_eval, programa) {
  var esINA = programa === 'INA';
  var pesos = {
    ORAL_1:    15, ORAL_2:    15, ORAL_3:    15, ORAL_4:    15,
    ESCRITO_1: esINA ? 5  : 15,
    ESCRITO_2: esINA ? 5  : 15,
    SOCIAL:    10,
    ICAN:      esINA ? 20 : 0,
  };
  return pesos[tipo_eval] !== undefined ? pesos[tipo_eval] : 0;
}

function registrarEvaluacion(data) {
  var requeridos = ['cod_grupo','cod_estudiante','nivel','programa','tipo_eval','nota_obtenida'];
  for (var i = 0; i < requeridos.length; i++) {
    if (data[requeridos[i]] === undefined || data[requeridos[i]] === '') {
      return { error: 'Falta campo requerido: ' + requeridos[i] };
    }
  }
  var tiposValidos = ['ORAL_1','ORAL_2','ORAL_3','ORAL_4','ESCRITO_1','ESCRITO_2','SOCIAL','ICAN'];
  if (tiposValidos.indexOf(data.tipo_eval) === -1) {
    return { error: 'tipo_eval invalido. Validos: ' + tiposValidos.join(', ') };
  }
  if (data.programa === 'SIN_INA' && data.tipo_eval === 'ICAN') {
    return { error: 'SIN_INA no tiene ICAN.' };
  }
  var peso_maximo = getPesoMaximo(data.tipo_eval, data.programa);
  var nota = parseFloat(data.nota_obtenida) || 0;
  if (nota < 0 || nota > peso_maximo) {
    return { error: 'nota_obtenida fuera de rango. Maximo: ' + peso_maximo };
  }
  var ss = SpreadsheetApp.openById(OPERATIVO_ID);
  var ws = ss.getSheetByName(OP.EVALUACIONES);
  ws.appendRow([
    new Date(), data.cod_grupo, data.cod_estudiante, data.nivel,
    data.programa, data.tipo_eval, data.leccion_num || '',
    nota, peso_maximo, data.registrado_por || 'CAMPUS'
  ]);
  return { ok: true, tipo_eval: data.tipo_eval, nota_obtenida: nota, peso_maximo: peso_maximo, programa: data.programa };
}

function getEvaluacionesEstudiante(codigo, nivel) {
  if (!codigo) return { error: 'codigo requerido' };
  var ss   = SpreadsheetApp.openById(OPERATIVO_ID);
  var ws   = ss.getSheetByName(OP.EVALUACIONES);
  var rows = ws.getDataRange().getValues();
  var h    = rows[0];
  var iEst = h.indexOf('cod_estudiante'), iNivel = h.indexOf('nivel');
  var iNota = h.indexOf('nota_obtenida');
  var resultado = [], total = 0;
  for (var i = 1; i < rows.length; i++) {
    var matchCod   = String(rows[i][iEst]).trim() === String(codigo).trim();
    var matchNivel = !nivel || String(rows[i][iNivel]).trim().toUpperCase() === nivel.toUpperCase();
    if (matchCod && matchNivel) {
      var obj = {};
      h.forEach(function(col, idx) { obj[col] = rows[i][idx]; });
      resultado.push(obj);
      total += parseFloat(rows[i][iNota]) || 0;
    }
  }
  return { ok: true, total: resultado.length, nota_final: total, aprobado: total >= 70, evaluaciones: resultado };
}

// ============================================================
// getGrupoEstudiantes(cod_grupo)                    — v4
// Lee hoja DATOS de APOLLO_G3, devuelve roster básico del grupo.
// Respuesta: { ok:true, total:N, estudiantes:[{code, name}] }
// ============================================================
function getGrupoEstudiantes(cod_grupo) {
  if (!cod_grupo) return { ok: false, error: 'missing_param' };

  var ss = SpreadsheetApp.openById(SHEET_ID);
  var ws = ss.getSheetByName(SH.DATOS);
  if (!ws) return { ok: false, error: 'sheet_not_found' };

  var rows   = ws.getDataRange().getValues();
  var header = rows[0];

  var iCodigo = header.indexOf('CODIGO');
  var iNombre = header.indexOf('NOMBRE');
  var iGrupo  = header.indexOf('GRUPO');

  if (iCodigo === -1 || iNombre === -1 || iGrupo === -1) {
    return { ok: false, error: 'schema_error: ' + JSON.stringify({ iCodigo:iCodigo, iNombre:iNombre, iGrupo:iGrupo }) };
  }

  var estudiantes = [];
  for (var i = 1; i < rows.length; i++) {
    var grupo = String(rows[i][iGrupo] || '').trim();
    if (grupo !== String(cod_grupo).trim()) continue;
    var code = String(rows[i][iCodigo] || '').trim();
    var name = String(rows[i][iNombre] || '').trim();
    if (!code) continue;
    estudiantes.push({ code: code, name: name });
  }

  return { ok: true, total: estudiantes.length, estudiantes: estudiantes };
}

// ════════════════════════════════════════════════════════════════════
// getEstudiantesParaCierre(cod_grupo, nivel)         — v4.21.7
// Devuelve los estudiantes que están CURSANDO ACTUALMENTE (ESTATUS=CA)
// el nivel indicado en el grupo indicado. Esta es la lista correcta
// para cerrar una lección y registrar asistencia.
//
// Por qué NO usar getGrupoEstudiantes:
//   getGrupoEstudiantes lee DATOS.GRUPO, que arrastra el bug histórico
//   de APOLLO (estudiantes que avanzaron de nivel no se reasignaron).
//   ESTATUS con CA es la fuente de verdad de "quién está en este nivel
//   de este grupo ahora".
//
// Respuesta:
// {
//   ok: true, cod_grupo, nivel, programa, total,
//   estudiantes: [ { code, name, estatus, convenio, programa } ]
// }
// ════════════════════════════════════════════════════════════════════
function getEstudiantesParaCierre(cod_grupo, nivel) {
  if (!cod_grupo || !nivel) return { ok: false, error: 'Faltan cod_grupo y nivel' };

  var cg = String(cod_grupo).trim();
  var nv = String(nivel).trim().toUpperCase();

  try {
    var ss = SpreadsheetApp.openById(SHEET_ID);

    // 1) ESTATUS: códigos con CA en este grupo+nivel
    var wsEst = ss.getSheetByName(SH.ESTATUS);
    if (!wsEst) return { ok: false, error: 'Hoja ESTATUS no existe' };
    var estRows = wsEst.getDataRange().getValues();
    var eH = estRows[0];
    var iECod = eH.indexOf('CODIGO');
    var iENiv = eH.indexOf('NIVEL');
    var iEGrp = eH.indexOf('GRUPO');
    var iEEst = eH.indexOf('ESTATUS');
    if (iECod === -1 || iENiv === -1 || iEGrp === -1 || iEEst === -1) {
      return { ok: false, error: 'ESTATUS sin columnas esperadas (CODIGO/NIVEL/GRUPO/ESTATUS)' };
    }

    var codigosCA = {};
    for (var i = 1; i < estRows.length; i++) {
      var est = String(estRows[i][iEEst] || '').trim().toUpperCase();
      if (est !== 'CA') continue;
      var grp = String(estRows[i][iEGrp] || '').trim();
      var niv = String(estRows[i][iENiv] || '').trim().toUpperCase();
      if (grp !== cg || niv !== nv) continue;
      var cod = String(estRows[i][iECod] || '').trim();
      if (cod) codigosCA[cod] = true;
    }

    // 2) DATOS: nombre + convenio de cada código
    var wsDat = ss.getSheetByName(SH.DATOS);
    var datRows = wsDat.getDataRange().getValues();
    var dH = datRows[0];
    var iCodigo = dH.indexOf('CODIGO');
    var iNombre = dH.indexOf('NOMBRE');
    var iConv   = dH.indexOf('CONVENIO');

    var datosPorCodigo = {};
    for (var j = 1; j < datRows.length; j++) {
      var c = String(datRows[j][iCodigo] || '').trim();
      if (c && codigosCA[c]) {
        datosPorCodigo[c] = {
          name:     iNombre !== -1 ? String(datRows[j][iNombre] || '').trim() : '',
          convenio: iConv   !== -1 ? String(datRows[j][iConv]   || '').trim() : ''
        };
      }
    }

    // 3) Programa del grupo+nivel
    var infoNivel = _leerFilaGrupoNivel(ss, cg, nv);
    var programa = (infoNivel && infoNivel.programa) ? infoNivel.programa : '';

    // 4) Armar lista
    var estudiantes = [];
    Object.keys(codigosCA).forEach(function(cod) {
      var d = datosPorCodigo[cod] || { name: '(sin nombre en DATOS)', convenio: '' };
      estudiantes.push({
        code: cod, name: d.name, estatus: 'CA',
        convenio: d.convenio, programa: programa
      });
    });
    estudiantes.sort(function(a, b) { return a.name.localeCompare(b.name, 'es'); });

    return {
      ok: true, cod_grupo: cg, nivel: nv, programa: programa,
      total: estudiantes.length, estudiantes: estudiantes
    };
  } catch (e) {
    return { ok: false, error: e.toString() };
  }
}


// ============================================================
// getAdminDashboard()                               — v4.1
// Calcula KPIs reales para el panel del superadmin.
// Lee DATOS, ESTATUS, GRUPOS, PAGOS de APOLLO_G3.
//
// Respuesta:
// {
//   ok: true,
//   kpis: { totalEstudiantes, activos, grupos, docentes, ingresoMes, ingresoTotal },
//   grupos: [ { code, nivel, docente, estudiantes, schedule, programa } ],
//   alertas: [ { level, title, detail } ]
// }
// ============================================================
function getAdminDashboard() {
  var ss = SpreadsheetApp.openById(SHEET_ID);

  // ── Leer DATOS — solo para totalEst ────────────────────────
  var wsDatos  = ss.getSheetByName(SH.DATOS);
  var datRows  = wsDatos.getDataRange().getValues();
  var datH     = datRows[0];
  var iCodigo  = datH.indexOf('CODIGO');

  var totalEst = 0;
  for (var i = 1; i < datRows.length; i++) {
    var c = String(datRows[i][iCodigo] || '').trim();
    if (c) totalEst++;
  }

  // ── Leer ESTATUS — fuente de verdad para estudiantes por grupo ──
  // Cuenta por GRUPO + ESTATUS=CA (cursando actualmente ese nivel en ese grupo).
  // Esto evita contar doble a estudiantes que avanzaron de nivel:
  // un estudiante que terminó B1 y está en B2 solo cuenta en el grupo B2.
  // Un estudiante con CA en B1-LM69-C3-0125 y APR en ese mismo grupo
  // solo suma 1 al contador (deduplicado por CODIGO).
  var wsEst   = ss.getSheetByName(SH.ESTATUS);
  var estRows = wsEst.getDataRange().getValues();
  var estH    = estRows[0];
  var iEst    = estH.indexOf('ESTATUS');
  var iNivel  = estH.indexOf('NIVEL');
  var iEstGrp = estH.indexOf('GRUPO');
  var iEstCod = estH.indexOf('CODIGO');
  var activos = 0;
  var estatusCount = {};

  // estPorGrupo: { cod_grupo: Set de CODIGOS con estatus CA en ese grupo }
  // Usamos Set (simulado con objeto) para evitar duplicados por código
  var estPorGrupoSet = {}; // { cod_grupo: { codigo: true } }

  for (var i = 1; i < estRows.length; i++) {
    var est = String(estRows[i][iEst] || '').trim().toUpperCase();
    if (!est) continue;
    estatusCount[est] = (estatusCount[est] || 0) + 1;
    if (est === 'CA') {
      activos++;
      var grpE = String(estRows[i][iEstGrp] || '').trim();
      var codE = String(estRows[i][iEstCod] || '').trim();
      if (grpE && codE) {
        if (!estPorGrupoSet[grpE]) estPorGrupoSet[grpE] = {};
        estPorGrupoSet[grpE][codE] = true;
      }
    }
  }
  // Convertir sets a conteos
  var estPorGrupo = {};
  Object.keys(estPorGrupoSet).forEach(function(g) {
    estPorGrupo[g] = Object.keys(estPorGrupoSet[g]).length;
  });

  // ── Ingresos desde PAGOS_CAMPUS (tabla nueva limpia) ───────
  var resumenPagos = getResumenPagosCampus();
  var ingresoMes   = resumenPagos.ingresoMes   || 0;
  var ingresoTotal = resumenPagos.ingresoTotal  || 0;

  // ── Leer GRUPOS — construir lista con nivel activo ─────────
  var wsGrupos  = ss.getSheetByName(SH.GRUPOS);
  var gruRows   = wsGrupos.getDataRange().getValues();
  var gruH      = gruRows[0];
  var iGCodigo  = gruH.indexOf('CODIGO_GRUPO');
  var iGFecha   = gruH.indexOf('FECHA_INICIO');
  var iGNivel   = gruH.indexOf('NIVEL_INICIO');
  var iGDocente = gruH.indexOf('DOCENTE');
  var iGDias    = gruH.indexOf('DIAS');
  var iGHini    = gruH.indexOf('HORA_INI');
  var iGHfin    = gruH.indexOf('HORA_FIN');
  var iGProg    = gruH.indexOf('PROGRAMA');

  // Agrupar filas por código de grupo
  var grupoMap = {};
  var hoy = new Date();
  hoy.setHours(0,0,0,0);
  for (var i = 1; i < gruRows.length; i++) {
    var cod = String(gruRows[i][iGCodigo] || '').trim();
    if (!cod) continue;
    var rawF = gruRows[i][iGFecha];
    var fechaD = new Date(rawF);
    fechaD.setHours(0,0,0,0);
    if (!grupoMap[cod]) grupoMap[cod] = { filas:[], docente:'', dias:'', hini:'', hfin:'', programa:'' };
    grupoMap[cod].filas.push({ fecha: fechaD, nivel: String(gruRows[i][iGNivel]||'').trim() });
    grupoMap[cod].docente  = String(gruRows[i][iGDocente]||'').trim();
    grupoMap[cod].dias     = String(gruRows[i][iGDias]   ||'').trim();
    grupoMap[cod].programa = String(gruRows[i][iGProg]   ||'').trim();
    // Derivar horario del código del grupo — más confiable que leer HORA_INI/FIN
    var partesCod = cod.split('-');
    var segHora = partesCod.length > 1 ? partesCod[1] : '';
    if (segHora.indexOf('69') !== -1)  { grupoMap[cod].hini = '6pm';  grupoMap[cod].hfin = '9pm'; }
    else if (segHora.indexOf('94') !== -1) { grupoMap[cod].hini = '9am';  grupoMap[cod].hfin = '4pm'; }
    else { grupoMap[cod].hini = '6pm'; grupoMap[cod].hfin = '9pm'; }
  }

  var diasLabel = { LM:'Lun/Mié', KJ:'Mar/Jue', LJ:'Lun-Jue', SA:'Sáb', LM94:'Lun/Mié' };
  var nivelesLabel = { B1:'Básico I', B2:'Básico II', I1:'Intermedio I', I2:'Intermedio II' };
  var docentes = {};
  var gruposList = [];

  Object.keys(grupoMap).forEach(function(cod) {
    var g = grupoMap[cod];
    // Nivel activo = fila con mayor fecha <= hoy
    var activo = null;
    g.filas.sort(function(a,b){ return a.fecha - b.fecha; });
    g.filas.forEach(function(f) {
      if (f.fecha <= hoy) activo = f;
    });
    if (!activo) activo = g.filas[0];
    var nivelLabel = nivelesLabel[activo ? activo.nivel : 'B1'] || activo.nivel;
    var schedLabel = (diasLabel[g.dias] || g.dias) + ' ' + g.hini + '–' + g.hfin;
    if (g.docente && g.docente !== 'POR DEFINIR') docentes[g.docente] = true;

    // v4.27.2 — Para que el frontend agrupe por período cronológico
    // Usamos FECHA_INICIO real del nivel activo (más confiable que el código).
    var fechaIso = '';
    var periodoLabel = '';
    var anioGrupo = '';
    var tipoPeriodo = ''; // 'C' o 'B'
    var numPeriodo = 0;
    if (activo && activo.fecha instanceof Date && !isNaN(activo.fecha.getTime())) {
      fechaIso = Utilities.formatDate(activo.fecha, 'America/Costa_Rica', 'yyyy-MM-dd');
      anioGrupo = activo.fecha.getFullYear();
      var mes = activo.fecha.getMonth(); // 0-11
      // Parsear tipo_periodo del código: '-C1-' o '-B3-'
      var m = cod.match(/-([CB])(\d)-/);
      if (m) {
        tipoPeriodo = m[1];
        numPeriodo  = parseInt(m[2], 10);
      } else {
        // fallback: deducir por mes
        tipoPeriodo = 'C';
        numPeriodo  = Math.floor(mes / 4) + 1;
      }
      var mesesEs = ['Ene','Feb','Mar','Abr','May','Jun','Jul','Ago','Set','Oct','Nov','Dic'];
      var dur = tipoPeriodo === 'C' ? 4 : 2;
      var mesFinIdx = (mes + dur - 1) % 12;
      periodoLabel = (tipoPeriodo === 'C' ? 'Cuatrimestre ' : 'Bimestre ') + numPeriodo +
                     ' · ' + mesesEs[mes] + '–' + mesesEs[mesFinIdx] + ' ' + anioGrupo;
    }

    gruposList.push({
      code:           cod,
      nivel:          nivelLabel,
      nivelId:        (activo ? activo.nivel : 'B1').toLowerCase(),
      docente:        g.docente,
      estudiantes:    estPorGrupo[cod] || 0,
      schedule:       schedLabel,
      programa:       g.programa,
      // v4.27.2 — agrupación cronológica
      fecha_inicio:   fechaIso,
      anio:           anioGrupo,
      tipo_periodo:   tipoPeriodo,
      num_periodo:    numPeriodo,
      periodo_label:  periodoLabel,
    });
  });

  // ── Alertas automáticas ────────────────────────────────────
  var alertas = [];
  gruposList.forEach(function(g) {
    if (g.estudiantes < 5 && g.estudiantes > 0) {
      alertas.push({ level:'high', title:'Grupo bajo cupo: ' + g.code, detail: g.estudiantes + ' estudiantes — revisar si continúa.' });
    }
    if (g.docente === 'POR DEFINIR') {
      alertas.push({ level:'med', title:'Docente pendiente: ' + g.code, detail:'El grupo inicia pronto sin docente asignado.' });
    }
  });

  return {
    ok: true,
    kpis: {
      totalEstudiantes: totalEst,
      activos:          activos,
      grupos:           gruposList.length,
      docentes:         Object.keys(docentes).length,
      ingresoMes:       ingresoMes,
      ingresoTotal:     ingresoTotal,
    },
    grupos:  gruposList,
    alertas: alertas,
    estatus: estatusCount,
  };
}

// ============================================================
// getUsuario(usuario, clave)                        — v4
// Valida credenciales contra hoja USUARIOS de APOLLO_G3.
// Si el usuario tiene múltiples grupos devuelve todos.
//
// Respuesta éxito (un grupo):
//   { ok:true, rol, nombre, grupo, codigo, programa }
// Respuesta éxito (múltiples grupos — ej. john):
//   { ok:true, rol, nombre, grupos:[{grupo, programa}], multiGrupo:true }
// Respuesta error:
//   { ok:false, error:'credenciales_invalidas' | 'usuario_inactivo' }
// ============================================================
// ════════════════════════════════════════════════════════════════════
// _programaDeGrupo(ssApollo, cod_grupo)              — v4.22.1
// Devuelve el PROGRAMA real ('INA' | 'SIN_INA') de un grupo, leído de
// APOLLO.GRUPOS en tiempo real. Si no lo encuentra, default 'SIN_INA'.
// Usado por getUsuario para no hardcodear el programa en el login.
// ════════════════════════════════════════════════════════════════════
function _programaDeGrupo(ssApollo, cod_grupo) {
  if (!cod_grupo) return 'SIN_INA';
  try {
    var wsG = ssApollo.getSheetByName(SH.GRUPOS);
    if (!wsG) return 'SIN_INA';
    var dG = wsG.getDataRange().getValues();
    var hG = dG[0];
    var iCod = hG.indexOf('CODIGO_GRUPO');
    var iProg = hG.indexOf('PROGRAMA');
    if (iCod === -1 || iProg === -1) return 'SIN_INA';
    var cg = String(cod_grupo).trim();
    for (var i = 1; i < dG.length; i++) {
      if (String(dG[i][iCod] || '').trim() === cg) {
        var p = String(dG[i][iProg] || '').trim().toUpperCase();
        return (p === 'INA') ? 'INA' : 'SIN_INA';
      }
    }
  } catch (e) {}
  return 'SIN_INA';
}



// ════════════════════════════════════════════════════════════════════
// SESIONES REALES — SEC-003A
// Migración compatible: crea y valida tokens, pero todavía no protege
// transversalmente los endpoints existentes. Esa exigencia entra en SEC-003B.
// ════════════════════════════════════════════════════════════════════
var _SESIONES_SHEET = 'SESIONES';
var _SESION_DURACION_MS = 8 * 60 * 60 * 1000; // 8 horas fijas
var _SESIONES_HEADERS = [
  'TOKEN_HASH', 'USUARIO', 'ROL', 'NOMBRE', 'CODIGO', 'CEDULA',
  'GRUPO', 'GRUPOS_JSON', 'PROGRAMA', 'CREADA', 'EXPIRA',
  'ULTIMA_ACTIVIDAD', 'ACTIVA', 'CIERRE_MOTIVO'
];

function _getOrCreateSesionesSheet_(ss) {
  var ws = ss.getSheetByName(_SESIONES_SHEET);
  if (!ws) {
    ws = ss.insertSheet(_SESIONES_SHEET);
    ws.getRange(1, 1, 1, _SESIONES_HEADERS.length).setValues([_SESIONES_HEADERS]);
    ws.setFrozenRows(1);
  } else {
    var lastCol = Math.max(ws.getLastColumn(), _SESIONES_HEADERS.length);
    var existing = ws.getRange(1, 1, 1, lastCol).getValues()[0];
    var changed = false;
    for (var i = 0; i < _SESIONES_HEADERS.length; i++) {
      if (String(existing[i] || '').trim() !== _SESIONES_HEADERS[i]) {
        existing[i] = _SESIONES_HEADERS[i];
        changed = true;
      }
    }
    if (changed) ws.getRange(1, 1, 1, _SESIONES_HEADERS.length).setValues([existing.slice(0, _SESIONES_HEADERS.length)]);
  }
  return ws;
}

function _getSessionPepper_() {
  var props = PropertiesService.getScriptProperties();
  var pepper = props.getProperty('AN_SESSION_PEPPER_V1');
  if (!pepper) {
    var lock = LockService.getScriptLock();
    lock.waitLock(10000);
    try {
      pepper = props.getProperty('AN_SESSION_PEPPER_V1');
      if (!pepper) {
        pepper = Utilities.getUuid() + Utilities.getUuid() + Utilities.getUuid();
        props.setProperty('AN_SESSION_PEPPER_V1', pepper);
      }
    } finally {
      lock.releaseLock();
    }
  }
  return pepper;
}

function _bytesToHex_(bytes) {
  return bytes.map(function(b) {
    var v = b < 0 ? b + 256 : b;
    return ('0' + v.toString(16)).slice(-2);
  }).join('');
}

function _hashSessionToken_(token) {
  var raw = String(token || '');
  if (!raw) return '';
  var digest = Utilities.computeDigest(
    Utilities.DigestAlgorithm.SHA_256,
    raw + '|' + _getSessionPepper_(),
    Utilities.Charset.UTF_8
  );
  return _bytesToHex_(digest);
}

function _crearTokenSesion_() {
  return Utilities.getUuid().replace(/-/g, '') +
         Utilities.getUuid().replace(/-/g, '') +
         Utilities.getUuid().replace(/-/g, '');
}

function _normalizarSesionDesdeLogin_(login, usuario) {
  var grupos = [];
  if (login && login.multiGrupo && Array.isArray(login.grupos)) {
    grupos = login.grupos;
  } else if (login && login.grupo) {
    grupos = [{ grupo: login.grupo, programa: login.programa || 'SIN_INA' }];
  }
  return {
    usuario: String(usuario || '').trim(),
    rol: String(login.rol || '').trim(),
    nombre: String(login.nombre || '').trim(),
    codigo: String(login.codigo || '').trim(),
    cedula: String(login.cedula || '').trim(),
    grupo: String(login.grupo || '').trim(),
    grupos: grupos,
    programa: String(login.programa || '').trim(),
    multiGrupo: !!login.multiGrupo
  };
}

function iniciarSesion(body) {
  body = body || {};
  var usuario = String(body.usuario || '').trim();
  var clave = String(body.clave || '');
  if (!usuario || !clave) return { ok: false, error: 'missing_param' };

  // Reutiliza la validación vigente para no alterar reglas de acceso en SEC-003A.
  var login = getUsuario(usuario, clave);
  if (!login || login.ok !== true) {
    return { ok: false, error: (login && login.error) || 'credenciales_invalidas' };
  }

  var sesion = _normalizarSesionDesdeLogin_(login, usuario);
  var token = _crearTokenSesion_();
  var tokenHash = _hashSessionToken_(token);
  var ahora = new Date();
  var expira = new Date(ahora.getTime() + _SESION_DURACION_MS);
  var ss = SpreadsheetApp.openById(SHEET_ID);
  var lock = LockService.getScriptLock();
  lock.waitLock(15000);
  try {
    var ws = _getOrCreateSesionesSheet_(ss);
    ws.appendRow([
      tokenHash,
      sesion.usuario,
      sesion.rol,
      sesion.nombre,
      sesion.codigo,
      sesion.cedula,
      sesion.grupo,
      JSON.stringify(sesion.grupos || []),
      sesion.programa,
      ahora,
      expira,
      ahora,
      true,
      ''
    ]);
  } finally {
    lock.releaseLock();
  }

  return {
    ok: true,
    token: token,
    expira: expira.toISOString(),
    rol: sesion.rol,
    nombre: sesion.nombre,
    codigo: sesion.codigo || null,
    cedula: sesion.cedula || null,
    grupo: sesion.grupo || null,
    programa: sesion.programa || null,
    multiGrupo: sesion.multiGrupo,
    grupos: sesion.grupos
  };
}

function validarSesion(token) {
  token = String(token || '').trim();
  if (!token) return { ok: false, error: 'sesion_requerida' };
  var tokenHash = _hashSessionToken_(token);
  var ss = SpreadsheetApp.openById(SHEET_ID);
  var ws = ss.getSheetByName(_SESIONES_SHEET);
  if (!ws || ws.getLastRow() < 2) return { ok: false, error: 'sesion_invalida' };

  var rows = ws.getDataRange().getValues();
  var h = rows[0];
  var ix = {};
  for (var c = 0; c < h.length; c++) ix[String(h[c] || '').trim()] = c;
  var ahora = new Date();

  for (var i = rows.length - 1; i >= 1; i--) {
    if (String(rows[i][ix.TOKEN_HASH] || '') !== tokenHash) continue;
    var activa = rows[i][ix.ACTIVA];
    var esActiva = activa === true || String(activa).trim().toUpperCase() === 'TRUE';
    if (!esActiva) return { ok: false, error: 'sesion_revocada' };
    var expira = rows[i][ix.EXPIRA] instanceof Date ? rows[i][ix.EXPIRA] : new Date(rows[i][ix.EXPIRA]);
    if (!expira || isNaN(expira.getTime()) || expira.getTime() <= ahora.getTime()) {
      ws.getRange(i + 1, ix.ACTIVA + 1).setValue(false);
      ws.getRange(i + 1, ix.CIERRE_MOTIVO + 1).setValue('EXPIRADA');
      return { ok: false, error: 'sesion_expirada' };
    }

    ws.getRange(i + 1, ix.ULTIMA_ACTIVIDAD + 1).setValue(ahora);
    var grupos = [];
    try { grupos = JSON.parse(String(rows[i][ix.GRUPOS_JSON] || '[]')); } catch (_) {}
    return {
      ok: true,
      expira: expira.toISOString(),
      usuario: String(rows[i][ix.USUARIO] || ''),
      rol: String(rows[i][ix.ROL] || ''),
      nombre: String(rows[i][ix.NOMBRE] || ''),
      codigo: String(rows[i][ix.CODIGO] || '') || null,
      cedula: String(rows[i][ix.CEDULA] || '') || null,
      grupo: String(rows[i][ix.GRUPO] || '') || null,
      programa: String(rows[i][ix.PROGRAMA] || '') || null,
      multiGrupo: grupos.length > 1,
      grupos: grupos
    };
  }
  return { ok: false, error: 'sesion_invalida' };
}

function cerrarSesion(body) {
  body = body || {};
  var token = String(body.token || body.session_token || '').trim();
  if (!token) return { ok: true };
  var tokenHash = _hashSessionToken_(token);
  var ss = SpreadsheetApp.openById(SHEET_ID);
  var ws = ss.getSheetByName(_SESIONES_SHEET);
  if (!ws || ws.getLastRow() < 2) return { ok: true };

  var rows = ws.getDataRange().getValues();
  var h = rows[0];
  var iHash = h.indexOf('TOKEN_HASH');
  var iActiva = h.indexOf('ACTIVA');
  var iMotivo = h.indexOf('CIERRE_MOTIVO');
  for (var i = rows.length - 1; i >= 1; i--) {
    if (String(rows[i][iHash] || '') !== tokenHash) continue;
    ws.getRange(i + 1, iActiva + 1).setValue(false);
    ws.getRange(i + 1, iMotivo + 1).setValue('LOGOUT');
    break;
  }
  return { ok: true };
}

function _limpiarSesionesExpiradas() {
  var ss = SpreadsheetApp.openById(SHEET_ID);
  var ws = ss.getSheetByName(_SESIONES_SHEET);
  if (!ws || ws.getLastRow() < 2) return { ok: true, expiradas: 0 };
  var rows = ws.getDataRange().getValues();
  var h = rows[0];
  var iExp = h.indexOf('EXPIRA');
  var iAct = h.indexOf('ACTIVA');
  var iMot = h.indexOf('CIERRE_MOTIVO');
  var ahora = new Date().getTime();
  var n = 0;
  for (var i = 1; i < rows.length; i++) {
    var activa = rows[i][iAct] === true || String(rows[i][iAct]).trim().toUpperCase() === 'TRUE';
    if (!activa) continue;
    var exp = rows[i][iExp] instanceof Date ? rows[i][iExp] : new Date(rows[i][iExp]);
    if (!exp || isNaN(exp.getTime()) || exp.getTime() > ahora) continue;
    ws.getRange(i + 1, iAct + 1).setValue(false);
    ws.getRange(i + 1, iMot + 1).setValue('EXPIRADA');
    n++;
  }
  return { ok: true, expiradas: n };
}


// ════════════════════════════════════════════════════════════════════
// ACADEMICO-001A — Auditoría Académica backend solo lectura
// Endpoint POST: getAuditoriaAcademicaGrupo({token,cod_grupo,nivel})
// Requiere sesión válida rol admin/superadmin. No escribe en Sheets.
// Objetivo: alimentar una vista admin por Grupo → Nivel → Lección sin
// hacer 30+ llamadas desde el frontend.
// ════════════════════════════════════════════════════════════════════
function _esAdminOSuperadmin(body) {
  if (!body) return { ok:false, error:'sesion_requerida' };
  var token = String(body.token || body.session_token || '').trim();
  if (!token) return { ok:false, error:'sesion_requerida' };
  try {
    var sesion = validarSesion(token);
    if (!sesion || sesion.ok !== true) return sesion || { ok:false, error:'sesion_invalida' };
    var rol = String(sesion.rol || '').trim().toLowerCase();
    if (rol !== 'admin' && rol !== 'superadmin') return { ok:false, error:'no_autorizado' };
    return { ok:true, sesion:sesion };
  } catch(e) {
    return { ok:false, error:'sesion_error: ' + e.toString() };
  }
}

function _idxHeader_(headers, names) {
  if (!Array.isArray(names)) names = [names];
  for (var i = 0; i < names.length; i++) {
    var n = String(names[i] || '');
    var idx = headers.indexOf(n);
    if (idx !== -1) return idx;
  }
  var map = {};
  for (var h = 0; h < headers.length; h++) map[String(headers[h] || '').toUpperCase()] = h;
  for (var j = 0; j < names.length; j++) {
    var k = String(names[j] || '').toUpperCase();
    if (map[k] !== undefined) return map[k];
  }
  return -1;
}

function _fmtISODate_(v) {
  if (v instanceof Date) return Utilities.formatDate(v, 'America/Costa_Rica', 'yyyy-MM-dd');
  return String(v || '').trim();
}

function _boolTrue_(v) {
  return v === true || String(v || '').trim().toUpperCase() === 'TRUE' || String(v || '').trim().toUpperCase() === 'SI';
}

function _ensureMatrizItem_(matriz, leccion, codigo) {
  var l = String(leccion || '');
  var c = String(codigo || '').trim();
  if (!l || !c) return null;
  if (!matriz[l]) matriz[l] = {};
  if (!matriz[l][c]) {
    matriz[l][c] = {
      codigo: c,
      presente: null,
      evaluaciones: [],
      nota_total: 0,
      retro: '',
      progress_check: ''
    };
  }
  return matriz[l][c];
}

function _getAuditoriaLeccion_(map, leccion) {
  var k = String(leccion || '');
  if (!map[k]) {
    map[k] = {
      leccion: Number(leccion) || 0,
      asistencia: { registrados:0, presentes:0, ausentes:0, total:0, pct:0 },
      notas: { total:0, estudiantes:0, tipos:{} },
      retro: { total:0, estudiantes:0 },
      progress_check: { total:0, estudiantes:0 },
      alertas: []
    };
  }
  return map[k];
}

function getAuditoriaAcademicaGrupo(body) {
  body = body || {};
  var auth = _esAdminOSuperadmin(body);
  if (!auth.ok) return auth;

  var cod_grupo = String(body.cod_grupo || body.grupo || '').trim();
  var nivel = String(body.nivel || '').trim().toUpperCase();
  if (!cod_grupo || !nivel) return { ok:false, error:'Faltan cod_grupo y nivel' };

  try {
    var ssApollo = SpreadsheetApp.openById(SHEET_ID);
    var ssOp = SpreadsheetApp.openById(OPERATIVO_ID);
    var infoNivel = _leerFilaGrupoNivel(ssApollo, cod_grupo, nivel);
    if (!infoNivel) return { ok:false, error:'No se encontró grupo+nivel en APOLLO.GRUPOS' };

    var roster = getEstudiantesParaCierre(cod_grupo, nivel);
    if (!roster || roster.ok !== true) return roster || { ok:false, error:'No se pudo cargar estudiantes' };
    var estudiantes = roster.estudiantes || [];

    var wsCal = ssOp.getSheetByName(SH_CALENDARIO);
    if (!wsCal) return { ok:false, error:'CALENDARIO_LECCIONES no existe' };
    var calData = wsCal.getDataRange().getValues();
    var cH = calData[0];
    var icG = _idxHeader_(cH, 'COD_GRUPO');
    var icN = _idxHeader_(cH, 'NIVEL');
    var icL = _idxHeader_(cH, 'LECCION');
    var icF = _idxHeader_(cH, 'FECHA');
    var icD = _idxHeader_(cH, 'DIA_SEMANA');
    var icT = _idxHeader_(cH, 'TURNO');
    var icK = _idxHeader_(cH, 'TIPO_LECCION');
    var icE = _idxHeader_(cH, 'ESTADO');
    var icDo = _idxHeader_(cH, 'DOCENTE');
    var icAR = _idxHeader_(cH, 'ASISTENCIA_REGISTRADA');
    var icND = _idxHeader_(cH, 'NOTAS_DOCENTE');

    var porLeccion = {};
    var lecciones = [];
    for (var i = 1; i < calData.length; i++) {
      if (String(calData[i][icG] || '').trim() !== cod_grupo) continue;
      if (String(calData[i][icN] || '').trim().toUpperCase() !== nivel) continue;
      var num = Number(calData[i][icL]) || 0;
      var base = _getAuditoriaLeccion_(porLeccion, num);
      base.fecha = _fmtISODate_(calData[i][icF]);
      base.dia = icD >= 0 ? String(calData[i][icD] || '') : '';
      base.turno = icT >= 0 ? String(calData[i][icT] || '') : '';
      base.tipo = icK >= 0 ? String(calData[i][icK] || '') : '';
      base.estado = icE >= 0 ? String(calData[i][icE] || '') : '';
      base.docente = icDo >= 0 ? String(calData[i][icDo] || '') : infoNivel.docente;
      base.asistencia_registrada = icAR >= 0 ? _boolTrue_(calData[i][icAR]) : false;
      base.notas_docente = icND >= 0 ? String(calData[i][icND] || '') : '';
    }

    var matriz = {};

    var wsA = ssOp.getSheetByName(OP.ASISTENCIA);
    if (wsA && wsA.getLastRow() > 1) {
      var aRows = wsA.getDataRange().getValues();
      var aH = aRows[0];
      var iaG = _idxHeader_(aH, 'cod_grupo');
      var iaL = _idxHeader_(aH, 'leccion_num');
      var iaC = _idxHeader_(aH, 'cod_estudiante');
      var iaP = _idxHeader_(aH, 'presente');
      var iaF = _idxHeader_(aH, 'fecha_leccion');
      var iaR = _idxHeader_(aH, 'registrado_por');
      for (var a = 1; a < aRows.length; a++) {
        if (String(aRows[a][iaG] || '').trim() !== cod_grupo) continue;
        var lecA = Number(aRows[a][iaL]) || 0;
        if (!porLeccion[String(lecA)]) continue;
        var codA = String(aRows[a][iaC] || '').trim();
        if (!codA) continue;
        var pre = _boolTrue_(aRows[a][iaP]);
        var itA = _ensureMatrizItem_(matriz, lecA, codA);
        if (itA) {
          itA.presente = pre;
          itA.fecha_asistencia = _fmtISODate_(aRows[a][iaF]);
          itA.registrado_por_asistencia = iaR >= 0 ? String(aRows[a][iaR] || '') : '';
        }
      }
    }

    var wsR = ssOp.getSheetByName(OP.RETROALIMENTACION);
    if (wsR && wsR.getLastRow() > 1) {
      var rRows = wsR.getDataRange().getValues();
      var rH = rRows[0];
      var irG = _idxHeader_(rH, 'cod_grupo');
      var irL = _idxHeader_(rH, 'leccion_num');
      var irC = _idxHeader_(rH, 'cod_estudiante');
      var irM = _idxHeader_(rH, 'comentario');
      for (var r = 1; r < rRows.length; r++) {
        if (String(rRows[r][irG] || '').trim() !== cod_grupo) continue;
        var lecR = Number(rRows[r][irL]) || 0;
        if (!porLeccion[String(lecR)]) continue;
        var codR = String(rRows[r][irC] || '').trim();
        var msgR = String(rRows[r][irM] || '').trim();
        if (!codR || !msgR) continue;
        var itR = _ensureMatrizItem_(matriz, lecR, codR);
        if (itR) itR.retro = msgR;
      }
    }

    var wsPC = ssOp.getSheetByName(OP.PROGRESS_CHECK);
    if (wsPC && wsPC.getLastRow() > 1) {
      var pcRows = wsPC.getDataRange().getValues();
      var pcH = pcRows[0];
      var ipG = _idxHeader_(pcH, 'cod_grupo');
      var ipL = _idxHeader_(pcH, 'leccion_num');
      var ipC = _idxHeader_(pcH, 'cod_estudiante');
      var ipM = _idxHeader_(pcH, 'comentario');
      for (var pc = 1; pc < pcRows.length; pc++) {
        if (String(pcRows[pc][ipG] || '').trim() !== cod_grupo) continue;
        var lecPC = Number(pcRows[pc][ipL]) || 0;
        if (!porLeccion[String(lecPC)]) continue;
        var codPC = String(pcRows[pc][ipC] || '').trim();
        var msgPC = String(pcRows[pc][ipM] || '').trim();
        if (!codPC || !msgPC) continue;
        var itPC = _ensureMatrizItem_(matriz, lecPC, codPC);
        if (itPC) itPC.progress_check = msgPC;
      }
    }

    var wsE = ssOp.getSheetByName(OP.EVALUACIONES);
    if (wsE && wsE.getLastRow() > 1) {
      var eRows = wsE.getDataRange().getValues();
      var eH = eRows[0];
      var ieG = _idxHeader_(eH, 'cod_grupo');
      var ieC = _idxHeader_(eH, 'cod_estudiante');
      var ieN = _idxHeader_(eH, 'nivel');
      var ieT = _idxHeader_(eH, 'tipo_eval');
      var ieL = _idxHeader_(eH, 'leccion_num');
      var ieNo= _idxHeader_(eH, 'nota_obtenida');
      var iePe= _idxHeader_(eH, 'peso_maximo');
      for (var ev = 1; ev < eRows.length; ev++) {
        if (String(eRows[ev][ieG] || '').trim() !== cod_grupo) continue;
        if (ieN >= 0 && String(eRows[ev][ieN] || '').trim().toUpperCase() !== nivel) continue;
        var lecE = Number(eRows[ev][ieL]) || 0;
        if (!porLeccion[String(lecE)]) continue;
        var codE = String(eRows[ev][ieC] || '').trim();
        var tipoE = String(eRows[ev][ieT] || '').trim();
        var notaE = parseFloat(eRows[ev][ieNo]) || 0;
        var pesoE = iePe >= 0 ? (parseFloat(eRows[ev][iePe]) || 0) : 0;
        if (!codE) continue;
        var itE = _ensureMatrizItem_(matriz, lecE, codE);
        if (itE) {
          itE.evaluaciones.push({ tipo: tipoE, nota: notaE, peso_maximo: pesoE });
          itE.nota_total += notaE;
        }
      }
    }

    var resumen = {
      estudiantes_activos: estudiantes.length,
      lecciones_total: 0,
      lecciones_cerradas: 0,
      lecciones_pendientes: 0,
      asistencia_promedio_pct: 0,
      asistencias_registradas: 0,
      notas_registradas: 0,
      retroalimentaciones: 0,
      progress_checks: 0,
      estudiantes_en_riesgo: 0,
      alertas_total: 0
    };

    var asistenciaPctSum = 0;
    var asistenciaPctN = 0;
    var riesgoPorEstudiante = {};

    Object.keys(porLeccion).sort(function(a,b){ return Number(a) - Number(b); }).forEach(function(k) {
      var pl = porLeccion[k];
      var detalle = matriz[k] || {};
      var codsAsistencia = {}, codsRetro = {}, codsPC = {}, codsNotas = {};
      Object.keys(detalle).forEach(function(cod) {
        var d = detalle[cod];
        if (d.presente !== null) codsAsistencia[cod] = true;
        if (d.retro) codsRetro[cod] = true;
        if (d.progress_check) codsPC[cod] = true;
        if (d.evaluaciones && d.evaluaciones.length) codsNotas[cod] = true;
        if (d.presente === false) riesgoPorEstudiante[cod] = (riesgoPorEstudiante[cod] || 0) + 1;
      });
      pl.asistencia.total = estudiantes.length;
      pl.asistencia.registrados = Object.keys(codsAsistencia).length;
      pl.asistencia.presentes = Object.keys(detalle).filter(function(c){ return detalle[c].presente === true; }).length;
      pl.asistencia.ausentes = Object.keys(detalle).filter(function(c){ return detalle[c].presente === false; }).length;
      pl.asistencia.pct = pl.asistencia.total > 0 ? Math.round((pl.asistencia.presentes / pl.asistencia.total) * 100) : 0;
      pl.retro.estudiantes = Object.keys(codsRetro).length;
      pl.retro.total = pl.retro.estudiantes;
      pl.progress_check.estudiantes = Object.keys(codsPC).length;
      pl.progress_check.total = pl.progress_check.estudiantes;
      pl.notas.estudiantes = Object.keys(codsNotas).length;
      pl.notas.total = Object.keys(detalle).reduce(function(s,c){ return s + ((detalle[c].evaluaciones || []).length); }, 0);

      var estado = String(pl.estado || '').toUpperCase();
      if (estado === 'CERRADA') {
        resumen.lecciones_cerradas++;
        if (pl.asistencia.registrados === 0) pl.alertas.push('cerrada_sin_asistencia');
        if (pl.retro.estudiantes === 0) pl.alertas.push('cerrada_sin_retroalimentacion');
      } else if (estado && estado !== 'FERIADO') {
        resumen.lecciones_pendientes++;
      }
      if (String(infoNivel.programa || '').toUpperCase() === 'INA' && LECCIONES_PROGRESS_CHECK[pl.leccion] && estado === 'CERRADA' && pl.progress_check.estudiantes === 0) {
        pl.alertas.push('progress_check_faltante');
      }
      if (pl.asistencia.total > 0 && pl.asistencia.registrados > 0) {
        asistenciaPctSum += pl.asistencia.pct;
        asistenciaPctN++;
      }
      resumen.lecciones_total++;
      resumen.asistencias_registradas += pl.asistencia.registrados;
      resumen.notas_registradas += pl.notas.total;
      resumen.retroalimentaciones += pl.retro.estudiantes;
      resumen.progress_checks += pl.progress_check.estudiantes;
      resumen.alertas_total += pl.alertas.length;
      lecciones.push(pl);
    });

    Object.keys(riesgoPorEstudiante).forEach(function(cod) {
      if (riesgoPorEstudiante[cod] >= 2) resumen.estudiantes_en_riesgo++;
    });
    resumen.asistencia_promedio_pct = asistenciaPctN > 0 ? Math.round(asistenciaPctSum / asistenciaPctN) : 0;

    return {
      ok: true,
      generado_en: new Date().toISOString(),
      solicitado_por: { usuario: auth.sesion.usuario, rol: auth.sesion.rol, nombre: auth.sesion.nombre },
      grupo: {
        cod_grupo: cod_grupo,
        nivel: nivel,
        programa: String(infoNivel.programa || '').trim(),
        modalidad: String(infoNivel.modalidad || '').trim(),
        docente: String(infoNivel.docente || '').trim(),
        fecha_inicio: _fmtISODate_(infoNivel.fechaInicio)
      },
      resumen: resumen,
      estudiantes: estudiantes,
      lecciones: lecciones,
      matriz: matriz,
      notas: [
        'Solo lectura. No modifica ninguna hoja.',
        'La auditoría cruza datos por cod_grupo + leccion_num. Si en el futuro se reutiliza el mismo cod_grupo para varios niveles con el mismo número de lección, se debe agregar NIVEL a ASISTENCIA/RETRO/PC para evitar colisiones.'
      ]
    };
  } catch(e) {
    return { ok:false, error:'getAuditoriaAcademicaGrupo: ' + e.toString() };
  }
}

function getUsuario(usuario, clave) {
  if (!usuario || !clave) return { ok: false, error: 'missing_param' };

  var ss = SpreadsheetApp.openById(SHEET_ID);
  var ws = ss.getSheetByName(SH.USUARIOS);
  if (!ws) return { ok: false, error: 'sheet_not_found' };

  var rows   = ws.getDataRange().getValues();
  var header = rows[0];

  var iUsuario = header.indexOf('usuario');
  var iClave   = header.indexOf('clave');
  var iRol     = header.indexOf('rol');
  var iNombre  = header.indexOf('nombre');
  var iGrupo   = header.indexOf('grupo');
  var iCodigo  = header.indexOf('codigo');
  var iActivo  = header.indexOf('activo');

  if (iUsuario === -1 || iClave === -1) {
    return { ok: false, error: 'schema_error' };
  }

  // Recoger todas las filas que coincidan con usuario+clave
  var matches = [];
  for (var i = 1; i < rows.length; i++) {
    var u = String(rows[i][iUsuario] || '').trim().toLowerCase();
    var c = String(rows[i][iClave]   || '').trim();
    if (u !== String(usuario).trim().toLowerCase()) continue;
    if (c !== String(clave).trim()) continue;

    // Verificar activo
    var activo = rows[i][iActivo];
    if (activo === false || String(activo).trim().toUpperCase() === 'FALSE') {
      return { ok: false, error: 'usuario_inactivo' };
    }

    matches.push({
      rol:      String(rows[i][iRol]    || '').trim(),
      nombre:   String(rows[i][iNombre] || '').trim(),
      grupo:    String(rows[i][iGrupo]  || '').trim(),
      codigo:   String(rows[i][iCodigo] || '').trim(),
      programa: _programaDeGrupo(ss, String(rows[i][iGrupo] || '').trim()), // programa real del grupo
    });
  }

  if (matches.length === 0) {
    // Fallback: buscar estudiante en DATOS por NUM_CEDULA + CODIGO
    return getUsuarioEstudiante(usuario, clave);
  }

  // Un solo grupo — respuesta simple
  if (matches.length === 1) {
    return {
      ok:       true,
      rol:      matches[0].rol,
      nombre:   matches[0].nombre,
      grupo:    matches[0].grupo   || null,
      codigo:   matches[0].codigo  || null,
      programa: matches[0].programa,
    };
  }

  // Múltiples grupos (ej. john) — devolver lista para que el cliente muestre selector
  return {
    ok:         true,
    rol:        matches[0].rol,
    nombre:     matches[0].nombre,
    multiGrupo: true,
    grupos:     matches.map(function(m) {
      return { grupo: m.grupo, programa: m.programa };
    }),
  };
}

// ============================================================
// crearGrupo(body)                                  — v4
// Escribe una fila nueva en hoja GRUPOS de APOLLO_G3.
// Solo Superadmin puede llamar esta función.
//
// body esperado:
// {
//   codigo_grupo,   // ej. "B1-LM69-C3-0126"  — generado por el cliente
//   consecutivo,    // número ej. 126
//   programa,       // "SIN_INA" | "INA"
//   nivel_inicio,   // "B1" | "B2" | "I1" | "I2"
//   tipo_periodo,   // "C" | "B"
//   periodo_inicio, // "C1"|"C2"|"C3"|"B1"..."B6"
//   año_inicio,     // número ej. 2026
//   fecha_inicio,   // "YYYY-MM-DD"
//   modalidad,      // "INTENSIVO" | "SUPER_INTENSIVO"
//   dias,           // "LM" | "KJ" | "SA" | "LJ"
//   dias_sem,       // número de días por semana: 2 | 4 | 1
//   hora_ini,       // "HH:MM" ej. "18:00"
//   hora_fin,       // "HH:MM" ej. "21:00"
//   docente,        // nombre completo
//   activo,         // true
//   capacidad,      // número ej. 40
//   comentario      // string opcional
// }
// ============================================================
function crearGrupo(body) {
  try {
  // v4.23.14: crea UNA fila por nivel (programa completo B1→B2→I1→I2).
  // Campos compartidos (docente, días, hora, precios, rubros) son iguales en
  // todas las filas. Campos por nivel (fecha_inicio, periodo, comentario/estado)
  // vienen en body.niveles[]. Retrocompatible: si no hay body.niveles, crea 1 fila.
  if (!body || !body.codigo_grupo) return { ok: false, error: 'missing_param: codigo_grupo' };

  var ss = SpreadsheetApp.openById(SHEET_ID);
  var ws = ss.getSheetByName(SH.GRUPOS);
  if (!ws) return { ok: false, error: 'sheet_not_found' };

  var rows   = ws.getDataRange().getValues();
  var header = rows[0];
  var iCodigo = header.indexOf('CODIGO_GRUPO');

  for (var i = 1; i < rows.length; i++) {
    if (String(rows[i][iCodigo] || '').trim() === String(body.codigo_grupo).trim()) {
      return { ok: false, error: 'duplicado: ' + body.codigo_grupo };
    }
  }

  // Auto-agregar columnas nuevas si no existen
  var colsNuevas = [
    'DISPONIBLE_INSCRIPCION','PRECIO_CUOTA','PRECIO_MATRICULA','PRECIO_CERTIFICADO','PRECIO_TITULO',
    'BECA_GRUPO','BECA_PCT','TOEIC','TOEIC_MONTO',
    // v4.23.13 — certificados por nivel (8 cols planas) + rubros extra (JSON)
    'CERT_B1_MONTO','CERT_B1_OBLIG','CERT_B2_MONTO','CERT_B2_OBLIG',
    'CERT_I1_MONTO','CERT_I1_OBLIG','CERT_I2_MONTO','CERT_I2_OBLIG',
    'RUBROS_EXTRA_JSON',
    // v4.23.14 — campos I CAN por fila (para grupos INA)
    'DIAS_ICAN','HORA_INI_ICAN','HORA_FIN_ICAN','DOCENTE_ICAN',
  ];
  colsNuevas.forEach(function(col) {
    if (header.indexOf(col) === -1) {
      ws.getRange(1, ws.getLastColumn() + 1).setValue(col);
      header.push(col);
    }
  });

  // ── Normalizar la lista de niveles a crear ──────────────────────────
  // body.niveles = [{nivel, fecha_inicio, periodo_inicio, año_inicio, tipo_periodo, comentario}]
  // Retrocompat: si no viene, se arma uno solo con los campos planos del body.
  var nivelesArr = Array.isArray(body.niveles) && body.niveles.length > 0
    ? body.niveles
    : [{
        nivel:          body.nivel_inicio,
        fecha_inicio:   body.fecha_inicio,
        periodo_inicio: body.periodo_inicio,
        año_inicio:     body.año_inicio,
        tipo_periodo:   body.tipo_periodo,
        comentario:     body.comentario,
      }];

  // Pre-calcular certificados por nivel y rubros JSON (compartidos en todas las filas)
  var cpn = body.certificados_por_nivel || {};
  var re  = Array.isArray(body.rubros_extra) ? body.rubros_extra : [];
  var reJson = re.length > 0 ? JSON.stringify(re) : '';

  var filasACrear = [];

  nivelesArr.forEach(function(nv) {
    var nuevaFila = new Array(header.length).fill('');
    var set = function(col, val) {
      var idx = header.indexOf(col);
      if (idx >= 0) nuevaFila[idx] = (val !== undefined && val !== null) ? val : '';
    };

    // ── Campos COMPARTIDOS (iguales en todas las filas del grupo) ──
    set('CODIGO_GRUPO',          String(body.codigo_grupo).trim());
    set('CONSECUTIVO',           body.consecutivo || '');
    set('PROGRAMA',              body.programa    || 'SIN_INA');
    set('MODALIDAD',             String(body.modalidad || 'INTENSIVO').toUpperCase());
    set('DIAS',                  String(body.dias || '').toUpperCase());
    set('DIAS_SEM',              body.dias_sem   || 2);
    set('HORA_INI',              body.hora_ini   || '18:00');
    set('HORA_FIN',              body.hora_fin   || '21:00');
    set('DOCENTE',               body.docente    || 'POR DEFINIR');
    set('ACTIVO',                body.activo !== false ? true : false);
    set('CAPACIDAD',             body.capacidad  || 40);
    set('DISPONIBLE_INSCRIPCION', body.disponible_inscripcion === true ? true : false);
    set('PRECIO_CUOTA',          parseFloat(body.precio_cuota)       || 0);
    set('PRECIO_MATRICULA',      parseFloat(body.precio_matricula)   || 0);
    set('PRECIO_CERTIFICADO',    parseFloat(body.precio_certificado) || 0);
    set('PRECIO_TITULO',         parseFloat(body.precio_titulo)      || 0);
    set('BECA_GRUPO',            String(body.beca_grupo  || '').toUpperCase());
    set('BECA_PCT',              parseFloat(body.beca_pct) || 0);
    set('TOEIC',                 body.toeic === true ? true : false);
    set('TOEIC_MONTO',           parseFloat(body.toeic_monto) || 0);
    // Certificados por nivel (8 cols) — compartidos
    ['B1','B2','I1','I2'].forEach(function(n) {
      var c = cpn[n] || {};
      set('CERT_' + n + '_MONTO', parseFloat(c.monto) || 0);
      set('CERT_' + n + '_OBLIG', c.obligatorio === true);
    });
    set('RUBROS_EXTRA_JSON', reJson);
    // I CAN — compartidos (solo aplican a INA; vacíos si SIN_INA)
    set('DIAS_ICAN',      body.dias_ican      || '');
    set('HORA_INI_ICAN',  body.hora_ini_ican  || '');
    set('HORA_FIN_ICAN',  body.hora_fin_ican  || '');
    set('DOCENTE_ICAN',   body.docente_ican   || '');

    // ── Campos POR NIVEL (distintos en cada fila) ──
    set('NIVEL_INICIO',   String(nv.nivel || 'B1').toUpperCase());
    set('TIPO_PERIODO',   String(nv.tipo_periodo || body.tipo_periodo || 'C').toUpperCase());
    set('PERIODO_INICIO', String(nv.periodo_inicio || '').toUpperCase());
    set('AÑO_INICIO',     nv.año_inicio || (nv.fecha_inicio ? new Date(nv.fecha_inicio).getFullYear() : new Date().getFullYear()));
    set('FECHA_INICIO',   nv.fecha_inicio || '');
    set('COMENTARIO',     nv.comentario || _estadoPorFecha(nv.fecha_inicio, body.modalidad));

    filasACrear.push(nuevaFila);
  });

  // Escribir todas las filas de una (más eficiente que appendRow ×4)
  if (filasACrear.length > 0) {
    ws.getRange(ws.getLastRow() + 1, 1, filasACrear.length, header.length).setValues(filasACrear);
  }

  return {
    ok: true,
    codigo_grupo: body.codigo_grupo,
    filas_creadas: filasACrear.length,
    niveles: nivelesArr.map(function(n){ return n.nivel; }),
    mensaje: 'Grupo creado: ' + filasACrear.length + ' nivel(es) en APOLLO_G3'
  };
  } catch (err) { return {ok:false, error:String(err)}; }
}

// Calcula el estado de un nivel según su fecha de inicio (para COMENTARIO).
// "Proyectado" si aún no empieza; "En curso" si ya empezó pero no terminó;
// "Cerrado" si ya terminó. Duración: 4 meses intensivo, 2 super intensivo.
function _estadoPorFecha(fechaInicioStr, modalidad) {
  if (!fechaInicioStr) return 'Proyectado';
  try {
    var dIni = new Date(fechaInicioStr);
    if (isNaN(dIni)) return 'Proyectado';
    var meses = (String(modalidad).toLowerCase().indexOf('super') >= 0) ? 2 : 4;
    var dFin = new Date(dIni.getFullYear(), dIni.getMonth() + meses, 0);
    var hoy = new Date();
    if (dIni > hoy) return 'Proyectado';
    return dFin < hoy ? 'Cerrado' : 'En curso';
  } catch (e) {
    return 'Proyectado';
  }
}

