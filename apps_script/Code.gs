// UTILIDAD — Ejecutar UNA SOLA VEZ
// Garantiza que cada estudiante en ESTATUS tenga las 4 filas de nivel
// (B1, B2, I1, I2) si su estatus en el nivel anterior lo justifica.
// Crea filas faltantes con estatus PE (proyectado) por defecto,
// excepto si el anterior es APR/CNV → crea CA (cursando).
// ══════════════════════════════════════════════════════════════════════════
function garantizar4LineasPorEstudiante() {
  var ss       = SpreadsheetApp.openById(SHEET_ID);
  var ws       = ss.getSheetByName(SH.ESTATUS);
  var rows     = ws.getDataRange().getValues();
  var header   = rows[0];

  var iLlave   = header.indexOf('LLAVE');
  var iGrupo   = header.indexOf('GRUPO');
  var iCod     = header.indexOf('CODIGO');
  var iEst     = header.indexOf('ESTATUS');
  var iNivel   = header.indexOf('NIVEL');
  var iFecha   = header.indexOf('FECHA DE MODIFICION');

  if (iCod === -1 || iEst === -1 || iNivel === -1) {
    Browser.msgBox('No encontré las columnas CODIGO / ESTATUS / NIVEL en ESTATUS');
    return;
  }

  var niveles    = ['B1', 'B2', 'I1', 'I2'];
  var siguiente  = { B1:'B2', B2:'I1', I1:'I2' };
  var aprCnv     = { APR:true, CNV:true };
  var activos    = { APR:true, CNV:true, CA:true, RI:true, REP:true };

  // Leer estado actual — agrupar por codigo
  // mapa[cod][nivel] = { estatus, grupo, fila }
  var mapa = {};
  for (var i = 1; i < rows.length; i++) {
    var cod  = String(rows[i][iCod]   || '').trim();
    var niv  = String(rows[i][iNivel] || '').trim().toUpperCase();
    var est  = String(rows[i][iEst]   || '').trim().toUpperCase();
    var grp  = String(rows[i][iGrupo] || '').trim();
    if (!cod || !niv) continue;
    if (!mapa[cod]) mapa[cod] = {};
    mapa[cod][niv] = { estatus: est, grupo: grp, fila: i + 1 };
  }

  var creadas = 0;
  var log     = [];
  var hoy     = new Date();

  // Para cada estudiante, verificar si tiene filas para todos los niveles
  // que debería tener según su progreso
  Object.keys(mapa).forEach(function(cod) {
    var nivEstud = mapa[cod];

    // Determinar hasta qué nivel debe llegar
    // Siempre debe tener B1. Si tiene APR/CNV en B1 → debe tener B2, etc.
    var grupoRef = '';
    niveles.forEach(function(niv) {
      if (nivEstud[niv]) grupoRef = nivEstud[niv].grupo || grupoRef;
    });

    for (var n = 0; n < niveles.length; n++) {
      var niv = niveles[n];

      // ¿Debe existir esta fila?
      // B1: siempre debe existir si el estudiante existe
      // B2+: debe existir si el nivel anterior es APR, CNV, CA, RI o REP
      //      (cualquiera que haya iniciado el nivel anterior)
      var debeExistir = false;
      if (niv === 'B1') {
        debeExistir = true;
      } else {
        var nivAnterior = niveles[n - 1];
        var estAnterior = nivEstud[nivAnterior] ? nivEstud[nivAnterior].estatus : '';
        debeExistir = !!activos[estAnterior];
      }

      if (!debeExistir) continue;
      if (nivEstud[niv]) continue; // ya existe, no hacer nada

      // Crear fila faltante
      var nivAnterior2  = n > 0 ? niveles[n - 1] : null;
      var estAnterior2  = nivAnterior2 && nivEstud[nivAnterior2] ? nivEstud[nivAnterior2].estatus : '';
      var nuevoEstatus  = aprCnv[estAnterior2] ? 'CA' : 'PE';

      var nf = new Array(header.length).fill('');
      nf[iGrupo]  = grupoRef;
      nf[iCod]    = cod;
      nf[iEst]    = nuevoEstatus;
      nf[iNivel]  = niv;
      nf[iFecha]  = hoy;

      // Generar llave igual que el sistema: GRUPO-NIVEL-COD
      if (iLlave > -1) {
        nf[iLlave] = grupoRef + '-' + niv + '-' + cod;
      }

      ws.appendRow(nf);
      creadas++;

      // Registrar en log
      log.push('Creada: ' + cod + ' | ' + niv + ' | ' + nuevoEstatus + ' | ' + grupoRef);

      // Actualizar mapa en memoria para que los niveles siguientes
      // sepan que este ya existe
      if (!mapa[cod]) mapa[cod] = {};
      mapa[cod][niv] = { estatus: nuevoEstatus, grupo: grupoRef };
    }
  });

  // Mostrar resumen
  var resumen = 'Filas creadas: ' + creadas + '\n\n';
  if (log.length > 0) {
    resumen += log.slice(0, 50).join('\n');
    if (log.length > 50) resumen += '\n... y ' + (log.length - 50) + ' más';
  } else {
    resumen += 'Todos los estudiantes ya tenían sus filas completas.';
  }

  Browser.msgBox('garantizar4LineasPorEstudiante', resumen, Browser.Buttons.OK);
  Logger.log(resumen);
}


