// ║                                                                  ║
// ║  v4.20.1 — SISTEMA DE CALENDARIO (final)                         ║
// ║                                                                  ║
// ║  Lee de APOLLO.GRUPOS en tiempo real:                            ║
// ║    DIAS, HORA_INI, HORA_FIN (curso)                              ║
// ║    DIAS_ICAN, HORA_INI_ICAN, HORA_FIN_ICAN (ICAN, solo INA)      ║
// ║  Lee de APOLLO.DETALLE DEL PROGRAMA + DETALLE DEL ICAN.          ║
// ║  Lee de APOLLO.FERIADOS (TODOS + columna por grupo).             ║
// ║                                                                  ║
// ║  TIPO_LECCION: TEORICA | PRACTICA | ICAN | LIBRE                 ║
// ║                                                                  ║
// ║  Funciones expuestas:                                            ║
// ║    crearHojaFeriados()              — crea/sincroniza FERIADOS   ║
// ║    leerFeriadosDelGrupo(cod_grupo)  — Map fecha → descripción    ║
// ║    simularCalendarioGrupo(g [,niv]) — Logger, no escribe         ║
// ║    regenerarCalendarioGrupo(g)      — WIPE TOTAL + repoblado     ║
// ║    regenerarCalendarioTodos()       — batch sobre APOLLO.GRUPOS  ║
// ║                                                                  ║
// ║  Wipe TOTAL: borra TODAS las filas del grupo. NO conserva        ║
// ║  CERRADAS/CALCULADAS (Leonardo confirmó que las actuales son     ║
// ║  basura). La inmunidad se aplicará a futuro desde Fase 2.        ║
// ║                                                                  ║
// ════════════════════════════════════════════════════════════════════


// ── Constantes del sistema de calendario ────────────────────────────
var SH_FERIADOS = 'FERIADOS';

// Días de la semana: 0=Dom 1=Lun 2=Mar 3=Mié 4=Jue 5=Vie 6=Sáb
var _DIAS_NOMBRE = ['DOM','LUN','MAR','MIE','JUE','VIE','SAB'];

// Mapeo carácter de día → número de día semana
var _CHAR_A_DIA = {
  'L': 1, // Lunes
  'M': 3, // Miércoles (M=Miércoles según la convención del proyecto)
  'K': 2, // Martes (K=Martes para evitar choque con M)
  'J': 4, // Jueves
  'V': 5, // Viernes
  'S': 6, // Sábado
  'D': 0, // Domingo
  '4': 4  // Por si llega "L4" representando "Lunes a Jueves" — se maneja aparte
};

// Niveles
var _NIVELES_ORDEN = ['B1','B2','I1','I2'];
var _NIVEL_A_DETALLE = {
  'B1':'BÁSICO I', 'B2':'BÁSICO II',
  'I1':'INTERMEDIO I', 'I2':'INTERMEDIO II'
};


// ── Utilidades de fecha ─────────────────────────────────────────────
function _calFmtFecha(d) {
  var y = d.getFullYear();
  var m = ('0' + (d.getMonth()+1)).slice(-2);
  var dd = ('0' + d.getDate()).slice(-2);
  return y + '-' + m + '-' + dd;
}

function _calAvanzar1Dia(d) {
  var n = new Date(d.getTime());
  n.setDate(n.getDate() + 1);
  return n;
}

function _calExtraerCodigoDias(codGrupo) {
  // B1-LM69-C3-0125 → LM-69
  // B1-SA94-C1-0326 → SA-94
  // B1-L469-B1-0226 → L4-69
  var partes = String(codGrupo).split('-');
  if (partes.length < 2) return null;
  var seg = partes[1];
  if (seg.length < 4) return null;
  return seg.substring(0,2) + '-' + seg.substring(2);
}


// ── Parseo de horas de Sheets ───────────────────────────────────────
// Apps Script devuelve las celdas tipo hora como Date en 1899-12-30.
// Extraemos solo la parte H:MM.
function _parseHora(v) {
  if (v instanceof Date) {
    return v.getHours() * 60 + v.getMinutes(); // minutos desde medianoche
  }
  if (typeof v === 'string') {
    var s = v.trim();
    if (!s || s === 'NO' || s === 'no') return null;
    // Formato "18:00" o "8:00"
    var m = s.match(/^(\d{1,2}):(\d{2})/);
    if (m) return parseInt(m[1],10) * 60 + parseInt(m[2],10);
    // Fecha tipo "1899-12-31" sin hora → vacío
    if (s.indexOf('1899') === 0) return null;
  }
  return null;
}

function _minutosAHora(min) {
  var h = Math.floor(min / 60);
  var m = min % 60;
  return ('0'+h).slice(-2) + ':' + ('0'+m).slice(-2);
}


// ── Parseo de DIAS / DIAS_ICAN ──────────────────────────────────────
// Convierte un string como "LM", "KJ", "LJ"(=Lun-Jue), "L4", "SA", "V", "S"
// en un array ordenado de números de día semana.
function _parseDias(diasStr) {
  if (!diasStr) return [];
  var s = String(diasStr).trim().toUpperCase();
  if (s === 'NO' || s === '') return [];

  // Casos especiales — códigos de "rango contiguo de días"
  if (s === 'LJ' || s === 'L4') {
    // SUPER_INTENSIVO Lun-Mar-Mié-Jue (4 días seguidos)
    return [1, 2, 3, 4];
  }

  // Otros casos: cada carácter es un día
  var dias = [];
  for (var i = 0; i < s.length; i++) {
    var d = _CHAR_A_DIA[s[i]];
    if (d !== undefined && dias.indexOf(d) === -1) dias.push(d);
  }
  dias.sort(function(a,b){ return a-b; });
  return dias;
}


// ── Lectura de fila de grupo+nivel desde APOLLO.GRUPOS ──────────────
function _leerFilaGrupoNivel(ssApollo, cod_grupo, nivel) {
  var ws = ssApollo.getSheetByName(SH.GRUPOS);
  var dat = ws.getDataRange().getValues();
  var H = dat[0];

  var iCod   = H.indexOf('CODIGO_GRUPO');
  var iNiv   = H.indexOf('NIVEL_INICIO');
  var iPrg   = H.indexOf('PROGRAMA');
  var iFI    = H.indexOf('FECHA_INICIO');
  var iMod   = H.indexOf('MODALIDAD');
  var iDias  = H.indexOf('DIAS');
  var iHI    = H.indexOf('HORA_INI');
  var iHF    = H.indexOf('HORA_FIN');
  var iDoc   = H.indexOf('DOCENTE');
  var iDIcan = H.indexOf('DIAS_ICAN');
  var iHIIcan= H.indexOf('HORA_INI_ICAN');
  var iHFIcan= H.indexOf('HORA_FIN_ICAN');

  for (var i = 1; i < dat.length; i++) {
    if (String(dat[i][iCod] || '').trim() !== cod_grupo) continue;
    if (String(dat[i][iNiv] || '').trim() !== nivel) continue;
    return {
      programa:    String(dat[i][iPrg] || '').trim(),
      modalidad:   String(dat[i][iMod] || '').trim(),
      docente:     String(dat[i][iDoc] || '').trim(),
      fechaInicio: dat[i][iFI],
      diasCurso:   _parseDias(dat[i][iDias]),
      horaIni:     _parseHora(dat[i][iHI]),
      horaFin:     _parseHora(dat[i][iHF]),
      diasIcan:    iDIcan  !== -1 ? _parseDias(dat[i][iDIcan]) : [],
      horaIniIcan: iHIIcan !== -1 ? _parseHora(dat[i][iHIIcan]) : null,
      horaFinIcan: iHFIcan !== -1 ? _parseHora(dat[i][iHFIcan]) : null,
    };
  }
  return null;
}


// ── Cálculo de bloques de un día de clase ───────────────────────────
// Dado HORA_INI y HORA_FIN del curso (en minutos desde medianoche),
// y el código del grupo (LM-94 vs LM-69), determina los bloques que
// caen ESE DÍA. Cada bloque es UNA lección.
//
// Convención del proyecto:
//   - Código termina en "94" → doble bloque (mañana 9-12 + tarde 13-16),
//     con 1h de almuerzo entremedio (12-13).
//   - Código termina en "69" → un solo bloque (típicamente 18-21 o 6-9pm).
function _bloquesDelDia(codGrupo, horaIniMin, horaFinMin) {
  var cd = _calExtraerCodigoDias(codGrupo) || '';
  var sufijo = cd.split('-')[1] || '';

  if (sufijo === '94') {
    // Doble bloque: 1h de almuerzo en medio.
    // Si rango total = 9-16 (7h), bloques 9-12 y 13-16 (3h cada uno).
    // Si rango total = 8-14 (6h), bloques 8-11 y 12-14 (3h+2h).
    // Algoritmo: 1er bloque = 3h desde horaIni; almuerzo 1h; 2do bloque resto.
    var b1Ini = horaIniMin;
    var b1Fin = horaIniMin + 180; // 3h
    var b2Ini = b1Fin + 60;        // +1h almuerzo
    var b2Fin = horaFinMin;
    if (b2Fin <= b2Ini) {
      // Si las horas no alcanzan para 2 bloques, devolver solo 1 con turno único
      return [{ ini: horaIniMin, fin: horaFinMin, turno: 'completo' }];
    }
    return [
      { ini: b1Ini, fin: b1Fin, turno: 'mañana' },
      { ini: b2Ini, fin: b2Fin, turno: 'tarde' }
    ];
  }

  // sufijo "69" o cualquier otro → un solo bloque
  var turno;
  if (horaIniMin < 12*60) turno = 'mañana';
  else if (horaIniMin < 17*60) turno = 'tarde';
  else turno = 'noche';

  return [{ ini: horaIniMin, fin: horaFinMin, turno: turno }];
}


// ════════════════════════════════════════════════════════════════════
// crearHojaFeriados()
// Crea la hoja FERIADOS en APOLLO si no existe, con headers y semilla
// 2025-2027. Si ya existe, sincroniza las columnas de grupo con
// APOLLO.GRUPOS (agrega columnas para grupos nuevos, no borra columnas
// de grupos eliminados).
// ════════════════════════════════════════════════════════════════════
function crearHojaFeriados() {
  var ss = SpreadsheetApp.openById(SHEET_ID);

  var wsG = ss.getSheetByName(SH.GRUPOS);
  if (!wsG) return { ok:false, error:'APOLLO.GRUPOS no existe' };
  var datG = wsG.getDataRange().getValues();
  var hG   = datG[0];
  var iGCod = hG.indexOf('CODIGO_GRUPO');
  if (iGCod === -1) return { ok:false, error:'GRUPOS sin columna CODIGO_GRUPO' };

  var gruposActivosSet = {};
  for (var i = 1; i < datG.length; i++) {
    var cod = String(datG[i][iGCod] || '').trim();
    if (cod) gruposActivosSet[cod] = true;
  }
  var gruposActivos = Object.keys(gruposActivosSet).sort();

  var ws = ss.getSheetByName(SH_FERIADOS);
  var creada = false;
  if (!ws) {
    ws = ss.insertSheet(SH_FERIADOS);
    creada = true;
  }

  if (creada || ws.getLastRow() === 0) {
    var headers = ['FECHA','DESCRIPCION','TIPO','TODOS'].concat(gruposActivos);
    var semilla = [
      // 2025
      ['2025-01-01','Año Nuevo','NACIONAL'],
      ['2025-04-14','Juan Santamaría (traslado lunes)','NACIONAL'],
      ['2025-04-17','Jueves Santo','NACIONAL'],
      ['2025-04-18','Viernes Santo','NACIONAL'],
      ['2025-05-01','Día del Trabajador','NACIONAL'],
      ['2025-07-28','Anexión Guanacaste (traslado lunes)','NACIONAL'],
      ['2025-08-02','Virgen de los Ángeles','NACIONAL'],
      ['2025-08-15','Día de la Madre','NACIONAL'],
      ['2025-09-01','Persona Negra y Cultura Afro (traslado)','NACIONAL'],
      ['2025-09-15','Independencia','NACIONAL'],
      ['2025-12-01','Abolición del Ejército','NACIONAL'],
      ['2025-12-25','Navidad','NACIONAL'],
      // 2026
      ['2026-01-01','Año Nuevo','NACIONAL'],
      ['2026-04-02','Jueves Santo','NACIONAL'],
      ['2026-04-03','Viernes Santo','NACIONAL'],
      ['2026-04-13','Juan Santamaría (traslado lunes)','NACIONAL'],
      ['2026-05-01','Día del Trabajador','NACIONAL'],
      ['2026-07-27','Anexión Guanacaste (traslado lunes)','NACIONAL'],
      ['2026-08-02','Virgen de los Ángeles (domingo)','NACIONAL'],
      ['2026-08-17','Día de la Madre (traslado lunes)','NACIONAL'],
      ['2026-09-14','Persona Negra y Cultura Afro (traslado)','NACIONAL'],
      ['2026-09-15','Independencia','NACIONAL'],
      ['2026-12-01','Abolición del Ejército','NACIONAL'],
      ['2026-12-25','Navidad','NACIONAL'],
      // 2027
      ['2027-01-01','Año Nuevo','NACIONAL'],
      ['2027-03-25','Jueves Santo','NACIONAL'],
      ['2027-03-26','Viernes Santo','NACIONAL'],
      ['2027-04-12','Juan Santamaría (traslado lunes)','NACIONAL'],
      ['2027-05-01','Día del Trabajador','NACIONAL'],
      ['2027-07-26','Anexión Guanacaste (traslado lunes)','NACIONAL'],
      ['2027-08-02','Virgen de los Ángeles','NACIONAL'],
      ['2027-08-16','Día de la Madre (traslado lunes)','NACIONAL'],
      ['2027-09-13','Persona Negra y Cultura Afro (traslado)','NACIONAL'],
      ['2027-09-15','Independencia','NACIONAL'],
      ['2027-12-01','Abolición del Ejército','NACIONAL'],
      ['2027-12-25','Navidad','NACIONAL'],
    ];
    var filas = semilla.map(function(s) {
      var fila = [s[0], s[1], s[2], true];
      for (var k = 0; k < gruposActivos.length; k++) fila.push(false);
      return fila;
    });
    var todo = [headers].concat(filas);
    ws.getRange(1, 1, todo.length, headers.length).setValues(todo);
    ws.setFrozenRows(1);
    ws.getRange(1, 1, 1, headers.length).setFontWeight('bold');
    return {
      ok: true, creada: true, filas: filas.length, grupos: gruposActivos.length,
      mensaje: 'FERIADOS creada: ' + filas.length + ' feriados, ' + gruposActivos.length + ' grupos'
    };
  }

  // Ya existe — sincronizar columnas de grupo nuevas
  var lastCol = ws.getLastColumn();
  var headersActuales = ws.getRange(1, 1, 1, lastCol).getValues()[0];
  var existentes = {};
  headersActuales.forEach(function(h) { existentes[String(h).trim()] = true; });
  var aAgregar = gruposActivos.filter(function(g) { return !existentes[g]; });

  if (aAgregar.length > 0) {
    var startCol = lastCol + 1;
    ws.getRange(1, startCol, 1, aAgregar.length).setValues([aAgregar]).setFontWeight('bold');
    var nFilas = ws.getLastRow() - 1;
    if (nFilas > 0) {
      var matrizFalse = [];
      for (var r = 0; r < nFilas; r++) {
        var row = [];
        for (var c = 0; c < aAgregar.length; c++) row.push(false);
        matrizFalse.push(row);
      }
      ws.getRange(2, startCol, nFilas, aAgregar.length).setValues(matrizFalse);
