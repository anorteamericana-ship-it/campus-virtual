  if (weight === '') weight = _examSafeNumber_(attempt && attempt.WEIGHT_PERCENT, '');
  if (weight === '') weight = 5;
  var weighted = '';
  if (final100 !== '') weighted = Math.round((Number(final100) * Number(weight) / 100) * 100) / 100;
  return { FINAL_SCORE_100: final100, WEIGHT_PERCENT: weight, WEIGHTED_SCORE: weighted };
}

