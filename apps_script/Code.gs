function _ccF85_aplicacionSolicitud_(solicitudId) {
  solicitudId = String(solicitudId || '').trim();
  if (!solicitudId) return null;
  try {
    var ssOp = SpreadsheetApp.openById(OPERATIVO_ID);
    var ws = ssOp.getSheetByName(SH_CALENDARIO);
    if (!ws || ws.getLastRow() < 2) return null;
    var data = ws.getDataRange().getValues();
    var idx = _ccF84_idxMap_(data[0] || []);
