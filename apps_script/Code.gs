}

function resolverSolicitudSuspension(body) {
  if (!body || !body.id || !body.accion) return { ok:false, error:'Faltan: id, accion' };
  var accion = String(body.accion).toLowerCase();
  if (accion !== 'aprobar' && accion !== 'rechazar') return { ok:false, error:'accion debe ser aprobar o rechazar' };
  var lock = LockService.getScriptLock();
  try {
    lock.waitLock(30000);
    var actor = _ccF85_actor_(body, 'ADMIN');
    var ssOp = SpreadsheetApp.openById(OPERATIVO_ID);
    var ws = _hojaSolicitudes(ssOp);
    var data = ws.getDataRange().getValues();
    var h = data[0] || [];
    var i = _ccF84_idxMap_(h);
    var fila = -1, sol = null;
    for (var r = 1; r < data.length; r++) {
      if (String(data[r][i.SOLICITUD_ID] || '').trim() === String(body.id).trim()) { fila = r + 1; sol = data[r]; break; }
    }
    if (fila < 0) return { ok:false, error:'Solicitud no encontrada: ' + body.id };
    var estadoActual = _ccF85_estadoNormalizado_(sol[i.ESTADO]);
    if (estadoActual === 'APLICADA' && accion === 'aprobar') return { ok:true, id:body.id, idempotente:true, estado_final:'APLICADA', mensaje:'La solicitud ya estaba aplicada.' };
    if (estadoActual === 'RECHAZADA' && accion === 'rechazar') return { ok:true, id:body.id, idempotente:true, estado_final:'RECHAZADA', mensaje:'La solicitud ya estaba rechazada.' };
    if (estadoActual !== 'PENDIENTE') return { ok:false, error:'La solicitud ya fue resuelta (estado: ' + estadoActual + ')' };

    var tipo = _ccF84_normTipo_(sol[i.TIPO]);
    var resultado = null;
    if (accion === 'aprobar') {
      // Recuperación idempotente: si el calendario se escribió pero falló la
      // actualización de la solicitud, no repetimos el movimiento.
      resultado = _ccF85_aplicacionSolicitud_(body.id);
      if (!resultado) {
        var common = { cod_grupo:String(sol[i.COD_GRUPO] || ''), nivel:String(sol[i.NIVEL] || ''),
          leccion:Number(sol[i.LECCION_NUM]), riel:String(sol[i.RIEL] || 'curso'),
          motivo:String(sol[i.MOTIVO] || '') + ' [solicitado por ' + String(sol[i.SOLICITADO_POR] || '') + ', aprobado por ' + actor + ']',
          solicitud_id:String(body.id), _auth_session:body._auth_session, token:body.token || body.session_token, _f85_lock_held:true };
