// ── Constantes de hoja ──────────────────────────────────────────────
var SH_ASISTENCIA       = 'ASISTENCIA';
var ESTADOS_INMUTABLES  = { 'CERRADA': true, 'CALCULADA': true, 'PRE_CAMPUS': true };


// ── Helper: localizar fila del calendario ───────────────────────────
function _buscarFilaCalendario(wsCal, cod_grupo, nivel, leccion, riel) {
  // riel = 'curso' | 'ican'. Si curso → TIPO_LECCION in {TEORICA,PRACTICA}.
  // Si ican → TIPO_LECCION === 'ICAN'.
  var data = wsCal.getDataRange().getValues();
  var H = data[0];
  var iG = H.indexOf('COD_GRUPO');
  var iN = H.indexOf('NIVEL');
  var iL = H.indexOf('LECCION');
  var iK = H.indexOf('TIPO_LECCION');
  if (iG === -1 || iN === -1 || iL === -1 || iK === -1) {
    return { error: 'CALENDARIO_LECCIONES sin columnas requeridas' };
  }
  var cgStr  = String(cod_grupo).trim();
  var nivStr = String(nivel).trim().toUpperCase();
  var lecNum = Number(leccion);

  for (var r = 1; r < data.length; r++) {
    if (String(data[r][iG] || '').trim() !== cgStr) continue;
    if (String(data[r][iN] || '').trim().toUpperCase() !== nivStr) continue;
    if (Number(data[r][iL]) !== lecNum) continue;

    var tipo = String(data[r][iK] || '').trim().toUpperCase();
    var esIcan = (tipo === 'ICAN');
    var esCurso = (tipo === 'TEORICA' || tipo === 'PRACTICA' || tipo === 'EVAL_ORAL' || tipo === 'EVAL_ESCRITO');
    if (riel === 'ican' && !esIcan) continue;
    if (riel === 'curso' && !esCurso) continue;

    return { ok: true, rowIndex: r + 1, headers: H, fila: data[r], data: data };
  }
  return { error: 'Fila no encontrada para ' + cgStr + '/' + nivStr + '/lec ' + lecNum + '/riel ' + riel };
}


// ── Helper: registrar/limpiar asistencia en hoja ASISTENCIA ─────────
// Schema híbrido: respeta headers viejos lowercase que ya usan otras
// funciones del .gs (cod_grupo, leccion_num, cod_estudiante, presente,
// fecha_leccion, programa, registrado_por, timestamp) y agrega 2
// columnas nuevas al final: 'nivel' y 'riel' (para soporte de INA).
// Todas las lecturas y escrituras son POR NOMBRE de columna (indexOf),
// nunca por posición numérica.
function _hojaAsistencia(ssOp) {
  var ws = ssOp.getSheetByName(SH_ASISTENCIA);
  var HEADERS_REQUERIDOS = [
    'timestamp','cod_grupo','leccion_num','fecha_leccion',
    'cod_estudiante','presente','registrado_por','programa',
    'nivel','riel'  // nuevas para Fase 2
  ];

  if (!ws) {
    // Crear hoja con schema completo
    ws = ssOp.insertSheet(SH_ASISTENCIA);
    ws.getRange(1, 1, 1, HEADERS_REQUERIDOS.length).setValues([HEADERS_REQUERIDOS]);
    ws.setFrozenRows(1);
    ws.getRange(1, 1, 1, HEADERS_REQUERIDOS.length).setFontWeight('bold');
    return ws;
  }

  // Existe — verificar que tenga 'nivel' y 'riel'. Si no, agregarlas al final.
  var lastCol = ws.getLastColumn();
  var headersActuales = ws.getRange(1, 1, 1, lastCol).getValues()[0];
  var existentes = {};
  headersActuales.forEach(function(h) { existentes[String(h).trim().toLowerCase()] = true; });

  var faltantes = ['nivel','riel'].filter(function(n) { return !existentes[n]; });
  if (faltantes.length > 0) {
    var startCol = lastCol + 1;
    ws.getRange(1, startCol, 1, faltantes.length).setValues([faltantes]).setFontWeight('bold');
  }
  return ws;
}

// Obtiene un mapa de índices de columna por nombre (lowercase).
// Si una columna falta retorna -1 para esa key.
function _idxAsistencia(ws) {
  var lastCol = ws.getLastColumn();
  var headers = ws.getRange(1, 1, 1, lastCol).getValues()[0];
  var idx = {};
  headers.forEach(function(h, i) { idx[String(h).trim().toLowerCase()] = i; });
  return {
    timestamp:      idx['timestamp']      != null ? idx['timestamp']      : -1,
    cod_grupo:      idx['cod_grupo']      != null ? idx['cod_grupo']      : -1,
    leccion_num:    idx['leccion_num']    != null ? idx['leccion_num']    : -1,
    fecha_leccion:  idx['fecha_leccion']  != null ? idx['fecha_leccion']  : -1,
    cod_estudiante: idx['cod_estudiante'] != null ? idx['cod_estudiante'] : -1,
    presente:       idx['presente']       != null ? idx['presente']       : -1,
    registrado_por: idx['registrado_por'] != null ? idx['registrado_por'] : -1,
    programa:       idx['programa']       != null ? idx['programa']       : -1,
    nivel:          idx['nivel']          != null ? idx['nivel']          : -1,
    riel:           idx['riel']           != null ? idx['riel']           : -1,
    _ncols:         headers.length
  };
}

function _limpiarAsistenciaLeccion(ssOp, cod_grupo, nivel, leccion, riel) {
  var ws = _hojaAsistencia(ssOp);
  if (ws.getLastRow() < 2) return 0;

  var idx = _idxAsistencia(ws);
  var data = ws.getDataRange().getValues();
  var conservadas = [data[0]];
  var borradas = 0;

  for (var r = 1; r < data.length; r++) {
    var mismaLec = (
      String(data[r][idx.cod_grupo]      || '').trim() === cod_grupo &&
      Number(data[r][idx.leccion_num])                  === Number(leccion) &&
      String(data[r][idx.nivel]          || '').trim().toUpperCase() === String(nivel).toUpperCase() &&
      String(data[r][idx.riel]           || '').trim().toLowerCase() === String(riel).toLowerCase()
    );
    if (mismaLec) borradas++;
    else conservadas.push(data[r]);
  }

  if (borradas > 0) {
    ws.clear();
    ws.getRange(1, 1, conservadas.length, conservadas[0].length).setValues(conservadas);
    ws.setFrozenRows(1);
    ws.getRange(1, 1, 1, conservadas[0].length).setFontWeight('bold');
  }
  return borradas;
}


// ════════════════════════════════════════════════════════════════════
// cerrarLeccion(body)
// body: { cod_grupo, nivel, leccion, riel, docente_real, asistencias, nota_docente, registrado_por }
//   asistencias = { 'cod_est_1': true, 'cod_est_2': false, ... }
// Reglas:
//   - La fila debe estar en ESTADO=PROGRAMADA. Si ya está CERRADA o
//     CALCULADA, falla (usar reabrirLeccion primero).
//   - docente_real puede ser distinto al titular del grupo (cobertura
//     o cambio permanente que vino antes).
// ════════════════════════════════════════════════════════════════════
function cerrarLeccion(body) {
  try {
  if (!body) return { ok: false, error: 'body requerido' };
  var cod_grupo    = String(body.cod_grupo || '').trim();
  var nivel        = String(body.nivel || '').trim().toUpperCase();
  var leccion      = Number(body.leccion);
  var riel         = String(body.riel || '').trim().toLowerCase();
  var docente_real = String(body.docente_real || '').trim();
  var asistencias  = body.asistencias || {};
  var nota         = String(body.nota_docente || '');
  var registrado_por = String(body.registrado_por || docente_real);

  if (!cod_grupo || !nivel || !leccion || !riel) {
    return { ok: false, error: 'cod_grupo, nivel, leccion, riel son obligatorios' };
  }
  if (riel !== 'curso' && riel !== 'ican') {
    return { ok: false, error: 'riel debe ser "curso" o "ican"' };
  }
  if (!docente_real) {
    return { ok: false, error: 'docente_real obligatorio (quien dio la clase)' };
  }

  try {
    var ssOp = SpreadsheetApp.openById(OPERATIVO_ID);
    var wsCal = ssOp.getSheetByName(SH_CALENDARIO);
    if (!wsCal) return { ok: false, error: 'CALENDARIO_LECCIONES no existe' };

    var found = _buscarFilaCalendario(wsCal, cod_grupo, nivel, leccion, riel);
    if (found.error) return { ok: false, error: found.error };

    var H = found.headers;
    var fila = found.fila;
    var iE  = H.indexOf('ESTADO');
    var iDo = H.indexOf('DOCENTE');
    var iAR = H.indexOf('ASISTENCIA_REGISTRADA');
    var iND = H.indexOf('NOTAS_DOCENTE');

    // Validar estado actual
    var estadoActual = String(fila[iE] || '').trim().toUpperCase();
    if (ESTADOS_INMUTABLES[estadoActual]) {
      var msgEstado = (estadoActual === 'PRE_CAMPUS')
        ? 'Lección archivada como PRE_CAMPUS (anterior al go-live del campus). Solo superadmin puede reabrir.'
        : 'Lección ya está ' + estadoActual + '. Use reabrirLeccion (superadmin) si necesita modificar.';
      return { ok: false, error: msgEstado };
    }

    // Escribir cambios en la fila
    wsCal.getRange(found.rowIndex, iE + 1).setValue('CERRADA');
    wsCal.getRange(found.rowIndex, iDo + 1).setValue(docente_real);
    wsCal.getRange(found.rowIndex, iAR + 1).setValue(true);
    if (iND !== -1) wsCal.getRange(found.rowIndex, iND + 1).setValue(nota);

    // Limpiar cualquier asistencia previa de esa lección (defensivo)
    _limpiarAsistenciaLeccion(ssOp, cod_grupo, nivel, leccion, riel);

    // Escribir filas de asistencia: una por estudiante.
    // Usamos índices por nombre para respetar schema híbrido.
    var ws_asis = _hojaAsistencia(ssOp);
    var idx = _idxAsistencia(ws_asis);

    // Calcular fecha_leccion y programa de la propia fila del calendario
    var iF_cal = H.indexOf('FECHA');
    var fechaLec = (iF_cal !== -1 && found.fila[iF_cal] instanceof Date)
      ? found.fila[iF_cal]
      : '';
    // Programa: leerlo de APOLLO.GRUPOS (en tiempo real)
    var infoNivelP = null;
    try {
      var ssApolloP = SpreadsheetApp.openById(SHEET_ID);
      infoNivelP = _leerFilaGrupoNivel(ssApolloP, cod_grupo, nivel);
    } catch(eP) {}
    var programaVal = (infoNivelP && infoNivelP.programa) || '';

    var filasAsis = [];
    var ts = new Date();
    var totalPresentes = 0;
    var totalAusentes  = 0;
    Object.keys(asistencias).forEach(function(codEst) {
      var presente = !!asistencias[codEst];
      // Construir fila respetando el orden REAL del header
      var fila = new Array(idx._ncols);
      for (var c = 0; c < idx._ncols; c++) fila[c] = '';
      if (idx.timestamp      !== -1) fila[idx.timestamp]      = ts;
      if (idx.cod_grupo      !== -1) fila[idx.cod_grupo]      = cod_grupo;
      if (idx.leccion_num    !== -1) fila[idx.leccion_num]    = leccion;
      if (idx.fecha_leccion  !== -1) fila[idx.fecha_leccion]  = fechaLec;
      if (idx.cod_estudiante !== -1) fila[idx.cod_estudiante] = String(codEst).trim();
      if (idx.presente       !== -1) fila[idx.presente]       = presente;
      if (idx.registrado_por !== -1) fila[idx.registrado_por] = registrado_por;
      if (idx.programa       !== -1) fila[idx.programa]       = programaVal;
      if (idx.nivel          !== -1) fila[idx.nivel]          = nivel;
      if (idx.riel           !== -1) fila[idx.riel]           = riel;
      filasAsis.push(fila);
      if (presente) totalPresentes++; else totalAusentes++;
    });
    if (filasAsis.length > 0) {
      var start = ws_asis.getLastRow() + 1;
      ws_asis.getRange(start, 1, filasAsis.length, idx._ncols).setValues(filasAsis);
    }

    return {
      ok: true,
      cod_grupo: cod_grupo, nivel: nivel, leccion: leccion, riel: riel,
      docente_real: docente_real,
      asistencia: { presentes: totalPresentes, ausentes: totalAusentes, total: filasAsis.length },
      mensaje: 'Lección ' + leccion + ' de ' + nivel + ' (' + riel + ') cerrada por ' + docente_real
    };
  } catch (e) {
    return { ok: false, error: e.toString() };
  }
  } catch (err) { return {ok:false, error:String(err)}; }
}


// ════════════════════════════════════════════════════════════════════
// reabrirLeccion(body) — SOLO SUPERADMIN
// body: { cod_grupo, nivel, leccion, riel, usuario_solicitante }
// Reglas:
//   - usuario_solicitante debe coincidir con SUPERADMIN_CEDULA en el .gs
//     (validación ya existente en otros endpoints).
//   - Revierte ESTADO a PROGRAMADA. Limpia asistencia. Restaura DOCENTE
//     al titular actual del riel según APOLLO.GRUPOS.
// ════════════════════════════════════════════════════════════════════
function _reabrirLeccionCore_(body) {
  if (!body) return { ok: false, error: 'body requerido' };
  var cod_grupo = String(body.cod_grupo || '').trim();
  var nivel     = String(body.nivel || '').trim().toUpperCase();
  var leccion   = Number(body.leccion);
  var riel      = String(body.riel || '').trim().toLowerCase();

  if (!cod_grupo || !nivel || !leccion || !riel) {
    return { ok: false, error: 'cod_grupo, nivel, leccion, riel obligatorios' };
  }
  if (riel !== 'curso' && riel !== 'ican') {
    return { ok: false, error: 'riel debe ser "curso" o "ican"' };
  }

  try {
    var ssApollo = SpreadsheetApp.openById(SHEET_ID);
    var ssOp     = SpreadsheetApp.openById(OPERATIVO_ID);
    var wsCal    = ssOp.getSheetByName(SH_CALENDARIO);
    if (!wsCal) return { ok: false, error: 'CALENDARIO_LECCIONES no existe' };

    var found = _buscarFilaCalendario(wsCal, cod_grupo, nivel, leccion, riel);
    if (found.error) return { ok: false, error: found.error };

    var H = found.headers;
    var fila = found.fila;
    var iE  = H.indexOf('ESTADO');
    var iDo = H.indexOf('DOCENTE');
    var iAR = H.indexOf('ASISTENCIA_REGISTRADA');
    var iND = H.indexOf('NOTAS_DOCENTE');

    var estadoActual = String(fila[iE] || '').trim().toUpperCase();
    if (!ESTADOS_INMUTABLES[estadoActual]) {
      return { ok: false, error: 'Lección no está en estado inmutable (estado actual: ' + estadoActual + '). Solo se pueden reabrir CERRADA, CALCULADA o PRE_CAMPUS.' };
    }
    var venia_de_pre_campus = (estadoActual === 'PRE_CAMPUS');

    // Restaurar docente titular del riel
    var infoNivel = _leerFilaGrupoNivel(ssApollo, cod_grupo, nivel);
    var docenteTitular = '';
    if (infoNivel) {
      // Releer columna específica
      var wsG = ssApollo.getSheetByName(SH.GRUPOS);
      var datG = wsG.getDataRange().getValues();
      var hG = datG[0];
      var iCod = hG.indexOf('CODIGO_GRUPO');
      var iNivG = hG.indexOf('NIVEL_INICIO');
      var iDoc  = hG.indexOf('DOCENTE');
      var iDIcan= hG.indexOf('DOCENTE_ICAN');
      for (var i = 1; i < datG.length; i++) {
        if (String(datG[i][iCod] || '').trim() !== cod_grupo) continue;
        if (String(datG[i][iNivG] || '').trim().toUpperCase() !== nivel) continue;
        docenteTitular = (riel === 'ican' && iDIcan !== -1)
          ? String(datG[i][iDIcan] || '').trim()
          : String(datG[i][iDoc] || '').trim();
        break;
      }
    }

    wsCal.getRange(found.rowIndex, iE + 1).setValue('PROGRAMADA');
    wsCal.getRange(found.rowIndex, iAR + 1).setValue(false);
    if (iND !== -1) wsCal.getRange(found.rowIndex, iND + 1).setValue('');
    if (docenteTitular) {
      wsCal.getRange(found.rowIndex, iDo + 1).setValue(docenteTitular);
    }

    // Limpiar asistencia
    var borradas = _limpiarAsistenciaLeccion(ssOp, cod_grupo, nivel, leccion, riel);

    return {
      ok: true,
      cod_grupo: cod_grupo, nivel: nivel, leccion: leccion, riel: riel,
      docente_restaurado: docenteTitular || '(sin titular en APOLLO)',
      asistencias_borradas: borradas,
      venia_de_pre_campus: venia_de_pre_campus,
      mensaje: 'Lección reabierta desde ' + estadoActual + '. Estado: PROGRAMADA. ' + borradas + ' asistencias eliminadas.'
    };
  } catch (e) {
    return { ok: false, error: e.toString() };
  }
}


function reabrirLeccion(body) {
  body = body || {};
  var ses = _ccF85_sesion_(body);
  var rol = ses ? String(ses.rol || '').trim().toLowerCase() : '';
  if (rol !== 'superadmin') return { ok:false, error:'Operación restringida a superadmin con sesión válida.' };
  return _reabrirLeccionCore_(body);
}



// ════════════════════════════════════════════════════════════════════
// asignarCoberturaLeccion(body)
// body: { cod_grupo, nivel, leccion, riel, docente_cobertura }
// Cambia DOCENTE de UNA fila PROGRAMADA. No toca APOLLO.GRUPOS ni
// otras filas. Si la fila ya está CERRADA, falla.
// ════════════════════════════════════════════════════════════════════
function asignarCoberturaLeccion(body) {
  if (!body) return { ok: false, error: 'body requerido' };
  var cod_grupo = String(body.cod_grupo || '').trim();
  var nivel     = String(body.nivel || '').trim().toUpperCase();
  var riel      = String(body.riel || '').trim().toLowerCase();
  var doc_cob   = String(body.docente_cobertura || '').trim();
  var motivo    = String(body.motivo || '').trim();
  var registrado_por = String(body.registrado_por || '').trim();

  // Puntual: leccion. Rango: leccion_desde + leccion_hasta.
  var leccion      = body.leccion != null ? Number(body.leccion) : null;
  var leccionDesde = body.leccion_desde != null ? Number(body.leccion_desde) : null;
  var leccionHasta = body.leccion_hasta != null ? Number(body.leccion_hasta) : null;

  if (!cod_grupo || !nivel || !riel || !doc_cob) {
    return { ok: false, error: 'cod_grupo, nivel, riel, docente_cobertura obligatorios' };
  }
  if (riel !== 'curso' && riel !== 'ican') {
    return { ok: false, error: 'riel debe ser "curso" o "ican"' };
  }

  // Rango de lecciones
  var desde, hasta;
  if (leccion != null && !isNaN(leccion)) {
    desde = leccion; hasta = leccion;
  } else if (leccionDesde != null && leccionHasta != null) {
    desde = leccionDesde; hasta = leccionHasta;
  } else {
    return { ok: false, error: 'Indicá leccion (puntual) o leccion_desde+leccion_hasta (rango)' };
  }
  if (desde > hasta) { var t = desde; desde = hasta; hasta = t; }

  try {
    var ssOp = SpreadsheetApp.openById(OPERATIVO_ID);
    var wsCal = ssOp.getSheetByName(SH_CALENDARIO);
    if (!wsCal) return { ok: false, error: 'CALENDARIO_LECCIONES no existe' };

    var data = wsCal.getDataRange().getValues();
    var H = data[0];
    var iG = H.indexOf('COD_GRUPO');
    var iN = H.indexOf('NIVEL');
    var iL = H.indexOf('LECCION');
    var iK = H.indexOf('TIPO_LECCION');
    var iE = H.indexOf('ESTADO');
    var iDo= H.indexOf('DOCENTE');

    function esRielFila(tipo) {
      var t = String(tipo || '').trim().toUpperCase();
      if (riel === 'ican') return t === 'ICAN';
      return (t === 'TEORICA' || t === 'PRACTICA');
    }

    var asignadas = [];
    var saltadas = [];
    var titular = '';

    for (var r = 1; r < data.length; r++) {
      if (String(data[r][iG] || '').trim() !== cod_grupo) continue;
      if (String(data[r][iN] || '').trim().toUpperCase() !== nivel) continue;
      if (!esRielFila(data[r][iK])) continue;
      var numL = Number(data[r][iL]);
      if (numL < desde || numL > hasta) continue;

      var estado = String(data[r][iE] || '').trim().toUpperCase();
      if (ESTADOS_INMUTABLES[estado]) {
        saltadas.push({ leccion: numL, estado: estado });
        continue; // no tocar cerradas/calculadas
      }

      if (!titular) titular = String(data[r][iDo] || '').trim();
      // Modelo simple (como el Excel): la lección cubierta pasa a nombre
      // de quien la da. Al cerrarse, ya queda registrada a su nombre.
      wsCal.getRange(r + 1, iDo + 1).setValue(doc_cob);
      asignadas.push(numL);
    }

    if (asignadas.length === 0) {
      return {
        ok: false,
        error: 'No se asignó cobertura. ' +
               (saltadas.length ? 'Lecciones en rango ya cerradas: ' + saltadas.map(function(s){return s.leccion;}).join(',') : 'No se encontraron lecciones en el rango.'),
        saltadas: saltadas
      };
    }

    // Bitácora (reusa SUSPENSIONES con TIPO=COBERTURA) para tener traza
    try {
      _registrarSuspension(ssOp, {
        cod_grupo: cod_grupo, nivel: nivel,
        leccion: (desde === hasta ? desde : desde + '-' + hasta),
        riel: riel, fecha_original: '',
        motivo: 'COBERTURA: ' + doc_cob + ' cubre a ' + (titular || '—') + (motivo ? (' — ' + motivo) : ''),
        tipo: 'COBERTURA', registrado_por: registrado_por
      });
    } catch (eBit) { /* la bitácora es secundaria, no bloquea */ }

    return {
      ok: true,
      cod_grupo: cod_grupo, nivel: nivel, riel: riel,
      docente_anterior: titular,
      docente_cobertura: doc_cob,
      lecciones_cubiertas: asignadas,
      total_cubiertas: asignadas.length,
      saltadas: saltadas,
      mensaje: 'Cobertura asignada a ' + doc_cob + ' en ' + asignadas.length +
               ' lección(es) [' + asignadas.join(',') + '] de ' + nivel +
               (saltadas.length ? '. Saltadas (cerradas): ' + saltadas.map(function(s){return s.leccion;}).join(',') : '') + '.'
    };
  } catch (e) {
    return { ok: false, error: e.toString() };
  }
}


// ════════════════════════════════════════════════════════════════════
// cambiarDocenteGrupo(body)
// body: { cod_grupo, nivel, riel, docente_nuevo, desde_leccion }
// Reglas:
//   - Actualiza APOLLO.GRUPOS columna DOCENTE o DOCENTE_ICAN según riel,
//     para la fila del nivel especificado.
//   - Actualiza CALENDARIO_LECCIONES en filas PROGRAMADAS del grupo/nivel/riel
//     con LECCION >= desde_leccion. NO toca CERRADAS/CALCULADAS.
//   - Si desde_leccion no se especifica, asume 1 (cambio desde el inicio
//     del nivel, pero respetando las cerradas).
// ════════════════════════════════════════════════════════════════════
function cambiarDocenteGrupo(body) {
  if (!body) return { ok: false, error: 'body requerido' };
  var cod_grupo = String(body.cod_grupo || '').trim();
  var nivel     = String(body.nivel || '').trim().toUpperCase();
  var riel      = String(body.riel || '').trim().toLowerCase();
  var doc_nuevo = String(body.docente_nuevo || '').trim();
  var desde_lec = Number(body.desde_leccion) || 1;

  if (!cod_grupo || !nivel || !riel || !doc_nuevo) {
    return { ok: false, error: 'cod_grupo, nivel, riel, docente_nuevo obligatorios' };
  }
  if (riel !== 'curso' && riel !== 'ican') {
    return { ok: false, error: 'riel debe ser "curso" o "ican"' };
  }

  try {
    var ssApollo = SpreadsheetApp.openById(SHEET_ID);
    var ssOp     = SpreadsheetApp.openById(OPERATIVO_ID);

    // 1. Actualizar APOLLO.GRUPOS (titular del riel para ese nivel)
    var wsG = ssApollo.getSheetByName(SH.GRUPOS);
    var datG = wsG.getDataRange().getValues();
    var hG = datG[0];
    var iCod = hG.indexOf('CODIGO_GRUPO');
    var iNivG = hG.indexOf('NIVEL_INICIO');
    var iDoc  = hG.indexOf('DOCENTE');
    var iDIcan= hG.indexOf('DOCENTE_ICAN');

    var colAUpdate = (riel === 'ican') ? iDIcan : iDoc;
    if (colAUpdate === -1) {
      return { ok: false, error: 'Columna ' + (riel === 'ican' ? 'DOCENTE_ICAN' : 'DOCENTE') + ' no existe en GRUPOS' };
    }

    var filaApollo = -1;
    var docenteAnteriorApollo = '';
    for (var i = 1; i < datG.length; i++) {
      if (String(datG[i][iCod] || '').trim() !== cod_grupo) continue;
      if (String(datG[i][iNivG] || '').trim().toUpperCase() !== nivel) continue;
      filaApollo = i + 1;
      docenteAnteriorApollo = String(datG[i][colAUpdate] || '').trim();
      break;
    }
    if (filaApollo === -1) {
      return { ok: false, error: 'No se encontró fila para ' + cod_grupo + ' nivel ' + nivel + ' en APOLLO.GRUPOS' };
    }

    wsG.getRange(filaApollo, colAUpdate + 1).setValue(doc_nuevo);

    // 2. Actualizar CALENDARIO_LECCIONES — solo PROGRAMADAS desde desde_lec
    var wsCal = ssOp.getSheetByName(SH_CALENDARIO);
    if (!wsCal) return { ok: true, mensaje: 'APOLLO actualizado, pero CALENDARIO_LECCIONES no existe', filas_calendario_tocadas: 0 };

    var datC = wsCal.getDataRange().getValues();
    var hC = datC[0];
    var icG = hC.indexOf('COD_GRUPO');
    var icN = hC.indexOf('NIVEL');
    var icL = hC.indexOf('LECCION');
    var icK = hC.indexOf('TIPO_LECCION');
    var icE = hC.indexOf('ESTADO');
    var icDo= hC.indexOf('DOCENTE');

    var tocadas = 0;
    var saltadas_cerradas = 0;
    for (var r = 1; r < datC.length; r++) {
      if (String(datC[r][icG] || '').trim() !== cod_grupo) continue;
      if (String(datC[r][icN] || '').trim().toUpperCase() !== nivel) continue;
      if (Number(datC[r][icL]) < desde_lec) continue;

      var tipo = String(datC[r][icK] || '').trim().toUpperCase();
      var esIcan = (tipo === 'ICAN');
      var esCurso = (tipo === 'TEORICA' || tipo === 'PRACTICA');
      if (riel === 'ican'  && !esIcan)  continue;
      if (riel === 'curso' && !esCurso) continue;

      var estado = String(datC[r][icE] || '').trim().toUpperCase();
      if (ESTADOS_INMUTABLES[estado]) {
        saltadas_cerradas++;
        continue; // dato duro — no se toca
      }

      wsCal.getRange(r + 1, icDo + 1).setValue(doc_nuevo);
      tocadas++;
    }

    return {
      ok: true,
      cod_grupo: cod_grupo, nivel: nivel, riel: riel,
      docente_anterior_apollo: docenteAnteriorApollo,
      docente_nuevo: doc_nuevo,
      desde_leccion: desde_lec,
      filas_calendario_tocadas: tocadas,
      filas_cerradas_conservadas: saltadas_cerradas,
      mensaje: 'Docente del riel ' + riel + ' actualizado en APOLLO + ' + tocadas + ' lecciones PROGRAMADAS desde lec ' + desde_lec + '. ' + saltadas_cerradas + ' cerradas conservaron su docente histórico.'
    };
  } catch (e) {
    return { ok: false, error: e.toString() };
  }
}


// ════════════════════════════════════════════════════════════════════
// getCalendarioDocente(cod_docente)
// Devuelve las lecciones donde aparece este docente:
//   - como_titular: filas PROGRAMADAS donde DOCENTE === cod_docente
//   - cerradas_historicas: filas CERRADAS/CALCULADAS donde DOCENTE === cod_docente
// El frontend distingue por estado: PROGRAMADA es editable; CERRADA es read-only.
// La "cobertura" no necesita campo aparte — es simplemente una fila
// PROGRAMADA cuyo DOCENTE difiere del titular del grupo en APOLLO.
// ════════════════════════════════════════════════════════════════════
function getCalendarioDocente(cod_docente) {
  if (!cod_docente) return { ok: false, error: 'cod_docente requerido (cédula o nombre)' };
  var input = String(cod_docente).trim();

  // Resolver: si parece cédula, busca en DOCENTES; si no, usa como nombre.
  var resuelto = _resolverDocenteFlex(input);
  var docName = resuelto.nombre;
  if (!docName) {
    return { ok: false, error: 'No se pudo resolver docente para: ' + input, detalle: resuelto.error };
  }
  var docNameNorm = _normalizarNombre(docName);

  try {
    var ssOp = SpreadsheetApp.openById(OPERATIVO_ID);
    var wsCal = ssOp.getSheetByName(SH_CALENDARIO);
    if (!wsCal) return { ok: false, error: 'CALENDARIO_LECCIONES no existe' };

    var data = wsCal.getDataRange().getValues();
    var H = data[0];
    var iG = H.indexOf('COD_GRUPO');
    var iN = H.indexOf('NIVEL');
    var iL = H.indexOf('LECCION');
    var iF = H.indexOf('FECHA');
    var iD = H.indexOf('DIA_SEMANA');
    var iT = H.indexOf('TURNO');
    var iK = H.indexOf('TIPO_LECCION');
    var iE = H.indexOf('ESTADO');
    var iDo= H.indexOf('DOCENTE');

    var programadas = [];
    var cerradas = [];
    var historico = []; // PRE_CAMPUS
    var libres = [];    // LIBRE (suspensiones visibles)

    for (var r = 1; r < data.length; r++) {
      if (_normalizarNombre(data[r][iDo]) !== docNameNorm) continue;
      var estado = String(data[r][iE] || '').trim().toUpperCase();
      var tipo = String(data[r][iK] || '').trim().toUpperCase();
      var item = {
        cod_grupo: String(data[r][iG] || '').trim(),
        nivel:     String(data[r][iN] || '').trim().toUpperCase(),
        leccion:   Number(data[r][iL]),
        fecha:     data[r][iF] instanceof Date ? _calFmtFecha(data[r][iF]) : String(data[r][iF] || ''),
        dia:       String(data[r][iD] || '').trim(),
        turno:     String(data[r][iT] || '').trim(),
        tipo:      tipo,
        riel:      (tipo === 'ICAN') ? 'ican' : 'curso',
        estado:    estado
      };
      if (estado === 'PRE_CAMPUS')                                historico.push(item);
      else if (estado === 'CERRADA' || estado === 'CALCULADA')    cerradas.push(item);
      else if (estado === 'PROGRAMADA')                           programadas.push(item);
      else if (estado === 'LIBRE')                                libres.push(item);
    }

    // Ordenar por fecha + lección
    var ordenar = function(a, b) {
      if (a.fecha < b.fecha) return -1;
      if (a.fecha > b.fecha) return 1;
      return a.leccion - b.leccion;
    };
    programadas.sort(ordenar);
    cerradas.sort(ordenar);
    historico.sort(ordenar);
    libres.sort(ordenar);

    return {
      ok: true,
      docente: docName,
      cedula: resuelto.cedula || null,
      input_original: input,
      programadas: programadas,
      cerradas: cerradas,
      historico: historico,
      libres: libres,
      total_programadas: programadas.length,
      total_cerradas: cerradas.length,
      total_historico: historico.length,
      total_libres: libres.length
    };
  } catch (e) {
    return { ok: false, error: e.toString() };
  }
}


// ════════════════════════════════════════════════════════════════════
// ║                                                                  ║
// ║  v4.21.3 — CIERRE TRANSACCIONAL + TAREAS PENDIENTES              ║
// ║                                                                  ║
// ║  cerrarLeccionCompleta(body)        — POST                       ║
// ║  getTareasPendientesDocente(doc)    — GET                        ║
// ║                                                                  ║
// ║  Lecciones con Progress Check (regla académica fija):            ║
// ║    4, 8, 13, 16, 21, 24, 28, 30                                  ║
// ║                                                                  ║
// ║  Reglas de validación (cierre):                                  ║
// ║    AUSENTE: requiere mensaje en retroalimentacion (siempre).     ║
// ║    PRESENTE en INA: requiere retroalimentacion.                  ║
// ║    PRESENTE en INA + lec PC + riel curso: requiere progress.     ║
// ║                                                                  ║
// ════════════════════════════════════════════════════════════════════


// ── Lecciones con Progress Check ────────────────────────────────────
// ════════════════════════════════════════════════════════════════════
// _normalizarNombre(s)
// Normaliza un nombre para comparación robusta:
//   - quita tildes/acentos (NFD + remueve diacríticos)
//   - convierte a mayúsculas
//   - colapsa espacios múltiples
//   - recorta espacios de borde
// Sirve para que "JOHN ALVAREZ GONZÁLEZ" == "JOHN ALVAREZ GONZALEZ".
// ════════════════════════════════════════════════════════════════════
function _normalizarNombre(s) {
  if (s === null || s === undefined) return '';
  var t = String(s);
  // Quitar diacríticos. Apps Script soporta normalize('NFD').
  try {
    t = t.normalize('NFD').replace(/[\u0300-\u036f]/g, '');
  } catch (e) {
    // Fallback manual si normalize no estuviera disponible
    t = t
      .replace(/[ÁÀÄÂÃ]/g, 'A').replace(/[áàäâã]/g, 'a')
      .replace(/[ÉÈËÊ]/g, 'E').replace(/[éèëê]/g, 'e')
      .replace(/[ÍÌÏÎ]/g, 'I').replace(/[íìïî]/g, 'i')
      .replace(/[ÓÒÖÔÕ]/g, 'O').replace(/[óòöôõ]/g, 'o')
      .replace(/[ÚÙÜÛ]/g, 'U').replace(/[úùüû]/g, 'u')
      .replace(/[Ñ]/g, 'N').replace(/[ñ]/g, 'n');
  }
  return t.toUpperCase().replace(/\s+/g, ' ').trim();
}


var LECCIONES_PROGRESS_CHECK = { 4:true, 8:true, 13:true, 16:true, 21:true, 24:true, 28:true, 30:true };


// ════════════════════════════════════════════════════════════════════
// cerrarLeccionCompleta(body)
// body: {
//   cod_grupo, nivel, leccion, riel,
//   docente_real,
//   asistencias:       { cod_est: true|false, ... },
//   retroalimentacion: { cod_est: 'texto', ... },
//   progress_check:    { cod_est: 'texto', ... },  // opcional
//   nota_docente:      'texto',
//   registrado_por:    'codigo o nombre'
// }
// ════════════════════════════════════════════════════════════════════
function cerrarLeccionCompleta(body) {
  if (!body) return { ok: false, error: 'body requerido' };

  var cod_grupo    = String(body.cod_grupo || '').trim();
  var nivel        = String(body.nivel || '').trim().toUpperCase();
  var leccion      = Number(body.leccion);
  var riel         = String(body.riel || '').trim().toLowerCase();
  var docente_real = String(body.docente_real || '').trim();
  var asistencias  = body.asistencias       || {};
  var retro        = body.retroalimentacion || {};
  var progress     = body.progress_check    || {};
  var nota         = String(body.nota_docente || '');
  var registrado_por = String(body.registrado_por || docente_real);

  // ── Validación 1: campos básicos ────────────────────────────────
  if (!cod_grupo || !nivel || !leccion || !riel || !docente_real) {
    return { ok: false, error: 'Campos obligatorios: cod_grupo, nivel, leccion, riel, docente_real' };
  }
  if (riel !== 'curso' && riel !== 'ican') {
    return { ok: false, error: 'riel debe ser "curso" o "ican"' };
  }

  // ── Validación 2: programa del grupo (necesario para reglas) ────
  var infoNivel = null;
  try {
    var ssApolloV = SpreadsheetApp.openById(SHEET_ID);
    infoNivel = _leerFilaGrupoNivel(ssApolloV, cod_grupo, nivel);
  } catch(e) {
    return { ok: false, error: 'Error leyendo APOLLO.GRUPOS: ' + e.toString() };
  }
  if (!infoNivel) {
    return { ok: false, error: 'No se encontró el grupo+nivel en APOLLO.GRUPOS' };
  }
  var esINA = (String(infoNivel.programa).trim().toUpperCase() === 'INA');

  // ── Validación 3: ausentes con mensaje obligatorio ──────────────
  var faltanMensajeAusente = [];
  var faltanRetroINA       = [];
  var faltanProgressINA    = [];
  var esLeccionPC = !!LECCIONES_PROGRESS_CHECK[leccion];
  var aplicaPC    = esINA && riel === 'curso' && esLeccionPC;

  Object.keys(asistencias).forEach(function(codEst) {
    var presente = !!asistencias[codEst];
    var msgRetro = String(retro[codEst]   || '').trim();
    var msgPC    = String(progress[codEst]|| '').trim();

    if (!presente) {
      // AUSENTE → mensaje obligatorio (todos los programas)
      if (!msgRetro) faltanMensajeAusente.push(codEst);
    } else {
      // PRESENTE
      if (esINA && !msgRetro) faltanRetroINA.push(codEst);
      if (aplicaPC && !msgPC) faltanProgressINA.push(codEst);
    }
  });

  if (faltanMensajeAusente.length > 0) {
    return {
      ok: false,
      error: 'AUSENTES sin mensaje',
      detalle: 'Cada estudiante ausente debe tener mensaje en retroalimentacion (el estudiante lo verá al abrir el campus).',
      estudiantes_faltantes: faltanMensajeAusente
    };
  }
  if (faltanRetroINA.length > 0) {
    return {
      ok: false,
      error: 'Retroalimentación obligatoria (INA)',
      detalle: 'Para grupos INA, cada estudiante presente requiere retroalimentación.',
      estudiantes_faltantes: faltanRetroINA
    };
  }
  if (faltanProgressINA.length > 0) {
    return {
      ok: false,
      error: 'Progress Check obligatorio (INA, lec ' + leccion + ')',
      detalle: 'Lecciones 4/8/13/16/21/24/28/30 en INA requieren Progress Check por estudiante presente.',
      estudiantes_faltantes: faltanProgressINA
    };
  }

  // ── Ejecutar cerrarLeccion (paso 1) ─────────────────────────────
  var r1 = cerrarLeccion({
    cod_grupo: cod_grupo, nivel: nivel, leccion: leccion, riel: riel,
    docente_real: docente_real, asistencias: asistencias,
    nota_docente: nota, registrado_por: registrado_por
  });
  if (!r1.ok) {
    return { ok: false, error: 'Falla al cerrar lección', detalle: r1.error };
  }

  // A partir de acá un fallo dispara rollback (reabrir la lección).
  var fechaLeccion = null;
  try {
    var ssOpFL = SpreadsheetApp.openById(OPERATIVO_ID);
    var wsCalFL = ssOpFL.getSheetByName(SH_CALENDARIO);
    var foundFL = _buscarFilaCalendario(wsCalFL, cod_grupo, nivel, leccion, riel);
    if (foundFL.ok) {
      var iF = foundFL.headers.indexOf('FECHA');
      fechaLeccion = (iF !== -1 && foundFL.fila[iF] instanceof Date)
        ? formatFecha(foundFL.fila[iF])
        : null;
    }
  } catch(eFL) {}

  // ── Paso 2: registrar retroalimentación ─────────────────────────
  var listaRetro = [];
  Object.keys(retro).forEach(function(codEst) {
    var txt = String(retro[codEst] || '').trim();
    if (txt) listaRetro.push({ cod_estudiante: codEst, comentario: txt });
  });

  var r2 = { ok: true, registrados: 0 };
  if (listaRetro.length > 0) {
    try {
      r2 = registrarRetroalimentacion({
        cod_grupo: cod_grupo,
        leccion_num: leccion,
        fecha_leccion: fechaLeccion || '',
        lista: listaRetro,
        registrado_por: registrado_por,
        programa: infoNivel.programa
      });
      if (!r2 || r2.error) {
        // Rollback
        var rb = _reabrirLeccionCore_({
          cod_grupo: cod_grupo, nivel: nivel, leccion: leccion, riel: riel
        });
        return {
          ok: false,
          error: 'Falla al registrar retroalimentación. Rollback: ' + (rb.ok ? 'OK' : 'FALLÓ'),
          detalle: (r2 && r2.error) || 'Sin detalle',
          rollback_ok: rb.ok
        };
      }
    } catch(e2) {
      var rbE = _reabrirLeccionCore_({
        cod_grupo: cod_grupo, nivel: nivel, leccion: leccion, riel: riel
      });
      return {
        ok: false,
        error: 'Excepción registrando retroalimentación. Rollback: ' + (rbE.ok ? 'OK' : 'FALLÓ'),
        detalle: e2.toString(),
        rollback_ok: rbE.ok
      };
    }
  }

  // ── Paso 3: registrar Progress Check (solo si aplica) ───────────
  var r3 = { ok: true, registrados: 0 };
  if (aplicaPC) {
    var listaPC = [];
    Object.keys(progress).forEach(function(codEst) {
      var txt = String(progress[codEst] || '').trim();
      if (txt) listaPC.push({ cod_estudiante: codEst, comentario: txt });
    });
    if (listaPC.length > 0) {
      try {
        // Unidades implícitas según lección PC
        var unidadesPC = {
          4:'U1-U2', 8:'U3-U4', 13:'U5-U6', 16:'U7-U8',
          21:'U9-U10', 24:'U11-U12', 28:'U13-U14', 30:'U15-U16'
        }[leccion] || '';

        r3 = registrarProgressCheck({
          cod_grupo: cod_grupo,
          leccion_num: leccion,
          unidades: unidadesPC,
          fecha_leccion: fechaLeccion || '',
          lista: listaPC,
          registrado_por: registrado_por,
          programa: infoNivel.programa
        });
        if (!r3 || r3.error) {
          var rb3 = _reabrirLeccionCore_({
            cod_grupo: cod_grupo, nivel: nivel, leccion: leccion, riel: riel
          });
          return {
            ok: false,
            error: 'Falla al registrar Progress Check. Rollback: ' + (rb3.ok ? 'OK' : 'FALLÓ'),
            detalle: (r3 && r3.error) || 'Sin detalle',
            rollback_ok: rb3.ok,
            advertencia: 'La retroalimentación SÍ se grabó. Si el rollback fue OK, también se limpió.'
          };
        }
      } catch(e3) {
        var rb3E = _reabrirLeccionCore_({
          cod_grupo: cod_grupo, nivel: nivel, leccion: leccion, riel: riel
        });
        return {
          ok: false,
          error: 'Excepción en Progress Check. Rollback: ' + (rb3E.ok ? 'OK' : 'FALLÓ'),
          detalle: e3.toString(),
          rollback_ok: rb3E.ok
        };
      }
    }
  }

  // ── Todo OK ─────────────────────────────────────────────────────
  return {
    ok: true,
    cod_grupo: cod_grupo, nivel: nivel, leccion: leccion, riel: riel,
    programa: infoNivel.programa,
    docente_real: docente_real,
    asistencia: r1.asistencia,
    retroalimentacion_registrada: r2.registrados || 0,
    progress_check_registrado: r3.registrados || 0,
    es_leccion_pc: esLeccionPC,
    aplico_pc: aplicaPC,
    mensaje: 'Lección ' + leccion + ' (' + riel + ') cerrada completa. ' +
             r1.asistencia.presentes + ' presentes, ' + r1.asistencia.ausentes + ' ausentes. ' +
             'Retroalimentación: ' + (r2.registrados || 0) + ' filas. ' +
             'Progress Check: ' + (r3.registrados || 0) + ' filas.'
  };
}


// ════════════════════════════════════════════════════════════════════
// getTareasPendientesDocente(cod_docente)
// Devuelve trabajo pendiente del docente para alimentar el banner.
// Tres categorías:
//   sin_cerrar: lecciones donde DOCENTE=cod_docente, FECHA < hoy, ESTADO=PROGRAMADA
//   sin_retro:  lecciones cerradas en grupos INA sin filas en RETROALIMENTACION
//   sin_pc:     lecciones 4/8/13/16/21/24/28/30 cerradas en grupos INA riel=curso
//               sin filas en PROGRESS_CHECK
// ════════════════════════════════════════════════════════════════════
function getTareasPendientesDocente(cod_docente) {
  if (!cod_docente) return { ok: false, error: 'cod_docente requerido (cédula o nombre)' };
  var input = String(cod_docente).trim();

  var resuelto = _resolverDocenteFlex(input);
  var docName = resuelto.nombre;
  if (!docName) {
    return { ok: false, error: 'No se pudo resolver docente para: ' + input, detalle: resuelto.error };
  }
  var docNameNorm = _normalizarNombre(docName);

  try {
    var ssApollo = SpreadsheetApp.openById(SHEET_ID);
    var ssOp     = SpreadsheetApp.openById(OPERATIVO_ID);

    // Mapa de programa por grupo (para saber si es INA)
    var wsG = ssApollo.getSheetByName(SH.GRUPOS);
    var datG = wsG.getDataRange().getValues();
    var hG = datG[0];
    var iCodG = hG.indexOf('CODIGO_GRUPO');
    var iPrgG = hG.indexOf('PROGRAMA');
    var programaPorGrupo = {};
    for (var i = 1; i < datG.length; i++) {
      var cg = String(datG[i][iCodG] || '').trim();
      if (cg) programaPorGrupo[cg] = String(datG[i][iPrgG] || '').trim().toUpperCase();
    }

    // Calendario del docente
    var wsCal = ssOp.getSheetByName(SH_CALENDARIO);
    var datC = wsCal.getDataRange().getValues();
    var H = datC[0];
    var iG = H.indexOf('COD_GRUPO');
    var iN = H.indexOf('NIVEL');
    var iL = H.indexOf('LECCION');
    var iF = H.indexOf('FECHA');
    var iK = H.indexOf('TIPO_LECCION');
    var iE = H.indexOf('ESTADO');
    var iDo = H.indexOf('DOCENTE');

    var hoy = new Date();
    hoy.setHours(0,0,0,0);

    var sinCerrar = [];
    var leccionesCerradasDelDoc = []; // para chequear retro/pc después

    for (var r = 1; r < datC.length; r++) {
      if (_normalizarNombre(datC[r][iDo]) !== docNameNorm) continue;
      var grp = String(datC[r][iG] || '').trim();
      var niv = String(datC[r][iN] || '').trim().toUpperCase();
      var lec = Number(datC[r][iL]);
      var fec = datC[r][iF];
      var tipo = String(datC[r][iK] || '').trim().toUpperCase();
      var est = String(datC[r][iE] || '').trim().toUpperCase();
      var riel = (tipo === 'ICAN') ? 'ican' : 'curso';

      if (est === 'PROGRAMADA' && fec instanceof Date && fec.getTime() < hoy.getTime()) {
        sinCerrar.push({
          cod_grupo: grp, nivel: niv, leccion: lec, riel: riel,
          fecha: _calFmtFecha(fec),
          dias_atraso: Math.floor((hoy.getTime() - fec.getTime()) / (1000*60*60*24))
        });
      }
      if (est === 'CERRADA' || est === 'CALCULADA') {
        leccionesCerradasDelDoc.push({
          cod_grupo: grp, nivel: niv, leccion: lec, riel: riel,
          fecha: fec instanceof Date ? _calFmtFecha(fec) : '',
          programa: programaPorGrupo[grp] || ''
        });
      }
    }

    // Construir sets de "ya tiene retro/pc" leyendo ambas hojas
    var sinRetro = [];
    var sinPC   = [];

    var wsR = ssOp.getSheetByName(OP.RETROALIMENTACION);
    var setRetro = {};
    if (wsR && wsR.getLastRow() > 1) {
      var datR = wsR.getDataRange().getValues();
      var hR = datR[0];
      var iRG = hR.indexOf('cod_grupo');
      var iRL = hR.indexOf('leccion_num');
      for (var rr = 1; rr < datR.length; rr++) {
        var gR = String(datR[rr][iRG] || '').trim();
        var lR = Number(datR[rr][iRL]);
        if (gR && lR) setRetro[gR + '|' + lR] = true;
      }
    }
    var wsPC = ssOp.getSheetByName(OP.PROGRESS_CHECK);
    var setPC = {};
    if (wsPC && wsPC.getLastRow() > 1) {
      var datPC = wsPC.getDataRange().getValues();
      var hPC = datPC[0];
      var iPCG = hPC.indexOf('cod_grupo');
      var iPCL = hPC.indexOf('leccion_num');
      for (var pp = 1; pp < datPC.length; pp++) {
        var gP = String(datPC[pp][iPCG] || '').trim();
        var lP = Number(datPC[pp][iPCL]);
        if (gP && lP) setPC[gP + '|' + lP] = true;
      }
    }

    leccionesCerradasDelDoc.forEach(function(it) {
      if (it.programa !== 'INA') return; // retro/pc obligatorios solo en INA
      var key = it.cod_grupo + '|' + it.leccion;
      if (!setRetro[key]) sinRetro.push(it);
      if (it.riel === 'curso' && LECCIONES_PROGRESS_CHECK[it.leccion] && !setPC[key]) {
        sinPC.push(it);
      }
    });

    // Ordenar por fecha+lección
    var ordenar = function(a, b) {
      if (a.fecha < b.fecha) return -1;
      if (a.fecha > b.fecha) return 1;
      return a.leccion - b.leccion;
    };
    sinCerrar.sort(ordenar);
    sinRetro.sort(ordenar);
    sinPC.sort(ordenar);

    return {
      ok: true,
      docente: docName,
      cedula: resuelto.cedula || null,
      sin_cerrar: sinCerrar,
      sin_retro: sinRetro,
      sin_pc: sinPC,
      totales: {
        sin_cerrar: sinCerrar.length,
        sin_retro:  sinRetro.length,
        sin_pc:     sinPC.length,
        total_pendientes: sinCerrar.length + sinRetro.length + sinPC.length
      }
    };
  } catch (e) {
    return { ok: false, error: e.toString() };
  }
}


// ════════════════════════════════════════════════════════════════════
// ║                                                                  ║
// ║  v4.21.4 — ARCHIVADO RETROACTIVO (PRE_CAMPUS)                    ║
// ║                                                                  ║
// ║  archivarLeccionesPasadas(modo, fecha_corte)                     ║
// ║                                                                  ║
// ║  Marca como PRE_CAMPUS todas las filas PROGRAMADAS con            ║
// ║  FECHA < fecha_corte. Default corte = '2026-05-18'.              ║
// ║                                                                  ║
// ║  No toca CERRADAS, CALCULADAS, ICAN, etc.                        ║
// ║  Solo PROGRAMADA pasa a PRE_CAMPUS.                              ║
// ║                                                                  ║
// ║  modo = 'dry_run'  → lista qué cambiaría, NO modifica.           ║
// ║  modo = 'ejecutar' → aplica los cambios.                         ║
// ║                                                                  ║
// ║  Se ejecuta una sola vez (manualmente desde el editor).          ║
// ║                                                                  ║
// ════════════════════════════════════════════════════════════════════

var FECHA_CORTE_CAMPUS_DEFAULT = '2026-05-18';


function archivarLeccionesPasadas(modo, fecha_corte) {
  modo = modo || 'dry_run';
  fecha_corte = fecha_corte || FECHA_CORTE_CAMPUS_DEFAULT;

  if (modo !== 'dry_run' && modo !== 'ejecutar') {
    return { ok: false, error: 'modo debe ser "dry_run" o "ejecutar"' };
  }

  // Validar fecha_corte formato YYYY-MM-DD
  if (!/^\d{4}-\d{2}-\d{2}$/.test(fecha_corte)) {
    return { ok: false, error: 'fecha_corte debe ser YYYY-MM-DD (recibido: ' + fecha_corte + ')' };
  }

  try {
    var ssOp = SpreadsheetApp.openById(OPERATIVO_ID);
    var wsCal = ssOp.getSheetByName(SH_CALENDARIO);
    if (!wsCal) return { ok: false, error: 'CALENDARIO_LECCIONES no existe' };

    var data = wsCal.getDataRange().getValues();
    var H = data[0];
    var iG = H.indexOf('COD_GRUPO');
    var iN = H.indexOf('NIVEL');
    var iL = H.indexOf('LECCION');
    var iF = H.indexOf('FECHA');
    var iK = H.indexOf('TIPO_LECCION');
    var iE = H.indexOf('ESTADO');

    if (iE === -1 || iF === -1) {
      return { ok: false, error: 'Calendario sin columnas ESTADO o FECHA' };
    }

    var corteDate = new Date(fecha_corte + 'T00:00:00');

    var aArchivar = []; // {rowIndex, cod_grupo, nivel, leccion, fecha}
    var resumenPorGrupo = {};
    var rielsResumen = { curso: 0, ican: 0 };

    for (var r = 1; r < data.length; r++) {
      var estadoActual = String(data[r][iE] || '').trim().toUpperCase();
      if (estadoActual !== 'PROGRAMADA') continue;
      var fecha = data[r][iF];
      if (!(fecha instanceof Date)) continue;
      if (fecha.getTime() >= corteDate.getTime()) continue;

      var tipo = String(data[r][iK] || '').trim().toUpperCase();
      var riel = (tipo === 'ICAN') ? 'ican' : 'curso';

      var item = {
        rowIndex: r + 1, // 1-based para setValue
        cod_grupo: String(data[r][iG] || '').trim(),
        nivel:     String(data[r][iN] || '').trim().toUpperCase(),
        leccion:   Number(data[r][iL]),
        fecha:     _calFmtFecha(fecha),
        riel:      riel
      };
      aArchivar.push(item);

      if (!resumenPorGrupo[item.cod_grupo]) {
        resumenPorGrupo[item.cod_grupo] = { curso: 0, ican: 0, total: 0, primera: item.fecha, ultima: item.fecha };
      }
      var rg = resumenPorGrupo[item.cod_grupo];
      rg[riel]++;
      rg.total++;
      if (item.fecha < rg.primera) rg.primera = item.fecha;
      if (item.fecha > rg.ultima)  rg.ultima  = item.fecha;
      rielsResumen[riel]++;
    }

    if (aArchivar.length === 0) {
      return {
        ok: true,
        modo: modo,
        fecha_corte: fecha_corte,
        filas_afectadas: 0,
        mensaje: 'No hay lecciones PROGRAMADAS con fecha < ' + fecha_corte
      };
    }

    if (modo === 'dry_run') {
      return {
        ok: true,
        modo: 'dry_run',
        fecha_corte: fecha_corte,
        filas_a_archivar: aArchivar.length,
        por_riel: rielsResumen,
        por_grupo: resumenPorGrupo,
        muestra_primeras_5: aArchivar.slice(0, 5).map(function(x) {
          return x.cod_grupo + '/' + x.nivel + '/lec ' + x.leccion + '/' + x.riel + '/' + x.fecha;
        }),
        mensaje: 'DRY RUN: se archivarían ' + aArchivar.length + ' filas. Re-ejecutar con modo="ejecutar".'
      };
    }

    // modo === 'ejecutar' — escribir PRE_CAMPUS en cada fila
    aArchivar.forEach(function(item) {
      wsCal.getRange(item.rowIndex, iE + 1).setValue('PRE_CAMPUS');
    });

    return {
      ok: true,
      modo: 'ejecutar',
      fecha_corte: fecha_corte,
      filas_archivadas: aArchivar.length,
      por_riel: rielsResumen,
      por_grupo: resumenPorGrupo,
      mensaje: aArchivar.length + ' filas marcadas como PRE_CAMPUS (' +
               Object.keys(resumenPorGrupo).length + ' grupos afectados)'
    };
  } catch (e) {
    return { ok: false, error: e.toString() };
  }
}


// ════════════════════════════════════════════════════════════════════
// ║                                                                  ║
// ║  v4.21.5 — TABLA DOCENTES + MAPEO CÉDULA → NOMBRE                ║
// ║                                                                  ║
// ║  crearHojaDOCENTES()                                              ║
// ║  extraerDocentesDeGRUPOS()                                        ║
// ║  _resolverDocentePorCedula(cedula)                                ║
// ║  _resolverDocenteFlex(input)                                      ║
// ║  getDocenteInfo(cedula)                                           ║
// ║                                                                  ║
// ║  HEADERS DOCENTES:                                                ║
// ║    CEDULA | NOMBRE_COMPLETO | EMAIL | TELEFONO | ACTIVO |        ║
// ║    FECHA_INGRESO | CERTIFICADO_INA | COLEGIATURA_VENCE | NOTAS   ║
// ║                                                                  ║
// ║  Convención:                                                      ║
// ║    - CEDULA es clave primaria (única).                            ║
// ║    - NOMBRE_COMPLETO debe coincidir EXACTAMENTE con el escrito    ║
// ║      en APOLLO.GRUPOS columnas DOCENTE y DOCENTE_ICAN.            ║
// ║    - ACTIVO: 'SI' o 'NO' (default 'SI' al crear).                 ║
// ║    - CERTIFICADO_INA: 'SI'/'NO' (relevante para grupos INA).      ║
// ║                                                                  ║
// ════════════════════════════════════════════════════════════════════

var DOCENTES_HEADERS = [
  'CEDULA', 'NOMBRE_COMPLETO', 'EMAIL', 'TELEFONO', 'ACTIVO',
  'FECHA_INGRESO', 'CERTIFICADO_INA', 'COLEGIATURA_VENCE', 'NOTAS'
];


// ════════════════════════════════════════════════════════════════════
// crearHojaDOCENTES()
// Crea la hoja DOCENTES en APOLLO con headers. Si ya existe, no toca.
// ════════════════════════════════════════════════════════════════════
function crearHojaDOCENTES() {
  try {
    var ss = SpreadsheetApp.openById(SHEET_ID);
    var ws = ss.getSheetByName(SH.DOCENTES);
    if (ws) {
      return { ok: true, mensaje: 'Hoja DOCENTES ya existía. No se modificó.', filas: ws.getLastRow() };
    }
    ws = ss.insertSheet(SH.DOCENTES);
    ws.getRange(1, 1, 1, DOCENTES_HEADERS.length).setValues([DOCENTES_HEADERS]).setFontWeight('bold');
    ws.setFrozenRows(1);
    ws.setColumnWidths(1, DOCENTES_HEADERS.length, 150);
    return { ok: true, mensaje: 'Hoja DOCENTES creada con ' + DOCENTES_HEADERS.length + ' columnas.' };
  } catch (e) {
    return { ok: false, error: e.toString() };
  }
}


// ════════════════════════════════════════════════════════════════════
// extraerDocentesDeGRUPOS()
// Lee APOLLO.GRUPOS columnas DOCENTE y DOCENTE_ICAN, recolecta los
// nombres únicos (excluyendo 'POR DEFINIR' y 'NO'), y los inserta en
// DOCENTES con CEDULA vacía + ACTIVO=SI. Si el nombre ya está en
// DOCENTES, lo salta.
// ════════════════════════════════════════════════════════════════════
function extraerDocentesDeGRUPOS() {
  try {
    var ss = SpreadsheetApp.openById(SHEET_ID);
    var wsD = ss.getSheetByName(SH.DOCENTES);
    if (!wsD) {
      return { ok: false, error: 'Hoja DOCENTES no existe. Ejecutar crearHojaDOCENTES primero.' };
    }

    // Nombres ya registrados
    var dD = wsD.getDataRange().getValues();
    var iNom = dD[0].indexOf('NOMBRE_COMPLETO');
    var yaRegistrados = {};
    for (var i = 1; i < dD.length; i++) {
      var n = String(dD[i][iNom] || '').trim().toUpperCase();
      if (n) yaRegistrados[n] = true;
    }

    // Recolectar de GRUPOS
    var wsG = ss.getSheetByName(SH.GRUPOS);
    var dG = wsG.getDataRange().getValues();
    var hG = dG[0];
    var iDoc = hG.indexOf('DOCENTE');
    var iDocI = hG.indexOf('DOCENTE_ICAN');
    var encontrados = {}; // nombre → fuentes

    for (var r = 1; r < dG.length; r++) {
      [iDoc, iDocI].forEach(function(col) {
        if (col === -1) return;
        var v = String(dG[r][col] || '').trim();
        if (!v) return;
        var vUp = v.toUpperCase();
        // Excluir valores que no son docentes reales
        if (vUp === 'POR DEFINIR' || vUp === 'NO' || vUp === 'N/A' || vUp === '-') return;
        if (!encontrados[v]) encontrados[v] = [];
        encontrados[v].push(col === iDoc ? 'curso' : 'ican');
      });
    }

    // Insertar los que faltan
    var nuevos = [];
    Object.keys(encontrados).sort().forEach(function(nombre) {
      if (yaRegistrados[nombre.toUpperCase()]) return;
      nuevos.push([
        '',                                  // CEDULA — vacío, Leonardo poblará
        nombre,                              // NOMBRE_COMPLETO
        '',                                  // EMAIL
        '',                                  // TELEFONO
        'SI',                                // ACTIVO
        '',                                  // FECHA_INGRESO
        '',                                  // CERTIFICADO_INA
        '',                                  // COLEGIATURA_VENCE
        'Auto-extraído de GRUPOS ' + new Date().toISOString().substring(0,10)
      ]);
    });

    if (nuevos.length === 0) {
      return {
        ok: true,
        nombres_encontrados: Object.keys(encontrados).length,
        insertados: 0,
        mensaje: 'Todos los nombres ya están en DOCENTES. Nada que insertar.'
      };
    }

    var start = wsD.getLastRow() + 1;
    wsD.getRange(start, 1, nuevos.length, DOCENTES_HEADERS.length).setValues(nuevos);

    return {
      ok: true,
      nombres_encontrados: Object.keys(encontrados).length,
      insertados: nuevos.length,
      nombres_insertados: nuevos.map(function(f) { return f[1]; }),
      mensaje: nuevos.length + ' docentes insertados en DOCENTES. ' +
               'CEDULA y demás campos quedaron vacíos para que los poblés.'
    };
  } catch (e) {
    return { ok: false, error: e.toString() };
  }
}


// ════════════════════════════════════════════════════════════════════
// _resolverDocentePorCedula(cedula)
// Devuelve { cedula, nombre, email, telefono, activo, certificado_ina }
// o null si la cédula no está en DOCENTES.
// ════════════════════════════════════════════════════════════════════
function _resolverDocentePorCedula(cedula) {
  if (!cedula) return null;
  var cedNorm = String(cedula).trim();
  if (!cedNorm) return null;
  try {
    var ss = SpreadsheetApp.openById(SHEET_ID);
    var ws = ss.getSheetByName(SH.DOCENTES);
    if (!ws || ws.getLastRow() < 2) return null;
    var d = ws.getDataRange().getValues();
    var h = d[0];
    var iC = h.indexOf('CEDULA');
    var iN = h.indexOf('NOMBRE_COMPLETO');
    var iE = h.indexOf('EMAIL');
    var iT = h.indexOf('TELEFONO');
    var iA = h.indexOf('ACTIVO');
    var iCI = h.indexOf('CERTIFICADO_INA');
    for (var r = 1; r < d.length; r++) {
      if (String(d[r][iC] || '').trim() === cedNorm) {
        return {
          cedula:           cedNorm,
          nombre:           String(d[r][iN] || '').trim(),
          email:            String(d[r][iE] || '').trim(),
          telefono:         String(d[r][iT] || '').trim(),
          activo:           String(d[r][iA] || '').trim().toUpperCase() === 'SI',
          certificado_ina:  String(d[r][iCI]|| '').trim().toUpperCase() === 'SI'
        };
      }
    }
    return null;
  } catch (e) {
    return null;
  }
}


// ════════════════════════════════════════════════════════════════════
// _resolverDocenteFlex(input)
// input puede ser cédula o nombre completo.
// Regla: si tiene dígitos y guiones (parece cédula), busca en DOCENTES.
// Si no, asume que es nombre y lo usa directo (compatibilidad con
// tests/llamadas viejas que pasaban nombre).
// Devuelve { nombre, cedula?, error? }
// ════════════════════════════════════════════════════════════════════
function _resolverDocenteFlex(input) {
  if (!input) return { nombre: null, error: 'input vacío' };
  var s = String(input).trim();
  if (!s) return { nombre: null, error: 'input vacío' };

  // Heurística: cédula = solo dígitos y guiones (al menos 1 dígito)
  var pareceCedula = /^[0-9\-]+$/.test(s) && /\d/.test(s);
  if (pareceCedula) {
    var info = _resolverDocentePorCedula(s);
    if (!info) {
      return { nombre: null, error: 'Cédula ' + s + ' no registrada en APOLLO.DOCENTES' };
    }
    if (!info.activo) {
      return { nombre: null, error: 'Docente ' + info.nombre + ' (' + s + ') marcado como INACTIVO' };
    }
    return { nombre: info.nombre, cedula: s };
  }

  // Asume nombre directo. Compatibilidad con código viejo.
  return { nombre: s };
}


// ════════════════════════════════════════════════════════════════════
// getDocenteInfo(cedula)
// Endpoint GET para el login del frontend.
// El frontend recibe la cédula del login, llama esto, y obtiene
// nombre + email + flags. Después usa esa cédula en los demás endpoints.
// ════════════════════════════════════════════════════════════════════
function getDocenteInfo(cedula) {
  if (!cedula) return { ok: false, error: 'cedula requerida' };
  var info = _resolverDocentePorCedula(cedula);
  if (!info) {
    return {
      ok: false,
      error: 'Cédula ' + cedula + ' no está registrada en APOLLO.DOCENTES',
      detalle: 'Pedí al superadmin que te registre.'
    };
  }
  if (!info.activo) {
    return {
      ok: false,
      error: 'Tu cuenta está marcada como INACTIVA',
      detalle: 'Contactá al superadmin.'
    };
  }
  return {
    ok: true,
    cedula: info.cedula,
    nombre: info.nombre,
    email: info.email,
    telefono: info.telefono,
    certificado_ina: info.certificado_ina
  };
}


// ════════════════════════════════════════════════════════════════════
// ║                                                                  ║
// ║  v4.21.8 — SUSPENSIÓN DE LECCIONES + CAMBIO DE INICIO DE NIVEL   ║
// ║                                                                  ║
// ║  REGLA DE ORO: las 32 lecciones SE DAN SIEMPRE. Suspender =      ║
// ║  empujar a la siguiente fecha del patrón. Nunca se salta.        ║
// ║                                                                  ║
// ║  _hojaSuspensiones(ssOp)                                          ║
// ║  _registrarSuspension(...)                                        ║
// ║  suspenderLeccion(body)            — POST                         ║
// ║  regenerarNivelGrupo(cod, nivel)   — helper (1 solo nivel)        ║
// ║  cambiarInicioNivel(body)          — POST                         ║
// ║                                                                  ║
// ════════════════════════════════════════════════════════════════════

var SH_SUSPENSIONES = 'SUSPENSIONES';

var SUSPENSIONES_HEADERS = [
  'FECHA_REGISTRO', 'COD_GRUPO', 'NIVEL', 'LECCION', 'RIEL',
  'FECHA_ORIGINAL', 'MOTIVO', 'TIPO', 'REGISTRADO_POR'
];


function _hojaSuspensiones(ssOp) {
  var ws = ssOp.getSheetByName(SH_SUSPENSIONES);
  if (!ws) {
    ws = ssOp.insertSheet(SH_SUSPENSIONES);
    ws.getRange(1, 1, 1, SUSPENSIONES_HEADERS.length).setValues([SUSPENSIONES_HEADERS]).setFontWeight('bold');
    ws.setFrozenRows(1);
  }
  return ws;
}


function _registrarSuspension(ssOp, datos) {
  // datos: { cod_grupo, nivel, leccion, riel, fecha_original, motivo, tipo, registrado_por }
  var ws = _hojaSuspensiones(ssOp);

  // La columna LECCION puede traer un número (5) o un rango ("6-8").
  // Sheets autoconvierte "6-8" a fecha (6-ago). Para evitarlo, formateamos
  // toda la columna LECCION (col 4) como texto plano antes de escribir.
  var col = 4; // FECHA_REGISTRO(1) COD_GRUPO(2) NIVEL(3) LECCION(4)
  ws.getRange(1, col, ws.getMaxRows(), 1).setNumberFormat('@');

  var leccionVal = (datos.leccion != null) ? String(datos.leccion) : '';

  ws.appendRow([
    new Date(),
    datos.cod_grupo || '',
    datos.nivel || '',
    leccionVal,
    datos.riel || '',
    datos.fecha_original || '',
    datos.motivo || '',
    datos.tipo || 'SUSPENSION',
    datos.registrado_por || ''
  ]);
}


// ════════════════════════════════════════════════════════════════════
// FLUJO DE SOLICITUD DE SUSPENSIÓN (2 pasos)               — v4.23.0
// El docente PIDE, el admin APRUEBA. Las solicitudes viven en una hoja
// SEPARADA (SOLICITUDES_SUSPENSION) para no ensuciar la bitácora INA.
// Solo al APROBAR se ejecuta suspenderLeccion (que sí escribe en
// SUSPENSIONES, la bitácora real).
//
// Hoja SOLICITUDES_SUSPENSION:
//   ID | FECHA_SOLICITUD | COD_GRUPO | NIVEL | LECCION | RIEL | MOTIVO |
//   SOLICITANTE | ESTADO | RESUELTO_POR | FECHA_RESOLUCION | NOTA_RESOLUCION
// ESTADO: PENDIENTE | APROBADA | RECHAZADA
// ════════════════════════════════════════════════════════════════════

var SH_SOLICITUDES = 'SOLICITUDES_CAMBIO_CLASE';
var SH_SOLICITUDES_LEGACY = 'SOLICITUDES_SUSPENSION';
var SOLICITUDES_HEADERS = [
  'SOLICITUD_ID','TIPO','ESTADO','COD_GRUPO','NIVEL','LECCION_NUM','RIEL',
  'FECHA_ORIGINAL','HORA_ORIGINAL_INICIO','HORA_ORIGINAL_FIN',
  'FECHA_DESTINO','HORA_DESTINO_INICIO','HORA_DESTINO_FIN',
  'MOTIVO','SOLICITADO_POR','SOLICITADO_AT','REVISADO_POR','REVISADO_AT',
  'RESPUESTA_ADMIN','APLICADO_AT','EVENTO_NUEVO_ID','EVENTO_ORIGEN_ID'
];

function _ccF84_normTipo_(v) {
  var s = String(v || 'SUSPENSION').trim().toUpperCase();
  if (s === 'REPROGRAMACION' || s === 'REPROGRAMAR' || s === 'REPROGRAMACION_EXTRAORDINARIA') {
    return 'REPROGRAMACION';
  }
  return 'SUSPENSION';
}

function _ccF84_idxMap_(h) {
  var out = {};
  (h || []).forEach(function(x, i){ out[String(x || '').trim().toUpperCase()] = i; });
  return out;
}

function _ccF84_iso_(v) {
  if (v instanceof Date) return Utilities.formatDate(v, 'America/Costa_Rica', 'yyyy-MM-dd');
  var s = String(v || '').trim();
  var m = s.match(/^(\d{4})-(\d{2})-(\d{2})/);
  if (m) return m[1] + '-' + m[2] + '-' + m[3];
  return s;
}

function _ccF84_hora_(v) {
  if (v instanceof Date) return Utilities.formatDate(v, 'America/Costa_Rica', 'HH:mm');
  var s = String(v == null ? '' : v).trim();
  var m = s.match(/(\d{1,2}):(\d{2})/);
  if (!m) return '';
  return ('0' + Number(m[1])).slice(-2) + ':' + m[2];
}

function _ccF84_horaMin_(v) {
  var s = _ccF84_hora_(v);
  if (!s) return null;
  var p = s.split(':');
  return Number(p[0]) * 60 + Number(p[1]);
}

function _ccF84_minHora_(m) {
  m = Number(m);
  if (!isFinite(m)) return '';
  return ('0' + Math.floor(m / 60)).slice(-2) + ':' + ('0' + (m % 60)).slice(-2);
}

function _ccF84_fechaHora_(iso, hhmm) {
  var fm = String(iso || '').match(/^(\d{4})-(\d{2})-(\d{2})$/);
  var hm = String(hhmm || '').match(/^(\d{2}):(\d{2})$/);
  if (!fm || !hm) return null;
  return new Date(Number(fm[1]), Number(fm[2]) - 1, Number(fm[3]), Number(hm[1]), Number(hm[2]), 0, 0);
}

function _ccF84_dia_(d) {
  var dias = ['DOM','LUN','MAR','MIE','JUE','VIE','SAB'];
  return d instanceof Date ? dias[d.getDay()] : '';
}

function _ccF84_turno_(horaMin) {
  if (horaMin < 12 * 60) return 'mañana';
  if (horaMin < 17 * 60) return 'tarde';
  return 'noche';
}

function _ccF84_ensureHeaders_(ws, headers) {
  var lastCol = Math.max(ws.getLastColumn(), 1);
  var current = ws.getRange(1, 1, 1, lastCol).getValues()[0];
  var norm = {};
  current.forEach(function(h, i){ norm[String(h || '').trim().toUpperCase()] = i; });
  var changed = false;
  headers.forEach(function(h){
    if (norm[h] == null) {
      current.push(h);
      norm[h] = current.length - 1;
      changed = true;
    }
  });
  if (changed) ws.getRange(1, 1, 1, current.length).setValues([current]).setFontWeight('bold');
  return current;
}

function _ccF84_appendObj_(ws, obj) {
  var h = ws.getRange(1, 1, 1, ws.getLastColumn()).getValues()[0];
  var row = h.map(function(k){ return obj[String(k || '').trim().toUpperCase()] != null ? obj[String(k || '').trim().toUpperCase()] : ''; });
  ws.appendRow(row);
}

function _ccF84_migrarLegacy_(ssOp, wsNuevo) {
  var legacy = ssOp.getSheetByName(SH_SOLICITUDES_LEGACY);
  if (!legacy || legacy.getLastRow() < 2) return;
  var existingData = wsNuevo.getDataRange().getValues();
  var eh = existingData[0] || [];
  var ei = _ccF84_idxMap_(eh);
  var ids = {};
  for (var x = 1; x < existingData.length; x++) ids[String(existingData[x][ei.SOLICITUD_ID] || '').trim()] = true;

  var d = legacy.getDataRange().getValues();
  var h = d[0] || [];
  var i = _ccF84_idxMap_(h);
  for (var r = 1; r < d.length; r++) {
    var id = String(d[r][i.ID] || '').trim();
    if (!id || ids[id]) continue;
    _ccF84_appendObj_(wsNuevo, {
      SOLICITUD_ID:id,
      TIPO:'SUSPENSION',
      ESTADO:(function(v){ var e=String(v || 'PENDIENTE').trim().toUpperCase(); return e === 'APROBADA' ? 'APLICADA' : (e === 'DENEGADA' ? 'RECHAZADA' : e); })(d[r][i.ESTADO]),
      COD_GRUPO:String(d[r][i.COD_GRUPO] || ''),
      NIVEL:String(d[r][i.NIVEL] || ''),
      LECCION_NUM:String(d[r][i.LECCION] || ''),
      RIEL:String(d[r][i.RIEL] || 'curso'),
      MOTIVO:String(d[r][i.MOTIVO] || ''),
      SOLICITADO_POR:String(d[r][i.SOLICITANTE] || ''),
      SOLICITADO_AT:d[r][i.FECHA_SOLICITUD] || '',
      REVISADO_POR:String(d[r][i.RESUELTO_POR] || ''),
      REVISADO_AT:d[r][i.FECHA_RESOLUCION] || '',
      RESPUESTA_ADMIN:String(d[r][i.NOTA_RESOLUCION] || '')
    });
    ids[id] = true;
  }
}

function _hojaSolicitudes(ssOp) {
  var ws = ssOp.getSheetByName(SH_SOLICITUDES);
  if (!ws) ws = ssOp.insertSheet(SH_SOLICITUDES);
  if (ws.getLastRow() === 0) {
    ws.getRange(1, 1, 1, SOLICITUDES_HEADERS.length).setValues([SOLICITUDES_HEADERS]).setFontWeight('bold');
    ws.setFrozenRows(1);
  } else {
    _ccF84_ensureHeaders_(ws, SOLICITUDES_HEADERS);
  }
  var h = ws.getRange(1, 1, 1, ws.getLastColumn()).getValues()[0];
  var idx = _ccF84_idxMap_(h);
  if (idx.LECCION_NUM != null) ws.getRange(1, idx.LECCION_NUM + 1, ws.getMaxRows(), 1).setNumberFormat('@');
  _ccF84_migrarLegacy_(ssOp, ws);
  return ws;
}

function _ccF84_catalogoGrupos_(ssApollo) {
  var ws = ssApollo.getSheetByName(SH.GRUPOS);
  var out = {};
  if (!ws) return out;
  var d = ws.getDataRange().getValues();
  var h = d[0] || [];
  var i = _ccF84_idxMap_(h);
  for (var r = 1; r < d.length; r++) {
    var cod = String(d[r][i.CODIGO_GRUPO] || '').trim();
    var niv = String(d[r][i.NIVEL_INICIO] || '').trim().toUpperCase();
    if (!cod || !niv) continue;
    var schedCode = _anF69_scheduleFromCode_(cod);
    var codeIni = _parseHora(schedCode.hora_i || '');
    var codeFin = _parseHora(schedCode.hora_f || '');
