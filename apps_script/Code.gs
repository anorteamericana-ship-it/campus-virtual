}

function _ccF84_intervaloFila_(row, idx, meta) {
  // F87: las horas regulares se derivan de GRUPOS + TURNO. Antes se confiaba
  // primero en celdas tipo hora de Sheets; al mover una suspensión esos Date
  // de 1899 se convertían con zona horaria y terminaban como 11:23/15:23.
  // Una reprogramación sí conserva su hora explícita porque puede ser especial.
  var tipo = String(row[idx.TIPO_LECCION] || '').trim().toUpperCase();
  var reprogramada = idx.REPROGRAMADA != null && _ccF85_bool_(row[idx.REPROGRAMADA]);
  var hi = idx.HORA_INICIO != null ? _ccF84_horaMin_(row[idx.HORA_INICIO]) : null;
  var hf = idx.HORA_FIN != null ? _ccF84_horaMin_(row[idx.HORA_FIN]) : null;

  if (reprogramada) {
    var desdeTraza = _ccF87_horasReprogramadasDesdeTraza_(row, idx);
    if (desdeTraza) return desdeTraza;
    if (hi != null && hf != null && hf > hi) return { ini:hi, fin:hf };
  }

  if (tipo === 'ICAN') {
    if (meta && meta.horaIniIcan != null && meta.horaFinIcan != null) return { ini:meta.horaIniIcan, fin:meta.horaFinIcan };
    if (hi != null && hf != null && hf > hi) return { ini:hi, fin:hf };
    return null;
  }

  if (meta && meta.horaIni != null && meta.horaFin != null) {
    var bloques = _bloquesDelDia(meta.cod_grupo, meta.horaIni, meta.horaFin);
    var turno = String(idx.TURNO != null ? row[idx.TURNO] : '').trim().toLowerCase();
    if (bloques.length === 1) return bloques[0];
    if (turno.indexOf('tarde') !== -1 || turno.indexOf('noche') !== -1) return bloques[1] || bloques[0];
    if (turno.indexOf('mañ') !== -1) return bloques[0];
    // En calendarios antiguos sin TURNO, la hora almacenada solo se usa para
    // escoger el bloque más cercano; nunca se copia tal cual al siguiente slot.
    if (hi != null) {
      var d0 = Math.abs(hi - bloques[0].ini);
      var d1 = Math.abs(hi - (bloques[1] || bloques[0]).ini);
      return d1 < d0 ? (bloques[1] || bloques[0]) : bloques[0];
    }
    return bloques[0];
  }

  if (hi != null && hf != null && hf > hi) return { ini:hi, fin:hf };
  return null;
}

// F87 — autocorrección de horas regulares ya dañadas por versiones anteriores.
// Conserva intactas las filas REPROGRAMADA=TRUE porque esas horas son elegidas
// deliberadamente por administración/docente.
function _ccF87_normalizarHorasGrupoNivel_(ws, data, headers, codGrupo, nivel) {
  try {
    if (!ws || !data || data.length < 2) return 0;
    var idx = _ccF84_idxMap_(headers || data[0] || []);
    if (idx.COD_GRUPO == null || idx.NIVEL == null || idx.HORA_INICIO == null || idx.HORA_FIN == null) return 0;
    var ssApollo = SpreadsheetApp.openById(SHEET_ID);
    var cat = _ccF84_catalogoGrupos_(ssApollo);
    var meta = cat[String(codGrupo || '').trim() + '|' + String(nivel || '').trim().toUpperCase()];
    if (!meta) return 0;
    var cambios = 0;
    for (var r = 1; r < data.length; r++) {
      if (String(data[r][idx.COD_GRUPO] || '').trim() !== String(codGrupo || '').trim()) continue;
      if (String(data[r][idx.NIVEL] || '').trim().toUpperCase() !== String(nivel || '').trim().toUpperCase()) continue;
      var tipo = idx.TIPO_LECCION != null ? String(data[r][idx.TIPO_LECCION] || '').trim().toUpperCase() : '';
      if (tipo === 'LIBRE' || tipo === 'FERIADO') continue;
      var itv = _ccF84_intervaloFila_(data[r], idx, meta);
      if (!itv) continue;
      var hi = _ccF84_minHora_(itv.ini), hf = _ccF84_minHora_(itv.fin);
      var actualHi = _ccF84_hora_(data[r][idx.HORA_INICIO]);
      var actualHf = _ccF84_hora_(data[r][idx.HORA_FIN]);
      if (actualHi === hi && actualHf === hf) continue;
      ws.getRange(r + 1, idx.HORA_INICIO + 1).setNumberFormat('@').setValue(hi);
      ws.getRange(r + 1, idx.HORA_FIN + 1).setNumberFormat('@').setValue(hf);
      data[r][idx.HORA_INICIO] = hi;
      data[r][idx.HORA_FIN] = hf;
      cambios++;
    }
    if (cambios) SpreadsheetApp.flush();
    return cambios;
  } catch (e) {
    Logger.log('F87 normalizar horas: ' + e);
    return 0;
  }
}


