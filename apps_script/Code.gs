// 3. getAsistencia(cod_grupo, leccion_num)
// ============================================================
function getAsistencia(cod_grupo, leccion_num) {
  if (!cod_grupo || !leccion_num) return { error: 'Se requiere cod_grupo y leccion' };
  var ss   = SpreadsheetApp.openById(OPERATIVO_ID);
  var ws   = ss.getSheetByName(OP.ASISTENCIA);
  var rows = ws.getDataRange().getValues();
  var h    = rows[0];

  var iGrupo   = h.indexOf('cod_grupo');
  var iLeccion = h.indexOf('leccion_num');
  var resultado = [];

  for (var i = 1; i < rows.length; i++) {
    if (String(rows[i][iGrupo]).trim()   === String(cod_grupo).trim() &&
        String(rows[i][iLeccion]).trim() === String(leccion_num).trim()) {
      var obj = {};
      h.forEach(function(col, idx) { obj[col] = rows[i][idx]; });
      resultado.push(obj);
    }
  }
  return { ok: true, total: resultado.length, asistencia: resultado };
}

