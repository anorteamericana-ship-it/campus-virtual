  return {
    ok: true, creada: false, columnas_agregadas: aAgregar.length,
    mensaje: 'FERIADOS sincronizada. Columnas nuevas: ' + (aAgregar.length || 'ninguna')
  };
}


// ════════════════════════════════════════════════════════════════════
// leerFeriadosDelGrupo(cod_grupo) → { 'YYYY-MM-DD': 'descripción', ... }
// ════════════════════════════════════════════════════════════════════
function leerFeriadosDelGrupo(cod_grupo) {
  var ss = SpreadsheetApp.openById(SHEET_ID);
  var ws = ss.getSheetByName(SH_FERIADOS);
  if (!ws || ws.getLastRow() < 2) return {};

  var data = ws.getDataRange().getValues();
  var H = data[0];
  var iF = H.indexOf('FECHA');
  var iD = H.indexOf('DESCRIPCION');
  var iT = H.indexOf('TODOS');
  var iG = H.indexOf(cod_grupo);

  if (iF === -1) return {};

  var resultado = {};
  for (var r = 1; r < data.length; r++) {
    var fechaRaw = data[r][iF];
    if (!fechaRaw) continue;
    var fechaStr = (fechaRaw instanceof Date)
      ? _calFmtFecha(fechaRaw)
      : String(fechaRaw).trim().substring(0,10);
    if (!fechaStr) continue;

    var afecta = false;
    if (iT !== -1) {
      var v = data[r][iT];
      if (v === true || String(v).toUpperCase() === 'TRUE') afecta = true;
    }
    if (!afecta && iG !== -1) {
      var vg = data[r][iG];
      if (vg === true || String(vg).toUpperCase() === 'TRUE') afecta = true;
    }
    if (afecta) {
      resultado[fechaStr] = String(data[r][iD] || '').trim() || 'Feriado';
    }
  }
  return resultado;
}


// ════════════════════════════════════════════════════════════════════
// _construirLeccionesCurso(fechaInicio, diasCurso, bloques, total, feriados)
// Genera las lecciones del CURSO respetando feriados.
// Cada día válido del patrón puede tener 1 o más bloques (lecciones).
// Retorna [{ numLec, fecha, diaSemana, turno, horaIniMin, horaFinMin }].
// ════════════════════════════════════════════════════════════════════
function _construirLeccionesCurso(fechaInicio, diasCurso, bloques, totalLec, feriados) {
  var resultado = [];
  var cur = new Date(fechaInicio.getTime());
  cur.setHours(0,0,0,0);

  var diasSet = {};
  diasCurso.forEach(function(d) { diasSet[d] = true; });

  var asignadas = 0;
  var safety = 0;
  while (asignadas < totalLec && safety < 3000) {
    safety++;
    var dow = cur.getDay();
    var fStr = _calFmtFecha(cur);
    if (!feriados[fStr] && diasSet[dow]) {
      for (var b = 0; b < bloques.length; b++) {
        asignadas++;
        resultado.push({
          numLec:      asignadas,
          fecha:       new Date(cur.getTime()),
          diaSemana:   _DIAS_NOMBRE[dow],
          turno:       bloques[b].turno,
          horaIniMin:  bloques[b].ini,
          horaFinMin:  bloques[b].fin
        });
        if (asignadas >= totalLec) break;
      }
    }
    cur = _calAvanzar1Dia(cur);
  }
  return resultado;
}


// ════════════════════════════════════════════════════════════════════
// _construirLeccionesICAN(fechaInicio, diasIcan, horaIni, horaFin, total, feriados)
// Genera las 16 lecciones ICAN. Primera ICAN = primer día válido del
// patrón ICAN ≥ fechaInicio del nivel.
// ════════════════════════════════════════════════════════════════════
function _construirLeccionesICAN(fechaInicio, diasIcan, horaIni, horaFin, totalIcan, feriados) {
  if (!diasIcan || diasIcan.length === 0) return [];
  if (horaIni == null || horaFin == null) return [];

  var resultado = [];
  var cur = new Date(fechaInicio.getTime());
  cur.setHours(0,0,0,0);

  var diasSet = {};
  diasIcan.forEach(function(d) { diasSet[d] = true; });

  var asignadas = 0;
  var safety = 0;
  while (asignadas < totalIcan && safety < 3000) {
    safety++;
    var dow = cur.getDay();
    var fStr = _calFmtFecha(cur);
    if (!feriados[fStr] && diasSet[dow]) {
      asignadas++;
      resultado.push({
        numLec:      asignadas,
        fecha:       new Date(cur.getTime()),
        diaSemana:   _DIAS_NOMBRE[dow],
        turno:       'icán',
        horaIniMin:  horaIni,
        horaFinMin:  horaFin
      });
    }
    cur = _calAvanzar1Dia(cur);
  }
  return resultado;
}


// ════════════════════════════════════════════════════════════════════
// _leerProgramaDelNivel(ssApollo, nivel)
// Lee APOLLO.DETALLE DEL PROGRAMA y retorna 32 filas del nivel:
//   [{ num, tipo (TEORICA/PRACTICA), detalle }]
// ════════════════════════════════════════════════════════════════════
function _leerProgramaDelNivel(ssApollo, nivel) {
  var ws = ssApollo.getSheetByName('DETALLE DEL PROGRAMA');
  if (!ws) return [];
  var dat = ws.getDataRange().getValues();
  var nombreEsperado = _NIVEL_A_DETALLE[nivel];
  if (!nombreEsperado) return [];

  var out = [];
  for (var i = 1; i < dat.length; i++) {
    var nomNiv = String(dat[i][1] || '').trim().toUpperCase();
    if (nomNiv !== nombreEsperado.toUpperCase()) continue;
    var num = Number(dat[i][5]);
    if (!num || num < 1 || num > 32) continue;
    out.push({
      num:     num,
      tipo:    String(dat[i][0] || '').trim().toUpperCase(),
      detalle: String(dat[i][9] || '').trim()
    });
  }
  out.sort(function(a,b) { return a.num - b.num; });
  return out;
}


// ════════════════════════════════════════════════════════════════════
// _leerICANDelNivel(ssApollo, nivel)
// Lee APOLLO.DETALLE DEL ICAN y retorna 16 filas del nivel.
// ════════════════════════════════════════════════════════════════════
function _leerICANDelNivel(ssApollo, nivel) {
  var ws = ssApollo.getSheetByName('DETALLE DEL ICAN');
  if (!ws) return [];
  var dat = ws.getDataRange().getValues();
  var nivelTarget = _NIVEL_A_DETALLE[nivel]
    .replace('BÁSICO','Básico')
    .replace('INTERMEDIO','Intermedio');

  var out = [];
  for (var i = 1; i < dat.length; i++) {
    var nomNiv = String(dat[i][7] || '').trim();
    if (nomNiv !== nivelTarget) continue;
    var num = Number(dat[i][2]);
    if (!num || num < 1 || num > 16) continue;
    out.push({
      num:     num,
      tipo:    'ICAN',
      detalle: String(dat[i][8] || '').trim()
    });
  }
  out.sort(function(a,b) { return a.num - b.num; });
  return out;
}


// ════════════════════════════════════════════════════════════════════
// simularCalendarioGrupo(cod_grupo, nivel_opcional)
// Imprime en el Logger la generación teórica. NO escribe nada.
// Incluye advertencias por traslape ICAN ↔ inicio del siguiente nivel.
// ════════════════════════════════════════════════════════════════════
function simularCalendarioGrupo(cod_grupo, nivel_opcional) {
  var ssApollo = SpreadsheetApp.openById(SHEET_ID);
  var feriados = leerFeriadosDelGrupo(cod_grupo);

  Logger.log('═══════════════════════════════════════════════════════');
  Logger.log('SIMULACIÓN CALENDARIO — ' + cod_grupo + '  (v4.20.1)');
  Logger.log('═══════════════════════════════════════════════════════');
  Logger.log('Feriados que afectan al grupo: ' + Object.keys(feriados).length);
  Logger.log('');

  var nivelesAProcesar = nivel_opcional ? [nivel_opcional] : _NIVELES_ORDEN;
  var ultimosIcanPorNivel = {}; // para advertencias de traslape

  for (var n = 0; n < nivelesAProcesar.length; n++) {
    var niv = nivelesAProcesar[n];
    var info = _leerFilaGrupoNivel(ssApollo, cod_grupo, niv);

    if (!info) {
      Logger.log('  ⚠ Nivel ' + niv + ': sin fila en GRUPOS');
      continue;
    }
    if (!(info.fechaInicio instanceof Date)) {
      Logger.log('  ⚠ Nivel ' + niv + ': FECHA_INICIO inválida');
      continue;
    }
    if (info.diasCurso.length === 0 || info.horaIni == null || info.horaFin == null) {
      Logger.log('  ⚠ Nivel ' + niv + ': DIAS/HORA del curso incompletos');
      continue;
    }

    var bloques = _bloquesDelDia(cod_grupo, info.horaIni, info.horaFin);
    var lecsCurso = _construirLeccionesCurso(
      info.fechaInicio, info.diasCurso, bloques, 32, feriados
    );
    var contenido = _leerProgramaDelNivel(ssApollo, niv);

    Logger.log('───── ' + niv + ' (' + _NIVEL_A_DETALLE[niv] + ') ─────');
    Logger.log('PROGRAMA:     ' + info.programa);
    Logger.log('MODALIDAD:    ' + info.modalidad);
    Logger.log('FECHA_INICIO: ' + _calFmtFecha(info.fechaInicio));
    Logger.log('DIAS curso:   ' + info.diasCurso.map(function(d){ return _DIAS_NOMBRE[d];}).join(','));
    Logger.log('HORA curso:   ' + _minutosAHora(info.horaIni) + '–' + _minutosAHora(info.horaFin) + '  (' + bloques.length + ' bloque(s)/día)');
    Logger.log('DOCENTE:      ' + info.docente);
    Logger.log('Lecciones generadas: ' + lecsCurso.length);
    if (lecsCurso.length === 32) {
      Logger.log('Última curso: ' + _calFmtFecha(lecsCurso[31].fecha));
    }
    Logger.log('');

    for (var L = 0; L < lecsCurso.length; L++) {
      var lec = lecsCurso[L];
      var cont = contenido[L] || { tipo:'?', detalle:'(falta en DETALLE DEL PROGRAMA)' };
      Logger.log(
        '  Lec ' + ('0'+lec.numLec).slice(-2) +
        ' | ' + lec.diaSemana + ' ' + _calFmtFecha(lec.fecha) +
        ' | ' + _minutosAHora(lec.horaIniMin) + '–' + _minutosAHora(lec.horaFinMin) +
        ' | ' + cont.tipo +
        ' | ' + cont.detalle
      );
    }

    // ICAN solo si es INA y tiene horario válido
    if (info.programa === 'INA') {
      var lecsICAN = _construirLeccionesICAN(
        info.fechaInicio, info.diasIcan, info.horaIniIcan, info.horaFinIcan, 16, feriados
      );
      var contICAN = _leerICANDelNivel(ssApollo, niv);

      Logger.log('');
      Logger.log('  ICAN:');
      Logger.log('    DIAS_ICAN: ' + info.diasIcan.map(function(d){ return _DIAS_NOMBRE[d];}).join(','));
      Logger.log('    HORA_ICAN: ' + (info.horaIniIcan != null ? _minutosAHora(info.horaIniIcan) + '–' + _minutosAHora(info.horaFinIcan) : '(sin definir)'));
      Logger.log('    Generadas: ' + lecsICAN.length);

      if (lecsICAN.length === 0) {
        Logger.log('    ⚠ No se pudieron generar ICAN — verificar DIAS_ICAN/HORA_INI_ICAN/HORA_FIN_ICAN');
      } else {
        if (lecsICAN.length === 16) {
          Logger.log('    Última ICAN: ' + _calFmtFecha(lecsICAN[15].fecha));
          ultimosIcanPorNivel[niv] = lecsICAN[15].fecha;
        }
        for (var I = 0; I < lecsICAN.length; I++) {
          var ic = lecsICAN[I];
          var ci = contICAN[I] || { detalle:'(falta en DETALLE DEL ICAN)' };
          Logger.log(
            '    ICAN ' + ('0'+ic.numLec).slice(-2) +
            ' | ' + ic.diaSemana + ' ' + _calFmtFecha(ic.fecha) +
            ' | ' + _minutosAHora(ic.horaIniMin) + '–' + _minutosAHora(ic.horaFinMin) +
            ' | ' + ci.detalle.substring(0, 70)
          );
        }
      }
    }
    Logger.log('');
  }

  // Advertencias de traslape: si el último ICAN de un nivel cae después del
  // inicio del siguiente, alertar.
  Logger.log('───── VALIDACIONES ─────');
  var pares = [['B1','B2'],['B2','I1'],['I1','I2']];
  for (var p = 0; p < pares.length; p++) {
    var nivPrev = pares[p][0], nivSig = pares[p][1];
    if (!ultimosIcanPorNivel[nivPrev]) continue;
    var infoSig = _leerFilaGrupoNivel(ssApollo, cod_grupo, nivSig);
    if (!infoSig || !(infoSig.fechaInicio instanceof Date)) continue;
    var ultIcan = ultimosIcanPorNivel[nivPrev];
    var inicio = infoSig.fechaInicio;
    if (ultIcan.getTime() >= inicio.getTime()) {
      Logger.log('  ⚠ TRASLAPE: último ICAN ' + nivPrev + ' = ' + _calFmtFecha(ultIcan) +
                 ' es igual o posterior al inicio del curso ' + nivSig + ' = ' + _calFmtFecha(inicio));
    }
  }
  Logger.log('');
  Logger.log('═══════════════════════════════════════════════════════');
  Logger.log('FIN SIMULACIÓN — nada fue escrito al spreadsheet');
  Logger.log('═══════════════════════════════════════════════════════');
  return { ok: true };
}


// ════════════════════════════════════════════════════════════════════
// regenerarCalendarioGrupo(cod_grupo)
// WIPE TOTAL del grupo en CALENDARIO_LECCIONES + repoblado completo.
// NO conserva CERRADAS/CALCULADAS (Leonardo confirmó: todas son basura).
// ════════════════════════════════════════════════════════════════════
function regenerarCalendarioGrupo(cod_grupo) {
  var ssApollo = SpreadsheetApp.openById(SHEET_ID);
  var ssOp     = SpreadsheetApp.openById(OPERATIVO_ID);

  // 1. Asegurar que FERIADOS exista y tenga columna para este grupo
  crearHojaFeriados();
  var feriados = leerFeriadosDelGrupo(cod_grupo);

  // 2. Verificar el grupo
  var infoB1 = _leerFilaGrupoNivel(ssApollo, cod_grupo, 'B1');
  if (!infoB1) return { ok:false, error:'grupo no encontrado: ' + cod_grupo };

  // 3. Leer CALENDARIO_LECCIONES y preparar wipe total del grupo
  var wsCal = ssOp.getSheetByName(SH_CALENDARIO);
  if (!wsCal) return { ok:false, error:'CALENDARIO_LECCIONES no existe' };

  var calData = wsCal.getDataRange().getValues();
  var cH = calData[0];
  var icG = cH.indexOf('COD_GRUPO');
  var icN = cH.indexOf('NIVEL');
  var icL = cH.indexOf('LECCION');
  var icF = cH.indexOf('FECHA');
  var icD = cH.indexOf('DIA_SEMANA');
  var icT = cH.indexOf('TURNO');
  var icK = cH.indexOf('TIPO_LECCION');
  var icE = cH.indexOf('ESTADO');
  var icDo= cH.indexOf('DOCENTE');
  var icAR= cH.indexOf('ASISTENCIA_REGISTRADA');
  var icND= cH.indexOf('NOTAS_DOCENTE');

  // Conservar TODAS las filas que no son de este grupo
  var conservadas = [calData[0]];
  for (var k = 1; k < calData.length; k++) {
    if (String(calData[k][icG] || '').trim() !== cod_grupo) {
      conservadas.push(calData[k]);
    }
    // Las del grupo se descartan completas (wipe total)
  }

  // 4. Generar filas nuevas
  var nuevasFilas = [];
  var totalCurso = 0, totalICAN = 0;

  _NIVELES_ORDEN.forEach(function(niv) {
    var info = _leerFilaGrupoNivel(ssApollo, cod_grupo, niv);
    if (!info || !(info.fechaInicio instanceof Date)) return;
    if (info.diasCurso.length === 0 || info.horaIni == null || info.horaFin == null) return;

    var bloques = _bloquesDelDia(cod_grupo, info.horaIni, info.horaFin);
    var lecsCurso = _construirLeccionesCurso(
      info.fechaInicio, info.diasCurso, bloques, 32, feriados
    );
    var contenidoCurso = _leerProgramaDelNivel(ssApollo, niv);

    lecsCurso.forEach(function(lec, idx) {
      var cont = contenidoCurso[idx] || { tipo:'TEORICA', detalle:'' };
      var fila = _construirFilaCalendario(
        cH, icG, icN, icL, icF, icD, icT, icK, icE, icDo, icAR, icND,
        cod_grupo, niv, lec.numLec, lec.fecha, lec.diaSemana, lec.turno,
        cont.tipo, 'PROGRAMADA', info.docente
      );
      nuevasFilas.push(fila);
      totalCurso++;
    });

    if (info.programa === 'INA') {
      var lecsICAN = _construirLeccionesICAN(
        info.fechaInicio, info.diasIcan, info.horaIniIcan, info.horaFinIcan, 16, feriados
      );
      lecsICAN.forEach(function(ic) {
        var fila = _construirFilaCalendario(
          cH, icG, icN, icL, icF, icD, icT, icK, icE, icDo, icAR, icND,
          cod_grupo, niv, ic.numLec, ic.fecha, ic.diaSemana, ic.turno,
          'ICAN', 'PROGRAMADA', info.docente
        );
        nuevasFilas.push(fila);
        totalICAN++;
      });
    }
  });

  // 5. Reescribir hoja completa
  var todas = conservadas.concat(nuevasFilas);
  wsCal.clear();
  wsCal.getRange(1, 1, todas.length, cH.length).setValues(todas);
  wsCal.setFrozenRows(1);
  wsCal.getRange(1, 1, 1, cH.length).setFontWeight('bold');

  return {
    ok: true,
    cod_grupo: cod_grupo,
    programa: infoB1.programa,
    filas_curso: totalCurso,
    filas_ican:  totalICAN,
    filas_total: nuevasFilas.length,
    mensaje: cod_grupo + ' → ' + totalCurso + ' curso + ' + totalICAN + ' ICAN = ' + nuevasFilas.length + ' filas'
  };
}


// Helper interno: construye una fila respetando el orden de columnas del header.
function _construirFilaCalendario(cH, icG, icN, icL, icF, icD, icT, icK, icE, icDo, icAR, icND,
                                  cod_grupo, niv, numLec, fecha, diaSemana, turno, tipo, estado, docente) {
  var fila = [];
  for (var c = 0; c < cH.length; c++) {
    if      (c === icG)  fila.push(cod_grupo);
    else if (c === icN)  fila.push(niv);
    else if (c === icL)  fila.push(numLec);
    else if (c === icF)  fila.push(fecha);
    else if (c === icD)  fila.push(diaSemana);
    else if (c === icT)  fila.push(turno);
    else if (c === icK)  fila.push(tipo);
    else if (c === icE)  fila.push(estado);
    else if (c === icDo) fila.push(docente);
    else if (c === icAR) fila.push(false);
    else if (c === icND) fila.push('');
    else fila.push('');
  }
  return fila;
}


// ════════════════════════════════════════════════════════════════════
// regenerarCalendarioTodos()
// Itera sobre APOLLO.GRUPOS en tiempo real y regenera cada grupo.
// ════════════════════════════════════════════════════════════════════
function regenerarCalendarioTodos() {
  var ss = SpreadsheetApp.openById(SHEET_ID);
  var wsG = ss.getSheetByName(SH.GRUPOS);
  var dat = wsG.getDataRange().getValues();
  var iCod = dat[0].indexOf('CODIGO_GRUPO');

  var gruposSet = {};
  for (var i = 1; i < dat.length; i++) {
    var c = String(dat[i][iCod] || '').trim();
    if (c) gruposSet[c] = true;
  }
  var grupos = Object.keys(gruposSet).sort();

  Logger.log('═══════════════════════════════════════════════════════');
  Logger.log('REGENERAR TODOS — ' + grupos.length + ' grupos');
  Logger.log('═══════════════════════════════════════════════════════');

  var resultados = [];
  grupos.forEach(function(g) {
    try {
      var r = regenerarCalendarioGrupo(g);
      resultados.push({ grupo:g, ok:r.ok, mensaje:r.mensaje || r.error });
      Logger.log(r.ok ? '✓ ' + (r.mensaje) : '✗ ' + g + ': ' + r.error);
    } catch(e) {
      resultados.push({ grupo:g, ok:false, mensaje:e.toString() });
      Logger.log('✗ ' + g + ': ' + e.toString());
    }
  });

  // Limpieza automática de huérfanos al final
  Logger.log('');
  Logger.log('───── Limpieza automática de filas huérfanas ─────');
  var limp = limpiarFilasHuerfanas('ejecutar');
  if (limp.ok) {
    Logger.log('✓ ' + limp.mensaje);
  } else {
    Logger.log('✗ Limpieza falló: ' + limp.error);
  }

  return {
    ok: true,
    total: grupos.length,
    resultados: resultados,
    limpieza_huerfanos: limp
  };
}


// ════════════════════════════════════════════════════════════════════
// inspeccionarFilasHuerfanas()
// Solo lectura. Lista códigos de grupo en CALENDARIO_LECCIONES que no
// existen en APOLLO.GRUPOS. Útil antes de borrar.
// ════════════════════════════════════════════════════════════════════
function inspeccionarFilasHuerfanas() {
  var ssApollo = SpreadsheetApp.openById(SHEET_ID);
  var ssOp     = SpreadsheetApp.openById(OPERATIVO_ID);

  var wsG = ssApollo.getSheetByName(SH.GRUPOS);
  var datG = wsG.getDataRange().getValues();
  var iCodG = datG[0].indexOf('CODIGO_GRUPO');
  var activos = {};
  for (var i = 1; i < datG.length; i++) {
    var c = String(datG[i][iCodG] || '').trim();
    if (c) activos[c] = true;
  }

  var wsCal = ssOp.getSheetByName(SH_CALENDARIO);
  var datC = wsCal.getDataRange().getValues();
  var iG = datC[0].indexOf('COD_GRUPO');

  var huerfanos = {};
  for (var r = 1; r < datC.length; r++) {
    var cg = String(datC[r][iG] || '').trim();
    if (cg && !activos[cg]) {
      huerfanos[cg] = (huerfanos[cg] || 0) + 1;
    }
  }

  return {
    ok: true,
    grupos_huerfanos: huerfanos,
    total_codigos: Object.keys(huerfanos).length,
    total_filas: Object.keys(huerfanos).reduce(function(s,k){ return s + huerfanos[k]; }, 0)
  };
}


// ════════════════════════════════════════════════════════════════════
// limpiarFilasHuerfanas(modo)
// modo = 'dry_run'  → solo lista qué borraría, NO borra.
// modo = 'ejecutar' → borra las filas huérfanas del calendario.
// Una fila es huérfana si su COD_GRUPO no está en APOLLO.GRUPOS.
// ════════════════════════════════════════════════════════════════════
function limpiarFilasHuerfanas(modo) {
  modo = modo || 'dry_run';
  if (modo !== 'dry_run' && modo !== 'ejecutar') {
    return { ok: false, error: 'modo debe ser "dry_run" o "ejecutar"' };
  }

  try {
    var ssApollo = SpreadsheetApp.openById(SHEET_ID);
    var ssOp     = SpreadsheetApp.openById(OPERATIVO_ID);

    // Conjunto de grupos activos
    var wsG = ssApollo.getSheetByName(SH.GRUPOS);
    var datG = wsG.getDataRange().getValues();
    var iCodG = datG[0].indexOf('CODIGO_GRUPO');
    var activos = {};
    for (var i = 1; i < datG.length; i++) {
      var c = String(datG[i][iCodG] || '').trim();
      if (c) activos[c] = true;
    }

    var wsCal = ssOp.getSheetByName(SH_CALENDARIO);
    var datC = wsCal.getDataRange().getValues();
    var iG = datC[0].indexOf('COD_GRUPO');

    var conservadas = [datC[0]]; // header
    var borradas = 0;
    var codigosBorrados = {};

    for (var r = 1; r < datC.length; r++) {
      var cg = String(datC[r][iG] || '').trim();
      if (!cg || activos[cg]) {
        conservadas.push(datC[r]);
      } else {
        borradas++;
        codigosBorrados[cg] = (codigosBorrados[cg] || 0) + 1;
      }
    }

    if (modo === 'dry_run') {
      return {
        ok: true,
        modo: 'dry_run',
        filas_a_borrar: borradas,
        codigos: codigosBorrados,
        mensaje: 'DRY RUN: se borrarían ' + borradas + ' filas de ' + Object.keys(codigosBorrados).length + ' códigos huérfanos. Re-ejecutar con modo="ejecutar".'
      };
    }

    // modo === 'ejecutar'
    if (borradas === 0) {
      return { ok: true, filas_borradas: 0, mensaje: 'Sin huérfanos para borrar' };
    }

    wsCal.clear();
    wsCal.getRange(1, 1, conservadas.length, conservadas[0].length).setValues(conservadas);
    wsCal.setFrozenRows(1);
    wsCal.getRange(1, 1, 1, conservadas[0].length).setFontWeight('bold');

    return {
      ok: true,
      modo: 'ejecutar',
      filas_borradas: borradas,
      codigos: codigosBorrados,
      mensaje: borradas + ' filas huérfanas borradas (' + Object.keys(codigosBorrados).length + ' códigos)'
    };
  } catch (e) {
    return { ok: false, error: e.toString() };
  }
}


