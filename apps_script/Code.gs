// ============================================================
// doGet(e) — endpoints públicos/controlados para inscripción
// v4.40.3
// ------------------------------------------------------------
// El formulario público de inscripción no tiene token. Por eso
// estas rutas se exponen por GET de forma explícita y limitada.
// NO agregar aquí lecturas administrativas ni datos privados.
// ============================================================
function doGet(e) {
  try {
    var p = (e && e.parameter) ? e.parameter : {};
    var fn = String(p.fn || '').trim();
    var result;

    if (fn === 'verificarCedulaInscripcion') {
      result = verificarCedulaInscripcion(p);
    }
    else if (fn === 'verificarCedulaExiste') {
      result = verificarCedulaExiste(p); // legacy público
    }
    else if (fn === 'buscarEnPadron') {
      result = buscarEnPadron(p); // público: solo la cédula consultada
    }
    else if (fn === 'getAsesoresActivos') {
      result = getAsesoresActivos(); // rol ventas activo TRUE
    }
    else if (fn === 'getGruposDisponibles') {
      result = getGruposDisponibles(p); // grupos marcados disponibles para inscripción
    }
    else if (fn === 'getInscripcionPublicConfig') {
      // CALGRUPO_F55_20260618_INSCRIPCION_PUBLIC_CONFIG_GET
      result = getInscripcionPublicConfig();
    }
    else if (fn === 'getInfoGeneral') {
      // v4.40.5 fallback compatible: el frontend nuevo usa POST con token,
      // pero algunas cachés antiguas aún piden GET. Info general no expone
      // datos personales; solo documentos institucionales del programa.
      result = getInfoGeneral();
    }
    else if (fn === 'getBecasDisponibles') {
      result = getBecasDisponibles(p); // legacy público
    }
    else if (fn === 'getBecas') {
      // Público únicamente para inscripción; si no mandan filtros, forzamos
      // solo visibles para no exponer el catálogo administrativo completo.
      var params = Object.assign({}, p);
      params.solo_visibles = true;
      result = getBecas(params);
    }
    else {
      result = { ok: false, error: 'Funcion GET no reconocida: ' + fn };
    }

    return jsonResponse(result);
  } catch (err) {
    return jsonResponse({ ok: false, error: err.message });
  }
}




