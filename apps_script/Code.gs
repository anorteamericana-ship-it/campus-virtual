function saveInscripcionGroupToeic(body) {
  var codigo = String(body.codigo || body.cod_grupo || '').trim();
  if (!codigo) return { ok:false, error:'codigo_grupo_requerido' };
  var toeic = body.toeic === true || body.toeic === 'true' || String(body.toeic || '').toUpperCase() === 'SI';
  var monto = parseFloat(body.toeic_monto || body.monto || 0) || 0;
  if (toeic && monto <= 0) return { ok:false, error:'monto_toeic_requerido', mensaje:'Si TOEIC aplica, indicá un monto mayor a cero.' };
  var ss = SpreadsheetApp.openById(SHEET_ID);
  var ws = ss.getSheetByName(SH.GRUPOS);
  if (!ws) return { ok:false, error:'hoja_grupos_no_existe' };
  var h = _insF55EnsureGrupoToeicHeaders_(ws);
  var iCod = h.indexOf('CODIGO_GRUPO');
  var iToeic = h.indexOf('TOEIC');
  var iMonto = h.indexOf('TOEIC_MONTO');
  if (iCod < 0) return { ok:false, error:'grupos_sin_codigo_grupo' };
  var last = ws.getLastRow();
  var count = 0;
  if (last >= 2) {
    var rows = ws.getRange(2, 1, last-1, ws.getLastColumn()).getValues();
