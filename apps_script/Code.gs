// v4.40.2 — Reparación manual opcional para estudiantes ya creados
// Uso desde Apps Script editor: repararBecaImpactaEstudiante_('113220041')
// No se expone al frontend. Solo ajusta columnas de DATOS si existen.
// ════════════════════════════════════════════════════════════════════════════
function repararBecaImpactaEstudiante_(cedulaOCodigo) {
  var ss = SpreadsheetApp.openById(SHEET_ID);
  var ws = ss.getSheetByName(SH.DATOS);
  if (!ws) return { ok: false, error: 'Hoja DATOS no encontrada' };
  var rows = ws.getDataRange().getValues();
  if (rows.length < 2) return { ok: false, error: 'DATOS vacío' };
  var H = rows[0];
  var iCed = H.indexOf('NUM_CEDULA');
  if (iCed < 0) iCed = H.indexOf('CEDULA');
  var iCod = H.indexOf('CODIGO');
  var key = String(cedulaOCodigo || '').replace(/[-\s]/g,'').trim();
  if (!key) return { ok: false, error: 'Falta cédula o código' };

  var fila = -1;
  for (var r = 1; r < rows.length; r++) {
    var ced = iCed >= 0 ? String(rows[r][iCed] || '').replace(/[-\s]/g,'').trim() : '';
    var cod = iCod >= 0 ? String(rows[r][iCod] || '').trim() : '';
    if (ced === key || cod === key) { fila = r + 1; break; }
  }
  if (fila < 0) return { ok: false, error: 'No encontrado en DATOS: ' + key };

  var cols = ['CONVENIO','BECA','BECAS','BECA_APLICADA','TIPO_BECA','PROMOCION'];
  var tocadas = [];
  cols.forEach(function(col) {
    for (var c = 0; c < H.length; c++) {
      if (String(H[c]).trim().toUpperCase() === col) {
        ws.getRange(fila, c + 1).setValue('BECA IMPACTA');
        tocadas.push(col + ':' + (c + 1));
      }
    }
  });
  return { ok: true, fila: fila, columnas_actualizadas: tocadas };
}

function repararBecaImpacta113220041() {
  return repararBecaImpactaEstudiante_('113220041');
}



