}

function _ccF85_rowMatches_(row, idx, cod, niv, lec) {
  if (!row) return false;
  var iG = idx.COD_GRUPO != null ? idx.COD_GRUPO : (idx.CODIGO_GRUPO != null ? idx.CODIGO_GRUPO : idx.GRUPO);
