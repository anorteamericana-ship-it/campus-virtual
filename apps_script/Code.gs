      cod_grupo:cod,
      nivel:niv,
      docente:String(d[r][i.DOCENTE] || '').trim(),
      // F87: el código SA94/KJ69/etc. manda sobre horas serializadas como Date 1899.
      horaIni:codeIni != null ? codeIni : _parseHora(d[r][i.HORA_INI]),
      horaFin:codeFin != null ? codeFin : _parseHora(d[r][i.HORA_FIN]),
      horaIniIcan:i.HORA_INI_ICAN != null ? _parseHora(d[r][i.HORA_INI_ICAN]) : null,
      horaFinIcan:i.HORA_FIN_ICAN != null ? _parseHora(d[r][i.HORA_FIN_ICAN]) : null
