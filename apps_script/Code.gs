// ════════════════════════════════════════════════════════════════════
function _sec006cCodigoProp_(v) {
  return String(v == null ? '' : v).trim();
}

function _sec006cCedulaProp_(v) {
  try {
    if (typeof _limpiarCedula === 'function') return _limpiarCedula(v);
  } catch (_) {}
  return String(v == null ? '' : v).replace(/[^0-9]/g, '').trim();
}

function _sec006cNormGrupo_(v) {
