}

function _ccF84_validarReprogramacion_(body) {
  var ctx = _ccF84_contextoCalendario_(body);
  if (!ctx.ok) return ctx;
  var fechaDestino = String(body.fecha_destino || '').trim();
  var horaIni = _ccF84_hora_(body.hora_destino_inicio);
  var horaFin = _ccF84_hora_(body.hora_destino_fin);
  if (!/^\d{4}-\d{2}-\d{2}$/.test(fechaDestino)) return { ok:false, error:'La fecha destino es obligatoria.' };
  if (!horaIni || !horaFin) return { ok:false, error:'La hora de inicio y finalización son obligatorias.' };
  var iniMin = _ccF84_horaMin_(horaIni), finMin = _ccF84_horaMin_(horaFin);
  if (iniMin == null || finMin == null || finMin <= iniMin) return { ok:false, error:'El horario destino no es válido.' };
  if (!ctx.originalInterval) return { ok:false, error:'No se pudo determinar la duración original de la lección.' };
  if ((finMin - iniMin) !== (ctx.originalInterval.fin - ctx.originalInterval.ini)) {
    return { ok:false, error:'La reprogramación debe conservar la duración original de ' + (ctx.originalInterval.fin - ctx.originalInterval.ini) + ' minutos.' };
  }
  var destStart = _ccF84_fechaHora_(fechaDestino, horaIni);
  var destEnd = _ccF84_fechaHora_(fechaDestino, horaFin);
  if (fechaDestino === ctx.fechaOriginal && iniMin === ctx.originalInterval.ini && finMin === ctx.originalInterval.fin) {
    return { ok:false, error:'La nueva fecha y horario son iguales a la programación actual.' };
