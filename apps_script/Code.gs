function _sec006cNormTexto_(v) {
  var t = String(v == null ? '' : v).trim();
  try { t = t.normalize('NFD').replace(/[\u0300-\u036f]/g, ''); } catch (_) {}
  return t.toUpperCase().replace(/\s+/g, ' ').trim();
}

function _sec006cGruposSesionSet_(sesion) {
  var set = {};
  sesion = sesion || {};
  function add(g) {
    var x = _sec006cNormGrupo_(g);
    if (x) set[x] = true;
  }
  add(sesion.grupo);
  var grupos = sesion.grupos || [];
  if (typeof grupos === 'string') {
    try { grupos = JSON.parse(grupos); } catch (_) { grupos = [grupos]; }
  }
  if (Array.isArray(grupos)) {
    for (var i = 0; i < grupos.length; i++) {
      var g = grupos[i];
      if (typeof g === 'string') add(g);
      else if (g && typeof g === 'object') add(g.grupo || g.cod_grupo || g.codigo || g.code);
    }
  }
  return set;
}

function _sec006cTeacherPuedeGrupo_(sesion, codGrupo) {
  var grupo = _sec006cNormGrupo_(codGrupo);
  if (!grupo) return false;
  var set = _sec006cGruposSesionSet_(sesion);
  return !!set[grupo];
}

function _sec006cNoAutorizadoRecurso_(mensaje) {
  return {
    ok: false,
    protegido: true,
    error: 'no_autorizado_recurso',
    mensaje: mensaje || 'No tiene permiso para consultar o modificar este recurso.'
  };
}

function _sec006cDocenteCoincideSesion_(sesion, solicitado) {
  var req = _sec006cNormTexto_(solicitado);
  if (!req) return false;
  var candidatos = [sesion && sesion.nombre, sesion && sesion.cedula, sesion && sesion.usuario, sesion && sesion.codigo];
  for (var i = 0; i < candidatos.length; i++) {
    if (_sec006cNormTexto_(candidatos[i]) === req) return true;
  }
  return false;
}

function _sec006cRosterGrupoSet_(codGrupo, nivel) {
  var set = {};
  var cg = _sec006cNormGrupo_(codGrupo);
  var nv = String(nivel || '').trim().toUpperCase();
  if (!cg) return set;
  try {
    var ss = SpreadsheetApp.openById(SHEET_ID);
    if (nv) {
      var wsE = ss.getSheetByName(SH.ESTATUS);
      if (wsE) {
        var rowsE = wsE.getDataRange().getValues();
        var hE = rowsE[0] || [];
        var iCodE = hE.indexOf('CODIGO');
        var iGrpE = hE.indexOf('GRUPO');
        var iNivE = hE.indexOf('NIVEL');
        for (var e = 1; e < rowsE.length; e++) {
          if (_sec006cNormGrupo_(rowsE[e][iGrpE]) !== cg) continue;
          if (String(rowsE[e][iNivE] || '').trim().toUpperCase() !== nv) continue;
          var codeE = _sec006cCodigoProp_(rowsE[e][iCodE]);
          if (codeE) set[codeE] = true;
        }
      }
    }
    // Fallback / complemento: DATOS.GRUPO. Mantiene compatibilidad con vistas
    // docentes antiguas que no siempre envían nivel.
    var wsD = ss.getSheetByName(SH.DATOS);
    if (wsD) {
      var rowsD = wsD.getDataRange().getValues();
      var hD = rowsD[0] || [];
      var iCodD = hD.indexOf('CODIGO');
      var iGrpD = hD.indexOf('GRUPO');
      for (var d = 1; d < rowsD.length; d++) {
        if (_sec006cNormGrupo_(rowsD[d][iGrpD]) !== cg) continue;
        var codeD = _sec006cCodigoProp_(rowsD[d][iCodD]);
        if (codeD) set[codeD] = true;
      }
    }
  } catch (_) {}
  return set;
}

function _sec006cExtraerCodigosBody_(body) {
  var out = {};
  body = body || {};
  function add(v) {
    var c = _sec006cCodigoProp_(v);
    if (c) out[c] = true;
  }
  add(body.cod_estudiante);
  add(body.codigo);
  add(body.code);

  if (Array.isArray(body.lista)) {
    for (var i = 0; i < body.lista.length; i++) {
      var item = body.lista[i] || {};
      add(item.cod_estudiante || item.codigo || item.code || item.cod_est || item.estudiante);
    }
  }

  var objetosPorCodigo = ['asistencias', 'retroalimentacion', 'progress_check', 'notas'];
  for (var k = 0; k < objetosPorCodigo.length; k++) {
    var obj = body[objetosPorCodigo[k]];
    if (obj && typeof obj === 'object' && !Array.isArray(obj)) {
      Object.keys(obj).forEach(add);
    }
  }
  return Object.keys(out);
}

function _sec006cValidarCodigosEnGrupo_(codGrupo, nivel, codigos) {
  codigos = codigos || [];
  if (!codigos.length) return { ok: true };
  var roster = _sec006cRosterGrupoSet_(codGrupo, nivel);
  var fuera = [];
  for (var i = 0; i < codigos.length; i++) {
    if (!roster[_sec006cCodigoProp_(codigos[i])]) fuera.push(codigos[i]);
  }
  if (fuera.length) {
    return _sec006cNoAutorizadoRecurso_('Uno o más estudiantes no pertenecen al grupo indicado.');
  }
  return { ok: true };
}


function _sec006cNormAsesor_(v) {
  return _sec006cNormTexto_(v);
}

function _sec006cAsesorSesion_(sesion) {
  sesion = sesion || {};
  return String(sesion.nombre || sesion.asesor || sesion.usuario || '').trim();
}

function _sec006cAsesorMatch_(rowAsesor, asesor) {
  var a = _sec006cNormAsesor_(rowAsesor);
  var b = _sec006cNormAsesor_(asesor);
  if (!a || !b) return false;
  return a === b || (b.length >= 4 && a.indexOf(b) >= 0) || (a.length >= 4 && b.indexOf(a) >= 0);
}

function _sec006cProspectoPorCampo_(campo, valor) {
  var v = String(valor == null ? '' : valor).trim();
  if (!v) return { ok: false, error: 'valor_requerido' };
  try {
    var ss = SpreadsheetApp.openById(SHEET_ID);
    var ws = ss.getSheetByName('PROSPECTOS');
    if (!ws || ws.getLastRow() < 2) return { ok: false, error: 'prospectos_no_disponibles' };
    var rows = ws.getDataRange().getValues();
    var h = rows[0] || [];
    var idx = h.indexOf(campo);
    if (idx < 0) return { ok: false, error: 'campo_no_disponible_' + campo };
    var buscar = campo === 'CEDULA' ? _sec006cCedulaProp_(v) : String(v).trim();
    for (var i = 1; i < rows.length; i++) {
      var cell = rows[i][idx];
      var comp = campo === 'CEDULA' ? _sec006cCedulaProp_(cell) : String(cell == null ? '' : cell).trim();
      if (comp !== buscar) continue;
      var obj = {};
      for (var j = 0; j < h.length; j++) obj[h[j]] = rows[i][j];
      return { ok: true, prospecto: obj, fila: i + 1, headers: h };
    }
    return { ok: false, error: 'prospecto_no_encontrado' };
  } catch (e) {
    return { ok: false, error: 'error_buscando_prospecto: ' + e.message };
  }
}

function _sec006cProspectoPorCedula_(cedula) {
  return _sec006cProspectoPorCampo_('CEDULA', cedula);
}

function _sec006cProspectoPorCodigo_(codigo) {
  return _sec006cProspectoPorCampo_('CODIGO_ESTUDIANTE', codigo);
}

function _sec006cVentasPuedeProspecto_(sesion, prospecto) {
  var asesorSesion = _sec006cAsesorSesion_(sesion);
  var asesorProspecto = prospecto && (prospecto.ASESOR_REF || prospecto.ASESOR || prospecto.VENDEDOR);
  return _sec006cAsesorMatch_(asesorProspecto, asesorSesion);
}

function _sec006cProspectoListoDocumentosVentas_(prospecto) {
  if (!prospecto) return false;
  var codigo = String(prospecto.CODIGO_ESTUDIANTE || prospecto.codigo_estudiante || prospecto.codigo || '').trim();
  if (!codigo) return false;
  var etapa = String(prospecto.ETAPA || prospecto.etapa || '').trim().toUpperCase();
  var estadoCuenta = String(prospecto.ESTADO_CUENTA || prospecto.estado_cuenta || '').trim().toUpperCase();
  // En este flujo, generar matrícula deja CODIGO_ESTUDIANTE y ESTADO_CUENTA=ACTIVO;
  // el embudo puede quedar en PAGO_ACADEMIA/CONAPE_MATRICULA según financiamiento.
  if (estadoCuenta === 'ACTIVO') return true;
  return etapa === 'ACTIVO' || etapa === 'PAGO_ACADEMIA' || etapa === 'CONAPE_MATRICULA';
}

function _sec006cValidarPropiedadGet_(fn, params, sesion) {
  params = params || {};
  sesion = sesion || {};
  var rol = String(sesion.rol || '').trim().toLowerCase();

  // SEC-006C-B3-1 — propiedad de estudiante.
  if (rol === 'student') {
    var endpointsCodigo = {
      getEstudiante: true,
      getPortalEstudianteCompleto: true,
      getRetroalimentacionEstudiante: true,
      getAsistenciaEstudiante: true,
      getICANEstudiante: true,
      getEvaluacionesEstudiante: true
    };

    if (endpointsCodigo[fn]) {
      var solicitado = _sec006cCodigoProp_(params.codigo || params.cod_estudiante || params.code);
      var propio = _sec006cCodigoProp_(sesion.codigo);
      if (!propio || !solicitado || solicitado !== propio) {
        return _sec006cNoAutorizadoRecurso_('No tiene permiso para consultar este expediente.');
      }
    }

    if (fn === 'getEstadoConape') {
      var cedSolicitada = _sec006cCedulaProp_(params.cedula);
      var cedPropia = _sec006cCedulaProp_(sesion.cedula);
      if (!cedPropia || !cedSolicitada || cedSolicitada !== cedPropia) {
        return _sec006cNoAutorizadoRecurso_('No tiene permiso para consultar este estado CONAPE.');
      }
    }

    // v4.40.4 — el panel de estudiante necesita leer información de SU grupo
    // por POST (getGrupoInfo / getFechasGrupo). Si la sesión trae grupo(s),
    // se valida contra ellos. Si la sesión antigua no trae grupo, no se bloquea
    // para evitar romper estudiantes existentes; la lectura sigue protegida por token.
    var endpointsGrupoEstudiante = {
      getGrupoInfo: true,
      getFechasGrupo: true
    };
    if (endpointsGrupoEstudiante[fn]) {
      var gEst = params.cod_grupo || params.grupo || params.codGrupo;
      var grupoReq = _sec006cNormGrupo_(gEst);
      var gruposSetEst = _sec006cGruposSesionSet_(sesion);
      var tieneGrupoSesion = false;
      for (var kGrupo in gruposSetEst) {
        if (gruposSetEst.hasOwnProperty(kGrupo)) { tieneGrupoSesion = true; break; }
      }
      if (grupoReq && tieneGrupoSesion && !gruposSetEst[grupoReq]) {
        return _sec006cNoAutorizadoRecurso_('No tiene permiso para consultar este grupo.');
      }
    }
  }

  // SEC-006C-B3-2 — propiedad docente.
  // Teacher solo puede consultar grupos asignados a su sesión backend.
  if (rol === 'teacher') {
    var endpointsGrupo = {
      getGrupoEstudiantes: true,
      getAsistenciaGrupoCompleta: true,
      getEstudiantesParaCierre: true,
      getLeccionCerradaDetalle: true,
      getGrupoInfo: true
    };
    if (endpointsGrupo[fn]) {
      var g = params.cod_grupo || params.grupo || params.codGrupo;
      if (!_sec006cTeacherPuedeGrupo_(sesion, g)) {
        return _sec006cNoAutorizadoRecurso_('El docente no tiene acceso a este grupo.');
      }
    }

    if (fn === 'getCalendarioDocente' || fn === 'getTareasPendientesDocente') {
      var solicitadoDoc = params.cod_docente || params.cedula || params.docente || '';
      if (!_sec006cDocenteCoincideSesion_(sesion, solicitadoDoc)) {
        return _sec006cNoAutorizadoRecurso_('El docente solo puede consultar su propio calendario.');
      }
    }
  }

  // SEC-006C-B3-3 — propiedad ventas.
  // Ventas solo puede consultar su propia cartera; el asesor del cliente
  // se ignora/sobrescribe usando el nombre de la sesión validada.
  if (rol === 'ventas') {
    var asesorSesion = _sec006cAsesorSesion_(sesion);
    if (!asesorSesion) {
      return _sec006cNoAutorizadoRecurso_('No se pudo identificar el asesor de la sesión.');
    }

    var endpointsAsesor = {
      getDashboardVentas: true,
      getProspectosAsesor: true,
      getResumenVentas: true
    };
    if (endpointsAsesor[fn]) {
      params.asesor = asesorSesion;
      params.cedula = '';
    }

    if (fn === 'getProspectoDetalle') {
      var pCed = _sec006cProspectoPorCedula_(params.cedula);
      if (!pCed.ok) return _sec006cNoAutorizadoRecurso_('Prospecto no disponible para esta sesión.');
      if (!_sec006cVentasPuedeProspecto_(sesion, pCed.prospecto)) {
        return _sec006cNoAutorizadoRecurso_('El prospecto no pertenece a este asesor.');
      }
    }
  }

  return { ok: true };
}

// F32 limpieza: definición duplicada anterior de _sec006cValidarPropiedadPost_ eliminada; se conserva la última definición activa.

// SEC-004B-B — Autorización central para endpoints sensibles POST
// Requiere token de sesión válido en body.token / body.session_token.
// Alcance limitado a endpoints cuyo frontend ya fue preparado para enviar
// token. No toca inscripción pública, ventas ni importarExtracto. El flujo docente de escritura se cierra en SEC-004C-B.
// ════════════════════════════════════════════════════════════════════
// F32 limpieza: definición duplicada anterior de _sec004bRolesPorEndpoint_ eliminada; se conserva la última definición activa.

function _sec004bAutorizarPost_(fn, body) {
  var rolesPermitidos = _sec004bRolesPorEndpoint_(fn);
  if (!rolesPermitidos) return { ok: true, protegido: false };

  var token = '';
  try {
    token = String((body && (body.token || body.session_token)) || '').trim();
  } catch (_) {
    token = '';
  }
  if (!token) {
    return {
      ok: false,
      protegido: true,
      error: 'sesion_requerida',
      mensaje: 'Esta acción requiere una sesión válida.'
    };
  }

  var sesion = validarSesion(token);
  if (!sesion || sesion.ok !== true) {
    return sesion || { ok: false, protegido: true, error: 'sesion_invalida' };
  }

  var rol = String(sesion.rol || '').trim().toLowerCase();
  var permitido = false;
  for (var i = 0; i < rolesPermitidos.length; i++) {
    if (rol === String(rolesPermitidos[i]).toLowerCase()) {
      permitido = true;
      break;
    }
  }
  if (!permitido) {
    return {
      ok: false,
      protegido: true,
      error: 'no_autorizado',
      mensaje: 'Operación restringida para este rol.'
    };
  }

  var propiedad = _sec006cValidarPropiedadPost_(fn, body, sesion);
  if (propiedad && propiedad.ok !== true) return propiedad;

  return { ok: true, protegido: true, sesion: sesion };
}

