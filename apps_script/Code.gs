  var target = null;
  for (var r = 1; r < d.length; r++) {
    if (String(d[r][idx.COD_GRUPO] || '').trim() !== cod) continue;
    if (String(d[r][idx.NIVEL] || '').trim().toUpperCase() !== niv) continue;
    if (Number(d[r][idx.LECCION]) !== lec) continue;
