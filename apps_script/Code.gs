function _examOfficialIds_() {
  var out = {};
  var niveles = ['B1','B2','I1','I2'];
  var tests = [{ code:'TEST1', leccion:'L18' }, { code:'TEST2', leccion:'L32' }];
  var ops = ['A','B'];
  for (var n = 0; n < niveles.length; n++) {
    for (var t = 0; t < tests.length; t++) {
      for (var o = 0; o < ops.length; o++) {
        out[niveles[n] + '_WRITTEN_' + tests[t].leccion + '_' + tests[t].code + '_' + ops[o]] = true;
      }
    }
  }
  return out;
}


