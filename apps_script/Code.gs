  var pushEnabled = _examUpper_(config.EXAM_PUSH_TO_NOTAS_ENABLED && config.EXAM_PUSH_TO_NOTAS_ENABLED.value) === 'YES';
  var studentEnabled = _examUpper_(config.STUDENT_EXAMS_ENABLED && config.STUDENT_EXAMS_ENABLED.value) === 'YES';
  _examF49Item_(items, 'Configuración', 'STUDENT_EXAMS_ENABLED', 'Exámenes estudiante habilitados', studentEnabled ? 'PASS' : 'WARN', studentEnabled ? 'STUDENT_EXAMS_ENABLED=YES.' : 'STUDENT_EXAMS_ENABLED no está en YES.', studentEnabled ? 'Sin acción.' : 'Definir si se habilita hasta el día de prueba o si se deja cerrado hasta QA.');
  _examF49Item_(items, 'Configuración', 'PUSH_TO_NOTAS_ENABLED', 'Puente Mis Notas habilitado', pushEnabled ? 'PASS' : 'WARN', pushEnabled ? 'EXAM_PUSH_TO_NOTAS_ENABLED=YES.' : 'EXAM_PUSH_TO_NOTAS_ENABLED no está en YES.', pushEnabled ? 'Sin acción.' : 'Antes de cierre real, confirmar si el push debe estar activo.');

  _examF49Item_(items, 'Datos reales', 'HAS_ACTIVATIONS', 'Activaciones creadas', Number(counts.activations || 0) > 0 ? 'PASS' : 'MANUAL', (counts.activations || 0) + ' activaciones registradas.', Number(counts.activations || 0) > 0 ? 'Revisar que fechas/grupos/niveles coincidan con cronograma.' : 'Crear una activación de prueba o esperar calendario real.');
  _examF49Item_(items, 'Datos reales', 'HAS_ATTEMPTS', 'Intentos existentes', Number(counts.attempts || 0) > 0 ? 'PASS' : 'MANUAL', (counts.attempts || 0) + ' intentos registrados.', Number(counts.attempts || 0) > 0 ? 'Usar bandeja F45 para revisar muestra.' : 'No se puede validar flujo estudiante completo sin al menos un intento real.');
  _examF49Item_(items, 'Datos reales', 'HAS_REVIEWS', 'Revisiones existentes', Number(counts.reviews || 0) > 0 ? 'PASS' : 'MANUAL', (counts.reviews || 0) + ' revisiones registradas.', Number(counts.reviews || 0) > 0 ? 'Revisar cerradas/sin Mis Notas.' : 'No se puede validar revisión real sin intento enviado.');
  _examF49Item_(items, 'Auditoría', 'HAS_AUDIT_LOGS', 'Bitácora con eventos', Number(counts.audit_logs || 0) > 0 ? 'PASS' : 'WARN', (counts.audit_logs || 0) + ' logs registrados.', Number(counts.audit_logs || 0) > 0 ? 'Usar F46 para revisar eventos críticos.' : 'Ejecutar al menos diagnóstico/bandeja/señales para tener trazabilidad.');

  var criticalSignals = Number(signalSummary.critical || 0) || 0;
  var highSignals = Number(signalSummary.high || 0) || 0;
  var mediumSignals = Number(signalSummary.medium || 0) || 0;
  _examF49Item_(items, 'Integridad', 'NO_CRITICAL_SIGNALS', 'Sin señales críticas', criticalSignals ? 'FAIL' : 'PASS', criticalSignals + ' señales críticas detectadas.', criticalSignals ? 'No cerrar notas ni publicar producción hasta revisar cada crítica.' : 'Sin acción.');
  _examF49Item_(items, 'Integridad', 'HIGH_SIGNALS_REVIEWED', 'Señales altas bajo control', highSignals ? 'WARN' : 'PASS', highSignals + ' señales altas detectadas.', highSignals ? 'Revisar F47 antes de pasar QA final.' : 'Sin acción.');
  _examF49Item_(items, 'Integridad', 'MEDIUM_SIGNALS_REVIEWED', 'Señales medias documentadas', mediumSignals ? 'MANUAL' : 'PASS', mediumSignals + ' señales medias detectadas.', mediumSignals ? 'Documentar si son configuración normal, latencia o datos de prueba.' : 'Sin acción.');

  _examF49Item_(items, 'QA manual', 'STUDENT_FLOW_LIVE', 'Prueba estudiante en vivo', 'MANUAL', 'Pendiente por decisión operativa: requiere día/activación real o tester controlado.', 'Ejecutar apertura, autosave, heartbeat, recarga, submit y auto-submit al final.');
  _examF49Item_(items, 'QA manual', 'OWNERSHIP_ATTACK', 'Intento ajeno rechazado', 'MANUAL', 'No probado en vivo desde sesión distinta.', 'Usar tester A/B y confirmar rechazo en save/submit/heartbeat.');
  _examF49Item_(items, 'QA manual', 'REVIEW_TO_NOTAS', 'Cierre revisión → Mis Notas', 'MANUAL', 'Pendiente de prueba contra ESTATUS/Mis Notas reales.', 'Cerrar revisión de prueba y validar nota, ponderación, grupo, nivel y trazabilidad.');
  _examF49Item_(items, 'QA manual', 'DOUBLE_TAB_RELOAD', 'Doble pestaña / recarga', 'MANUAL', 'Pendiente de prueba de navegador.', 'Abrir dos pestañas, enviar una y confirmar que la otra no pueda seguir guardando.');

  items.sort(function(a,b){ return (b.sort_rank || 0) - (a.sort_rank || 0) || String(a.area).localeCompare(String(b.area)) || String(a.id).localeCompare(String(b.id)); });
  var statusCounts = _examF49CountStatuses_(items);
  var blockers = items.filter(function(x){ return x.status === 'FAIL'; });
  var warnings = items.filter(function(x){ return x.status === 'WARN'; });

  var decision = 'NO_LISTO';
  if (blockers.length) decision = 'BLOQUEADO';
  else if (warnings.length || statusCounts.MANUAL) decision = 'LISTO_PARA_QA_MANUAL';
  else decision = 'LISTO_TECNICAMENTE';

  var manualProbes = [
    { order:1, fn:'examDiagnosticCenter', payload:{ include_sample:'NO' }, expected:'ok=true, sin MISSING_SHEET ni MISSING_FUNCTION.' },
    { order:2, fn:'examReviewInbox', payload:{ queue:'NEEDS_ACTION', limit:20 }, expected:'ok=true y filas coherentes con EXAM_ATTEMPTS/EXAM_REVIEW.' },
