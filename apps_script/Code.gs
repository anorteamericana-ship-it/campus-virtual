        return { ok:false, error:'La lección ya tiene un intento de examen iniciado o registrado y no se puede mover.' };
      }
    }
  }

  return { ok:true };
}

function _ccF85_slotRow_(row, idx, meta) {
  var itv = _ccF84_intervaloFila_(row, idx, meta);
  return {
    fecha: row[idx.FECHA],
    fechaIso: _ccF84_iso_(row[idx.FECHA]),
