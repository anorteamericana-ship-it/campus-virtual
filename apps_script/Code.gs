  if (role === 'admin' || role === 'superadmin') return { ok:true, mode:'admin_preview', actor:actor };
  if (role === 'teacher') return { ok:true, mode:'teacher_public_preview', actor:actor };
  try { _examSetupSheetsInternal_(actor); } catch (_) {}
  var enabled = _examUpper_(_examConfigValue_('STUDENT_EXAMS_ENABLED', 'YES')) === 'YES';
  if (!enabled) {
    return { ok:false, error:'student_exams_disabled', mensaje:'Payload público V10G listo, pero estudiante sigue deshabilitado por EXAM_CONFIG.STUDENT_EXAMS_ENABLED=NO.', actor_role: role };
  }
  return { ok:true, mode:'student_assignment', actor:actor };
}

function examGetPublicExamPayload(body) {
  body = body || {};
  var actor = _examActor_(body);
  _examSetupSheetsInternal_(actor);
  var allowed = _examPayloadRequestAllowed_(body, actor);
  if (allowed.ok !== true) return allowed;
  var role = _examClean_(actor.role).toLowerCase();
  var activation = null;
  var examId = '';
  var plan = _examUpper_(body.plan || body.PLAN || 'CON_INA');

  if (role === 'student') {
    var foundRuntime = _examFindLessonActivationForRuntime_(body, actor);
    if (!foundRuntime || foundRuntime.assigned !== true) {
      return { ok:true, assigned:false, availability: foundRuntime && foundRuntime.availability || null, mensaje: foundRuntime && foundRuntime.mensaje || 'No hay examen disponible para la lección actual.' };
    }
    activation = foundRuntime.activation;
    examId = activation.EXAM_ID;
    plan = activation.PLAN;
  } else {
    if (body.activation_id || body.ACTIVATION_ID) {
      activation = _examActivationById_(body.activation_id || body.ACTIVATION_ID);
      if (!activation) return { ok:false, error:'activacion_no_encontrada' };
      examId = activation.EXAM_ID;
      plan = activation.PLAN;
    } else {
      examId = _examBuildExamId_(body);
    }
  }

  if (!examId) return { ok:false, error:'exam_id_requerido', mensaje:'Indique exam_id o nivel/test_code/leccion/opcion.' };
  var payload = _examPublicExamById_(examId, plan);
  if (!payload) return { ok:false, error:'exam_public_payload_no_disponible', exam_id: examId };
  _examAudit_('PUBLIC_EXAM_PAYLOAD_READ', 'exam', examId, { mode: allowed.mode, activation_id: activation && activation.ACTIVATION_ID || '', sanitized: true }, actor, body);
  return { ok:true, assigned: !!activation, exam_id: examId, activation: activation ? _examPublicActivationPayload_(activation) : null, public_exam: payload };
}

function _examBuildExamId_(body) {
  var id = _examUpper_(body.exam_id || body.EXAM_ID || body.id);
  if (id) return id;
  var nivel = _examUpper_(body.nivel || body.NIVEL);
  var test = _examUpper_(body.test_code || body.TEST_CODE || body.test || body.TEST);
  var opcion = _examUpper_(body.opcion || body.OPCION);
  var leccion = String(body.leccion || body.LECCION || '').replace(/[^0-9]/g, '');
  var l = leccion === '18' ? 'L18' : leccion === '32' ? 'L32' : '';
  return nivel && test && opcion && l ? (nivel + '_WRITTEN_' + l + '_' + test + '_' + opcion) : '';
}

function _examValidateActivation_(body, partial) {
  body = body || {};
  var nivel = _examUpper_(body.nivel || body.NIVEL);
  var codGrupo = _examUpper_(body.cod_grupo || body.COD_GRUPO || body.grupo);
  var test = _examUpper_(body.test_code || body.TEST_CODE || body.test || body.TEST);
  var opcion = _examUpper_(body.opcion || body.OPCION);
  var leccion = String(body.leccion || body.LECCION || '').replace(/[^0-9]/g, '');
  var plan = _examUpper_(body.plan || body.PLAN || 'CON_INA').replace(/\s+/g, '_');
  var tipo = _examUpper_(body.tipo || body.TIPO || 'ORDINARIO').replace(/\s+/g, '_');
  var examId = _examBuildExamId_(body);
  var errors = [];

  if (!partial || codGrupo) { if (!codGrupo) errors.push('COD_GRUPO requerido.'); }
  if (!partial || nivel) { if (['B1','B2','I1','I2'].indexOf(nivel) < 0) errors.push('NIVEL inválido.'); }
  if (!partial || test) { if (['TEST1','TEST2'].indexOf(test) < 0) errors.push('TEST_CODE inválido.'); }
  if (!partial || opcion) { if (['A','B'].indexOf(opcion) < 0) errors.push('OPCION inválida.'); }
  if (!partial || leccion) { if (['18','32'].indexOf(leccion) < 0) errors.push('LECCION inválida; debe ser 18 o 32.'); }
  if (!partial || plan) { if (['CON_INA','SIN_INA'].indexOf(plan) < 0) errors.push('PLAN inválido; use CON_INA o SIN_INA.'); }
  if (!partial || tipo) { if (['ORDINARIO','REPOSICION','EXTRAORDINARIO'].indexOf(tipo) < 0) errors.push('TIPO inválido.'); }
  if (!partial || examId) { if (!examId || !_examOfficialIds_()[examId]) errors.push('EXAM_ID no pertenece a los 16 exámenes oficiales.'); }

  if (!partial && leccion && test) {
    if (test === 'TEST1' && leccion !== '18') errors.push('TEST1 debe corresponder a lección 18.');
    if (test === 'TEST2' && leccion !== '32') errors.push('TEST2 debe corresponder a lección 32.');
  }

  return {
    ok: errors.length === 0,
    errors: errors,
    data: {
      COD_GRUPO: codGrupo,
      NIVEL: nivel,
      EXAM_ID: examId,
      TEST_CODE: test,
      LECCION: leccion,
      OPCION: opcion,
      PLAN: plan,
      TIPO: tipo,
      OPEN_AT: _examClean_(body.open_at || body.OPEN_AT),
      CLOSE_AT: _examClean_(body.close_at || body.CLOSE_AT),
      TIME_LIMIT_MIN: Number(body.time_limit_min || body.TIME_LIMIT_MIN || 90) || 90,
      ALLOW_LATE: _examBoolSiNo_(body.allow_late || body.ALLOW_LATE),
      MAX_ATTEMPTS: Number(body.max_attempts || body.MAX_ATTEMPTS || 1) || 1,
      NOTES: _examClean_(body.notes || body.NOTES)
    }
  };
}

function _examFindRowById_(ws, idCol, id) {
  var values = ws.getDataRange().getValues();
  if (!values.length) return { rowIndex: -1, values: values, headers: [] };
  var headers = values[0].map(function(h){ return _examClean_(h); });
  var idx = headers.indexOf(idCol);
  if (idx < 0) return { rowIndex: -1, values: values, headers: headers };
  var target = _examClean_(id);
  for (var i = 1; i < values.length; i++) {
    if (_examClean_(values[i][idx]) === target) return { rowIndex: i + 1, values: values, headers: headers, row: values[i] };
  }
  return { rowIndex: -1, values: values, headers: headers };
}

function _examSetCells_(ws, rowIndex, updates) {
