// ════════════════════════════════════════════════════════════════════
// SEC-006C-B2 — Autorización central para lecturas sensibles GET
// Requiere token de sesión válido en e.parameter.token / session_token.
// Alcance limitado a endpoints cuyo frontend ya fue preparado para enviar
// token. No toca inscripción pública, login, recuperación ni catálogos públicos.
// ════════════════════════════════════════════════════════════════════
function _sec006cRolesPorGetEndpoint_(fn) {
  fn = String(fn || '').trim();
  var adminSuper = ['admin', 'superadmin'];
  var ventasAdminSuper = ['ventas', 'admin', 'superadmin'];
  var docenteAdminSuper = ['teacher', 'admin', 'superadmin'];
  var campusRoles = ['student', 'teacher', 'admin', 'superadmin'];
  var estudianteCampus = ['student', 'teacher', 'admin', 'superadmin'];

  var mapa = {
    // Estudiantes / pagos / comprobantes / CONAPE
    getEstudiante: estudianteCampus,
    getPortalEstudianteCompleto: estudianteCampus,
    getComprobantes: adminSuper,
    getEstadoConape: ['student', 'admin', 'superadmin'],
    getNovedadesConape: adminSuper,
    getPanelConapeCobranza: adminSuper,

    // Ventas / prospectos
    getProspectos: ventasAdminSuper,
    getProspectosAsesor: ventasAdminSuper,
    getProspectoDetalle: ventasAdminSuper,
    getResumenVentas: ventasAdminSuper,

    // Admin / académico
    getAdminDashboard: adminSuper,
    getAuditoriaAcademicaGrupo: adminSuper,
    getBecas: adminSuper,
    diagnosticoSistemaInterno: adminSuper,
    repararEstructuraOperativaF61: adminSuper,
    revisionAcademicaAsistidaF61: adminSuper,
    revisionAcademicaAsistidaF63: adminSuper,
    getGrupoEstudiantes: docenteAdminSuper,
    getAsistenciaGrupoCompleta: docenteAdminSuper,
    getEstudiantesParaCierre: docenteAdminSuper,
    getLeccionCerradaDetalle: docenteAdminSuper,
    getGrupoInfo: campusRoles,

    // Lecturas por estudiante / académico
    getRetroalimentacionEstudiante: estudianteCampus,
    getAsistenciaEstudiante: estudianteCampus,
    getICANEstudiante: estudianteCampus,
    getEvaluacionesEstudiante: estudianteCampus,

    // Docente / suspensiones
    getCalendarioDocente: docenteAdminSuper,
    getTareasPendientesDocente: docenteAdminSuper,
    getDocentesAtrasados: adminSuper,
    getSolicitudesSuspension: docenteAdminSuper
  };
  return mapa[fn] || null;
}

function _sec006cAutorizarGet_(fn, params) {
  var rolesPermitidos = _sec006cRolesPorGetEndpoint_(fn);
  if (!rolesPermitidos) return { ok: true, protegido: false };

  params = params || {};
  var token = '';
  try {
    token = String(params.token || params.session_token || '').trim();
  } catch (_) {
    token = '';
  }
  if (!token) {
    return {
      ok: false,
      protegido: true,
      error: 'sesion_requerida',
      mensaje: 'Esta lectura requiere una sesión válida.'
    };
  }

  var sesion = validarSesion(token);
  if (!sesion || sesion.ok !== true) {
    return sesion || { ok: false, protegido: true, error: 'sesion_invalida' };
  }

  var rol = String(sesion.rol || '').trim().toLowerCase();
  var permitido = false;
  for (var i = 0; i < rolesPermitidos.length; i++) {
    if (rol === String(rolesPermitidos[i]).toLowerCase()) {
      permitido = true;
      break;
    }
  }
  if (!permitido) {
    return {
      ok: false,
      protegido: true,
      error: 'no_autorizado',
      mensaje: 'Lectura restringida para este rol.'
    };
  }

  var propiedad = _sec006cValidarPropiedadGet_(fn, params, sesion);
  if (propiedad && propiedad.ok !== true) return propiedad;

  return { ok: true, protegido: true, sesion: sesion };
}

// ════════════════════════════════════════════════════════════════════
// SEC-006C-B3-1 — Validación de propiedad para rol student
// Evita IDOR: un estudiante autenticado no puede cambiar codigo/cedula
// en la URL para consultar datos académicos o CONAPE de otra persona.
// Esta fase SOLO afecta rol student. Teacher/admin/superadmin quedan
