  }
  return out;
}

function _ccF84_esRiel_(tipo, riel) {
  var t = String(tipo || '').trim().toUpperCase();
  if (riel === 'ican') return t === 'ICAN';
  return t === 'TEORICA' || t === 'PRACTICA' || t === 'EVAL_ORAL' || t === 'EVAL_ESCRITO';
}

function _ccF87_horasReprogramadasDesdeTraza_(row, idx) {
  if (!row || !idx || idx.NOTAS_DOCENTE == null) return null;
  var txt = String(row[idx.NOTAS_DOCENTE] || '');
  var re = /REPROGRAMADA\s+de[\s\S]*?\s+a\s+\d{4}-\d{2}-\d{2}\s+(\d{1,2}:\d{2})\s*[-–]\s*(\d{1,2}:\d{2})/gi;
