      mensaje:accion === 'aprobar' ? ('Solicitud aprobada y aplicada. ' + (resultado && resultado.mensaje || '')) : 'Solicitud rechazada. No se modificó el calendario.' };
  } catch (e) {
    return { ok:false, error:e.toString() };
  } finally {
    try { lock.releaseLock(); } catch (_) {}
  }
}


// ════════════════════════════════════════════════════════════════════
// suspenderLeccion(body) — F85
// Suspende un espacio y desplaza desde la lección seleccionada hasta el final
// usando las FECHAS REALES actuales de CALENDARIO_LECCIONES. Incluye clases,
// prácticas y evaluaciones. La fecha adicional se genera con el patrón regular
// del grupo y feriados. Toda la operación corre con lock, validación previa,
// idempotencia por solicitud y rollback de filas ante error de escritura.
// ════════════════════════════════════════════════════════════════════
function suspenderLeccion(body) {
  body = body || {};
  var ownsLock = body._f85_lock_held !== true;
  var lock = LockService.getScriptLock();
  try {
    if (ownsLock) lock.waitLock(30000);
    var ctx = _ccF84_contextoCalendario_(body);
    if (!ctx.ok) return ctx;
    var motivo = String(body.motivo || '').trim();
    if (!motivo) return { ok:false, error:'El motivo es obligatorio (traza para INA).' };
    var actor = _ccF85_actor_(body, 'ADMIN');
    var solicitudId = String(body.solicitud_id || '').trim();
    var idx = ctx.idx, data = ctx.data, wsCal = ctx.ws;

    // Idempotencia: no repetir una solicitud ya aplicada al calendario.
    if (solicitudId && idx.CAMBIO_SOLICITUD_ID != null) {
      for (var ir = 1; ir < data.length; ir++) {
        if (String(data[ir][idx.CAMBIO_SOLICITUD_ID] || '').trim() === solicitudId) {
          return { ok:true, idempotente:true, movimiento_id:String(data[ir][idx.ULTIMO_MOVIMIENTO_ID] || ''), mensaje:'La suspensión ya había sido aplicada.' };
        }
      }
    }

    var rowsByLesson = {};
    var duplicateLessons = [];
    var expectedMax = ctx.riel === 'ican' ? 16 : 32;
    for (var r = 1; r < data.length; r++) {
      if (String(data[r][idx.COD_GRUPO] || '').trim() !== ctx.cod) continue;
      if (String(data[r][idx.NIVEL] || '').trim().toUpperCase() !== ctx.niv) continue;
      if (!_ccF84_esRiel_(data[r][idx.TIPO_LECCION], ctx.riel)) continue;
      var n = Number(data[r][idx.LECCION]);
      if (!n || n < 1 || n > expectedMax) continue;
      if (rowsByLesson[n] != null) duplicateLessons.push(n);
      else rowsByLesson[n] = r;
    }
    if (duplicateLessons.length) {
      return { ok:false, error:'El calendario tiene lecciones duplicadas (' + duplicateLessons.join(', ') + '). No se aplicó ningún cambio; repará el calendario primero.' };
    }
    var missingLessons = [];
    for (var chk = 1; chk <= expectedMax; chk++) if (rowsByLesson[chk] == null) missingLessons.push(chk);
    if (missingLessons.length) {
      return { ok:false, error:'El calendario está incompleto. Faltan las lecciones: ' + missingLessons.join(', ') + '. Repará el calendario antes de suspender.' };
    }
    var maxLesson = expectedMax;

    var lessons = [];
    var excluded = {};
    for (var L = ctx.lec; L <= maxLesson; L++) {
      var rr = rowsByLesson[L];
      if (rr == null) return { ok:false, error:'Falta la lección ' + L + ' en CALENDARIO_LECCIONES. No se aplicó ningún cambio.' };
      var est = String(data[rr][idx.ESTADO] || '').trim().toUpperCase();
      if (est !== 'PROGRAMADA') return { ok:false, error:'No se puede desplazar: la lección ' + L + ' está ' + est + '.' };
      if (idx.REPROGRAMADA != null && _ccF85_bool_(data[rr][idx.REPROGRAMADA])) {
        return { ok:false, error:'La lección ' + L + ' tiene una reprogramación aprobada. Para no destruirla, resolvé esa reprogramación antes de suspender la secuencia.' };
      }
      var act = _ccF85_validarActividad_(ctx, { row:rr, values:data[rr] });
      if (!act.ok) return { ok:false, error:'Lección ' + L + ': ' + act.error };
      lessons.push(L); excluded[rr] = true;
    }

    var lastRow = data[rowsByLesson[maxLesson]];
    var lastSlot = _ccF85_nextRegularSlot_(ctx, lastRow);
    if (!lastSlot.ok) return lastSlot;
    var collision = _ccF85_validarChoqueSlot_(ctx, lastSlot, excluded);
    if (!collision.ok) return collision;

    var movementId = 'MOV-' + Utilities.getUuid().toUpperCase();
    var originalRows = {};
    var updates = [];
    var changes = [];
    for (var x = 0; x < lessons.length; x++) {
      var lesson = lessons[x];
      var rowIndex = rowsByLesson[lesson];
      var source = data[rowIndex];
      originalRows[rowIndex] = source.slice();
      var dest = lesson < maxLesson ? _ccF85_slotRow_(data[rowsByLesson[lesson + 1]], idx, ctx.meta) : lastSlot;
      var updated = source.slice();
      if (idx.FECHA_ORIGINAL != null && !String(updated[idx.FECHA_ORIGINAL] || '').trim()) updated[idx.FECHA_ORIGINAL] = source[idx.FECHA];
      updated[idx.FECHA] = dest.fecha instanceof Date ? new Date(dest.fecha.getTime()) : _ccF84_fechaHora_(dest.fechaIso, '00:00');
      if (idx.DIA_SEMANA != null) updated[idx.DIA_SEMANA] = dest.dia;
      if (idx.TURNO != null) updated[idx.TURNO] = dest.turno;
      if (idx.HORA_INICIO != null) updated[idx.HORA_INICIO] = dest.horaInicio;
      if (idx.HORA_FIN != null) updated[idx.HORA_FIN] = dest.horaFin;
      if (idx.ULTIMO_MOVIMIENTO_ID != null) updated[idx.ULTIMO_MOVIMIENTO_ID] = movementId;
      if (idx.ULTIMO_CAMBIO_AT != null) updated[idx.ULTIMO_CAMBIO_AT] = new Date();
      if (idx.ULTIMO_CAMBIO_POR != null) updated[idx.ULTIMO_CAMBIO_POR] = actor;
      if (idx.CAMBIO_SOLICITUD_ID != null) updated[idx.CAMBIO_SOLICITUD_ID] = solicitudId;
      updates.push({ rowIndex:rowIndex, row:updated });
      changes.push({ leccion:lesson, de:_ccF84_iso_(source[idx.FECHA]), a:dest.fechaIso });
    }

    var targetOriginal = originalRows[ctx.target.row] || data[ctx.target.row].slice();
    var suspendedSlot = _ccF85_slotRow_(targetOriginal, idx, ctx.meta);
    var appendedRow = 0;
    try {
      for (var u = 0; u < updates.length; u++) wsCal.getRange(updates[u].rowIndex + 1, 1, 1, updates[u].row.length).setValues([updates[u].row]);
      var filaLibre = _construirFilaCalendario(ctx.h, idx.COD_GRUPO, idx.NIVEL, idx.LECCION, idx.FECHA, idx.DIA_SEMANA, idx.TURNO,
        idx.TIPO_LECCION, idx.ESTADO, idx.DOCENTE, idx.ASISTENCIA_REGISTRADA, idx.NOTAS_DOCENTE,
        ctx.cod, ctx.niv, 0, suspendedSlot.fecha, suspendedSlot.dia, suspendedSlot.turno, 'LIBRE', 'LIBRE', targetOriginal[idx.DOCENTE]);
      if (idx.HORA_INICIO != null) filaLibre[idx.HORA_INICIO] = suspendedSlot.horaInicio;
      if (idx.HORA_FIN != null) filaLibre[idx.HORA_FIN] = suspendedSlot.horaFin;
      if (idx.EVENTO_ID != null) filaLibre[idx.EVENTO_ID] = 'LIBRE-' + Utilities.getUuid().toUpperCase();
      if (idx.ULTIMO_MOVIMIENTO_ID != null) filaLibre[idx.ULTIMO_MOVIMIENTO_ID] = movementId;
      if (idx.ULTIMO_CAMBIO_AT != null) filaLibre[idx.ULTIMO_CAMBIO_AT] = new Date();
      if (idx.ULTIMO_CAMBIO_POR != null) filaLibre[idx.ULTIMO_CAMBIO_POR] = actor;
      if (idx.CAMBIO_SOLICITUD_ID != null) filaLibre[idx.CAMBIO_SOLICITUD_ID] = solicitudId;
      if (idx.NOTAS_DOCENTE != null) filaLibre[idx.NOTAS_DOCENTE] = 'SUSPENDIDA: ' + motivo + ' (reg: ' + actor + ', ' + _calFmtFecha(new Date()) + ')';
      wsCal.appendRow(filaLibre);
      appendedRow = wsCal.getLastRow();
      _registrarSuspension(ctx.ssOp, { cod_grupo:ctx.cod, nivel:ctx.niv, leccion:ctx.lec, riel:ctx.riel,
        fecha_original:suspendedSlot.fechaIso, motivo:motivo, tipo:'SUSPENSION', registrado_por:actor });
      SpreadsheetApp.flush();
    } catch (writeErr) {
      for (var key in originalRows) {
        if (!originalRows.hasOwnProperty(key)) continue;
        try { wsCal.getRange(Number(key) + 1, 1, 1, originalRows[key].length).setValues([originalRows[key]]); } catch (_) {}
      }
      if (appendedRow) try { wsCal.deleteRow(appendedRow); } catch (_) {}
      throw writeErr;
    }

    return { ok:true, tipo:'SUSPENSION', cod_grupo:ctx.cod, nivel:ctx.niv, leccion:ctx.lec, riel:ctx.riel,
      libre_insertado_en:suspendedSlot.fechaIso, lecciones_empujadas:lessons.length, total_cambios:changes.length,
      cambios:changes.slice(0, 8), movimiento_id:movementId, motivo:motivo,
      mensaje:'Lección ' + ctx.lec + ' suspendida. Se desplazaron ' + lessons.length + ' lecciones usando el calendario real y se añadió una fecha al final.' };
  } catch (e) {
    return { ok:false, error:e.toString() };
  } finally {
    if (ownsLock) try { lock.releaseLock(); } catch (_) {}
  }
}


// ════════════════════════════════════════════════════════════════════
// regenerarNivelGrupo(cod_grupo, nivel)
// Regenera SOLO las filas de UN nivel de un grupo en CALENDARIO,
// sin tocar los demás niveles. Borra las del nivel (curso + ican) y
// las repuebla desde GRUPOS. Valida que no haya cerradas antes.
// ════════════════════════════════════════════════════════════════════
function regenerarNivelGrupo(cod_grupo, nivel) {
  var ssApollo = SpreadsheetApp.openById(SHEET_ID);
  var ssOp     = SpreadsheetApp.openById(OPERATIVO_ID);

  crearHojaFeriados();
  var feriados = leerFeriadosDelGrupo(cod_grupo);

  var info = _leerFilaGrupoNivel(ssApollo, cod_grupo, nivel);
  if (!info || !(info.fechaInicio instanceof Date)) {
    return { ok:false, error:'Nivel sin fecha de inicio válida en GRUPOS' };
  }

  var wsCal = ssOp.getSheetByName(SH_CALENDARIO);
  var data = wsCal.getDataRange().getValues();
  var H = data[0];
  var iG = H.indexOf('COD_GRUPO');
  var iN = H.indexOf('NIVEL');
  var iE = H.indexOf('ESTADO');

  // Validar que el nivel no tenga cerradas
  for (var r = 1; r < data.length; r++) {
    if (String(data[r][iG] || '').trim() !== cod_grupo) continue;
    if (String(data[r][iN] || '').trim().toUpperCase() !== nivel) continue;
    var est = String(data[r][iE] || '').trim().toUpperCase();
    if (est === 'CERRADA' || est === 'CALCULADA') {
      return { ok:false, error:'El nivel ' + nivel + ' tiene lecciones ' + est + '. No se puede regenerar sin perder datos. Usá suspenderLeccion para empujar.' };
    }
  }

  // Conservar todo lo que NO sea este grupo+nivel
  var conservadas = [H];
  for (var k = 1; k < data.length; k++) {
    var esEsteNivel = (String(data[k][iG] || '').trim() === cod_grupo &&
                       String(data[k][iN] || '').trim().toUpperCase() === nivel);
    if (!esEsteNivel) conservadas.push(data[k]);
  }

  // Generar nuevas filas del nivel
  var icG = H.indexOf('COD_GRUPO');
  var icN = H.indexOf('NIVEL');
  var icL = H.indexOf('LECCION');
  var icF = H.indexOf('FECHA');
  var icD = H.indexOf('DIA_SEMANA');
  var icT = H.indexOf('TURNO');
  var icK = H.indexOf('TIPO_LECCION');
  var icE = H.indexOf('ESTADO');
  var icDo= H.indexOf('DOCENTE');
  var icAR= H.indexOf('ASISTENCIA_REGISTRADA');
  var icND= H.indexOf('NOTAS_DOCENTE');

  var nuevas = [];
  var bloques = _bloquesDelDia(cod_grupo, info.horaIni, info.horaFin);
  var lecsCurso = _construirLeccionesCurso(info.fechaInicio, info.diasCurso, bloques, 32, feriados);
  var contenidoCurso = _leerProgramaDelNivel(ssApollo, nivel);
  lecsCurso.forEach(function(lec, idx) {
    var cont = contenidoCurso[idx] || { tipo:'TEORICA', detalle:'' };
    nuevas.push(_construirFilaCalendario(
      H, icG, icN, icL, icF, icD, icT, icK, icE, icDo, icAR, icND,
      cod_grupo, nivel, lec.numLec, lec.fecha, lec.diaSemana, lec.turno,
      cont.tipo, 'PROGRAMADA', info.docente
    ));
  });

  if (info.programa === 'INA') {
    var lecsICAN = _construirLeccionesICAN(info.fechaInicio, info.diasIcan, info.horaIniIcan, info.horaFinIcan, 16, feriados);
    lecsICAN.forEach(function(ic) {
      nuevas.push(_construirFilaCalendario(
        H, icG, icN, icL, icF, icD, icT, icK, icE, icDo, icAR, icND,
        cod_grupo, nivel, ic.numLec, ic.fecha, ic.diaSemana, ic.turno,
        'ICAN', 'PROGRAMADA', info.docente
      ));
    });
  }

  var todas = conservadas.concat(nuevas);
  wsCal.clear();
  wsCal.getRange(1, 1, todas.length, H.length).setValues(todas);
  wsCal.setFrozenRows(1);
  wsCal.getRange(1, 1, 1, H.length).setFontWeight('bold');

  return { ok:true, nivel:nivel, filas_generadas: nuevas.length };
}


// ════════════════════════════════════════════════════════════════════
// cambiarInicioNivel(body)
// body: { cod_grupo, nivel, nueva_fecha (YYYY-MM-DD), motivo, registrado_por }
//
// Cambia FECHA_INICIO del nivel en APOLLO.GRUPOS y regenera SOLO ese
// nivel. Valida que el nivel no tenga lecciones cerradas. Registra traza.
// Para empujar el arranque de un nivel atrasado (caso: matrícula tarda).
// ════════════════════════════════════════════════════════════════════
function cambiarInicioNivel(body) {
  if (!body) return { ok: false, error: 'body requerido' };
  var cod_grupo = String(body.cod_grupo || '').trim();
  var nivel     = String(body.nivel || '').trim().toUpperCase();
  var nueva_fecha = String(body.nueva_fecha || '').trim();
  var motivo    = String(body.motivo || '').trim();
  var registrado_por = String(body.registrado_por || '').trim();

  if (!cod_grupo || !nivel || !nueva_fecha) {
    return { ok: false, error: 'Faltan cod_grupo, nivel, nueva_fecha' };
  }
  if (!/^\d{4}-\d{2}-\d{2}$/.test(nueva_fecha)) {
    return { ok: false, error: 'nueva_fecha debe ser YYYY-MM-DD' };
  }
  if (!motivo) {
    return { ok: false, error: 'El motivo es obligatorio (traza para INA)' };
  }

  try {
    var ssApollo = SpreadsheetApp.openById(SHEET_ID);
    var ssOp     = SpreadsheetApp.openById(OPERATIVO_ID);

    // Guardar fecha original para la traza
    var infoPrev = _leerFilaGrupoNivel(ssApollo, cod_grupo, nivel);
    var fechaOriginal = (infoPrev && infoPrev.fechaInicio instanceof Date)
      ? _calFmtFecha(infoPrev.fechaInicio) : '';

    // Escribir nueva FECHA_INICIO en GRUPOS
    var wsG = ssApollo.getSheetByName(SH.GRUPOS);
    var dG = wsG.getDataRange().getValues();
    var hG = dG[0];
    var iCod = hG.indexOf('CODIGO_GRUPO');
    var iNiv = hG.indexOf('NIVEL_INICIO');
    var iFI  = hG.indexOf('FECHA_INICIO');
    var filaG = -1;
    for (var i = 1; i < dG.length; i++) {
      if (String(dG[i][iCod] || '').trim() === cod_grupo &&
          String(dG[i][iNiv] || '').trim().toUpperCase() === nivel) {
        filaG = i; break;
      }
    }
    if (filaG === -1) {
      return { ok: false, error: 'No se encontró el grupo+nivel en GRUPOS' };
    }

    var nuevaDate = new Date(nueva_fecha + 'T00:00:00');
    wsG.getRange(filaG + 1, iFI + 1).setValue(nuevaDate);

    // Regenerar solo ese nivel
    var rgen = regenerarNivelGrupo(cod_grupo, nivel);
    if (!rgen.ok) {
      // Revertir la fecha si la regeneración falló
      if (infoPrev && infoPrev.fechaInicio instanceof Date) {
        wsG.getRange(filaG + 1, iFI + 1).setValue(infoPrev.fechaInicio);
      }
      return { ok: false, error: 'No se pudo regenerar el nivel: ' + rgen.error, revertido: true };
    }

    // Traza
    _registrarSuspension(ssOp, {
      cod_grupo: cod_grupo, nivel: nivel, leccion: '', riel: 'curso',
      fecha_original: fechaOriginal, motivo: motivo,
      tipo: 'CAMBIO_INICIO', registrado_por: registrado_por
    });

    return {
      ok: true,
      cod_grupo: cod_grupo, nivel: nivel,
      fecha_anterior: fechaOriginal,
      fecha_nueva: nueva_fecha,
      filas_regeneradas: rgen.filas_generadas,
      motivo: motivo,
      mensaje: 'Inicio del nivel ' + nivel + ' movido de ' + fechaOriginal + ' a ' + nueva_fecha +
               '. ' + rgen.filas_generadas + ' lecciones regeneradas respetando patrón+feriados.'
    };
  } catch (e) {
    return { ok: false, error: e.toString() };
  }
}


// ════════════════════════════════════════════════════════════════════
// getDocentesAtrasados()                             — v4.21.9
// Panel de supervisión (admin). Itera la hoja DOCENTES activos y para
// cada uno calcula sus pendientes reusando getTareasPendientesDocente.
//
// Devuelve TODOS los docentes (con y sin atraso), con un resumen por
// cada uno. El frontend ordena/colorea. Incluye el atraso máximo en
// días (dato más urgente: quién tiene la lección más vieja sin cerrar).
//
// Respuesta:
// {
//   ok: true,
//   generado: "2026-05-22",
//   total_docentes: 8,
//   total_con_atraso: 3,
//   docentes: [
//     {
//       nombre: "JOHN ALVAREZ GONZALEZ",
//       cedula: "" | "1-1234-5678",
//       activo: true,
//       sin_cerrar: 3, sin_retro: 0, sin_pc: 0, total_pendientes: 3,
//       max_dias_atraso: 3,
//       grupos_afectados: ["B1-KJ94-B6-0425"],
//       lecciones: [ {cod_grupo, nivel, leccion, riel, fecha, dias_atraso} ]  // de sin_cerrar
//     }
//   ]
// }
// ════════════════════════════════════════════════════════════════════
function getDocentesAtrasados() {
  try {
    var ssApollo = SpreadsheetApp.openById(SHEET_ID);
    var ssOp     = SpreadsheetApp.openById(OPERATIVO_ID);

    // ── 1) Leer DOCENTES (activos) UNA vez ──────────────────────────
    var wsD = ssApollo.getSheetByName(SH.DOCENTES);
    if (!wsD) {
      return { ok: false, error: 'Hoja DOCENTES no existe. Corré crearHojaDOCENTES() y extraerDocentesDeGRUPOS().' };
    }
    var dD = wsD.getDataRange().getValues();
    var hD = dD[0];
    var iNom = hD.indexOf('NOMBRE_COMPLETO');
    var iCed = hD.indexOf('CEDULA');
    var iAct = hD.indexOf('ACTIVO');
    if (iNom === -1) return { ok: false, error: 'DOCENTES sin columna NOMBRE_COMPLETO' };

    // Lista de docentes activos, indexados por nombre normalizado
    var docentesActivos = []; // {nombre, cedula, norm}
    for (var d = 1; d < dD.length; d++) {
      var nombre = String(dD[d][iNom] || '').trim();
      if (!nombre) continue;
      var activoRaw = iAct !== -1 ? String(dD[d][iAct] || '').trim().toUpperCase() : 'SI';
      var activo = (activoRaw === 'SI' || activoRaw === 'TRUE' || activoRaw === 'SÍ' || activoRaw === '');
      if (!activo) continue;
      docentesActivos.push({
        nombre: nombre,
        cedula: iCed !== -1 ? String(dD[d][iCed] || '').trim() : '',
        norm: _normalizarNombre(nombre)
      });
    }

    // ── 2) Programa por grupo (GRUPOS) UNA vez ───────────────────────
    var wsG = ssApollo.getSheetByName(SH.GRUPOS);
    var datG = wsG.getDataRange().getValues();
    var hG = datG[0];
    var iCodG = hG.indexOf('CODIGO_GRUPO');
    var iPrgG = hG.indexOf('PROGRAMA');
    var programaPorGrupo = {};
    for (var g = 1; g < datG.length; g++) {
      var cg = String(datG[g][iCodG] || '').trim();
      if (cg) programaPorGrupo[cg] = String(datG[g][iPrgG] || '').trim().toUpperCase();
    }

    // ── 3) Calendario UNA vez → acumular por docente normalizado ─────
    var wsCal = ssOp.getSheetByName(SH_CALENDARIO);
    var datC = wsCal.getDataRange().getValues();
    var H = datC[0];
    var iG = H.indexOf('COD_GRUPO');
    var iN = H.indexOf('NIVEL');
    var iL = H.indexOf('LECCION');
    var iF = H.indexOf('FECHA');
    var iK = H.indexOf('TIPO_LECCION');
    var iE = H.indexOf('ESTADO');
    var iDo = H.indexOf('DOCENTE');

    var hoy = new Date();
    hoy.setHours(0,0,0,0);

    // Acumuladores por docente normalizado
    var acc = {}; // norm → { sinCerrar:[], cerradas:[] }
    docentesActivos.forEach(function(dc){ acc[dc.norm] = { sinCerrar: [], cerradas: [] }; });

    for (var r = 1; r < datC.length; r++) {
      var norm = _normalizarNombre(datC[r][iDo]);
      if (!acc[norm]) continue; // docente no activo o no en la lista
      var grp = String(datC[r][iG] || '').trim();
      var niv = String(datC[r][iN] || '').trim().toUpperCase();
      var lec = Number(datC[r][iL]);
      var fec = datC[r][iF];
      var tipo = String(datC[r][iK] || '').trim().toUpperCase();
      var est = String(datC[r][iE] || '').trim().toUpperCase();
      var riel = (tipo === 'ICAN') ? 'ican' : 'curso';

      if (est === 'PROGRAMADA' && fec instanceof Date && fec.getTime() < hoy.getTime()) {
        acc[norm].sinCerrar.push({
          cod_grupo: grp, nivel: niv, leccion: lec, riel: riel,
          fecha: _calFmtFecha(fec),
          dias_atraso: Math.floor((hoy.getTime() - fec.getTime()) / (1000*60*60*24))
        });
      } else if (est === 'CERRADA' || est === 'CALCULADA') {
        acc[norm].cerradas.push({
          cod_grupo: grp, nivel: niv, leccion: lec, riel: riel,
          programa: programaPorGrupo[grp] || ''
        });
      }
    }

    // ── 4) Retro y PC UNA vez (sets globales) ────────────────────────
    var setRetro = {};
    var wsR = ssOp.getSheetByName(OP.RETROALIMENTACION);
    if (wsR && wsR.getLastRow() > 1) {
      var datR = wsR.getDataRange().getValues();
      var hR = datR[0];
      var iRG = hR.indexOf('cod_grupo');
      var iRL = hR.indexOf('leccion_num');
      for (var rr = 1; rr < datR.length; rr++) {
        var gR = String(datR[rr][iRG] || '').trim();
        var lR = Number(datR[rr][iRL]);
        if (gR && lR) setRetro[gR + '|' + lR] = true;
      }
    }
    var setPC = {};
    var wsPC = ssOp.getSheetByName(OP.PROGRESS_CHECK);
    if (wsPC && wsPC.getLastRow() > 1) {
      var datPC = wsPC.getDataRange().getValues();
      var hPC = datPC[0];
      var iPCG = hPC.indexOf('cod_grupo');
      var iPCL = hPC.indexOf('leccion_num');
      for (var pp = 1; pp < datPC.length; pp++) {
        var gP = String(datPC[pp][iPCG] || '').trim();
        var lP = Number(datPC[pp][iPCL]);
        if (gP && lP) setPC[gP + '|' + lP] = true;
      }
    }

    // ── 5) Calcular pendientes de cada docente sobre lo acumulado ────
    var docentes = [];
    var totalConAtraso = 0;

    docentesActivos.forEach(function(dc){
      var a = acc[dc.norm];
      var sinCerrar = a.sinCerrar;

      // retro/pc faltantes: solo lecciones cerradas en grupos INA
      var sinRetroN = 0, sinPCN = 0;
      a.cerradas.forEach(function(it){
        if (it.programa !== 'INA') return;
        var key = it.cod_grupo + '|' + it.leccion;
        if (!setRetro[key]) sinRetroN++;
        if (it.riel === 'curso' && LECCIONES_PROGRESS_CHECK[it.leccion] && !setPC[key]) sinPCN++;
      });

      var totalPend = sinCerrar.length + sinRetroN + sinPCN;

      var maxDias = 0;
      var gruposSet = {};
      var lecciones = [];
      sinCerrar.forEach(function(it){
        if (it.dias_atraso > maxDias) maxDias = it.dias_atraso;
        if (it.cod_grupo) gruposSet[it.cod_grupo] = true;
        lecciones.push(it);
      });

      if (totalPend > 0) totalConAtraso++;

      docentes.push({
        nombre: dc.nombre,
        cedula: dc.cedula,
        activo: true,
        sin_cerrar: sinCerrar.length,
        sin_retro: sinRetroN,
        sin_pc: sinPCN,
        total_pendientes: totalPend,
        max_dias_atraso: maxDias,
        grupos_afectados: Object.keys(gruposSet),
        lecciones: lecciones
      });
    });

    // Ordenar por gravedad: primero más días de atraso, luego más pendientes.
    docentes.sort(function(a, b) {
      if (b.max_dias_atraso !== a.max_dias_atraso) return b.max_dias_atraso - a.max_dias_atraso;
      return b.total_pendientes - a.total_pendientes;
    });

    return {
      ok: true,
      generado: _calFmtFecha(new Date()),
      total_docentes: docentes.length,
      total_con_atraso: totalConAtraso,
      docentes: docentes
    };
  } catch (e) {
    return { ok: false, error: e.toString() };
  }
}

// ============================================================
// getAsesoresActivos()                                  — v4.28.0
// Devuelve la lista de asesores de ventas activos desde
// hoja USUARIOS de APOLLO_G3.
//
// Filtra: rol === 'ventas' AND activo === TRUE
//
// Respuesta:
//   { ok:true, asesores:[{nombre, telefono, wa_link, cedula}, ...] }
//
// Uso desde frontend:
//   - Dropdown "asesor_ref" en inscripcion.jsx
//   - Lookup de TELEFONO al cerrar el formulario (link WhatsApp)
// ============================================================
function getAsesoresActivos() {
  try {
    var ss = SpreadsheetApp.openById(SHEET_ID);
    var ws = ss.getSheetByName(SH.USUARIOS);
    if (!ws) return { ok: false, error: 'sheet_not_found' };

    var rows   = ws.getDataRange().getValues();
    var header = rows[0];

    var iRol      = header.indexOf('rol');
    var iNombre   = header.indexOf('nombre');
    var iActivo   = header.indexOf('activo');
    var iCedula   = header.indexOf('CEDULA');
    var iTelefono = header.indexOf('TELEFONO');

    if (iRol === -1 || iNombre === -1 || iActivo === -1 || iTelefono === -1) {
      return { ok: false, error: 'schema_error', detalle: 'Falta columna rol/nombre/activo/TELEFONO en USUARIOS' };
    }

    var asesores = [];
    for (var i = 1; i < rows.length; i++) {
      var rol = String(rows[i][iRol] || '').trim().toLowerCase();
      if (rol !== 'ventas') continue;

      var activo = rows[i][iActivo];
      var esActivo = (activo === true)
                  || (String(activo).trim().toUpperCase() === 'TRUE')
                  || (String(activo).trim().toUpperCase() === 'SI');
      if (!esActivo) continue;

      var nombre   = String(rows[i][iNombre]   || '').trim();
      var telefono = String(rows[i][iTelefono] || '').trim();
      var cedula   = iCedula !== -1 ? String(rows[i][iCedula] || '').trim() : '';

      if (!nombre) continue;

      // Normalizar teléfono: solo dígitos para construir wa.me link
      var telLimpio = telefono.replace(/[^0-9]/g, '');
      // Si tiene 8 dígitos (CR) y no empieza con código país, agregar 506
      if (telLimpio.length === 8) telLimpio = '506' + telLimpio;

      asesores.push({
        nombre:   nombre,
        telefono: telefono,         // para mostrar al usuario: "8686-0060"
        wa_link:  telLimpio,        // para link wa.me/{wa_link}
        cedula:   cedula,
      });
    }

    return { ok: true, asesores: asesores };
  } catch (err) {
    return { ok: false, error: 'exception', detalle: String(err) };
  }
}


// ============================================================
// actualizarEstadoConapeProspecto(params)              — v4.30.0
// GET ?fn=actualizarEstadoConapeProspecto&cedula=XXXXXXXXX
//
// Consulta el WS CONAPE (GetEstudiantesFinanciados), filtra por
// la cédula del prospecto, y actualiza las 2 columnas nuevas en
// PROSPECTOS:
//   - CONAPE_WS_ULTIMO_DESEMBOLSO  ("DD/MM/YYYY" o vacío si aún
//     no hay desembolso registrado)
//   - CONAPE_WS_ULTIMA_CONSULTA    (timestamp de la consulta)
//
// Lógica de novedad:
//   - Sin nombre en WS:          'no_encontrado' (CONAPE no le ha dado visto bueno)
//   - Nombre pero sin fecha:     'aprobado_sin_desembolso'
//   - Con fecha DD/MM/YYYY:      'con_desembolso' (DD es el número, MM/YYYY el período)
//
// Respuesta:
//   {
//     ok: true,
//     encontrado: bool,
//     num_desembolso: '01'|'02'|'03'|'',
//     periodo_mes:    '01'-'12'|'',
//     periodo_anio:   'YYYY'|'',
//     fecha:          'DD/MM/YYYY'|'',
//     novedad:        'no_encontrado' | 'aprobado_sin_desembolso' | 'con_desembolso',
//     nombre_ws:      'NOMBRE EN PADRÓN CONAPE'|'',
//     ultima_consulta: 'YYYY-MM-DD HH:mm:ss'
//   }
// ============================================================
function actualizarEstadoConapeProspecto(params) {
  if (!params || !params.cedula) return { ok: false, error: 'Falta cedula' };
  var cedLimpia = String(params.cedula).replace(/[-\s]/g,'').trim();

  try {
    // ── 1. Asegurar que las columnas nuevas existen (migración automática) ─
    var ss = SpreadsheetApp.openById(SHEET_ID);
    getOrCreateProspectos(ss);  // agrega CONAPE_WS_* si faltan

    var wsP = ss.getSheetByName('PROSPECTOS');
    if (!wsP) return { ok: false, error: 'Hoja PROSPECTOS no existe' };
    var pRows = wsP.getDataRange().getValues();
    var pH    = pRows[0];
    var iPCed   = pH.indexOf('CEDULA');
    var iPFinan = pH.indexOf('FINANCIAMIENTO');
    var iPDes   = pH.indexOf('CONAPE_WS_ULTIMO_DESEMBOLSO');
    var iPCon   = pH.indexOf('CONAPE_WS_ULTIMA_CONSULTA');
    var iPNov   = pH.indexOf('CONAPE_WS_NOVEDAD');  // v4.34.0

    if (iPDes === -1 || iPCon === -1) {
      return { ok: false, error: 'Columnas CONAPE_WS no existen tras migración. Revisar PROSPECTOS_HEADERS.' };
    }

    var filaP = -1;
    var financiamiento = '';
    for (var i = 1; i < pRows.length; i++) {
      if (String(pRows[i][iPCed] || '').replace(/[-\s]/g,'').trim() === cedLimpia) {
        filaP = i + 1;
        financiamiento = String(pRows[i][iPFinan] || '').toUpperCase().trim();
        break;
      }
    }
    if (filaP === -1) return { ok: false, error: 'Prospecto no encontrado: ' + cedLimpia };

    if (financiamiento !== 'CONAPE') {
      return {
        ok: false,
        error: 'El prospecto no es CONAPE (financiamiento=' + financiamiento + ')'
      };
    }

    // ── 2. Consultar WS CONAPE ─────────────────────────────────
    var url = getConapeUrl();
    var resp = UrlFetchApp.fetch(url, {
      muteHttpExceptions: true,
      followRedirects: true,
      validateHttpsCertificates: true
    });
    var status = resp.getResponseCode();
    if (status !== 200) {
      return { ok: false, error: 'WS CONAPE devolvió HTTP ' + status };
    }
    var xmlText = resp.getContentText();
    var prestatarios;
    try {
      prestatarios = parsearXmlConape(xmlText);
    } catch (errXml) {
      return { ok: false, error: 'Error parseando XML CONAPE: ' + errXml.message };
    }

    // ── 3. Buscar la cédula en la respuesta ────────────────────
    var encontrado = null;
    for (var k = 0; k < prestatarios.length; k++) {
      var cedWS = String(prestatarios[k].cedula || '').replace(/[-\s]/g,'').trim();
      if (cedWS === cedLimpia) {
        encontrado = prestatarios[k];
        break;
      }
    }

    var ahora = Utilities.formatDate(new Date(), 'America/Costa_Rica', 'yyyy-MM-dd HH:mm:ss');

    // ── 4. Determinar novedad ─────────────────────────────────
    var novedad = 'no_encontrado';
    var nombreWs = '';
    var fechaRaw = '';
    var numDes = '';
    var periodoMes = '';
    var periodoAnio = '';

    if (encontrado) {
      nombreWs = encontrado.nombre || '';
      fechaRaw = encontrado.fechaRaw || '';
      numDes = encontrado.numDesembolso || '';
      periodoMes = encontrado.periodoMes || '';
      periodoAnio = encontrado.periodoAnio || '';
      novedad = fechaRaw ? 'con_desembolso' : 'aprobado_sin_desembolso';
    }

    // ── 5. Actualizar las 3 columnas en PROSPECTOS ────────────
    wsP.getRange(filaP, iPDes + 1).setValue(fechaRaw);
    wsP.getRange(filaP, iPCon + 1).setValue(ahora);
    if (iPNov >= 0) wsP.getRange(filaP, iPNov + 1).setValue(novedad);  // v4.34.0

    return {
      ok:              true,
      encontrado:      !!encontrado,
      num_desembolso:  numDes,
      periodo_mes:     periodoMes,
      periodo_anio:    periodoAnio,
      fecha:           fechaRaw,
      novedad:         novedad,
      nombre_ws:       nombreWs,
      ultima_consulta: ahora
    };

  } catch (err) {
    return { ok: false, error: 'Error: ' + err.message };
  }
}

