// calcularPendientes(estudiante, pagos, otrosPagos, niveles)
// Calcula lo que queda por pagar por nivel, descontando pagos reales.
// pagos      = filas de PAGOS (cuotas) para este estudiante
// otrosPagos = filas de OTROS_PAGOS (matrícula/cert) para este estudiante
// Retorna pendientes por nivel + totales
function calcularPendientes(estudiante, pagos, otrosPagos, niveles) {
  niveles = niveles || {};
  var ORDEN = ['B1','B2','I1','I2'];
  var NCUENTA_MAT  = { B1:60, B2:61, I1:62, I2:63 };
  var NCUENTA_CERT = { B1:43, B2:44, I1:45, I2:46 };

  // Costo base del estudiante (puede tener precio personalizado)
  var costoMat  = parseFloat(estudiante['MATRICULA'])   || 0;
  var costoCert = parseFloat(estudiante['CERTIFICADO']) || 0;
  var costoQta  = parseFloat(estudiante['CUOTAS'])      || 0;

  // Totalizar pagos de OTROS_PAGOS por ncuenta
  var pagadoMat  = { B1:0, B2:0, I1:0, I2:0 };
  var pagadoCert = { B1:0, B2:0, I1:0, I2:0 };
  for (var o = 0; o < otrosPagos.length; o++) {
    var nc = parseInt(otrosPagos[o].ncuenta) || 0;
    var mo = parseFloat(otrosPagos[o].monto) || 0;
    ORDEN.forEach(function(n) {
      if (nc === NCUENTA_MAT[n])  pagadoMat[n]  += mo;
      if (nc === NCUENTA_CERT[n]) pagadoCert[n] += mo;
    });
  }

  // Totalizar cuotas pagadas por nivel desde PAGOS.
  // FIX v4.23.5: solo se cuentan los conceptos CUOTA_B1/B2/I1/I2 (formato con nivel).
  // El substring(6,8) posicional fallaba con formatos viejos (CUOTA_BAC-..., CUOTA_0, etc.)
  // sacando "AC"/basura. Ahora usamos regex que exige un nivel válido tras "CUOTA_".
  // Los conceptos sin nivel válido quedan FUERA del sistema (decisión: ya no se usan).
  var pagadoCuotas = { B1:0, B2:0, I1:0, I2:0 };
  var RE_CUOTA_NIVEL = /^CUOTA_(B1|B2|I1|I2)\b/i;
  for (var p = 0; p < pagos.length; p++) {
    var conc = String(pagos[p].concepto || pagos[p].Concepto || '').trim();
    var m = conc.match(RE_CUOTA_NIVEL);
    if (m) {
      var nivConc = m[1].toUpperCase();
      pagadoCuotas[nivConc] += parseFloat(pagos[p].monto || pagos[p].PAGO) || 0;
    }
  }

  // Calcular nivel activo (CA o último APR)
  var nivelActivo =
    ORDEN.find(function(n){ return (typeof niveles[n]==='object'?niveles[n].estatus:niveles[n])==='CA'; }) ||
    ORDEN.slice().reverse().find(function(n){
      var s = typeof niveles[n]==='object'?niveles[n].estatus:niveles[n];
      return s==='APR'||s==='CNV';
    }) || 'B1';

  // Tipo de periodo para calcular cuotas esperadas
  var tipoP = estudiante['TIPO_PERIODO'] || 'C';
  var nCuotas = tipoP === 'B' ? 2 : 4;

  // Pendientes del nivel activo
  var matPendiente  = Math.max(0, costoMat  - pagadoMat[nivelActivo]);
  var certPendiente = Math.max(0, costoCert - pagadoCert[nivelActivo]);
  var cuotasTotales = costoQta * nCuotas;
  var cuotasPend    = Math.max(0, cuotasTotales - pagadoCuotas[nivelActivo]);

  // Total cuotas pagadas (todos los niveles)
  var totalCuotas = 0;
  for (var p2 = 0; p2 < pagos.length; p2++) totalCuotas += parseFloat(pagos[p2].monto || pagos[p2].PAGO) || 0;
  var totalOtros = 0;
  for (var o2 = 0; o2 < otrosPagos.length; o2++) totalOtros += parseFloat(otrosPagos[o2].monto) || 0;

  return {
    nivel_activo:         nivelActivo,
    cuota_mensual:        costoQta,
    costo_total_curso:    parseFloat(estudiante['COSTO'])  || 0,
    // Montos pendientes del nivel activo (ya descontando pagos reales)
    matricula:            matPendiente,
    certificado:          certPendiente,
    cuotas_pendiente:     cuotasPend,
    cuotas_pagadas_nivel: pagadoCuotas[nivelActivo],
    n_cuotas_periodo:     nCuotas,
    // Totales históricos
    cuotas_pagadas_total: totalCuotas,
    otros_pagos_total:    totalOtros,
    // Por nivel (para vista admin)
    por_nivel: ORDEN.reduce(function(acc, n) {
      var s = typeof niveles[n]==='object'?niveles[n].estatus:niveles[n];
      if (!s) return acc;
      acc[n] = {
        matricula_pend:  Math.max(0, costoMat  - pagadoMat[n]),
        cert_pend:       Math.max(0, costoCert - pagadoCert[n]),
        cuotas_pend:     Math.max(0, (costoQta * nCuotas) - pagadoCuotas[n]),
        cuotas_pagadas:  pagadoCuotas[n],
        mat_pagada:      pagadoMat[n],
        cert_pagado:     pagadoCert[n],
        estatus:         s,
      };
      return acc;
    }, {}),
  };
}

function calcularNivelActual(grupo) {
  var tipoP      = grupo.TIPO_PERIODO;
  var perIni     = grupo.PERIODO_INICIO;
  var anioInicio = parseInt(grupo['ANO_INICIO'] || grupo['AÑO_INICIO'] || 2025);
  var hoy        = new Date();
  var anioHoy    = hoy.getFullYear();
  var mesHoy     = hoy.getMonth() + 1;
  var seqC       = ['C1','C2','C3'];
  var seqB       = ['B1','B2','B3','B4','B5','B6'];
  var niveles    = ['B1','B2','I1','I2'];
  var seq        = tipoP === 'C' ? seqC : seqB;
  var idx        = seq.indexOf(perIni);
  if (idx === -1) return 'B1';
  var nIdx = 0, anioActual = anioInicio;
  while (nIdx < 4) {
    var rango = getRangoMeses(seq[idx]);
    if (anioActual > anioHoy) break;
    if (anioActual === anioHoy && rango[0] > mesHoy) break;
    if (anioActual === anioHoy && rango[1] >= mesHoy) break;
    nIdx++;
    idx = (idx + 1) % seq.length;
    if (idx === 0) anioActual++;
  }
  return niveles[Math.min(nIdx, 3)];
}

function calcularPeriodoActual(grupo) {
  var mes = new Date().getMonth() + 1;
  if (grupo.TIPO_PERIODO === 'C') return mes <= 4 ? 'C1' : mes <= 8 ? 'C2' : 'C3';
  if (mes <= 2) return 'B1'; if (mes <= 4) return 'B2'; if (mes <= 6) return 'B3';
  if (mes <= 8) return 'B4'; if (mes <= 10) return 'B5'; return 'B6';
}

function calcularProximoPeriodo(grupo) {
  var seqC = ['C1','C2','C3'], seqB = ['B1','B2','B3','B4','B5','B6'];
  var seq  = grupo.TIPO_PERIODO === 'C' ? seqC : seqB;
  var act  = calcularPeriodoActual(grupo);
  return seq[(seq.indexOf(act) + 1) % seq.length];
}

function getRangoMeses(periodo) {
  var r = { C1:[1,4],C2:[5,8],C3:[9,12],B1:[1,2],B2:[3,4],B3:[5,6],B4:[7,8],B5:[9,10],B6:[11,12] };
  return r[periodo] || [1,12];
}

function crearSiguienteNivel(ss, cod, nivelActual, grupoActual) {
  var sig       = { B1:'B2', B2:'I1', I1:'I2' };
  var siguiente = sig[nivelActual];
  if (!siguiente) return;

  var ws     = ss.getSheetByName(SH.ESTATUS);
  var rows   = ws.getDataRange().getValues();
  var header = rows[0];

  var iLlave   = header.indexOf('LLAVE');
  var iGrupo   = header.indexOf('GRUPO');
  var iCodigo  = header.indexOf('CODIGO');
  var iNivel   = header.indexOf('NIVEL');
  var iEstatus = header.indexOf('ESTATUS');
  var iFecha   = header.indexOf('FECHA DE MODIFICION');

  var grupo      = grupoActual || '';
  var llaveNueva = String(cod) + grupo + siguiente;

  // Verificar si ya existe esa LLAVE exacta
  for (var i = 1; i < rows.length; i++) {
    var llave   = String(rows[i][iLlave]  || '').trim();
    var codFila = String(rows[i][iCodigo] || '').trim();
    var nivFila = String(rows[i][iNivel]  || '').trim().toUpperCase();
    if (iLlave > -1 && llave === llaveNueva) return;
    if (!grupo && codFila === String(cod).trim() && nivFila === siguiente) return;
  }

  var nf = new Array(header.length).fill('');
  if (iLlave  > -1) nf[iLlave]   = llaveNueva;
  if (iGrupo  > -1) nf[iGrupo]   = grupo;
  nf[iCodigo]  = String(cod);
  nf[iNivel]   = siguiente;
  nf[iEstatus] = 'CA';
  nf[iFecha]   = new Date();
  ws.appendRow(nf);
}

function getNextRecibo(ss) {
  var pV = ss.getSheetByName(SH.PAGOS).getDataRange().getValues();
  var oV = ss.getSheetByName(SH.OTROS_PAGOS).getDataRange().getValues();
  var ph = pV[0].indexOf('RECIBO'), oh = oV[0].indexOf('RECIBO');
  var max = 1000;
  for (var i = 1; i < pV.length; i++) { var r = parseInt(pV[i][ph])||0; if (r>max) max=r; }
  for (var i = 1; i < oV.length; i++) { var r = parseInt(oV[i][oh])||0; if (r>max) max=r; }
  return max + 1;
}

function formatFecha(d) {
  if (!d) return '';
  try { return Utilities.formatDate(new Date(d), 'America/Costa_Rica', 'dd/MM/yyyy'); }
  catch(e) { return String(d); }
}

function jsonResponse(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj))
    .setMimeType(ContentService.MimeType.JSON);
}

