// ── Decidir nombre de plantilla según programa + modalidad + TOEIC ─
function _decidirPlantillaPrograma(programa, modalidad, conTOEIC) {
  var horas = String(programa).toUpperCase() === 'INA' ? '128H' : '96H';
  var mod   = String(modalidad).toUpperCase().indexOf('SUPER') >= 0 ? 'SUPER INTENSIVO' : 'INTENSIVO';
  var toeic = conTOEIC ? 'CON TOEIC' : 'SIN TOEIC';
